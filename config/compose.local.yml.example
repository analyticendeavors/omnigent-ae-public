# This machine's own additions to the server stack (2026-10-22). Copy to
# config/compose.local.yml (gitignored) with every <user> replaced, e.g.
#   sed 's/<user>/member/g' config/compose.local.yml.example > config/compose.local.yml
# deploy/compose.sh layers it after deploy/docker-compose.override.yml whenever
# it exists, so it rides every up, deploy and backup without being in the
# repository; an unedited copy names an invalid network and stops the whole
# server stack from starting.
#
# Its one use today: the internal network each containerised user host reaches
# the server on (deploy/README.md, "Second user's host (container)"). Owned by
# the server stack, not the host's project, so the server never fails to start
# for want of a network some other project should have made; internal, so it
# carries no route off the machine, Postgres is not on it, and the bridge has no
# address on the machine (below). A new user is one entry under the server's
# networks and one under the top-level networks, then `deploy/compose.sh up -d`
# (it recreates the server, so every session reconnects) and
# `deploy/host-container.sh <user> up -d`.
#
# Naming networks on the service replaces Compose's implicit default network,
# so `default` stays listed: it carries Postgres and the way out.

services:
  omnigent:
    networks:
      default: {}
      host-<user>: {}

networks:
  host-<user>:
    name: omnigent-host-<user>
    internal: true
    # No address on the machine's side of the bridge. Docker gives an internal
    # network a gateway address on the machine anyway, and a container can open
    # any port the machine serves on a wildcard address (ssh :22 answered,
    # checked 2026-10-20); with no bridge address there is nothing to connect to.
    # It applies only when the network is created: one made without it must be
    # removed and recreated.
    driver_opts:
      com.docker.network.bridge.inhibit_ipv4: "true"
