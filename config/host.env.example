# omnigent-ae box host environment (Phase 6, 2026-09-23). Copy to
# config/host.env on the box (gitignored; no secrets in it). The user unit
# deploy/systemd/ae-omnigent-host.service reads this file, then
# /secure/env/omnigent-host.env, which deploy/pull-secrets.sh writes with the
# one secret the host needs.
#
# Names checked against the pinned upstream (upstream.lock): omnigent/host/connect.py:
# _RUNNER_ENV_ALLOWLIST, HARNESS_CREDENTIAL_ENV_VARS,
# RUNNER_ENV_PASSTHROUGH_ENV_VAR; omnigent/host/service_entry.py and
# packages/ae_omni_policies/src/ae_omni_policies/omni.py.

# The server, exactly as given to `omnigent login` (the stored token is keyed
# by this URL). The unit passes it to `omnigent host --server`. The agents'
# MCP server never sees this variable (the host starts it with the MCP SDK's
# default environment); it reads the `server` key `omnigent login` wrote to
# ~/.omnigent/config.yaml, so log in with this same URL (2026-09-24). The
# server's OMNIGENT_ACCOUNTS_BASE_URL; on a tailnet,
# https://<box-hostname>.<tailnet>.ts.net:8010.
OMNIGENT_SERVER_URL=http://127.0.0.1:8010

# The host forwards only an allowlist of its environment to the runners it
# spawns. Nothing OMNIGENT_-prefixed is in it except what this variable names.
# This gets the two names to the runner, not to a stdio MCP server the runner
# starts: that one receives them only when its agent spec declares `env:`,
# which ours do not (see OMNIGENT_SERVER_URL above).
OMNIGENT_RUNNER_ENV_PASSTHROUGH=OMNIGENT_SERVER_URL,OMNIGENT_TOKEN

# A session token to use instead of the stored login, for a process that
# receives this environment (not the agents' stdio MCP server, as above).
# Normally unset: the host and the MCP server share ~/.omnigent/auth_tokens.json,
# which the host keeps refreshed. A secret when set; keep it in the secrets file.
# OMNIGENT_TOKEN=

# Where the Claude CLI is when it is not on PATH; the unit already puts
# ~/.local/node/bin on PATH, so this is a fallback.
# OMNIGENT_CLAUDE_PATH=<your-home>/.local/node/bin/claude

# The plan name the usage popover shows for Claude, read by the limits relay
# (docs/PLAN-LIMITS.md, 2026-09-24). The CLI reports the plan ("Max") but not
# its tier, so the tier is spelled out here. Unset shows the reported name.
# AE_LIMITS_CLAUDE_PLAN=Max 20x

# Prompt suggestions (patches/0123 and 0128, 2026-10-20): after each finished Claude
# or Codex turn a small `claude -p --model haiku` side call guesses the next prompt
# and the web composer shows it as ghost text. Off unless set to 1. Both forwarders
# run in the runner, which receives only allowlisted names, so add
# AE_PROMPT_SUGGESTIONS to OMNIGENT_RUNNER_ENV_PASSTHROUGH above as well. Costs one
# Haiku call per turn: on a named account's login for a Claude session on one, else
# on the host's active Claude account (Codex sessions too).
# AE_PROMPT_SUGGESTIONS=1

# Box health relay (box_health_relay.py, deploy/systemd/user/ae-omnigent-box-health.service,
# which reads this file; 2026-10-28). Why: on 2026-10-28 /tmp (a 62 GB RAM tmpfs capped at
# 1,048,576 inodes) ran out of inodes and every Claude Code Bash call failed for about 15
# minutes. The relay measures every five minutes (hourly for the folder scans) and posts
# counts, sizes and ages only: never a folder, project, session, branch, worktree or file
# name. All optional; the value shown is the default.
# AE_BOX_USERS=1000=Alex,1001=Sam,container:omnigent-host-sam=Sam
#                               box user ids and host containers -> the names the card shows. Empty:
#                               each id of 1000 or more shows its login and no container is measured.
#                               Only a container named here is touched, by fixed read-only
#                               `docker exec -u agent` commands (deploy/README.md, Box health relay)
# AE_BOX_HEALTH_CONTAINER_USER=agent
# AE_BOX_HEALTH_CLAUDE_ROOTS=/tmp/claude-{uid},~/.cache/claude-tmp/claude-{uid}
#                               {uid} is each mapped user's id; ~ is that user's home. A folder of
#                               another user is shown as "not readable"
# AE_BOX_HEALTH_STALE_DAYS=2    older than this is stale (the box's tmpfiles rule uses the same two days)
# AE_BOX_HEALTH_SLOW_MINUTES=60 how often the folder scans, Docker and worktrees run
# AE_BOX_HEALTH_WALK_MAX_ENTRIES=500000   per-folder scan caps; past either the count says "at least"
# AE_BOX_HEALTH_WALK_MAX_SECONDS=30
# AE_BOX_HEALTH_DIRS=cache=~/.cache,npm=~/.npm   label=path folders whose size is reported (Claude temp
#                               folders left out). Only the label is posted, never the path; a bare path
#                               is labelled "folder 1", "folder 2" and so on
# AE_BOX_HEALTH_WORKTREES=~/worktrees      counted with size and age; never removed, never named
# AE_BOX_HEALTH_SKIP_MOUNTS=/run/user,/run/credentials,/run/lock,/snap,/var/snap,/var/lib/docker
# AE_BOX_HEALTH_GUARD_FILE=/run/user/{uid}/ae-claude-tmp-guard.json
#                               counts written by ae-claude-tmp-guard, which locks live sessions'
#                               temp folders so the two-day cleanup skips them
# AE_BOX_HEALTH_CLEANUP=on      on lets a box admin's Clean up button remove old temp files on this box, and
#                               ages each mapped container's old temp folders hourly (2026-10-29). off hides the
#                               buttons and stops both. The cleanup runs as this user, never root, and only
#                               touches the allowlisted two-day-old items (deploy/README.md, Box health relay)
# AE_BOX_HEALTH_STATE_FILE=~/.local/state/ae-omnigent/box-health.json

# Claude Code's temp root (2026-10-28, with the box hardening in
# https://github.com/analyticendeavors/agents-and-automation/pull/2038): the hardening
# moves Claude Code's per-session temp folders from the RAM-backed /tmp (which ran out of
# inodes) to the disk at /home/<user>/.cache/claude-tmp, and a tmpfiles rule ages them out
# after two days. It takes effect at the host's next restart. The runner receives only
# allowlisted names, so CLAUDE_CODE_TMPDIR must also be named in
# OMNIGENT_RUNNER_ENV_PASSTHROUGH above, or sessions keep using /tmp.
# CLAUDE_CODE_TMPDIR=/home/<user>/.cache/claude-tmp

# Key Vault card (secrets relay, deploy/systemd/user/ae-omnigent-secrets-meta.service,
# which reads this file). AE_OIDC_APP_ID is the Entra app id of the OmniGent OIDC
# client; empty by default. AE_AZURE_COST_APP_ID is the Entra app id of the Azure cost
# reader, so the relay can tag azure-cost-client-secret (2026-10-28: a real tenant id, so
# it is not in the source tree; the server needs it too, see server.env). AE_EXTRA_VAULTS is a comma-separated list of extra Key
# Vault names the Secrets card reads besides the box vault; empty by default, so
# only the box vault is listed. deploy/vault-source-tags.sh reads the host.env
# next to it, which is this unit's file only when run from the deployed tree.
# AE_VAULT_NAME is the box's Key Vault name; required by the relay and by
# deploy/pull-secrets.sh (they stop with a message when it is unset).
# AE_VAULT_NAME=kv-example-box
# AE_OIDC_APP_ID=00000000-0000-0000-0000-000000000001
# AE_AZURE_COST_APP_ID=00000000-0000-0000-0000-000000000001
# AE_EXTRA_VAULTS=kv-example-web
# AE_SECRET_SOURCE_APPS is a comma-separated list of <vault secret>=<Entra app id> pairs
# for four known secrets whose app the name alone does not say (ae-client-secret,
# devops-bridge-client-secret, cf-access-azure-client-secret,
# esignatures-oauth-ms-client-secret). While it is unset the relay proposes no ae-source
# tag for those four; secrets already tagged render as before. It is not in the source
# tree because the ids are real tenant identifiers (2026-10-29).
# AE_SECRET_SOURCE_APPS=<vault secret>=<app id>,<vault secret>=<app id>

# ── Secrets: written by deploy/pull-secrets.sh to /secure/env/omnigent-host.env ─
# CLAUDE_CODE_OAUTH_TOKEN=      from `claude setup-token` on a Claude subscription;
#                               forwarded to the Claude harnesses. Without it (or a
#                               `claude` login as the host's user) every Claude turn
#                               ends "Not logged in".
