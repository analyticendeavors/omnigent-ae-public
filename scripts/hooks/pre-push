#!/usr/bin/env bash
# Block internal identifiers before a push leaves the box (2026-10-28).
#
# Installed by `just hooks-install` as core.hooksPath for this repository and for
# upstream/, because a push from the submodule goes to the public fork. Git passes the
# remote's name and URL as arguments and the refs being pushed on stdin;
# scripts/leak-scan.py push scans every outgoing commit (its lines, message and author), the
# ref names and any tag message, against the destination remote only. docs/LEAK-SCAN.md has
# the classes and how to clear a false positive.
#
# A hook does not run for `git push --no-verify`, for a clone that never ran hooks-install,
# or for a push through the GitHub API. scripts/fork-push.sh runs this same check itself, and
# the hourly fork-backstop workflow scans the public fork's branches after the fact.
#
# The private denylist is read from AE_LEAK_DENYLIST_FILE, or from
# ~/.config/omnigent-ae/leak-denylist.txt when that file exists. Its sha256 is checked
# against AE_LEAK_DENYLIST_SHA256 or a sibling <bundle>.sha256 file; with neither the push is
# refused (write the pin with `sha256sum <bundle> | cut -d' ' -f1 > <bundle>.sha256`). With no
# bundle the push is refused, unless AE_LEAK_ALLOW_NO_DENYLIST=1 says this clone has no access
# to the private denylist (then only the generic classes run, with a warning).
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
scanner="$here/../leak-scan.py"
bundle="${AE_LEAK_DENYLIST_FILE:-}"
default="${XDG_CONFIG_HOME:-$HOME/.config}/omnigent-ae/leak-denylist.txt"
if [ -z "$bundle" ] && [ -r "$default" ]; then
  bundle="$default"
fi

args=()
if [ -n "$bundle" ]; then
  args+=(--denylist-bundle "$bundle")
  pin="${AE_LEAK_DENYLIST_SHA256:-}"
  if [ -z "$pin" ] && [ -r "$bundle.sha256" ]; then
    pin="$(cut -d' ' -f1 "$bundle.sha256")"
  fi
  if [ -n "$pin" ]; then
    args+=(--denylist-sha256 "$pin")
  elif [ "${AE_LEAK_ALLOW_NO_DENYLIST:-}" = "1" ]; then
    echo "leak-scan: warning, AE_LEAK_ALLOW_NO_DENYLIST=1 and no pinned sha256 for the denylist bundle, so it was not verified." >&2
  else
    echo "leak-scan: no pinned sha256 for the denylist bundle, so this push is refused: a stale or edited bundle would pass unnoticed. Write the pin with: sha256sum $bundle | cut -d' ' -f1 > $bundle.sha256 (or set AE_LEAK_DENYLIST_SHA256); public-release/push-denylist.sh writes it next to a fresh bundle. AE_LEAK_ALLOW_NO_DENYLIST=1 skips the check." >&2
    exit 1
  fi
elif [ "${AE_LEAK_ALLOW_NO_DENYLIST:-}" = "1" ]; then
  echo "leak-scan: warning, AE_LEAK_ALLOW_NO_DENYLIST=1 and no denylist bundle; running the generic classes only." >&2
else
  echo "leak-scan: no denylist bundle found, so this push is refused. Put the bundle at $default or point AE_LEAK_DENYLIST_FILE at it. A clone with no access to the private denylist sets AE_LEAK_ALLOW_NO_DENYLIST=1 to run the generic classes only." >&2
  exit 1
fi

exec "${AE_PYTHON:-python3}" "$scanner" "${args[@]}" push "$@"
