From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Sat, 7 Nov 2026 09:44:39 -0800
Subject: [PATCH 300/333] [ae-patch] Send openPage params only when the
 extension passes them

The host drops any message that carries an undefined value (its payload
budget check rejects it and sends no reply), so navigation.openPage(id)
without params always timed out after 10 s. Leave the params key out when
undefined, as server.request already does. Adds an SDK test for both shapes.
---
 sdks/web-extension/src/index.ts          |  8 ++-
 web/src/extensions/sdkNavigation.test.ts | 85 ++++++++++++++++++++++++
 2 files changed, 92 insertions(+), 1 deletion(-)
 create mode 100644 web/src/extensions/sdkNavigation.test.ts

diff --git a/sdks/web-extension/src/index.ts b/sdks/web-extension/src/index.ts
index 6157695a08c35fa45fc57bd2ee836c7593882090..2603bbad7df643afd6628a795c0d45b732935fdb 100644
--- a/sdks/web-extension/src/index.ts
+++ b/sdks/web-extension/src/index.ts
@@ -233,7 +233,13 @@ export function defineExtension(lifecycle: ExtensionLifecycle): void {
     capabilities: [...grantedCapabilities].sort(),
     navigation: {
       async openPage(pageId, params) {
-        await request("navigation.openPage", { pageId, params });
+        // Params are left out when absent, not sent as undefined: the host's
+        // payload budget rejects undefined values and drops the message, so
+        // the request would never be answered and would time out.
+        await request(
+          "navigation.openPage",
+          params === undefined ? { pageId } : { pageId, params },
+        );
       },
       async openSession(sessionId) {
         await request("navigation.openSession", { sessionId });
diff --git a/web/src/extensions/sdkNavigation.test.ts b/web/src/extensions/sdkNavigation.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..30b4085ac6e8a4f087e14719a3878a953ecdc757
--- /dev/null
+++ b/web/src/extensions/sdkNavigation.test.ts
@@ -0,0 +1,85 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  defineExtension,
+  type ExtensionContext,
+} from "../../../sdks/web-extension/src/index";
+import {
+  EXTENSION_RPC_SOURCE,
+  EXTENSION_RPC_VERSION,
+  type ExtensionIdentity,
+} from "../../../sdks/web-extension/src/protocol";
+
+const identity: ExtensionIdentity = {
+  extensionId: "test.ext",
+  pageId: "main",
+  view: "page",
+  nonce: "n1",
+  apiVersion: EXTENSION_RPC_VERSION,
+};
+
+// Activates the SDK against a fake host port and hands back the context plus
+// the port, so a test can read what the SDK posted.
+async function activate(): Promise<{
+  context: ExtensionContext;
+  posted: Array<Record<string, unknown>>;
+}> {
+  globalThis.__OMNIGENT_EXTENSION__ = identity;
+  const posted: Array<Record<string, unknown>> = [];
+  const port = {
+    postMessage: (message: Record<string, unknown>) => posted.push(message),
+    start: vi.fn(),
+    close: vi.fn(),
+    onmessage: null as unknown,
+  };
+  let context: ExtensionContext | undefined;
+  defineExtension({
+    activate: (ctx) => {
+      context = ctx;
+    },
+  });
+  const init = new Event("message");
+  Object.defineProperties(init, {
+    source: { value: window.parent },
+    ports: { value: [port] },
+    data: {
+      value: {
+        ...identity,
+        source: EXTENSION_RPC_SOURCE,
+        type: "init",
+        capabilities: ["navigation.openPage"],
+      },
+    },
+  });
+  window.dispatchEvent(init);
+  await Promise.resolve();
+  if (!context) throw new Error("extension did not activate");
+  return { context, posted };
+}
+
+describe("navigation.openPage", () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+  });
+  afterEach(() => {
+    vi.useRealTimers();
+    window.dispatchEvent(new Event("pagehide"));
+    delete globalThis.__OMNIGENT_EXTENSION__;
+  });
+
+  it("sends no params key when the extension passes none", async () => {
+    const { context, posted } = await activate();
+    void context.navigation.openPage("x").catch(() => undefined);
+    const request = posted.find((m) => m.type === "request");
+    expect(request?.method).toBe("navigation.openPage");
+    // The host rejects any undefined value, so the key must be absent.
+    expect(request?.params).toEqual({ pageId: "x" });
+    expect(Object.keys(request?.params as object)).not.toContain("params");
+  });
+
+  it("still sends params when the extension passes them", async () => {
+    const { context, posted } = await activate();
+    void context.navigation.openPage("x", { a: 1 }).catch(() => undefined);
+    const request = posted.find((m) => m.type === "request");
+    expect(request?.params).toEqual({ pageId: "x", params: { a: 1 } });
+  });
+});
