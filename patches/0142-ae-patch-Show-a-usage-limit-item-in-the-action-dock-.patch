diff --git a/web/src/lib/aeLimitGate.test.ts b/web/src/lib/aeLimitGate.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..73d973351ea0674f0ae5c2681ac9d01a3e74d253
--- /dev/null
+++ b/web/src/lib/aeLimitGate.test.ts
@@ -0,0 +1,207 @@
+import { describe, expect, it } from "vitest";
+import type { AeLimitWindow, AeLimitsAnswer } from "@/components/AePlanLimits";
+import {
+  AE_LIMIT_GATE_PERCENT,
+  aeHasOtherClaudeAccount,
+  aeHeadlineWindows,
+  aeLimitGate,
+  aeLimitGateShort,
+  AE_LIMIT_GATE_DISMISS_KEEP,
+  type AeLimitDismissal,
+  aeLimitDismissed,
+  aeLimitGateDismiss,
+  aeLimitGateText,
+} from "./aeLimitGate";
+
+const NOW = Date.parse("2026-10-21T12:00:00Z");
+const IN_2H = "2026-10-21T14:00:00Z";
+const IN_2D = "2026-10-23T09:00:00Z";
+const NEXT_WEEK = "2026-10-30T09:00:00Z";
+
+function win(id: string, used: number, resets: string | null, minutes: number | null) {
+  return {
+    id,
+    label: id,
+    used_percent: used,
+    resets_at: resets,
+    window_minutes: minutes,
+  } satisfies AeLimitWindow;
+}
+
+const five = (used: number, resets: string | null = IN_2H) => win("five_hour", used, resets, 300);
+const week = (used: number, resets: string | null = IN_2D) => win("seven_day", used, resets, 10080);
+
+function answer(
+  windows: AeLimitWindow[],
+  over: { account?: string | null; account_label?: string | null } = {},
+): AeLimitsAnswer {
+  return {
+    now: new Date(NOW).toISOString(),
+    harnesses: {
+      claude: {
+        harness: "claude",
+        source: "statusline",
+        observed_at: new Date(NOW).toISOString(),
+        plan: null,
+        windows,
+        note: null,
+        ...over,
+      },
+    },
+  };
+}
+
+describe("aeLimitGate", () => {
+  it("is 90 percent", () => {
+    expect(AE_LIMIT_GATE_PERCENT).toBe(90);
+  });
+
+  for (const [name, make] of [
+    ["5-hour", (used: number) => [five(used), week(10)]],
+    ["weekly", (used: number) => [five(10), week(used)]],
+  ] as const) {
+    it(`${name}: none below 90, a gate at and above it`, () => {
+      expect(aeLimitGate(answer(make(89.9)), "claude", NOW)).toBeNull();
+      const at = aeLimitGate(answer(make(90)), "claude", NOW);
+      expect(at).toMatchObject({ span: name, percent: 90 });
+      const above = aeLimitGate(answer(make(97.6)), "claude", NOW);
+      expect(above).toMatchObject({ span: name, percent: 98 });
+    });
+  }
+
+  it("the fullest window wins", () => {
+    expect(aeLimitGate(answer([five(95), week(92)]), "claude", NOW)?.span).toBe("5-hour");
+    expect(aeLimitGate(answer([five(91), week(96)]), "claude", NOW)?.span).toBe("weekly");
+  });
+
+  it("a tie goes to the window that resets later", () => {
+    expect(aeLimitGate(answer([five(93), week(93)]), "claude", NOW)?.span).toBe("weekly");
+  });
+
+  it("no windows, no answer or no harness gives no gate", () => {
+    expect(aeLimitGate(answer([]), "claude", NOW)).toBeNull();
+    expect(aeLimitGate(undefined, "claude", NOW)).toBeNull();
+    expect(aeLimitGate(answer([five(99)]), null, NOW)).toBeNull();
+    expect(aeLimitGate(answer([five(99)]), "codex", NOW)).toBeNull();
+  });
+
+  it("ignores per-model weekly rows and a window that already reset", () => {
+    const opus = win("seven_day.model.opus", 99, IN_2D, 10080);
+    expect(aeLimitGate(answer([five(10), week(10), opus]), "claude", NOW)).toBeNull();
+    expect(aeLimitGate(answer([five(99, "2026-10-21T11:00:00Z")]), "claude", NOW)).toBeNull();
+  });
+
+  it("picks Codex's windows by length and names the account", () => {
+    const codex: AeLimitsAnswer = {
+      now: new Date(NOW).toISOString(),
+      harnesses: {
+        codex: {
+          harness: "codex",
+          source: "codex",
+          observed_at: new Date(NOW).toISOString(),
+          plan: null,
+          note: null,
+          windows: [win("codex.primary", 40, IN_2H, 300), win("codex.secondary", 91, IN_2D, 10080)],
+        },
+      },
+    };
+    expect(aeHeadlineWindows(codex.harnesses.codex!.windows).week?.id).toBe("codex.secondary");
+    expect(aeLimitGate(codex, "codex", NOW)).toMatchObject({ label: "Codex", span: "weekly" });
+  });
+
+  it("labels the account", () => {
+    const named = aeLimitGate(
+      answer([week(92)], { account: "ae", account_label: "AE Default" }),
+      "claude",
+      NOW,
+    );
+    expect(named?.label).toBe("AE Default");
+    expect(aeLimitGate(answer([week(92)]), "claude", NOW)?.label).toBe("Default CLI account");
+  });
+
+  it("reads like the brief", () => {
+    const gate = aeLimitGate(answer([week(92.4)], { account_label: "AE Default" }), "claude", NOW)!;
+    expect(aeLimitGateText(gate, NOW, () => "Thu 09:00")).toBe(
+      "AE Default is at 92% of its weekly limit, resets Thu 09:00",
+    );
+    expect(aeLimitGateShort(gate)).toBe("92% weekly");
+    const noReset = aeLimitGate(answer([week(92, null)]), "claude", NOW)!;
+    expect(aeLimitGateText(noReset, NOW)).toBe("Default CLI account is at 92% of its weekly limit");
+  });
+});
+
+describe("dismiss", () => {
+  const gateOf = (windows: AeLimitWindow[], dismissed: AeLimitDismissal[] = []) =>
+    aeLimitGate(answer(windows), "claude", NOW, dismissed);
+
+  it("holds until resets_at changes, then the gate returns", () => {
+    const first = gateOf([week(92)])!;
+    const dismissed = aeLimitGateDismiss([], first);
+    expect(gateOf([week(92)], dismissed)).toBeNull();
+    // Later readings of the same window, seconds apart and fuller, across the half hour too.
+    expect(gateOf([week(95, "2026-10-23T09:00:07Z")], dismissed)).toBeNull();
+    const halfHour = aeLimitGateDismiss([], gateOf([week(92, "2026-10-23T09:29:58Z")])!);
+    expect(gateOf([week(93, "2026-10-23T09:30:01Z")], halfHour)).toBeNull();
+    // The next window.
+    expect(gateOf([week(91, NEXT_WEEK)], dismissed)?.span).toBe("weekly");
+  });
+
+  it("a dismissed fuller window does not hide the other one", () => {
+    const fiveHour = gateOf([five(95), week(91)])!;
+    expect(fiveHour.span).toBe("5-hour");
+    const dismissed = aeLimitGateDismiss([], fiveHour);
+    expect(gateOf([five(95), week(91)], dismissed)?.span).toBe("weekly");
+  });
+
+  it("dismissing one window keeps the other's dismissal", () => {
+    let dismissed = aeLimitGateDismiss([], gateOf([five(92), week(20)])!);
+    dismissed = aeLimitGateDismiss(dismissed, gateOf([five(92), week(93)], dismissed)!);
+    expect(gateOf([five(94), week(93)], dismissed)).toBeNull();
+  });
+
+  it("a dismissal is the account's, not another account's", () => {
+    const dismissed = aeLimitGateDismiss([], gateOf([week(92)])!);
+    const other = aeLimitGate(
+      answer([week(92)], { account: "personal" }),
+      "claude",
+      NOW,
+      dismissed,
+    );
+    expect(other?.account).toBe("personal");
+  });
+
+  it("keeps the newest dismissals only, one per window", () => {
+    let dismissed: AeLimitDismissal[] = [];
+    for (let i = 0; i < AE_LIMIT_GATE_DISMISS_KEEP + 3; i++) {
+      const gate = aeLimitGate(answer([week(92)], { account: `a${i}` }), "claude", NOW)!;
+      dismissed = aeLimitGateDismiss(dismissed, gate);
+    }
+    const last = aeLimitGate(answer([week(92)], { account: "a10" }), "claude", NOW)!;
+    dismissed = aeLimitGateDismiss(dismissed, last);
+    expect(dismissed).toHaveLength(AE_LIMIT_GATE_DISMISS_KEEP);
+    expect(dismissed.at(-1)?.window).toBe(last.windowKey);
+    expect(dismissed.filter((d) => d.window === last.windowKey)).toHaveLength(1);
+    expect(aeLimitDismissed(dismissed, "claude|a0|seven_day", IN_2D)).toBe(false);
+  });
+});
+
+describe("aeHasOtherClaudeAccount", () => {
+  const rows = [
+    { family: "claude-oauth-active", env_var: "" },
+    { family: "claude-oauth", env_var: "personal" },
+  ];
+
+  it("is true when the host has a login other than the session's", () => {
+    expect(aeHasOtherClaudeAccount(rows, undefined)).toBe(true);
+    expect(aeHasOtherClaudeAccount(rows, "personal")).toBe(true);
+  });
+
+  it("is false with one login, or on provider credentials", () => {
+    expect(aeHasOtherClaudeAccount([rows[0]!], undefined)).toBe(false);
+    expect(aeHasOtherClaudeAccount([rows[0]!], "")).toBe(false);
+    expect(aeHasOtherClaudeAccount([...rows, { family: "claude-provider-bedrock" }], "")).toBe(
+      false,
+    );
+    expect(aeHasOtherClaudeAccount([], undefined)).toBe(false);
+  });
+});
diff --git a/web/src/lib/aeLimitGate.ts b/web/src/lib/aeLimitGate.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b00c2a9a21be8a076e9b359e23e0ab2f297c737e
--- /dev/null
+++ b/web/src/lib/aeLimitGate.ts
@@ -0,0 +1,211 @@
+// The usage gate: when the account a chat runs on reaches
+// AE_LIMIT_GATE_PERCENT of its 5-hour or weekly window, the action dock offers
+// a way out (another model, another account, a new chat) before the session
+// runs into the limit. It never blocks sending. Pure, so the threshold, the
+// window pick and the dismiss rule are unit-tested (aeLimitGate.test.ts).
+// Fed by the session's own `GET /v1/ae/limits?session_id=` answer, which
+// already carries the windows of the account that session runs on.
+// omnigent-ae, 2026-10-21.
+
+import type { AeHarness, AeLimitWindow, AeLimitsAnswer } from "@/components/AePlanLimits";
+
+/** The gate's one step: either headline window at or past this percent. */
+export const AE_LIMIT_GATE_PERCENT = 90;
+
+const FIVE_HOUR_MINUTES = 300;
+const WEEK_MINUTES = 7 * 24 * 60;
+const HOUR_MS = 3_600_000;
+
+/** What the server calls the default CLI login when it has no label for it. */
+export const AE_DEFAULT_ACCOUNT_LABEL = "Default CLI account";
+
+export type AeLimitSpan = "5-hour" | "weekly";
+
+export interface AeLimitGate {
+  harness: AeHarness;
+  /** The backup account name; null is the default login (or Codex's one login). */
+  account: string | null;
+  /** "AE Default", "Default CLI account", "Codex". */
+  label: string;
+  windowId: string;
+  /** The window across sessions: harness, account and window id. */
+  windowKey: string;
+  span: AeLimitSpan;
+  /** Whole percent, rounded as the usage popover rounds it. */
+  percent: number;
+  resetsAt: string | null;
+}
+
+/** One dismissed window and the reset it was dismissed for. */
+export interface AeLimitDismissal {
+  window: string;
+  resets: number | null;
+}
+
+/**
+ * The 5-hour and the weekly window, as the server's `headline_windows` picks
+ * them: Claude's by id (`five_hour`, `seven_day`; never a per-model weekly
+ * row), Codex's by length, the first of each.
+ */
+export function aeHeadlineWindows(windows: readonly AeLimitWindow[]): {
+  five: AeLimitWindow | null;
+  week: AeLimitWindow | null;
+} {
+  const five =
+    windows.find((w) => w.id === "five_hour") ??
+    windows.find((w) => w.window_minutes === FIVE_HOUR_MINUTES) ??
+    null;
+  const week =
+    windows.find((w) => w.id === "seven_day") ??
+    windows.find((w) => w.window_minutes === WEEK_MINUTES && !w.id.startsWith("seven_day")) ??
+    null;
+  return { five, week };
+}
+
+function resetMs(resetsAt: string | null): number | null {
+  const at = resetsAt ? Date.parse(resetsAt) : Number.NaN;
+  return Number.isFinite(at) ? at : null;
+}
+
+export function aeLimitWindowKey(
+  harness: AeHarness,
+  account: string | null,
+  windowId: string,
+): string {
+  return [harness, account ?? "", windowId].join("|");
+}
+
+/**
+ * Whether this window's reading falls under a standing dismissal. Readings
+ * of one window differ by seconds; the next window resets at least five
+ * hours later, so a reset within the hour is the same window.
+ */
+export function aeLimitDismissed(
+  dismissed: readonly AeLimitDismissal[],
+  windowKey: string,
+  resetsAt: string | null,
+): boolean {
+  const at = resetMs(resetsAt);
+  return dismissed.some(
+    (d) =>
+      d.window === windowKey &&
+      (d.resets === null || at === null ? d.resets === at : Math.abs(d.resets - at) < HOUR_MS),
+  );
+}
+
+/** Dismissals kept: both windows of a few accounts. */
+export const AE_LIMIT_GATE_DISMISS_KEEP = 8;
+
+/** The dismissals after one more; a window keeps only its newest. */
+export function aeLimitGateDismiss(
+  dismissed: readonly AeLimitDismissal[],
+  gate: AeLimitGate,
+): AeLimitDismissal[] {
+  return [
+    ...dismissed.filter((d) => d.window !== gate.windowKey),
+    { window: gate.windowKey, resets: resetMs(gate.resetsAt) },
+  ].slice(-AE_LIMIT_GATE_DISMISS_KEEP);
+}
+
+/**
+ * The gate for one session's limits answer, or null when no window is at
+ * the threshold and not dismissed. The fullest of those windows wins, so a
+ * dismissed 5-hour gate never hides a weekly one; on a tie, the one that
+ * resets later (the longer wait). A window whose reset has passed waits for
+ * a new reading.
+ */
+export function aeLimitGate(
+  answer: AeLimitsAnswer | null | undefined,
+  harness: AeHarness | null,
+  now: number,
+  dismissed: readonly AeLimitDismissal[] = [],
+  threshold: number = AE_LIMIT_GATE_PERCENT,
+): AeLimitGate | null {
+  if (!harness) return null;
+  const snapshot = answer?.harnesses?.[harness];
+  if (!snapshot || !Array.isArray(snapshot.windows)) return null;
+  const account = snapshot.account ?? null;
+  const { five, week } = aeHeadlineWindows(snapshot.windows);
+  let pick: { window: AeLimitWindow; span: AeLimitSpan } | null = null;
+  for (const [window, span] of [
+    [five, "5-hour"],
+    [week, "weekly"],
+  ] as const) {
+    if (!window || !Number.isFinite(window.used_percent)) continue;
+    if (window.used_percent < threshold) continue;
+    const at = resetMs(window.resets_at);
+    if (at !== null && at <= now) continue;
+    if (
+      aeLimitDismissed(dismissed, aeLimitWindowKey(harness, account, window.id), window.resets_at)
+    )
+      continue;
+    const laterReset = pick !== null && (at ?? 0) > (resetMs(pick.window.resets_at) ?? 0);
+    if (
+      !pick ||
+      window.used_percent > pick.window.used_percent ||
+      (window.used_percent === pick.window.used_percent && laterReset)
+    ) {
+      pick = { window, span };
+    }
+  }
+  if (!pick) return null;
+  const fallback = harness === "codex" ? "Codex" : (account ?? AE_DEFAULT_ACCOUNT_LABEL);
+  return {
+    harness,
+    account,
+    label: snapshot.account_label?.trim() || fallback,
+    windowId: pick.window.id,
+    windowKey: aeLimitWindowKey(harness, account, pick.window.id),
+    span: pick.span,
+    percent: Math.round(pick.window.used_percent),
+    resetsAt: pick.window.resets_at,
+  };
+}
+
+/** "9:00 AM" today, "Thu 9:00 AM" on another day, in the viewer's clock. */
+export function aeLimitResetClock(iso: string, now: number): string {
+  const date = new Date(iso);
+  const clock = date.toLocaleTimeString(undefined, { hour: "numeric", minute: "2-digit" });
+  if (new Date(now).toDateString() === date.toDateString()) return clock;
+  return `${date.toLocaleDateString(undefined, { weekday: "short" })} ${clock}`;
+}
+
+/** "AE Default is at 92% of its weekly limit, resets Thu 09:00". */
+export function aeLimitGateText(
+  gate: AeLimitGate,
+  now: number,
+  clock: (iso: string, now: number) => string = aeLimitResetClock,
+): string {
+  const head = `${gate.label} is at ${gate.percent}% of its ${gate.span} limit`;
+  const at = gate.resetsAt ? Date.parse(gate.resetsAt) : Number.NaN;
+  return Number.isFinite(at) ? `${head}, resets ${clock(gate.resetsAt!, now)}` : head;
+}
+
+/** The phone line and the badge: "92% weekly". */
+export function aeLimitGateShort(gate: AeLimitGate): string {
+  return `${gate.percent}% ${gate.span}`;
+}
+
+/** The fields of a detected credential row the account check reads. */
+export interface AeLimitCredentialRow {
+  family: string;
+  env_var?: string | null;
+}
+
+/**
+ * Whether the host offers a Claude login other than the one this session
+ * runs on, so a fork onto another account has somewhere to go. Mirrors the
+ * fork dialog's account row: none on a host signed in with provider
+ * credentials. `currentAccount` is the session's account label; without
+ * one the session runs on the host's active login.
+ */
+export function aeHasOtherClaudeAccount(
+  rows: readonly AeLimitCredentialRow[],
+  currentAccount: string | null | undefined,
+): boolean {
+  if (rows.some((row) => row.family.startsWith("claude-provider"))) return false;
+  const logins = rows.filter((row) => row.family.startsWith("claude-oauth"));
+  const active = logins.find((row) => row.family === "claude-oauth-active");
+  const current = currentAccount ?? active?.env_var ?? "";
+  return logins.some((row) => (row.env_var ?? "") !== current);
+}
