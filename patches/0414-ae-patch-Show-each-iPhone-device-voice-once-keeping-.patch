diff --git a/web/src/lib/aeSpeakReplies.ts b/web/src/lib/aeSpeakReplies.ts
index 716c666f4ee3239d9d05a1acef20ac8bdd2b21fe..4a4dbba7666fda1ee27d88c969257ee1f869be3a 100644
