 const v = (name: string, voiceURI: string) => ({ name, voiceURI, lang: "en-US" }) as SpeechSynthesisVoice;
 const voices = [
@@ -33,3 +33,12 @@ describe("silent iOS voices", () => {
     expect(listVoices()).toHaveLength(4);
