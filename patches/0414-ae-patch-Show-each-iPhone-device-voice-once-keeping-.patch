 });
+
+describe("duplicate iOS voices", () => {
+  it("keeps the best quality copy of a name", () => {
+    const compact = v("Samantha", "com.apple.voice.compact.en-US.Samantha");
+    const enhanced = v("Samantha", "com.apple.voice.enhanced.en-US.Samantha");
