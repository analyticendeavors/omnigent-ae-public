From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Fri, 30 Oct 2026 17:47:48 -0700
Subject: [PATCH 262/333] [ae-patch] Fix the review findings on 0261

Reading /proc/<pid>/stat can raise ProcessLookupError when the process is reaped after the open succeeds. The test now treats that as dead too, like a missing entry.
---
 .../claude_native/forwarder/test_ae_prompt_suggest.py       | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/tests/harnesses/claude_native/forwarder/test_ae_prompt_suggest.py b/tests/harnesses/claude_native/forwarder/test_ae_prompt_suggest.py
index bd47e1c49ef674c78cb39fd8efc66d531136a35e..a582505e69c924f51279b4a85c1ab78b2c10fa43 100644
--- a/tests/harnesses/claude_native/forwarder/test_ae_prompt_suggest.py
+++ b/tests/harnesses/claude_native/forwarder/test_ae_prompt_suggest.py
@@ -312,11 +312,11 @@ async def test_timeout_kills_the_whole_process_group(on_path: Path) -> None:
         except ProcessLookupError:
             break
         # A killed but unreaped child shows as a zombie; that is dead too. The
-        # reaper can remove it between the kill probe and this read, which also
-        # means dead.
+        # reaper can remove it between the kill probe and this read, or after the
+        # open and before the read (ESRCH), which also means dead.
         try:
             fields = Path(f"/proc/{grandchild}/stat").read_text().split()
-        except FileNotFoundError:
+        except (FileNotFoundError, ProcessLookupError):
             break
         if fields[2] == "Z":
             break
