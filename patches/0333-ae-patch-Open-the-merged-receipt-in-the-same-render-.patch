Date: Mon, 9 Nov 2026 16:21:20 -0800
Subject: [PATCH 333/333] [ae-patch] Open the merged receipt in the same render
 that marks it merged

The inline PR receipt opened after a merge from a useEffect. The effect's
setOpen runs at default priority, so React rendered it in a later task and
the DOM showed one frame with the receipt word "merged" and aria-expanded
false. The AeInlinePrCards squash-merge test read the receipt in that frame
now and then on CI (runs 42699227611 and 42725885218 on 2026-11-09).

The open now happens while rendering, keyed on the merge result, so the
first frame that says merged is already open. The test watches the DOM and
asserts the receipt is open the moment the word first reads merged; it
fails on the old effect every run.
---
 web/src/components/AeInlinePrCards.test.tsx | 11 +++++++++++
 web/src/components/AePrCards.tsx            | 12 ++++++++----
 2 files changed, 19 insertions(+), 4 deletions(-)

diff --git a/web/src/components/AeInlinePrCards.test.tsx b/web/src/components/AeInlinePrCards.test.tsx
index 7c0223d656e4bcec90e1c66e941cb70a7655b6c6..71d53e1e35c2778e9252b1b487384d25663cd88a 100644
--- a/web/src/components/AeInlinePrCards.test.tsx
+++ b/web/src/components/AeInlinePrCards.test.tsx
@@ -175,10 +175,21 @@ describe("AeInlinePrCards", () => {
       });
       renderText(`Opened ${url(41)}`, [url(41)], card(41));
       await screen.findByTestId("ae-pr-receipt");
+      // Read the receipt the moment it first says "merged": it is open already,
+      // never one collapsed frame first (that frame flaked CI on 2026-11-09).
+      const firstMerged: (string | null)[] = [];
+      const watch = new MutationObserver(() => {
+        if (firstMerged.length > 0) return;
+        if (screen.queryByTestId("ae-pr-receipt-word")?.textContent !== "merged") return;
+        firstMerged.push(screen.getByTestId("ae-pr-receipt").getAttribute("aria-expanded"));
+      });
+      watch.observe(document.body, { subtree: true, childList: true, characterData: true });
       fireEvent.click(screen.getByRole("button", { name: "Squash into main" }));
       await vi.waitFor(() =>
         expect(screen.getByTestId("ae-pr-receipt-word").textContent).toBe("merged"),
       );
+      watch.disconnect();
+      expect(firstMerged).toEqual(["true"]);
       expect(screen.getByTestId("ae-pr-receipt")).toHaveAttribute("data-tone", "purple");
       // It opens on its own, so the note and its offer show.
       expect(screen.getByTestId("ae-pr-receipt")).toHaveAttribute("aria-expanded", "true");
diff --git a/web/src/components/AePrCards.tsx b/web/src/components/AePrCards.tsx
index 68d370fd60599de90c5a179928761b8a26c175c3..62b9480418d288612935c48bd007b51c862be013 100644
--- a/web/src/components/AePrCards.tsx
+++ b/web/src/components/AePrCards.tsx
@@ -711,10 +711,14 @@ export function AePrCardView({
     select: (mutation) => mutation.state.data as AeMergeResult,
   }).filter((done) => !done.session || done.session.id === sessionId);
   const result = panel ? mergedByCard : (mergedElsewhere.at(-1) ?? null);
-  // The receipt opens when a merge lands, so the note and its offer show.
-  useEffect(() => {
-    if (variant === "inline" && result) setOpen(true);
-  }, [variant, result]);
+  // The receipt opens when a merge lands, so the note and its offer show. Set
+  // while rendering, not in an effect, so the frame that first says "merged" is
+  // already open (an effect left one collapsed frame, which flaked CI, 2026-11-09).
+  const [openedFor, setOpenedFor] = useState<AeMergeResult | null>(null);
+  if (variant === "inline" && result && result !== openedFor) {
+    setOpenedFor(result);
+    setOpen(true);
+  }
   // Inline and panel cards share the operation, including when one mounts mid-update.
   const { data: branchUpdate } = useQuery<{ sha: string; started: number } | null>({
     queryKey: updateKey,
