+        )
+        assert common._session_status_cache[child_id] == "waiting"
+        assert _statuses(published, child_id) == []
+    finally:
+        common._session_status_cache.pop(child_id, None)
+        common._session_blocked_on_cache.pop(child_id, None)
+
