+                store, now=conv.updated_at + CLAUDE_SUBAGENT_STALE_AFTER_S + 1
+            )
+            == 1
+        )
+        assert common._session_status_cache[child_id] == "idle"
+    finally:
+        common._session_status_cache.pop(child_id, None)
+
