+        "balanced"
+    )
+    custom = {"roles": YOLO["roles"], "rules": YOLO["rules"]}
+    labels = team_label(roles={"preset": "balanced", "custom": custom})
+    assert resolve_roles(conversation(labels), owner_store("reid@example.com"))["custom"] is True
