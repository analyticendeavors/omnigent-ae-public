From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Wed, 11 Nov 2026 14:18:13 -0800
Subject: [PATCH 359/443] [ae-patch] Tap to start the mic on the new-chat
 screen restarts the mic with a fresh recognizer

---
 web/src/hooks/useAeVoiceStart.test.ts | 13 +++++++++++--
 web/src/hooks/useAeVoiceStart.ts      |  5 ++++-
 2 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/web/src/hooks/useAeVoiceStart.test.ts b/web/src/hooks/useAeVoiceStart.test.ts
index a88e717b75fcc66169267598c1564a18fbbe374f..4739e88508dd53b923f39117082751cb1728a2d8 100644
--- a/web/src/hooks/useAeVoiceStart.test.ts
+++ b/web/src/hooks/useAeVoiceStart.test.ts
@@ -105,15 +105,24 @@ describe("useAeVoiceStart with a mic that is already listening", () => {
     expect(result.current.phase).toBe("listening");
   });
 
-  it("restart starts the mic again and reports listening when it already is", () => {
+  it("restart gives the mic a fresh start and reports listening when it already is", () => {
     const { result, mic } = setup();
     act(() => result.current.toggle());
     act(() => result.current.onListening(false));
     expect(result.current.phase).toBe("unavailable");
     act(() => result.current.restart());
-    expect(mic.start).toHaveBeenCalledTimes(2);
+    expect(mic.restart).toHaveBeenCalledTimes(1);
     mic.isListening = () => true;
     act(() => result.current.restart());
     expect(result.current.phase).toBe("listening");
   });
+
+  it("the Tap to start the mic tap calls restart, not start, so a stuck start gets a fresh recognizer", () => {
+    const { result, mic } = setup();
+    act(() => result.current.toggle());
+    expect(mic.start).toHaveBeenCalledTimes(1);
+    act(() => result.current.restart());
+    expect(mic.restart).toHaveBeenCalledTimes(1);
+    expect(mic.start).toHaveBeenCalledTimes(1);
+  });
 });
diff --git a/web/src/hooks/useAeVoiceStart.ts b/web/src/hooks/useAeVoiceStart.ts
index aa74a54317d3a5d6c4e6bc1718065cf8d714a42c..a124050a24a2fa4593722ee88a5764c1342632c9 100644
--- a/web/src/hooks/useAeVoiceStart.ts
+++ b/web/src/hooks/useAeVoiceStart.ts
@@ -101,7 +101,10 @@ export function useAeVoiceStart({
   }, [armed, controller, disarm, reportIfListening]);
 
   const restart = useCallback(() => {
-    controller.current?.start();
+    // A fresh recognizer inside the tap: a start that is stuck (iOS) ignores a second start().
+    const c = controller.current;
+    if (c?.restart) c.restart();
+    else c?.start();
     reportIfListening();
   }, [controller, reportIfListening]);
 
