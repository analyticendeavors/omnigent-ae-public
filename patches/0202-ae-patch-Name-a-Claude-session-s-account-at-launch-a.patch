+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import type { ReactNode } from "react";
+import { renderHook, waitFor } from "@testing-library/react";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const mocks = vi.hoisted(() => ({
+  session: { session: null as { hostId?: string } | null, isLoading: false },
+  credentials: { data: undefined as unknown, isSuccess: false, isError: false, isFetching: false },
+}));
+vi.mock("@/hooks/useSession", () => ({ useSession: () => mocks.session }));
+vi.mock("@/hooks/useHosts", () => ({ useDetectedCredentials: () => mocks.credentials }));
+
+import { useAePickedClaudeAccount } from "./useAePickedClaudeAccount";
+
+const wrapper = ({ children }: { children: ReactNode }) => (
+  <QueryClientProvider client={new QueryClient()}>{children}</QueryClientProvider>
+);
+
+beforeEach(() => {
+  mocks.session = { session: { hostId: "h1" }, isLoading: false };
+  mocks.credentials = { data: undefined, isSuccess: false, isError: false, isFetching: false };
+});
+
+describe("useAePickedClaudeAccount", () => {
+  it("is ready with no account when it is off", () => {
+    const { result } = renderHook(() => useAePickedClaudeAccount("conv_a", false), { wrapper });
+    expect(result.current).toEqual({ account: undefined, ready: true });
+  });
+
+  it("waits for the host's logins, then names the selected one", async () => {
+    const { result, rerender } = renderHook(() => useAePickedClaudeAccount("conv_a", true), {
+      wrapper,
+    });
+    expect(result.current).toEqual({ account: undefined, ready: false });
+    mocks.credentials = {
+      data: [
+        { family: "claude-oauth", source: "Default CLI account", env_var: "" },
+        { family: "claude-oauth-active", source: "AE Backup", env_var: "shared:AE Backup" },
+      ],
+      isSuccess: true,
+      isError: false,
+      isFetching: false,
+    };
+    rerender();
+    await waitFor(() =>
+      expect(result.current).toEqual({ account: "shared:AE Backup", ready: true }),
+    );
+  });
+
+  it("is ready without a hint when the logins cannot be read or the host is unknown", () => {
+    mocks.credentials = { data: undefined, isSuccess: false, isError: true, isFetching: false };
+    const failed = renderHook(() => useAePickedClaudeAccount("conv_a", true), { wrapper });
+    expect(failed.result.current).toEqual({ account: undefined, ready: true });
+    mocks.session = { session: null, isLoading: false };
+    const noHost = renderHook(() => useAePickedClaudeAccount("conv_a", true), { wrapper });
+    expect(noHost.result.current).toEqual({ account: undefined, ready: true });
+  });
+
+  it("does not name a pick from stale cached logins while a refetch is in flight", () => {
+    mocks.credentials = {
+      data: [{ family: "claude-oauth-active", source: "AE Backup", env_var: "AE Backup" }],
+      isSuccess: true,
+      isError: false,
+      isFetching: true,
+    };
+    const { result, rerender } = renderHook(() => useAePickedClaudeAccount("conv_a", true), {
+      wrapper,
+    });
+    expect(result.current).toEqual({ account: undefined, ready: false });
+    mocks.credentials = {
+      data: [{ family: "claude-oauth-active", source: "Default CLI account", env_var: "" }],
+      isSuccess: true,
+      isError: false,
+      isFetching: false,
+    };
+    rerender();
+    expect(result.current).toEqual({ account: "", ready: true });
+  });
+});
diff --git a/web/src/hooks/useAePickedClaudeAccount.ts b/web/src/hooks/useAePickedClaudeAccount.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e12095a15456b5ba2b1d120f5bb8099ef34164d1
--- /dev/null
+++ b/web/src/hooks/useAePickedClaudeAccount.ts
@@ -0,0 +1,34 @@
+// The Claude login the account picker has selected for new chats, as the usage
+// panels send it to `GET /v1/ae/limits?account=`: a chat that has not replied
+// yet has no reading of its own, and the server answers it for this account
+// rather than with the host's reading of another one. omnigent-ae, 2026-10-26.
+
+import { useDetectedCredentials } from "@/hooks/useHosts";
+import { useSession } from "@/hooks/useSession";
+import { aePickedClaudeAccount } from "@/lib/aeLimitGate";
+
+/**
+ * @param sessionId - The chat the usage panel is for; its host is asked.
+ * @param enabled - Only a Claude chat has an account to name.
+ * @returns `account` is `""` for the default login and `undefined` when none
+ *   can be named; `ready` is false until the host's logins have answered (or
+ *   failed to), so a panel waits for them instead of showing the default
+ *   login's numbers first.
+ */
+export function useAePickedClaudeAccount(
+  sessionId: string | null | undefined,
+  enabled: boolean,
+): { account: string | undefined; ready: boolean } {
+  const on = enabled && Boolean(sessionId);
+  const { session, isLoading } = useSession(on ? sessionId : null);
+  const credentials = useDetectedCredentials(session?.hostId, on);
+  if (!on) return { account: undefined, ready: true };
+  const hostKnown = Boolean(session?.hostId);
+  // Cached logins from before a pick are stale while a refetch is in flight: wait it out,
+  // or the session's first hint (frozen for good) would be the previous pick.
+  const settled = (credentials.isSuccess || credentials.isError) && !credentials.isFetching;
+  return {
+    account: credentials.data && settled ? aePickedClaudeAccount(credentials.data) : undefined,
+    ready: !isLoading && (!hostKnown || settled),
+  };
+}
