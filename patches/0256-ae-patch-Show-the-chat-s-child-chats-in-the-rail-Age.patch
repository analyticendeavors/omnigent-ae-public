diff --git a/web/src/lib/aeDockReveal.ts b/web/src/lib/aeDockReveal.ts
new file mode 100644
index 0000000000000000000000000000000000000000..041d555d85dfad80bb1c0bd88e8fb527cb443d06
--- /dev/null
+++ b/web/src/lib/aeDockReveal.ts
@@ -0,0 +1,28 @@
+// A tiny event so a control outside the action dock (the rail's Answer button) can ask
+// the dock to open its tray and scroll to a kind of line, or to one child's line (omnigent-ae, 2026-10-29).
+// Nothing is stored: a reveal with no dock mounted is simply lost.
+
+import { useEffect, useRef } from "react";
+import type { AeDockKind } from "@/lib/aeActionDock";
+
+type Listener = (kind: AeDockKind, childId?: string) => void;
+
+const listeners = new Set<Listener>();
+
+/** Ask any mounted dock to open its tray at the first line of `kind`, or at `childId`'s. */
+export function aeRevealDock(kind: AeDockKind, childId?: string): void {
+  for (const listener of [...listeners]) listener(kind, childId);
+}
+
+/** Run `onReveal` for each reveal while the caller is mounted. */
+export function useAeDockReveal(onReveal: Listener): void {
+  const latest = useRef(onReveal);
+  latest.current = onReveal;
+  useEffect(() => {
+    const listener: Listener = (kind, childId) => latest.current(kind, childId);
+    listeners.add(listener);
+    return () => {
+      listeners.delete(listener);
+    };
+  }, []);
+}
diff --git a/web/src/lib/aeRailChildChats.test.ts b/web/src/lib/aeRailChildChats.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d72ec9745a19c462f364f32a0a31e5cdfa31acae
--- /dev/null
+++ b/web/src/lib/aeRailChildChats.test.ts
@@ -0,0 +1,69 @@
+import { describe, expect, it } from "vitest";
+import type { Conversation } from "@/hooks/useConversations";
+import { buildAeChildChats } from "./aeRailChildChats";
+
+function row(id: string, extra: Partial<Conversation> = {}, labels: Record<string, string> = {}) {
+  return {
+    id,
+    object: "conversation",
+    title: id,
+    created_at: 0,
+    updated_at: 100,
+    labels: { "ae.orch": "lead", ...labels },
+    permission_level: null,
+    status: "idle",
+    ...extra,
+  } as Conversation;
+}
+
+describe("buildAeChildChats", () => {
+  it("keeps only direct children, never forks, the lead itself or other families", () => {
+    const model = buildAeChildChats(
+      [
+        row("a"),
+        row("fork", {}, { "omnigent.fork.source_id": "x" }),
+        row("other", {}, { "ae.orch": "elsewhere" }),
+        row("lead", {}, { "ae.orch": "lead" }),
+        row("grand", {}, { "ae.orch": "a" }),
+        row("none", {}, { "ae.orch": "1" }),
+      ],
+      "lead",
+    );
+    expect(model.open.map((c) => c.row.id)).toEqual(["a"]);
+  });
+
+  it("orders needs-you, then working, then the rest newest first", () => {
+    const model = buildAeChildChats(
+      [
+        row("old-done", { updated_at: 10 }),
+        row("new-done", { updated_at: 90 }),
+        row("busy", { status: "running", updated_at: 50 }),
+        row("asks", { pending_elicitations_count: 1, updated_at: 5 }),
+        row("broke", { status: "failed", updated_at: 40 }),
+      ],
+      "lead",
+    );
+    expect(model.open.map((c) => [c.row.id, c.status])).toEqual([
+      ["asks", "needs"],
+      ["busy", "working"],
+      ["new-done", "done"],
+      ["broke", "error"],
+      ["old-done", "done"],
+    ]);
+    expect(model.needs.map((c) => c.row.id)).toEqual(["asks"]);
+    expect(model.working).toBe(1);
+  });
+
+  it("folds reference and archived children into closed, newest first", () => {
+    const model = buildAeChildChats(
+      [
+        row("ref", { updated_at: 1 }, { "ae.status": "reference" }),
+        row("arch", { updated_at: 2, archived: true }),
+        row("live"),
+      ],
+      "lead",
+    );
+    expect(model.open.map((c) => c.row.id)).toEqual(["live"]);
+    expect(model.closed.map((r) => r.id)).toEqual(["arch", "ref"]);
+  });
+});
diff --git a/web/src/lib/aeRailChildChats.ts b/web/src/lib/aeRailChildChats.ts
