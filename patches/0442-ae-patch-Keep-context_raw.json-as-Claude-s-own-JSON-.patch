+@pytest.mark.asyncio
+async def test_tokens_post_with_the_cost_once_the_seed_recovers(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    bridge = tmp_path / "bridge"
