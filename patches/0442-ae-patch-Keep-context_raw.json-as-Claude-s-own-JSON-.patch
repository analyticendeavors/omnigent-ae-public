     try:
         stat = raw_path.stat()
     except OSError:
@@ -111,11 +115,11 @@ def sync_raw_status_context(
         text = raw_path.read_text(encoding="utf-8")
     except OSError:
         return last_sig
-    proc_id, _, rest = text.partition("\n")
-    if PROC_ID_RE.fullmatch(proc_id):
-        text = rest
-    else:
-        proc_id = ""
