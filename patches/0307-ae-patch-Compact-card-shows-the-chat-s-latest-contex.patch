From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Sat, 7 Nov 2026 13:34:16 -0800
Subject: [PATCH 307/333] [ae-patch] Compact card shows the chat's latest
 context reading, not the size it first crossed at

---
 web/src/lib/aeCompactSuggestion.test.ts | 16 ++++++++++++----
 web/src/lib/aeCompactSuggestion.ts      |  8 +++++---
 2 files changed, 17 insertions(+), 7 deletions(-)

diff --git a/web/src/lib/aeCompactSuggestion.test.ts b/web/src/lib/aeCompactSuggestion.test.ts
index 1a88d995034e7a0d8e4cfdcfadc784b6d5fbfad1..c73d5b0d9d84f3ec92725eeb8097950e7dcdcf5d 100644
--- a/web/src/lib/aeCompactSuggestion.test.ts
+++ b/web/src/lib/aeCompactSuggestion.test.ts
@@ -57,10 +57,18 @@ describe("aeCompactSuggestion", () => {
     expect(aeCompactSuggestion(row)).toBeNull();
   });
 
-  it("falls back to the context label when the size is missing", () => {
-    const labels = { ...LEAD, "omnigent.last_context_tokens": "310000" } as Record<string, string>;
-    delete labels["ae.handoff_at"];
-    expect(aeCompactSuggestion({ labels })).toEqual({ tokens: 310000 });
+  it("prefers the live context label over the size at labelling", () => {
+    const labels = { ...LEAD, "omnigent.last_context_tokens": "734000" };
+    expect(aeCompactSuggestion({ labels })).toEqual({ tokens: 734000 });
+  });
+
+  it("falls back to ae.handoff_at when the live context label is missing", () => {
+    expect(aeCompactSuggestion({ labels: LEAD })).toEqual({ tokens: 370400 });
+  });
+
+  it("falls back to ae.handoff_at when the live context label is 0", () => {
+    const labels = { ...LEAD, "omnigent.last_context_tokens": "0" };
+    expect(aeCompactSuggestion({ labels })).toEqual({ tokens: 370400 });
   });
 
   it("words the line in thousands", () => {
diff --git a/web/src/lib/aeCompactSuggestion.ts b/web/src/lib/aeCompactSuggestion.ts
index d57bb4a11d38832a9ab4201389c5aebfeb95f30f..39a5b957ed7cc18c695b5ac1c44ea9935ff400cc 100644
--- a/web/src/lib/aeCompactSuggestion.ts
+++ b/web/src/lib/aeCompactSuggestion.ts
@@ -1,7 +1,9 @@
 // The Compact card's model (omnigent-ae, 2026-10-29): the server sweep
 // (lead_handoff.py) labels a top-level Claude chat `ae.handoff=suggest` once its
-// context passes the owner's "Suggest compacting at" size, with the size in
-// `ae.handoff_at`. The dock and the rail both read it from the cached session row.
+// context passes the owner's "Suggest compacting at" size. The card shows the chat's latest
+// context reading (`omnigent.last_context_tokens`), so it keeps up as the chat grows.
+// `ae.handoff_at` is only the size when the label was written (the server still uses it as
+// the snooze base), so it is the fallback. The dock and the rail both read the cached session row.
 // Pure, so the rules are unit-tested (aeCompactSuggestion.test.ts).
 
 import { authenticatedFetch } from "@/lib/identity";
@@ -61,7 +63,7 @@ export function aeCompactSuggestion(
 ): AeCompactSuggestion | null {
   if (!row || row.labels[AE_HANDOFF_KEY] !== "suggest" || !aeCompactEligible(row)) return null;
   const { labels } = row;
-  return { tokens: positive(labels[AE_HANDOFF_AT_KEY]) ?? positive(labels[CONTEXT_KEY]) ?? 0 };
+  return { tokens: positive(labels[CONTEXT_KEY]) ?? positive(labels[AE_HANDOFF_AT_KEY]) ?? 0 };
 }
 
 /** "370k": the size in thousands, rounded. */
