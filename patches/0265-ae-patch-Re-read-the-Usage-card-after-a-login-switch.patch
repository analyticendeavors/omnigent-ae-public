@@ -106,3 +113,40 @@ describe("aeSwitchSummary", () => {
     ).toBe("This chat now runs on Backup; 1 child chat moved; 1 skipped: Docs: needs a host");
   });
 });
+
+describe("aeRefreshChatAccountSoon", () => {
+  afterEach(() => vi.useRealTimers());
+
+  const limitsCalls = (spy: ReturnType<typeof vi.fn>) =>
+    spy.mock.calls.filter(([arg]) => arg?.queryKey?.[0] === "ae-limits").length;
+
+  it("re-reads the Usage numbers now and at each follow-up delay", () => {
+    vi.useFakeTimers();
+    const invalidate = vi.fn();
+    const client = { invalidateQueries: invalidate } as unknown as QueryClient;
+    aeRefreshChatAccountSoon(client, "s1");
+    expect(limitsCalls(invalidate)).toBe(1);
+    expect(invalidate).toHaveBeenCalledWith({ queryKey: ["session", "s1"] });
+    vi.advanceTimersByTime(Math.max(...AE_ACCOUNT_FOLLOW_UP_DELAYS_MS));
+    expect(limitsCalls(invalidate)).toBe(1 + AE_ACCOUNT_FOLLOW_UP_DELAYS_MS.length);
+    expect(invalidate).toHaveBeenCalledWith({ queryKey: ["ae-limits", "s1"] });
+  });
+
+  it("stops re-reading once cancelled", () => {
+    vi.useFakeTimers();
+    const invalidate = vi.fn();
+    const client = { invalidateQueries: invalidate } as unknown as QueryClient;
+    const cancel = aeRefreshChatAccountSoon(client, "s1");
+    vi.advanceTimersByTime(AE_ACCOUNT_FOLLOW_UP_DELAYS_MS[0]);
+    cancel();
+    vi.advanceTimersByTime(60_000);
+    expect(limitsCalls(invalidate)).toBe(2);
+  });
+
+  it("schedules nothing without a session", () => {
+    vi.useFakeTimers();
+    const invalidate = vi.fn();
+    aeRefreshChatAccountSoon({ invalidateQueries: invalidate } as unknown as QueryClient, null);
+    expect(vi.getTimerCount()).toBe(0);
+  });
+});
diff --git a/web/src/lib/aeClaudeAccount.ts b/web/src/lib/aeClaudeAccount.ts
index bac5107c956cefbce56bd5b13f01d3d1260e5989..0f4c7afada2aafbe8d17740854196d7909ecf957 100644
--- a/web/src/lib/aeClaudeAccount.ts
+++ b/web/src/lib/aeClaudeAccount.ts
@@ -61,6 +61,32 @@ export function aeRefreshChatAccount(queryClient: QueryClient, sessionId: string
   if (sessionId) void queryClient.invalidateQueries({ queryKey: ["ae-limits", sessionId] });
 }
 
+/**
+ * When to re-read the Usage numbers after a switch (ms after it settled). The server answers
+ * from the runner's launch-time label, which the runner stamps only after the terminal
+ * relaunches, so the first re-read can still see the old login (2026-10-30).
+ */
+export const AE_ACCOUNT_FOLLOW_UP_DELAYS_MS = [2000, 5000, 12000, 30000];
+
+/**
+ * `aeRefreshChatAccount` now, then the Usage numbers again at each follow-up delay so the card
+ * catches the runner's stamp. Returns a function that cancels the pending re-reads.
+ */
+export function aeRefreshChatAccountSoon(
+  queryClient: QueryClient,
+  sessionId: string | null,
+): () => void {
+  aeRefreshChatAccount(queryClient, sessionId);
+  if (!sessionId) return () => {};
+  const timers = AE_ACCOUNT_FOLLOW_UP_DELAYS_MS.map((delay) =>
+    setTimeout(
+      () => void queryClient.invalidateQueries({ queryKey: ["ae-limits", sessionId] }),
+      delay,
+    ),
+  );
+  return () => timers.forEach(clearTimeout);
+}
+
 /** The login a chat is on: the stored pick, else the last launch's, else unknown (`undefined`). */
 export function aeChatAccount(
   labels: Record<string, string> | null | undefined,
