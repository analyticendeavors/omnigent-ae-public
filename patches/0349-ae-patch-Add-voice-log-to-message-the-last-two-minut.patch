diff --git a/web/src/lib/aeVoiceLog.test.ts b/web/src/lib/aeVoiceLog.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3b4364bc1d267e3085b426d9f799deafb55fcac1
--- /dev/null
+++ b/web/src/lib/aeVoiceLog.test.ts
@@ -0,0 +1,63 @@
+// Tests for the voice log: ring buffer, window, detail cap, format and the insert event.
+
+import { act, renderHook } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  formatVoiceLog,
+  logVoice,
+  requestVoiceLogInsert,
+  resetVoiceLog,
+  useVoiceLogInsert,
+} from "./aeVoiceLog";
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  vi.setSystemTime(new Date("2026-11-10T12:00:00.000Z"));
+  resetVoiceLog();
+});
+afterEach(() => vi.useRealTimers());
+
+describe("voice log", () => {
+  it("formats a header and offset lines, oldest first", () => {
+    logVoice("mic start", "browser");
+    vi.advanceTimersByTime(1230);
+    logVoice("final", "hello");
+    const lines = formatVoiceLog().split("\n");
+    expect(lines[0]).toBe(`Voice log 2026-11-10T12:00:00.000Z ${navigator.userAgent}`);
+    expect(lines[1]).toBe("+0.00s mic start browser");
+    expect(lines[2]).toBe("+1.23s final hello");
+  });
+
+  it("keeps only entries inside the window", () => {
+    logVoice("old");
+    vi.advanceTimersByTime(130_000);
+    logVoice("new");
+    const text = formatVoiceLog();
+    expect(text).toContain("new");
+    expect(text).not.toContain("old");
+    expect(formatVoiceLog(200_000)).toContain("old");
+  });
+
+  it("caps details at 80 characters and the buffer at 300 entries", () => {
+    logVoice("long", "x".repeat(200));
+    expect(formatVoiceLog().split("\n")[1]).toBe(`+0.00s long ${"x".repeat(80)}`);
+    resetVoiceLog();
+    for (let i = 0; i < 350; i += 1) logVoice(`e${i}`);
+    const lines = formatVoiceLog().split("\n");
+    expect(lines).toHaveLength(301);
+    expect(lines[1]).toContain("e50");
+  });
+
+  it("asks the page to insert the log into the draft", () => {
+    logVoice("voice on");
+    const setValue = vi.fn();
+    const { rerender } = renderHook(({ v }) => useVoiceLogInsert(v, setValue), {
+      initialProps: { v: "" },
+    });
+    act(() => requestVoiceLogInsert());
+    expect(setValue).toHaveBeenLastCalledWith(expect.stringContaining("+0.00s voice on"));
+    rerender({ v: "draft" });
+    act(() => requestVoiceLogInsert());
+    expect(setValue).toHaveBeenLastCalledWith(expect.stringMatching(/^draft\n\nVoice log /));
+  });
+});
diff --git a/web/src/lib/aeVoiceLog.ts b/web/src/lib/aeVoiceLog.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7c7584fd8300d71c3e9be22aa3eaf40cf5bbb86b
--- /dev/null
+++ b/web/src/lib/aeVoiceLog.ts
@@ -0,0 +1,67 @@
+// A small in-memory log of voice events (mic, sentences, replies, browser errors) so a
+// phone's voice session can be diagnosed: the menu row "Add voice log to message" puts the
+// last two minutes into the message box. Nothing leaves the device until the user sends.
+
+import { useEffect, useRef } from "react";
+
+interface VoiceLogEntry {
+  t: number;
+  event: string;
+  detail?: string;
+}
+
+const MAX_ENTRIES = 300;
+const MAX_DETAIL = 80;
+const INSERT_EVENT = "ae-voice-log-insert";
+
+let entries: VoiceLogEntry[] = [];
+
+export function logVoice(event: string, detail?: string): void {
+  try {
+    if (typeof window === "undefined") return;
+    entries.push({ t: Date.now(), event, detail });
+    if (entries.length > MAX_ENTRIES) entries.splice(0, entries.length - MAX_ENTRIES);
+  } catch {
+    // Logging must never break voice.
+  }
+}
+
+export function resetVoiceLog(): void {
+  entries = [];
+}
+
+export function formatVoiceLog(windowMs = 120_000): string {
+  const now = Date.now();
+  const inWindow = entries.filter((e) => now - e.t <= windowMs);
+  const start = inWindow.length > 0 ? inWindow[0].t : now;
+  const ua = typeof navigator === "undefined" ? "" : navigator.userAgent;
+  const header = `Voice log ${new Date(start).toISOString()} ${ua}`;
+  const lines = inWindow.map((e) => {
+    const detail = e.detail ? ` ${e.detail.slice(0, MAX_DETAIL)}` : "";
+    return `+${((e.t - start) / 1000).toFixed(2)}s ${e.event}${detail}`;
+  });
+  return [header, ...lines].join("\n");
+}
+
+export function requestVoiceLogInsert(): void {
+  if (typeof window === "undefined") return;
+  window.dispatchEvent(new CustomEvent(INSERT_EVENT, { detail: { text: formatVoiceLog() } }));
+}
+
+/** Appends the voice log to the message box when the speaker menu asks for it. */
+export function useVoiceLogInsert(value: string, setValue: (next: string) => void): void {
+  const valueRef = useRef(value);
+  valueRef.current = value;
+  const setRef = useRef(setValue);
+  setRef.current = setValue;
+  useEffect(() => {
+    const onInsert = (e: Event) => {
+      const text = (e as CustomEvent<{ text: string }>).detail?.text;
+      if (!text) return;
+      const current = valueRef.current;
+      setRef.current(current ? `${current}\n\n${text}` : text);
+    };
+    window.addEventListener(INSERT_EVENT, onInsert);
+    return () => window.removeEventListener(INSERT_EVENT, onInsert);
+  }, []);
+}
