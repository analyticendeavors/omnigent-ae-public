+++ b/web/src/lib/aeQueryCacheSubscribe.test.ts
@@ -0,0 +1,58 @@
+import { QueryClient } from "@tanstack/react-query";
+import { describe, expect, it, vi } from "vitest";
+import { subscribeToQueryKeys } from "./aeQueryCacheSubscribe";
+
+describe("subscribeToQueryKeys", () => {
+  it("fires for a matching key and a longer key under the prefix", () => {
+    const client = new QueryClient();
+    const onChange = vi.fn();
+    subscribeToQueryKeys(client, [["conversations"]], onChange);
+    client.setQueryData(["conversations"], 1);
+    expect(onChange).toHaveBeenCalled();
+    onChange.mockClear();
+    client.setQueryData(["conversations", "list", { a: 1 }], 1);
+    expect(onChange).toHaveBeenCalled();
+    onChange.mockClear();
+    client.setQueryData(["conversations", "list", { a: 1 }], 2);
+    expect(onChange).toHaveBeenCalled();
+  });
+
+  it("matches any of several keys", () => {
+    const client = new QueryClient();
+    const onChange = vi.fn();
+    subscribeToQueryKeys(client, [["conversations"], ["ae", "helpers-count"]], onChange);
+    client.setQueryData(["ae", "helpers-count"], true);
+    expect(onChange).toHaveBeenCalled();
+  });
+
+  it("does not fire for a non-matching key", () => {
+    const client = new QueryClient();
+    const onChange = vi.fn();
+    subscribeToQueryKeys(client, [["conversations"]], onChange);
+    client.setQueryData(["session", "a"], 1);
+    client.setQueryData(["ae", "helpers-count"], true);
+    expect(onChange).not.toHaveBeenCalled();
+  });
+
+  it("does not fire for observer-only events", () => {
+    const client = new QueryClient();
+    client.setQueryData(["conversations"], 1);
+    const onChange = vi.fn();
+    subscribeToQueryKeys(client, [["conversations"]], onChange);
+    const query = client.getQueryCache().find({ queryKey: ["conversations"] })!;
+    const observer = { onQueryUpdate: () => {} } as never;
+    query.addObserver(observer);
+    query.removeObserver(observer);
+    client.getQueryCache().notify({ type: "observerResultsUpdated", query });
+    expect(onChange).not.toHaveBeenCalled();
+  });
+
+  it("stops after unsubscribe", () => {
+    const client = new QueryClient();
+    const onChange = vi.fn();
+    const unsubscribe = subscribeToQueryKeys(client, [["conversations"]], onChange);
+    unsubscribe();
+    client.setQueryData(["conversations"], 1);
+    expect(onChange).not.toHaveBeenCalled();
+  });
+});
diff --git a/web/src/lib/aeQueryCacheSubscribe.ts b/web/src/lib/aeQueryCacheSubscribe.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d645120fc30f58bba5455b3ecb999951af548e1f
--- /dev/null
+++ b/web/src/lib/aeQueryCacheSubscribe.ts
@@ -0,0 +1,19 @@
+// A query-cache subscription that wakes only for the keys a hook reads. A bare
+// `getQueryCache().subscribe(onChange)` fires for every cache event, and a
+// session switch fires hundreds (each fetch adds, updates and re-notifies its
+// observers), so each hook re-scanned the cache on events it could not care about.
+
+import { type QueryClient, type QueryKey, partialMatchKey } from "@tanstack/react-query";
+
+/** Calls `onChange` when a query under one of `keys` is added, removed or updated. */
+export function subscribeToQueryKeys(
+  queryClient: QueryClient,
+  keys: readonly QueryKey[],
+  onChange: () => void,
+): () => void {
+  return queryClient.getQueryCache().subscribe((event) => {
+    if (event.type !== "added" && event.type !== "removed" && event.type !== "updated") return;
+    const queryKey = event.query.queryKey;
+    if (keys.some((key) => partialMatchKey(queryKey, key))) onChange();
+  });
+}
