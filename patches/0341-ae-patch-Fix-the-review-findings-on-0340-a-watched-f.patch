 });
+
+describe("a watched family the catalog does not list", () => {
+  afterEach(() => aeSetWatchedModels([]));
+  const SUB = { kind: "subscription", label: "Subscription", name: "claude" };
+  const FABLE_ONLY: NativeModelOption[] = [
+    { id: "claude-fable-5-2[1m]", model: "claude-fable-5-2", displayName: "Fable", source: SUB },
+  ];
+
+  it("adds one subscription row for a watched Mythos id", () => {
+    aeSetWatchedModels(["claude-mythos-5-2"]);
+    const row = aeWithClaudeVersions(FABLE_ONLY).find((r) => r.id === "claude-mythos-5-2");
+    expect(row).toEqual({
+      id: "claude-mythos-5-2",
+      model: "claude-mythos-5-2",
+      displayName: "Mythos 5.2",
+      source: SUB,
+    });
+  });
+
+  it("adds nothing from the static list alone", () => {
+    const rows = aeWithClaudeVersions(FABLE_ONLY);
+    expect(rows.some((r) => r.id.includes("opus") || r.id.includes("mythos"))).toBe(false);
+  });
+
+  it("adds nothing when the catalog has no subscription row", () => {
+    aeSetWatchedModels(["claude-mythos-5-2"]);
+    const other: NativeModelOption[] = [{ id: "x", model: "x", displayName: "X" }];
+    expect(aeWithClaudeVersions(other)).toBe(other);
+  });
+});
diff --git a/web/src/lib/aeClaudeModels.ts b/web/src/lib/aeClaudeModels.ts
index faa5d51ce3917a5761f170fa4c960576b2bb11d8..b5a6d4148445763940a59f39177574393a4f80ff 100644
--- a/web/src/lib/aeClaudeModels.ts
+++ b/web/src/lib/aeClaudeModels.ts
@@ -231,7 +231,21 @@ export function aeMergeKnownClaudeModels(
     )?.source;
     older.push({ id, model: id, displayName: aeClaudeVersionLabel(id) ?? id, source });
   }
-  return [...relabeled, ...older];
+  // A watched id (the box saw it answer) whose family the catalog does not list at all would never
+  // show; it gets one subscription row of its own. The static list never adds a family.
+  const fresh = new Map<string, { version: AeClaudeVersion; id: string }>();
+  for (const id of new Set([...extraKnown, ...watched])) {
+    const version = WATCHED_ID.test(id) ? aeClaudeVersion(id) : null;
+    if (!version || newest.has(version.family)) continue;
+    const held = fresh.get(version.family);
+    if (!held || compareVersions(version, held.version) > 0)
+      fresh.set(version.family, { version, id });
+  }
+  const source = subscriptionRows[0]?.source;
+  const added: NativeModelOption[] = [...fresh.values()]
+    .filter(({ id }) => !rows.some((row) => row.id === id))
+    .map(({ id }) => ({ id, model: id, displayName: aeClaudeVersionLabel(id) ?? id, source }));
+  return [...relabeled, ...older, ...added];
 }
 
 /** {@link aeMergeKnownClaudeModels} with the built-in known list. */
