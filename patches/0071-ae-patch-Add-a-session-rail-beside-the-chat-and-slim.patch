+// Tests for the Triage section's pure parts: the absorbed and unfiled lines,
+// the turn count, the started line, the overflow tag, and the gate reply.
+
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { AnyBlock, BlockContext } from "@/lib/blocks";
+
+const mocks = vi.hoisted(() => ({ fetch: vi.fn() }));
+vi.mock("@/lib/identity", () => ({ authenticatedFetch: mocks.fetch }));
+
+import {
+  aeOrdinal,
+  aeOverflowTag,
+  aeStartedLine,
+  countAeUserTurns,
+  fetchAeLotTasks,
+  formatAeAge,
+  parseAeStarted,
+  replyAeGate,
+  scanAeTriageLines,
+} from "./aeRailTriage";
+
+const ctx: BlockContext = {
+  agent: null,
+  depth: 0,
+  turn: 0,
+  timestamp: 0,
+  responseId: "r",
+  itemId: null,
+};
+
+function said(text: string): AnyBlock {
+  return { type: "text_done", ctx, fullText: text, hasCodeBlocks: false };
+}
+
+function asked(text: string): AnyBlock {
+  return { type: "user_message", ctx, content: [{ type: "input_text", text }] };
+}
+
+function json(status: number, body: unknown): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { "Content-Type": "application/json" },
+  });
+}
+
+afterEach(() => mocks.fetch.mockReset());
+
+describe("scanAeTriageLines", () => {
+  it("reads tokens at the start of a line only, from assistant text only", () => {
+    const blocks = [
+      said("Done.\nAbsorbed: Tabler icon for the rail button, same file\nmore"),
+      said("We said Absorbed: inside prose, which is not a marker."),
+      said("UNFILED (target unreachable), file this yourself\r\nTHREAD: x"),
+      asked("Absorbed: typed by the human"),
+      said("Absorbed:   Phone frame for the popover  "),
+    ];
+    expect(scanAeTriageLines(blocks)).toEqual({
+      absorbed: ["Tabler icon for the rail button, same file", "Phone frame for the popover"],
+      unfiled: ["(target unreachable), file this yourself"],
+    });
+  });
+
+  it("keeps the token for a bare line and is empty with nothing loaded", () => {
+    expect(scanAeTriageLines([said("UNFILED")]).unfiled).toEqual(["UNFILED"]);
+    expect(scanAeTriageLines([])).toEqual({ absorbed: [], unfiled: [] });
+  });
+});
+
+describe("countAeUserTurns", () => {
+  it("counts user messages and leaves out system markers", () => {
+    expect(countAeUserTurns([asked("one"), said("reply"), asked("two")])).toBe(2);
+    expect(countAeUserTurns([asked("[System: the runner restarted]")])).toBe(0);
+  });
+});
+
+describe("the started line", () => {
+  it("parses ae.started and rejects blanks and junk", () => {
+    expect(parseAeStarted("1760000000")).toBe(1760000000);
+    expect(parseAeStarted(null)).toBeNull();
+    expect(parseAeStarted("soon")).toBeNull();
+    expect(parseAeStarted("0")).toBeNull();
+  });
+
+  it("formats ages", () => {
+    expect(formatAeAge(30)).toBe("just now");
+    expect(formatAeAge(5 * 60)).toBe("5m");
+    expect(formatAeAge(2 * 3600 + 10 * 60)).toBe("2h 10m");
+    expect(formatAeAge(3 * 3600)).toBe("3h");
+    expect(formatAeAge(3 * 86400 + 4 * 3600)).toBe("3d 4h");
+  });
+
+  it("joins the age and the turns, either alone, or nothing", () => {
+    const now = 10_000_000 * 1000;
+    const started = 10_000_000 - (2 * 3600 + 10 * 60);
+    expect(aeStartedLine(started, now, 41)).toBe("Started 2h 10m ago · 41 turns");
+    expect(aeStartedLine(started, now, null)).toBe("Started 2h 10m ago");
+    expect(aeStartedLine(null, now, 1)).toBe("1 turn");
+    expect(aeStartedLine(null, now, 12, true)).toBeNull();
+    expect(aeStartedLine(started, now, 12, true)).toBe("Started 2h 10m ago");
+    expect(aeStartedLine(null, now, null)).toBeNull();
+  });
+});
+
+describe("the overflow tag", () => {
+  it("names the place past the limit", () => {
+    expect(aeOrdinal(4)).toBe("4th");
+    expect(aeOrdinal(2)).toBe("2nd");
+    expect(aeOrdinal(11)).toBe("11th");
+    expect(aeOrdinal(22)).toBe("22nd");
+    expect(aeOverflowTag(3)).toEqual({
+      label: "4th working",
+      title: "Started while three sessions were already working",
+    });
+  });
+});
+
+describe("replyAeGate", () => {
+  it("posts the route to the gate reply route", async () => {
+    mocks.fetch.mockResolvedValue(json(200, { posted: true }));
+    await replyAeGate("conv a", "C");
+    expect(mocks.fetch).toHaveBeenCalledWith("/v1/ae/gate/conv%20a/reply", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ route: "C" }),
+    });
+  });
+
+  it("throws the server's message", async () => {
+    mocks.fetch.mockResolvedValue(
+      json(409, { error: { code: "conflict", message: "no open gate on session s1" } }),
+    );
+    await expect(replyAeGate("s1", "A")).rejects.toThrow("no open gate on session s1");
+  });
+
+  it("falls back to the status line without a JSON body", async () => {
+    mocks.fetch.mockResolvedValue(new Response("boom", { status: 502, statusText: "Bad Gateway" }));
+    await expect(replyAeGate("s1", "close")).rejects.toThrow("502 Bad Gateway");
+  });
+});
+
+describe("fetchAeLotTasks", () => {
+  it("keeps id, title and link, and drops rows without an id", async () => {
+    mocks.fetch.mockResolvedValue(
+      json(200, {
+        tasks: [{ id: "t1", title: "Parked thing", url: "https://tasks.example/#/all?q=x" }, {}],
+      }),
+    );
+    await expect(fetchAeLotTasks()).resolves.toEqual([
+      { id: "t1", title: "Parked thing", url: "https://tasks.example/#/all?q=x" },
+    ]);
+  });
+
+  it("throws what the lot route said", async () => {
+    mocks.fetch.mockResolvedValue(
+      json(503, { error: { code: "not_configured", message: "task-store is not configured" } }),
+    );
+    await expect(fetchAeLotTasks()).rejects.toThrow("task-store is not configured");
+  });
+});
diff --git a/web/src/lib/aeRailTriage.ts b/web/src/lib/aeRailTriage.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c5ca126f74d638344697f8a59e67e7c23b08432b
--- /dev/null
+++ b/web/src/lib/aeRailTriage.ts
@@ -0,0 +1,194 @@
+// The session rail's Triage section, the pure parts: the absorbed and unfiled
+// lines in the loaded assistant messages, the user turns, the "started" age,
+// and the gate reply the Dashboard's buttons send.
+
+import type { AnyBlock } from "@/lib/blocks";
+import { authenticatedFetch } from "@/lib/identity";
+import { isSystemUserContent } from "@/lib/systemMessage";
+
+export interface AeTriageLines {
+  absorbed: string[];
+  unfiled: string[];
+}
+
+// Read like the observer reads them: the token at the start of a line only.
+const ABSORBED = /^Absorbed:\s*(.*)$/;
+const UNFILED = /^UNFILED\b[\s:,.-]*(.*)$/;
+
+/**
+ * Every "Absorbed:" and "UNFILED" line in the loaded assistant messages, the
+ * token stripped (an UNFILED line with nothing after it keeps the token).
+ */
+export function scanAeTriageLines(blocks: readonly AnyBlock[]): AeTriageLines {
+  const absorbed: string[] = [];
+  const unfiled: string[] = [];
+  for (const block of blocks) {
+    if (block.type !== "text_done") continue;
+    for (const raw of block.fullText.split("\n")) {
+      const line = raw.replace(/\r$/, "");
+      const a = ABSORBED.exec(line);
+      if (a) {
+        absorbed.push(a[1].trim() || "Absorbed");
+        continue;
+      }
+      const u = UNFILED.exec(line);
+      if (u) unfiled.push(u[1].trim() || "UNFILED");
+    }
+  }
+  return { absorbed, unfiled };
+}
+
+/** The user messages loaded for the session, leaving out runtime `[System: ...]` markers. */
+export function countAeUserTurns(blocks: readonly AnyBlock[]): number {
+  let turns = 0;
+  for (const block of blocks) {
+    if (block.type === "user_message" && !isSystemUserContent(block.content)) turns += 1;
+  }
+  return turns;
+}
+
+/** `ae.started` (epoch seconds as text) as a number, or `null` when blank or not a time. */
+export function parseAeStarted(value: string | null): number | null {
+  if (value === null) return null;
+  const seconds = Number(value);
+  return Number.isFinite(seconds) && seconds > 0 ? seconds : null;
+}
+
+/** "2h 10m", "5m", "3d 4h", "just now" for an age in seconds. */
+export function formatAeAge(seconds: number): string {
+  const s = Math.max(0, Math.floor(seconds));
+  if (s < 60) return "just now";
+  const minutes = Math.floor(s / 60);
+  if (minutes < 60) return `${minutes}m`;
+  const hours = Math.floor(minutes / 60);
+  if (hours < 24) return minutes % 60 ? `${hours}h ${minutes % 60}m` : `${hours}h`;
+  const days = Math.floor(hours / 24);
+  return hours % 24 ? `${days}d ${hours % 24}h` : `${days}d`;
+}
+
+/**
+ * "Started 2h 10m ago · 41 turns", either half alone when the other is
+ * unknown, or `null` when both are. With older history unloaded the count
+ * would only be a floor, so it is left out.
+ */
+export function aeStartedLine(
+  startedS: number | null,
+  nowMs: number,
+  turns: number | null,
+  moreHistory = false,
+): string | null {
+  const parts: string[] = [];
+  if (startedS !== null) {
+    const age = formatAeAge(nowMs / 1000 - startedS);
+    parts.push(age === "just now" ? "Started just now" : `Started ${age} ago`);
+  }
+  if (turns !== null && !moreHistory) {
+    parts.push(`${turns} ${turns === 1 ? "turn" : "turns"}`);
+  }
+  return parts.length > 0 ? parts.join(" · ") : null;
+}
+
+const ORDINAL_SUFFIX = ["th", "st", "nd", "rd"];
+
+/** 4 reads "4th", 11 "11th", 22 "22nd". */
+export function aeOrdinal(n: number): string {
+  const teen = n % 100 >= 11 && n % 100 <= 13;
+  return `${n}${(!teen && ORDINAL_SUFFIX[n % 10]) || "th"}`;
+}
+
+const NUMBER_WORDS = [
+  "zero",
+  "one",
+  "two",
+  "three",
+  "four",
+  "five",
+  "six",
+  "seven",
+  "eight",
+  "nine",
+];
+
+/** The overflow tag and its title for a slot limit: "4th working" over three. */
+export function aeOverflowTag(limit: number): { label: string; title: string } {
+  const count = NUMBER_WORDS[limit] ?? String(limit);
+  return {
+    label: `${aeOrdinal(limit + 1)} working`,
+    title: `Started while ${count} sessions were already working`,
+  };
+}
+
+// ── the gate reply ───────────────────────────────────────────────────────
+
+export type AeGateRoute = "A" | "B" | "C" | "close";
+
+/** The Dashboard's four answers (ae_omni_extension gate.ts): route, label, tooltip. */
+export const AE_GATE_ROUTES: readonly [AeGateRoute, string, string][] = [
+  ["A", "Do it now", "A, act now: absorb it into this thread"],
+  ["B", "Write a note", "B, handoff note here, then back to the task"],
+  ["C", "Save for later", "C, file it to the Parking Lot"],
+  ["close", "Drop it", "Close: neither urgent nor important, so drop it"],
+];
+
+export function aeGateLabel(route: AeGateRoute): string {
+  return AE_GATE_ROUTES.find(([r]) => r === route)?.[1] ?? route;
+}
+
+/** The server's `{"error": {"message"}}`, else FastAPI's `detail`, else the status line. */
+export async function aeErrorMessage(res: Response): Promise<string> {
+  const status = `${res.status} ${res.statusText}`.trim();
+  try {
+    const body = (await res.json()) as {
+      error?: { message?: unknown };
+      detail?: unknown;
+    };
+    if (typeof body.error?.message === "string") return body.error.message;
+    if (typeof body.detail === "string") return body.detail;
+    if (body.detail !== undefined) return `${status}: ${JSON.stringify(body.detail)}`;
+  } catch {
+    // No JSON body; the status line is all there is.
+  }
+  return status;
+}
+
+/**
+ * Answer an open gate as the Dashboard does: `POST /v1/ae/gate/{id}/reply`
+ * posts the letter as the session's next user turn and marks the gate
+ * answered. Throws with the server's reason (409 when no gate is open).
+ */
+export async function replyAeGate(sessionId: string, route: AeGateRoute): Promise<void> {
+  const res = await authenticatedFetch(`/v1/ae/gate/${encodeURIComponent(sessionId)}/reply`, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ route }),
+  });
+  if (!res.ok) throw new Error(await aeErrorMessage(res));
+}
+
+// ── the parked task ──────────────────────────────────────────────────────
+
+export interface AeLotTask {
+  id: string;
+  title: string | null;
+  url: string | null;
+}
+
+/** The open Parking Lot through `GET /v1/ae/lot` (the Dashboard's read), id, title and link only. */
+export async function fetchAeLotTasks(): Promise<AeLotTask[]> {
+  const res = await authenticatedFetch("/v1/ae/lot?status=open&limit=100", { method: "GET" });
+  if (!res.ok) throw new Error(await aeErrorMessage(res));
+  const body = (await res.json()) as { tasks?: unknown };
+  const tasks = Array.isArray(body.tasks) ? body.tasks : [];
+  return tasks.flatMap((raw): AeLotTask[] => {
+    if (!raw || typeof raw !== "object") return [];
+    const task = raw as Record<string, unknown>;
+    if (typeof task.id !== "string") return [];
+    return [
+      {
+        id: task.id,
+        title: typeof task.title === "string" ? task.title : null,
+        url: typeof task.url === "string" ? task.url : null,
+      },
+    ];
+  });
+}
