+  } as AePrCard;
+}
+
+function pr(number: number, cardExtra?: Partial<AePrCard>) {
+  return {
+    url: `https://github.com/${REPO}/pull/${number}`,
+    repository: REPO,
+    number,
+    title: cardExtra ? `PR ${number}` : null,
+    card: cardExtra ? card(number, cardExtra) : undefined,
