index 0000000000000000000000000000000000000000..de3b439f6cd362ec03824da87cc7168dc81bc5b5
--- /dev/null
+++ b/web/src/components/aeRail/AeRailScheduled.tsx
@@ -0,0 +1,153 @@
+// The rail's Scheduled section: the scheduled tasks aimed at this session
+// (the check-in that names it, and any it created), each with Pause or
+// Resume, over a line that says what is still running before it is closed.
+
+import { useQuery, useQueryClient } from "@tanstack/react-query";
+import { useState } from "react";
+import { SCHEDULED_TASKS_KEY, useUpdateScheduledTask } from "@/hooks/useScheduledTasks";
+import { useChildSessions } from "@/hooks/useChildSessions";
+import { useActiveRootSessionId } from "@/hooks/useSession";
+import {
+  beforeClosingLine,
+  createdScheduleIds,
+  isAeCheckin,
+  scheduleTitle,
+  scheduleWhen,
+  schedulesForSession,
+} from "@/lib/aeRailScheduled";
+import { type AeRailSectionProps, useAeRailSectionActive } from "@/lib/aeSessionRail";
+import { listScheduledTasks, type ScheduledTask } from "@/lib/scheduledTasksApi";
+import { splitAgentSections } from "@/shell/aeAgentsPaneModel";
+import { AeRailSection } from "./AeRailSection";
+import { useAeRailLoadedBlocks } from "./aeRailSessionData";
+import { AeRailIcon, AeRailMuted } from "./aeRailUi";
+
+/** The section's own list, apart from the Tasks page's polled one (see useScheduledTasks). */
+export const AE_RAIL_SCHEDULED_KEY = ["ae-rail", "scheduled-tasks"] as const;
+const NO_IDS: ReadonlySet<string> = new Set();
+
+export function AeRailScheduled({ sessionId }: AeRailSectionProps) {
+  const active = useAeRailSectionActive("scheduled");
+  const loaded = useAeRailLoadedBlocks(sessionId);
+  const query = useQuery<ScheduledTask[]>({
+    queryKey: AE_RAIL_SCHEDULED_KEY,
+    queryFn: listScheduledTasks,
+    enabled: active,
+    staleTime: 10_000,
+    refetchOnWindowFocus: true,
+  });
+  const created = loaded ? createdScheduleIds(loaded.blocks) : NO_IDS;
+  const rows = query.data ? schedulesForSession(query.data, sessionId, created) : [];
+  const activeCount = rows.filter((task) => task.state === "active").length;
+  return (
+    <AeRailSection id="scheduled" summary={activeCount > 0 ? `${activeCount} active` : undefined}>
+      <AeScheduledBody
+        sessionId={sessionId}
+        active={active}
+        rows={rows}
+        activeCount={activeCount}
+        loading={query.isPending && query.fetchStatus !== "idle"}
+        error={query.error}
+      />
+    </AeRailSection>
+  );
+}
+
+function AeScheduledBody({
+  sessionId,
+  active,
+  rows,
+  activeCount,
+  loading,
+  error,
+}: {
+  sessionId: string;
+  active: boolean;
+  rows: ScheduledTask[];
+  activeCount: number;
+  loading: boolean;
+  error: Error | null;
+}) {
+  const root = useActiveRootSessionId(sessionId) ?? sessionId;
+  const { children } = useChildSessions(active ? root : null);
+  const running = splitAgentSections(children, null).running.length;
+  const now = new Date();
+  return (
+    <div className="text-sm">
+      {error && rows.length === 0 ? (
+        <AeRailMuted className="text-destructive">
+          Could not read the scheduled tasks: {error.message}. It retries when this section opens or
+          the tab regains focus.
+        </AeRailMuted>
+      ) : loading && rows.length === 0 ? (
+        <AeRailMuted>Reading the scheduled tasks…</AeRailMuted>
+      ) : rows.length === 0 ? (
+        <AeRailMuted>Nothing scheduled for this session.</AeRailMuted>
+      ) : (
+        rows.map((task) => <AeScheduleRow key={task.id} task={task} now={now} />)
+      )}
+      {(rows.length > 0 || running > 0) && (
+        <div className="mt-2 flex items-start gap-1.5 border-t border-border pt-2 text-xs text-muted-foreground">
+          <AeRailIcon name="info" className="mt-px size-3.5" />
+          <span>{beforeClosingLine(activeCount, running)}</span>
+        </div>
+      )}
+    </div>
+  );
+}
+
+function AeScheduleRow({ task, now }: { task: ScheduledTask; now: Date }) {
+  const update = useUpdateScheduledTask();
+  const queryClient = useQueryClient();
+  const [error, setError] = useState<string | null>(null);
+  const paused = task.state === "paused";
+  const action = paused ? "Resume" : "Pause";
+  const toggle = () => {
+    setError(null);
+    update.mutate(
+      { id: task.id, input: { state: paused ? "active" : "paused" } },
+      {
+        onSuccess: () => {
+          void queryClient.invalidateQueries({ queryKey: AE_RAIL_SCHEDULED_KEY });
+          void queryClient.invalidateQueries({ queryKey: SCHEDULED_TASKS_KEY });
+        },
+        onError: (err) =>
+          setError(
+            `Could not ${action.toLowerCase()} it: ${err.message}. ` +
+              `Try again, or change it on the Scheduled Tasks page.`,
+          ),
+      },
+    );
+  };
+  return (
+    <div data-testid="ae-schedule-row" className="py-1">
+      <div className="flex items-start gap-2">
+        <AeRailIcon
+          name={isAeCheckin(task) ? "alarm" : "clock"}
+          className="mt-0.5 text-muted-foreground"
+        />
+        <div className="min-w-0 flex-1">
+          <div className="truncate" title={task.prompt}>
+            {scheduleTitle(task)}
+          </div>
+          <div className="truncate text-xs text-muted-foreground">{scheduleWhen(task, now)}</div>
+        </div>
+        <button
+          type="button"
+          onClick={toggle}
+          disabled={update.isPending}
+          aria-label={`${action} ${scheduleTitle(task)}`}
+          className="flex min-h-7 shrink-0 items-center gap-1 self-center rounded-md border border-border bg-muted px-2 text-xs hover:bg-muted/70 disabled:cursor-wait disabled:opacity-60"
+        >
+          <AeRailIcon name={paused ? "play" : "pause"} className="size-3.5" />
+          {action}
+        </button>
+      </div>
+      {error && (
+        <p role="alert" className="mt-1 ml-6 text-xs text-destructive">
+          {error}
+        </p>
+      )}
+    </div>
+  );
+}
diff --git a/web/src/components/aeRail/AeRailSection.tsx b/web/src/components/aeRail/AeRailSection.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..79e61dee33b1fa4332daf7ae26676cfb37d4a012
--- /dev/null
+++ b/web/src/components/aeRail/AeRailSection.tsx
@@ -0,0 +1,150 @@
+// One folding section of the session rail: a header (drag grip, title that
+// folds it, summary, a menu with the moves a phone needs) over a body that
+// renders only while unfolded.
+
+import { createContext, type ReactNode, useContext, useId } from "react";
+import {
+  DropdownMenu,
+  DropdownMenuContent,
+  DropdownMenuItem,
+  DropdownMenuSeparator,
+  DropdownMenuTrigger,
+} from "@/components/ui/dropdown-menu";
+import {
+  AE_RAIL_TITLES,
+  type AeRailSectionId,
+  useAeRailSectionOpen,
+  useAeSessionRailStore,
+} from "@/lib/aeSessionRail";
+import { cn } from "@/lib/utils";
+import { AeRailIcon } from "./aeRailUi";
+
+/** What the rail's sortable list hands a section header to make its grip drag the section. */
+export interface AeRailDragHandle {
+  ref: (element: HTMLElement | null) => void;
+  /** Spread on the grip: dnd-kit's attributes and listeners. */
+  props: Record<string, unknown>;
+  dragging: boolean;
+}
+
+export const AeRailDragHandleContext = createContext<AeRailDragHandle | null>(null);
+
+export function AeRailSection({
+  id,
+  summary,
+  foldedSummary,
+  children,
+}: {
+  id: AeRailSectionId;
+  /** Beside the title, folded or not ("5 running"). */
+  summary?: ReactNode;
+  /** Beside the title only while folded (the host and branch). */
+  foldedSummary?: ReactNode;
+  /** The body; rendered only while unfolded. */
+  children: ReactNode;
+}) {
+  const open = useAeRailSectionOpen(id);
+  const setFolded = useAeSessionRailStore((s) => s.setFolded);
+  const handle = useContext(AeRailDragHandleContext);
+  const bodyId = useId();
+  const title = AE_RAIL_TITLES[id];
+  const shownSummary = open ? summary : (foldedSummary ?? summary);
+  return (
+    <section
+      aria-label={title}
+      data-ae-rail-section={id}
+      className={cn(
+        "group/rail-section rounded-[10px] border border-border bg-card",
+        handle?.dragging && "relative z-10 shadow-lg",
+      )}
+    >
+      <div className="flex min-h-9 items-center gap-1 py-1.5 pr-1.5 pl-1">
+        <button
+          type="button"
+          ref={handle?.ref}
+          {...handle?.props}
+          aria-label={`Drag to reorder ${title}`}
+          className={cn(
+            "flex h-6 w-5 shrink-0 cursor-grab touch-none items-center justify-center rounded text-muted-foreground",
+            "opacity-0 group-hover/rail-section:opacity-100 focus-visible:opacity-100 pointer-coarse:opacity-100",
+            "active:cursor-grabbing",
+            !handle && "invisible",
+          )}
+        >
+          <AeRailIcon name="grip" className="size-3.5" />
+        </button>
+        <button
+          type="button"
+          aria-expanded={open}
+          aria-controls={bodyId}
+          onClick={() => setFolded(id, open)}
+          className="flex items-center gap-1 rounded px-1 py-0.5 font-semibold hover:bg-muted"
+        >
+          {title}
+          <AeRailIcon
+            name="chevronDown"
+            className={cn(
+              "size-3.5 text-muted-foreground transition-transform",
+              !open && "-rotate-90",
+            )}
+          />
+        </button>
+        {shownSummary != null && (
+          <span className="ml-auto min-w-0 truncate text-xs text-muted-foreground">
+            {shownSummary}
+          </span>
+        )}
+        <AeRailSectionMenu id={id} className={shownSummary == null ? "ml-auto" : undefined} />
+      </div>
+      {open && (
+        <div id={bodyId} className="px-3 pb-2.5">
+          {children}
+        </div>
+      )}
+    </section>
+  );
+}
+
+function AeRailSectionMenu({ id, className }: { id: AeRailSectionId; className?: string }) {
+  const order = useAeSessionRailStore((s) => s.order);
+  const moveBy = useAeSessionRailStore((s) => s.moveBy);
+  const moveToTop = useAeSessionRailStore((s) => s.moveToTop);
+  const resetOrder = useAeSessionRailStore((s) => s.resetOrder);
+  const index = order.indexOf(id);
+  return (
+    <DropdownMenu modal={false}>
+      <DropdownMenuTrigger asChild>
+        <button
+          type="button"
+          aria-label={`${AE_RAIL_TITLES[id]} options`}
+          className={cn(
+            "flex size-6 shrink-0 items-center justify-center rounded text-muted-foreground hover:bg-muted hover:text-foreground",
+            "opacity-0 group-hover/rail-section:opacity-100 focus-visible:opacity-100 data-[state=open]:opacity-100 pointer-coarse:opacity-100",
+            className,
+          )}
+        >
+          <AeRailIcon name="dots" className="size-3.5" />
+        </button>
+      </DropdownMenuTrigger>
+      <DropdownMenuContent align="end">
+        <DropdownMenuItem disabled={index <= 0} onSelect={() => moveBy(id, -1)}>
+          <AeRailIcon name="arrowUp" className="size-3.5" />
+          Move up
+        </DropdownMenuItem>
+        <DropdownMenuItem disabled={index >= order.length - 1} onSelect={() => moveBy(id, 1)}>
+          <AeRailIcon name="arrowDown" className="size-3.5" />
+          Move down
+        </DropdownMenuItem>
+        <DropdownMenuItem disabled={index <= 0} onSelect={() => moveToTop(id)}>
+          <AeRailIcon name="arrowToTop" className="size-3.5" />
+          Move to top
+        </DropdownMenuItem>
+        <DropdownMenuSeparator />
+        <DropdownMenuItem onSelect={resetOrder}>
+          <AeRailIcon name="restore" className="size-3.5" />
+          Reset order
+        </DropdownMenuItem>
+      </DropdownMenuContent>
