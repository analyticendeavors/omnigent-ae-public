+
+  it("summarises files when there is no pull request", () => {
+    state.changes = {
+      data: { available: true, data: [{ path: "a.ts", lines_added: 1, lines_removed: 0 }] },
+    };
+    render(<AeRailChanges sessionId="s1" />);
