+    expect(rows.map((r) => [r.name, r.tone, r.word])).toEqual([
+      ["raymcp", "err", "failed"],
+      ["github", "warn", "needs sign-in"],
+      ["slow", "warn", "starting"],
+      ["ae", "ok", "connected"],
+      ["omnigent", "ok", "connected"],
