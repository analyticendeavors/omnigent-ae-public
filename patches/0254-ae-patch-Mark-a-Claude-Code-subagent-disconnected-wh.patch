+def _two_hours_later(monkeypatch: pytest.MonkeyPatch) -> None:
+    """Make the liveness module see a clock two hours past every stored item."""
+    real = time.time()
+    monkeypatch.setattr(
+        ae_subagent_liveness, "time", SimpleNamespace(time=lambda: real + 2 * 60 * 60)
