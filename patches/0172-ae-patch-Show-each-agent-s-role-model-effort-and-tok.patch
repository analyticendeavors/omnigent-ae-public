+import { describe, expect, it } from "vitest";
+import { aeAgentRole, aeFormatTokens, aeRoleName } from "./aeAgentRole";
+
+describe("aeAgentRole", () => {
+  it("reads the ae.role label", () => {
+    expect(aeAgentRole({ labels: { "ae.role": "builder" } })).toBe("builder");
+  });
+  it("does not read a role from the title", () => {
+    expect(aeAgentRole({ title: "Builder A: x" } as never)).toBeNull();
+  });
+  it("ignores an unknown label and falls back to the Role line", () => {
+    expect(
+      aeAgentRole({ labels: { "ae.role": "boss" }, task_summary: "  role: Reviewer.\nx" }),
+    ).toBe("reviewer");
+  });
+  it("reads the Role line from the description label", () => {
+    expect(aeAgentRole({ labels: { "omnigent.claude_native.description": "Role: Helper." } })).toBe(
+      "helper",
+    );
+  });
+  it("is null with neither", () => {
+    expect(aeAgentRole({ labels: {}, task_summary: "Do a Role: Builder thing" })).toBeNull();
+    expect(aeAgentRole({ task_summary: "Role: Wizard." })).toBeNull();
+  });
+  it.each([
+    "Builder A: x",
+    "Reviewer 2: x",
+    "Helper: watch PR",
+    "Role: Planner: x",
+    "Role: Builder.",
+  ])("reads the role from the description %j", (text) => {
+    expect(aeAgentRole({ task_summary: text })).not.toBeNull();
+  });
+  it.each([
+    "Review more-starters diff",
+    "Helpers list",
+    "Build the thing",
+    "Builder notes",
+    "Helper functions: refactor",
+    "Lead the migration: x",
+    "Builder pattern: compare",
+  ])("does not read a role from %j", (text) => {
+    expect(aeAgentRole({ task_summary: text })).toBeNull();
+  });
+  it("names a role", () => {
+    expect(aeRoleName("builder")).toBe("Builder");
+  });
+});
+
+describe("aeFormatTokens", () => {
+  it.each([
+    [0, "0"],
+    [999, "999"],
+    [9000, "9k"],
+    [116_400, "116.4k"],
+    [116_040, "116k"],
+    [999_999, "999.9k"],
+    [999_950, "999.9k"],
+    [1_240_000, "1.24M"],
+    [1_000_000, "1M"],
+  ])("%s", (n, text) => {
+    expect(aeFormatTokens(n)).toBe(text);
+  });
+});
diff --git a/web/src/lib/aeAgentRole.ts b/web/src/lib/aeAgentRole.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d7b7041f498db9d9e6f6a19144817012b11e1195
--- /dev/null
+++ b/web/src/lib/aeAgentRole.ts
@@ -0,0 +1,55 @@
+// The role an agent works in (omnigent-ae): a session's `ae.role` label, or for a
+// native subagent its description opening with the role ("Builder A: ...").
+
+import { AE_ROLE_IDS, AE_ROLE_LABELS, type AeRoleId } from "@/lib/aeRoles";
+
+/** The child fields a role can be read from; a native subagent's role rides in its summary or description. */
+export interface AeAgentRoleSource {
+  labels?: Record<string, string> | null;
+  task_summary?: string | null;
+}
+
+const DESCRIPTION_LABEL = "omnigent.claude_native.description";
+const NAMES = AE_ROLE_IDS.join("|");
+// "Role: Builder." alone, or a description opening "Builder A: ..." (at most one 1-2 character token, then a colon).
+const ROLE_PREFIX = new RegExp(`^\\s*role:\\s*(${NAMES})\\b`, "i");
+const ROLE_DESCRIPTION = new RegExp(
+  `^\\s*(?:role:\\s*)?(${NAMES})\\b(?:[ \\t]+[a-z0-9]{1,2})?[ \\t]*:`,
+  "i",
+);
+
+function isRoleId(value: unknown): value is AeRoleId {
+  return (AE_ROLE_IDS as readonly unknown[]).includes(value);
+}
+
+function roleFromText(text: string | null | undefined): AeRoleId | null {
+  const match = ROLE_PREFIX.exec(text ?? "") ?? ROLE_DESCRIPTION.exec(text ?? "");
+  const id = match?.[1].toLowerCase();
+  return isRoleId(id) ? id : null;
+}
+
+/** The agent's role id, or null when it has none. */
+export function aeAgentRole(child: AeAgentRoleSource): AeAgentRoleId | null {
+  const label = child.labels?.["ae.role"];
+  if (isRoleId(label)) return label;
+  return roleFromText(child.task_summary) ?? roleFromText(child.labels?.[DESCRIPTION_LABEL]);
+}
+
+export type AeAgentRoleId = AeRoleId;
+
+/** "builder" reads "Builder". */
+export function aeRoleName(role: AeRoleId): string {
+  return AE_ROLE_LABELS[role].label;
+}
+
+function trim(n: number, digits: number): string {
+  return n.toFixed(digits).replace(/\.?0+$/, "");
+}
+
+/** 950, 9k, 116.4k, 1.24M. */
+export function aeFormatTokens(n: number): string {
+  if (n < 1000) return String(Math.round(n));
+  // Floor, so 999,999 reads 999.9k rather than rounding up to a million.
+  if (n < 1_000_000) return `${trim(Math.floor(n / 100) / 10, 1)}k`;
+  return `${trim(n / 1_000_000, 2)}M`;
+}
diff --git a/web/src/lib/aeAgentUsage.ts b/web/src/lib/aeAgentUsage.ts
new file mode 100644
index 0000000000000000000000000000000000000000..743b73484f519e99493c8083664dd8103eec57d5
--- /dev/null
+++ b/web/src/lib/aeAgentUsage.ts
@@ -0,0 +1,129 @@
+// Token use per agent for the Agents card, the sidebar hover and the family
+// pill (omnigent-ae). A session's usage covers its whole subtree, so a lead's
+// number already holds its native subagents.
+
+import { useQueries } from "@tanstack/react-query";
+import { aeClaudeVersion } from "@/lib/aeClaudeModels";
+import { getSessionUsage } from "@/lib/sessionsApi";
+import type { ModelUsage } from "@/lib/types";
+
+export type AeModelFamily = "fable" | "opus" | "sonnet" | "haiku" | "codex" | "other";
+
+export const AE_MODEL_FAMILIES: readonly AeModelFamily[] = [
+  "fable",
+  "opus",
+  "sonnet",
+  "haiku",
+  "codex",
+  "other",
+];
+
+export const AE_MODEL_FAMILY_NAMES: Record<AeModelFamily, string> = {
+  fable: "Fable",
+  opus: "Opus",
+  sonnet: "Sonnet",
+  haiku: "Haiku",
+  codex: "Codex",
+  other: "Other",
+};
+
+/** Bar and dot colors: the Claude ones match the model dots in Settings. */
+export const AE_MODEL_FAMILY_BG: Record<AeModelFamily, string> = {
+  fable: "bg-violet-400",
+  opus: "bg-amber-400",
+  sonnet: "bg-blue-400",
+  haiku: "bg-emerald-400",
+  codex: "bg-sky-400",
+  other: "bg-muted-foreground",
+};
+
+export function aeModelFamily(model: string): AeModelFamily {
+  const alias = model.trim().toLowerCase();
+  if (alias === "fable" || alias === "opus" || alias === "sonnet" || alias === "haiku")
+    return alias;
+  const family = aeClaudeVersion(model)?.family;
+  if (family === "fable" || family === "opus" || family === "sonnet" || family === "haiku") {
+    return family;
+  }
+  return /gpt|codex|^o\d/i.test(model) ? "codex" : "other";
+}
+
+/** Input plus output tokens of one model's usage. */
+export function aeModelTokens(usage: ModelUsage): number {
+  return (usage.inputTokens ?? 0) + (usage.outputTokens ?? 0);
+}
+
+/** Tokens per model family, summed over a usage map. */
+export function aeTokensByFamily(
+  usage: Record<string, ModelUsage> | null | undefined,
+): Partial<Record<AeModelFamily, number>> {
+  const out: Partial<Record<AeModelFamily, number>> = {};
+  for (const [model, row] of Object.entries(usage ?? {})) {
+    const family = aeModelFamily(model);
+    out[family] = (out[family] ?? 0) + aeModelTokens(row);
+  }
+  return out;
+}
+
+/** Input plus output tokens over a usage map, or null when none is known. */
+export function aeUsageTokens(usage: Record<string, ModelUsage> | null | undefined): number | null {
+  if (!usage || Object.keys(usage).length === 0) return null;
+  return Object.values(usage).reduce((sum, row) => sum + aeModelTokens(row), 0);
+}
+
+export interface AeSessionUsage {
+  tokens: number | null;
+  byFamily: Partial<Record<AeModelFamily, number>>;
+  effort: string | null;
+  /** The model the session runs on, or null when the read does not say. */
+  model: string | null;
+}
+
+const USAGE_STALE_MS = 30_000;
+
+export interface AeUsageRequest {
+  id: string;
+  /** Part of the query key: a new stamp (a status change) reads again. */
+  stamp: string | number;
+  /** The session has stopped: read once and keep it, never poll. */
+  done?: boolean;
+}
+
+/**
+ * Usage of each session listed. A finished one is read once; the others read
+ * again after `staleMs` and, while *live*, every `pollMs` (never faster).
+ */
+export function useAeSessionUsages(
+  sessions: readonly AeUsageRequest[],
+  {
+    enabled = true,
+    live = false,
+    staleMs = USAGE_STALE_MS,
+    pollMs = USAGE_STALE_MS,
+  }: { enabled?: boolean; live?: boolean; staleMs?: number; pollMs?: number } = {},
+): Map<string, AeSessionUsage> {
+  const results = useQueries({
+    queries: sessions.map((s) => ({
+      queryKey: ["ae-session-usage", s.id, s.stamp],
+      queryFn: ({ signal }: { signal: AbortSignal }) => getSessionUsage(s.id, { signal }),
+      enabled,
+      staleTime: s.done ? Number.POSITIVE_INFINITY : staleMs,
+      refetchInterval: live && !s.done ? pollMs : false,
+      retry: false,
+      placeholderData: (previous: unknown) => previous as never,
+    })),
+  });
+  const out = new Map<string, AeSessionUsage>();
+  results.forEach((result, index) => {
+    const data = result.data;
+    if (!data) return;
+    out.set(sessions[index].id, {
+      tokens: aeUsageTokens(data.usageByModel),
+      byFamily: aeTokensByFamily(data.usageByModel),
+      model: data.model,
+      effort:
+        data.reasoningEffort && data.reasoningEffort !== "default" ? data.reasoningEffort : null,
+    });
+  });
+  return out;
+}
