+import { act, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { ClaudeBrowserLogin } from "./ClaudeBrowserLogin";
+
+const mutateAsync = vi.fn();
+vi.mock("@/hooks/useHosts", () => ({
+  useStoreCredential: () => ({ mutateAsync, isPending: false }),
+}));
+beforeEach(() => mutateAsync.mockReset());
+afterEach(() => vi.useRealTimers());
+const waiting = {
+  login_id: "id",
+  login_status: "waiting",
+  login_url: "https://claude.com/oauth/authorize?state=example",
+};
+describe("Claude browser login", () => {
+  it("starts login on the chosen host and submits only the one-time code", async () => {
+    mutateAsync.mockResolvedValue(waiting);
+    render(<ClaudeBrowserLogin hostId="host" name="Backup" onComplete={() => {}} />);
+    fireEvent.click(screen.getByText("Sign in with Claude"));
+    await screen.findByText("Open Claude sign-in");
+    expect(mutateAsync.mock.calls[0][0]).toEqual({
+      harness: "claude-native",
+      kind: "claude-login-start",
+      account_name: "Backup",
+    });
+    expect(screen.getByRole("link").getAttribute("href")).toBe(waiting.login_url);
+    fireEvent.change(screen.getByLabelText("Claude authorization code"), {
+      target: { value: "code#state" },
+    });
+    fireEvent.click(screen.getByText("Complete sign-in"));
+    await waitFor(() =>
+      expect(mutateAsync).toHaveBeenCalledWith({
+        harness: "claude-native",
+        kind: "claude-login-code",
+        account_name: "id",
+        secret: "code#state",
+      }),
+    );
+  });
+  it("never links an untrusted authorization URL", async () => {
+    mutateAsync.mockResolvedValue({
+      ...waiting,
+      login_url: "https://claude.com.evil.test/oauth/authorize",
+    });
+    render(<ClaudeBrowserLogin hostId="host" name="Backup" onComplete={() => {}} />);
+    fireEvent.click(screen.getByText("Sign in with Claude"));
+    await screen.findByText("Cancel sign-in");
+    expect(screen.queryByRole("link")).toBeNull();
+  });
+  it("polls until the host confirms the account was saved", async () => {
+    vi.useFakeTimers();
+    mutateAsync
+      .mockResolvedValueOnce(waiting)
+      .mockResolvedValueOnce({ login_id: "id", login_status: "complete" });
+    const done = vi.fn();
+    render(<ClaudeBrowserLogin hostId="host" name="Backup" onComplete={done} />);
+    await act(async () => {
+      fireEvent.click(screen.getByText("Sign in with Claude"));
+    });
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(1500);
+    });
+    expect(done).toHaveBeenCalledOnce();
+  });
+});
diff --git a/web/src/shell/ClaudeBrowserLogin.tsx b/web/src/shell/ClaudeBrowserLogin.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..12461a6040ed2262bc39f33c70585fffe38c8b9a
--- /dev/null
+++ b/web/src/shell/ClaudeBrowserLogin.tsx
@@ -0,0 +1,152 @@
+import { useEffect, useRef, useState } from "react";
+import { Button } from "@/components/ui/button";
+import { Input } from "@/components/ui/input";
+import { useStoreCredential, type StoreCredentialResult } from "@/hooks/useHosts";
+
+function safeLoginUrl(value: string | null | undefined): string | null {
+  if (!value) return null;
+  try {
+    const url = new URL(value);
+    return url.protocol === "https:" &&
+      ["claude.com", "claude.ai"].includes(url.hostname) &&
+      ["/oauth/authorize", "/cai/oauth/authorize"].includes(url.pathname)
+      ? url.href
+      : null;
+  } catch {
+    return null;
+  }
+}
+
+/** Only the provider's authorization link and one-time code reach this form. */
+export function ClaudeBrowserLogin({
+  hostId,
+  name,
+  onComplete,
+}: {
+  hostId: string;
+  name: string;
+  onComplete: () => void;
+}) {
+  const store = useStoreCredential(hostId);
+  const [login, setLogin] = useState<StoreCredentialResult | null>(null);
+  const [error, setError] = useState("");
+  const [code, setCode] = useState("");
+  const completed = useRef(false);
+  const done = useRef(onComplete);
+  done.current = onComplete;
+  const active = login?.login_status === "starting" || login?.login_status === "waiting";
+  const action = async (
+    kind: "claude-login-start" | "claude-login-code" | "claude-login-cancel",
+  ) => {
+    if (store.isPending) return;
+    setError("");
+    try {
+      const result = await store.mutateAsync({
+        harness: "claude-native",
+        kind,
+        account_name: kind === "claude-login-start" ? name.trim() : (login?.login_id ?? ""),
+        ...(kind === "claude-login-code" ? { secret: code.trim() } : {}),
+      });
+      setCode("");
+      setLogin(result);
+    } catch (cause) {
+      setError(cause instanceof Error ? cause.message : "Could not start sign-in.");
+    }
+  };
+  const request = store.mutateAsync;
+  useEffect(() => {
+    if (!active || !login?.login_id) return;
+    let cancelled = false;
+    const timer = setTimeout(() => {
+      void request({
+        harness: "claude-native",
+        kind: "claude-login-poll",
+        account_name: login.login_id ?? "",
+      })
+        .then((result) => {
+          if (!cancelled) setLogin(result);
+        })
+        .catch((cause) => {
+          if (!cancelled) {
+            setError(
+              cause instanceof Error ? cause.message : "Connection lost. Start sign-in again.",
+            );
+            setLogin(null);
+          }
+        });
+    }, 1500);
+    return () => {
+      cancelled = true;
+      clearTimeout(timer);
+    };
+  }, [active, login, request]);
+  useEffect(() => {
+    if (login?.login_status === "complete" && !completed.current) {
+      completed.current = true;
+      done.current();
+    }
+  }, [login]);
+  const url = safeLoginUrl(login?.login_url);
+  return (
+    <div className="flex min-w-0 flex-col gap-2">
+      {!active && (
+        <Button
+          type="button"
+          disabled={!name.trim() || store.isPending}
+          onClick={() => void action("claude-login-start")}
+        >
+          Sign in with Claude
+        </Button>
+      )}
+      {active && (
+        <>
+          <p role="status" className="text-xs text-muted-foreground">
+            {url
+              ? "Open Claude and authorize your second subscription account. Your password stays on Claude's site."
+              : "Preparing secure sign-in on the host…"}
+          </p>
+          {url && (
+            <a className="text-sm underline" href={url} target="_blank" rel="noopener noreferrer">
+              Open Claude sign-in
+            </a>
+          )}
+          {url && (
+            <>
+              <p className="text-xs text-muted-foreground">
+                If Claude shows a one-time code, paste it here. If it opens your primary account,
+                switch to the second account before authorizing.
+              </p>
+              <Input
+                aria-label="Claude authorization code"
+                placeholder="One-time authorization code"
+                autoComplete="off"
+                value={code}
+                onChange={(e) => setCode(e.target.value)}
+              />
+              <Button
+                type="button"
+                disabled={!code.trim() || store.isPending}
+                onClick={() => void action("claude-login-code")}
+              >
+                Complete sign-in
+              </Button>
+            </>
+          )}
+          <Button
+            type="button"
+            variant="ghost"
+            disabled={store.isPending}
+            onClick={() => void action("claude-login-cancel")}
+          >
+            Cancel sign-in
+          </Button>
+        </>
+      )}
+      {(error || login?.login_error) && (
+        <p role="alert" className="text-xs text-destructive">
+          {error || login?.login_error}
+        </p>
+      )}
+    </div>
+  );
+}
