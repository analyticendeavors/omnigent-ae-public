From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Tue, 27 Oct 2026 08:23:09 -0700
Subject: [PATCH 207/260] [ae-patch] Repair a copied note whose encoded URL
 copy ends in a newline

A note copied from a code block ends in a newline. The URL form keeps it as a trailing %0A while the plain text was trimmed, so the 0206 comparison never matched and the encoded text pasted on Reid's iPhone. Trim both sides before comparing.
---
 web/src/lib/aePasteRepair.test.ts | 23 +++++++++++++++++++++++
 web/src/lib/aePasteRepair.ts      |  4 +++-
 2 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/web/src/lib/aePasteRepair.test.ts b/web/src/lib/aePasteRepair.test.ts
index f418211d75d01b0f34690810e3897b763afcaecf..4f40158161a924424deade6ef920910852592eb5 100644
--- a/web/src/lib/aePasteRepair.test.ts
+++ b/web/src/lib/aePasteRepair.test.ts
@@ -24,6 +24,29 @@ describe("repairEncodedNote", () => {
     expect(repairEncodedNote(plain, uri)).toBe(plain);
   });
 
+  it("repairs the note copied from a code block, trailing newline and all", () => {
+    // Exact clipboard of Reid's iPhone, 2026-10-27: the URL form ends in %0A.
+    const plain =
+      'THREAD: paste-test\nSTATE: Has spaces, "quotes", [brackets](url), <angle> and a dash - it\'s fine.\nQUADRANT: admin \u00b7 EST: minutes\n';
+    const uri =
+      "thread:%20paste-test%0ASTATE:%20Has%20spaces,%20%22quotes%22,%20%5Bbrackets%5D(url),%20%3Cangle%3E%20and%20a%20dash%20-%20it's%20fine.%0AQUADRANT:%20admin%20%C2%B7%20EST:%20minutes%0A";
+    expect(repairEncodedNote(plain, uri)).toBe(plain);
+  });
+
+  it("repairs whether or not either side carries the trailing newline", () => {
+    const body = "THREAD: a\nSTATE: b c";
+    const encoded = "thread:%20a%0ASTATE:%20b%20c";
+    expect(repairEncodedNote(body, `${encoded}%0A`)).toBe(body);
+    expect(repairEncodedNote(`${body}\n`, encoded)).toBe(`${body}\n`);
+    expect(repairEncodedNote(`${body}\r\n`, `${encoded}%0D%0A`)).toBe(`${body}\r\n`);
+  });
+
+  it("leaves a paste alone when only whitespace matches and the words differ", () => {
+    expect(
+      repairEncodedNote("THREAD: a\nSTATE: z z\n", "thread:%20a%0ASTATE:%20b%20c%0A"),
+    ).toBeNull();
+  });
+
   it("leaves a paste alone when the plain text is not the URI list's own decoded form", () => {
     expect(repairEncodedNote("something else", "foo:%20a%20b%20c")).toBeNull();
     expect(repairEncodedNote("", "foo:%20a%20b%20c")).toBeNull();
diff --git a/web/src/lib/aePasteRepair.ts b/web/src/lib/aePasteRepair.ts
index 347c0065da3026f335a128c8260dbb9972bc06d5..dcd5a0769257d9c656898c5b2cc6ad556dc15b47 100644
--- a/web/src/lib/aePasteRepair.ts
+++ b/web/src/lib/aePasteRepair.ts
@@ -24,7 +24,9 @@ function isEncodedNote(text: string): boolean {
 /** True when `plain` is `uri` decoded, ignoring case (the URL form lowercases the scheme). */
 function decodesTo(uri: string, plain: string): boolean {
   try {
-    return decodeURIComponent(uri).toLowerCase() === plain.toLowerCase();
+    // A copied block ends in a newline: the URL form keeps it as a trailing %0A
+    // while the caller trimmed `plain`, so both sides are trimmed here.
+    return decodeURIComponent(uri).trim().toLowerCase() === plain.trim().toLowerCase();
   } catch {
     return false;
   }
