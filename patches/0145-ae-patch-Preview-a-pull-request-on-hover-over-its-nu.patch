Subject: [PATCH 145/260] [ae-patch] Preview a pull request on hover over its
 number in the action dock

The dock's pull request number now opens the same hover preview as a pull
request link in the chat (state, title, author, size, checks) before the click
that opens GitHub. The link's title tooltip goes, since it would show over the
preview; its text moves to aria-label.
---
 web/src/components/AeActionDock.test.tsx | 11 +++++++++++
 web/src/components/AeActionDock.tsx      | 23 ++++++++++++++---------
 2 files changed, 25 insertions(+), 9 deletions(-)

diff --git a/web/src/components/AeActionDock.test.tsx b/web/src/components/AeActionDock.test.tsx
index b5419f398e99b246c0cf6e719286b5b86cee78ab..5aa608c2759e5478f63f5d5f428c26d943898be2 100644
--- a/web/src/components/AeActionDock.test.tsx
+++ b/web/src/components/AeActionDock.test.tsx
@@ -182,6 +182,17 @@ describe("AeActionDock", () => {
     );
   });
 
+  it("previews the pull request when its number is hovered or focused", async () => {
+    serve({ 180: card(180) });
+    renderDock([`Opened ${url(180)}`]);
+    const link = await screen.findByTestId("ae-dock-pr-link");
+    expect(link).toHaveAttribute("href", url(180));
+    expect(link).not.toHaveAttribute("title");
+    fireEvent.focus(link);
+    const preview = await screen.findByTestId("ae-pr-hover");
+    expect(within(preview).getByText("PR 180")).toBeTruthy();
+  });
+
   it("renders inside the workspace bar, the caret after the bar's right cluster", async () => {
     serve({ 180: card(180) });
     renderDock([`Opened ${url(180)}`], [question]);
