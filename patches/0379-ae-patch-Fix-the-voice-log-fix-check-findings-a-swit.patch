From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Mon, 16 Nov 2026 14:20:44 -0800
Subject: [PATCH 379/443] [ae-patch] Fix the voice log fix-check findings: a
 switch to a Voice-off chat still stops the mic (0378)

---
 web/src/hooks/useAeVoiceMode.test.tsx |  9 +++++++++
 web/src/hooks/useAeVoiceMode.ts       | 14 +++++++++-----
 2 files changed, 18 insertions(+), 5 deletions(-)

diff --git a/web/src/hooks/useAeVoiceMode.test.tsx b/web/src/hooks/useAeVoiceMode.test.tsx
index d88a4323bf1daa52aada98161c57eec53e50aec8..ea2774ce06721e0121cbb135f5abb046eba0f3c4 100644
--- a/web/src/hooks/useAeVoiceMode.test.tsx
+++ b/web/src/hooks/useAeVoiceMode.test.tsx
@@ -1122,6 +1122,15 @@ describe("voice log upload", () => {
     expect(reasons()).toEqual([]);
   });
 
+  it("a switch to a Voice-off chat still stops the mic, with no upload", () => {
+    setVoiceOn("c2", false);
+    const { rerender } = mount();
+    controller.current.stop.mockClear();
+    rerender({ chatId: "c2", value: "", status: "idle", canSend: true, submit });
+    expect(controller.current.stop).toHaveBeenCalled();
+    expect(reasons()).toEqual([]);
+  });
+
   it("attributes the Voice end upload to the chat it came on in", () => {
     const { rerender } = mount();
     // Same on state but the visible chat id moves to c2 while c1's voice ends.
diff --git a/web/src/hooks/useAeVoiceMode.ts b/web/src/hooks/useAeVoiceMode.ts
index 5f521606e2b7a696b67a60b89e8b61084eed08ab..6777b46b58ffd8c0a4a72c0801c8a8816b981364 100644
--- a/web/src/hooks/useAeVoiceMode.ts
+++ b/web/src/hooks/useAeVoiceMode.ts
@@ -289,22 +289,26 @@ export function useAeVoiceMode({
   const wasOn = useRef(on);
   // The chat Voice mode was on in, taken when it came on: its log belongs to that chat.
   const onChatId = useRef(chatId);
-  // Switching chats is not Voice ending: forget the old on state before the effect below
-  // reads it, so the switch never uploads voice_end (and the new chat starts its own edge).
+  // Switching chats is not Voice ending: the effect below still stops the mic and logs the
+  // end when the new chat has Voice off, but it skips the voice_end upload and lets the new
+  // chat start its own edge.
   const lastChatId = useRef(chatId);
+  const chatSwitched = useRef(false);
   useEffect(() => {
     if (lastChatId.current === chatId) return;
     lastChatId.current = chatId;
-    wasOn.current = false;
+    chatSwitched.current = true;
   }, [chatId]);
   useEffect(() => {
     const mic = controller.current;
+    const switched = chatSwitched.current;
+    chatSwitched.current = false;
     if (!on) {
       clearGrace();
       // Turning the switch off hands the mic back, quiet.
       if (wasOn.current) {
         logVoice("voice end");
-        void uploadVoiceLog("voice_end", onChatId.current);
+        if (!switched) void uploadVoiceLog("voice_end", onChatId.current);
       }
       if (wasOn.current && mic) {
         stopAsked.current = mic.isListening() || startPending.current;
@@ -319,7 +323,7 @@ export function useAeVoiceMode({
       setMicDetail(null);
       return;
     }
-    if (!wasOn.current) onChatId.current = chatId;
+    if (!wasOn.current || switched) onChatId.current = chatId;
     wasOn.current = true;
     if (!mic) return;
     if (wantListen) {
