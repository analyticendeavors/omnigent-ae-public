diff --git a/omnigent/runtime/pending_inputs.py b/omnigent/runtime/pending_inputs.py
index 92d1f12c6bb5a74804ce8eb04ada9848fd68912d..c3cbaa3976e538a1d1a4f1084711ba558dd2f281 100644
--- a/omnigent/runtime/pending_inputs.py
