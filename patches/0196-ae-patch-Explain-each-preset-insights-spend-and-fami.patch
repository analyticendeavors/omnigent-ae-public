+import { act, cleanup, render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { afterEach, describe, expect, it } from "vitest";
+import { AE_SETTING_HINTS } from "@/lib/aeSettingHints";
+import { AeHint } from "./AeHint";
+
+afterEach(cleanup);
+
+const TEXT = AE_SETTING_HINTS["insights.run_now"].hint;
+
+function setup() {
+  render(
+    <div>
+      <p data-testid="outside">outside</p>
+      <AeHint id="insights.run_now" />
+    </div>,
+  );
+  return {
+    user: userEvent.setup({
+      pointerMap: [
+        { name: "mouse", pointerType: "mouse" },
+        { name: "touch", pointerType: "touch" },
+      ],
+    }),
+    button: screen.getByRole("button", { name: "About Run now" }),
+  };
+}
+
+type User = ReturnType<typeof setup>["user"];
+/** One finger tap: pointer down, up, then click, as a phone sends them. */
+const tap = (user: User, target: Element) => user.pointer({ keys: "[touch]", target });
+
+describe("AeHint", () => {
+  it("shows its text when the icon takes keyboard focus", async () => {
+    render(<AeHint id="rules.helpers" />);
+    const button = screen.getByRole("button", { name: "About Helpers" });
+    act(() => button.focus());
+    expect(await screen.findByRole("tooltip")).toHaveTextContent(
+      AE_SETTING_HINTS["rules.helpers"].hint,
+    );
+  });
+
+  it("keeps the text open when a mouse clicks the icon it hovered open", async () => {
+    const { user, button } = setup();
+    await user.click(button);
+    expect(await screen.findByRole("tooltip")).toHaveTextContent(TEXT);
+  });
+
+  it("opens on a tap (pointer down, up, click) and names the text as its description", async () => {
+    const { user, button } = setup();
+    await tap(user, button);
+    expect(await screen.findByRole("tooltip")).toHaveTextContent(TEXT);
+    expect(button).toHaveAttribute("data-state", expect.stringMatching(/open/));
+    expect(button).toHaveAttribute("aria-describedby");
+  });
+
+  it("closes on a second tap and stays closed", async () => {
+    const { user, button } = setup();
+    await tap(user, button);
+    await screen.findByRole("tooltip");
+    await tap(user, button);
+    expect(button).toHaveAttribute("data-state", "closed");
+    expect(button).not.toHaveAttribute("aria-describedby");
+    expect(screen.queryByRole("tooltip")).toBeNull();
+  });
+
+  it("closes on a tap outside", async () => {
+    const { user, button } = setup();
+    await tap(user, button);
+    await screen.findByRole("tooltip");
+    await tap(user, screen.getByTestId("outside"));
+    expect(button).toHaveAttribute("data-state", "closed");
+  });
+
+  it("closes on Escape", async () => {
+    const { user, button } = setup();
+    await tap(user, button);
+    await screen.findByRole("tooltip");
+    await user.keyboard("{Escape}");
+    expect(button).toHaveAttribute("data-state", "closed");
+  });
+
+  it("opens again on a third tap", async () => {
+    const { user, button } = setup();
+    await tap(user, button);
+    await tap(user, button);
+    await tap(user, button);
+    expect(await screen.findByRole("tooltip")).toHaveTextContent(TEXT);
+  });
+});
diff --git a/web/src/components/AeHint.tsx b/web/src/components/AeHint.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..26fc434c5b6f084e2a0a7fd96e0983ab22550707
--- /dev/null
+++ b/web/src/components/AeHint.tsx
@@ -0,0 +1,57 @@
+// A small info icon that opens a tooltip (omnigent-ae, 2026-10-26). Focus opens
+// it for keyboard users, a tap opens it for touch (Radix closes it on the next
+// pointer down, so a second tap closes it, as do a tap outside and Escape),
+// hover opens it for a mouse. The hit area is 24px; the icon stays 16px. It sits on a line the control already has, so a section stays as tall
+// as before. Text comes from lib/aeSettingHints.ts.
+
+import { InfoIcon } from "lucide-react";
+import { useRef, useState } from "react";
+import { Tooltip, TooltipContent, TooltipProvider, TooltipTrigger } from "@/components/ui/tooltip";
+import { AE_SETTING_HINTS, type AeSettingHintId } from "@/lib/aeSettingHints";
+import { cn } from "@/lib/utils";
+
+export function AeHint({ id, className }: { id: AeSettingHintId; className?: string }) {
+  const [open, setOpen] = useState(false);
+  // Radix closes an open tooltip on pointer down; the click that follows must not reopen it.
+  const openAtPointerDown = useRef(false);
+  const { label, hint } = AE_SETTING_HINTS[id];
+  return (
+    <TooltipProvider delayDuration={0}>
+      <Tooltip open={open} onOpenChange={setOpen}>
+        {/* The handlers sit on the trigger so Radix's own close-on-click is skipped by preventDefault. */}
+        <TooltipTrigger
+          asChild
+          onPointerDownCapture={(event) => {
+            // A mouse that hovered it open keeps it open on click; only touch and pen toggle.
+            openAtPointerDown.current = open && event.pointerType !== "mouse";
+          }}
+          onClick={(event) => {
+            event.preventDefault();
+            event.stopPropagation();
+            if (!openAtPointerDown.current) setOpen(true);
+            openAtPointerDown.current = false;
+          }}
+        >
+          <button
+            type="button"
+            aria-label={`About ${label}`}
+            data-testid={`ae-hint-${id}`}
+            className={cn(
+              "relative -my-1 ml-1 inline-flex size-4 shrink-0 items-center justify-center rounded-sm align-middle text-muted-foreground hover:text-foreground focus-visible:outline-2 focus-visible:outline-ring after:absolute after:-inset-1 after:content-['']",
+              className,
+            )}
+          >
+            <InfoIcon className="size-3.5" aria-hidden="true" />
+          </button>
+        </TooltipTrigger>
+        <TooltipContent
+          side="top"
+          align="start"
+          className="max-w-[min(18rem,calc(100vw-2rem))] whitespace-normal font-normal normal-case leading-normal tracking-normal"
+        >
+          {hint}
+        </TooltipContent>
+      </Tooltip>
+    </TooltipProvider>
+  );
+}
