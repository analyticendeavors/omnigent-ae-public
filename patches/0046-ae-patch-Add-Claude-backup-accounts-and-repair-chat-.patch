+import { fireEvent, render, screen } from "@testing-library/react";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { ClaudeAccounts } from "./ClaudeAccounts";
+import type { Host } from "@/hooks/useHosts";
+
+const mutate = vi.fn();
+vi.mock("@/hooks/useHosts", () => ({
+  useDetectedCredentials: () => ({
+    data: [
+      { family: "claude-oauth-active", source: "Default CLI account", env_var: "" },
+      { family: "claude-oauth", source: "Backup", env_var: "Backup" },
+    ],
+  }),
+  useStoreCredential: () => ({ mutate, isPending: false }),
+}));
+const host = { host_id: "host", name: "Laptop" } as Host;
+beforeEach(() => mutate.mockReset());
+describe("ClaudeAccounts", () => {
+  it("selects the backup account without a token", () => {
+    render(<ClaudeAccounts host={host} />);
+    fireEvent.click(screen.getByText("Backup"));
+    expect(mutate.mock.calls[0][0]).toEqual({
+      harness: "claude-native",
+      kind: "claude-oauth-select",
+      account_name: "Backup",
+    });
+    expect(screen.getByText(/Start a new chat/)).toBeTruthy();
+  });
+  it("adds a named OAuth token through the credential endpoint", () => {
+    render(<ClaudeAccounts host={host} />);
+    fireEvent.click(screen.getByText("Add Claude account"));
+    fireEvent.change(screen.getByLabelText("Claude account name"), {
+      target: { value: "Personal" },
+    });
+    fireEvent.change(screen.getByLabelText("Claude OAuth token"), {
+      target: { value: "sk-ant-oat-example" },
+    });
+    fireEvent.click(screen.getByText("Save account"));
+    expect(mutate.mock.calls[0][0]).toEqual({
+      harness: "claude-native",
+      kind: "claude-oauth-add",
+      account_name: "Personal",
+      secret: "sk-ant-oat-example",
+    });
+  });
+});
diff --git a/web/src/shell/ClaudeAccounts.tsx b/web/src/shell/ClaudeAccounts.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..872169bbfdba50279289e06218cd1b8f1d9fc234
--- /dev/null
+++ b/web/src/shell/ClaudeAccounts.tsx
@@ -0,0 +1,123 @@
+import { useState } from "react";
+import { Button } from "@/components/ui/button";
+import { Input } from "@/components/ui/input";
+import { useDetectedCredentials, useStoreCredential, type Host } from "@/hooks/useHosts";
+
+/** Host-owned subscription choices; no token is returned by the discovery API. */
+export function ClaudeAccounts({ host }: { host: Host | null | undefined }) {
+  const [name, setName] = useState("");
+  const [token, setToken] = useState("");
+  const [adding, setAdding] = useState(false);
+  const [message, setMessage] = useState("");
+  const accounts = useDetectedCredentials(host?.host_id, !!host);
+  const store = useStoreCredential(host?.host_id ?? "");
+  const addAccount = () => {
+    if (store.isPending || !name.trim() || !token.trim()) return;
+    store.mutate(
+      {
+        harness: "claude-native",
+        kind: "claude-oauth-add",
+        account_name: name.trim(),
+        secret: token.trim(),
+      },
+      {
+        onSuccess: () => {
+          setToken("");
+          setName("");
+          setAdding(false);
+          setMessage("Account saved and selected for new chats.");
+        },
+        onError: (error) => setMessage(error.message),
+      },
+    );
+  };
+  if (!host) return null;
+  const rows = (accounts.data ?? []).filter((row) => row.family.startsWith("claude-oauth"));
+  return (
+    <div className="flex flex-col gap-2 border-t px-3 py-3" data-testid="claude-accounts">
+      <span className="text-sm font-medium">Claude subscription account</span>
+      <p className="text-xs text-muted-foreground">
+        Used for new Claude subscription chats on {host.name}, including team members. Start a new
+        chat to switch a running conversation. Gateway connections keep their own credentials.
+      </p>
+      {(accounts.isError || (accounts.isSuccess && rows.length === 0)) && (
+        <p role="alert">Could not load Claude accounts. Check the host account configuration.</p>
+      )}
+      {rows.map((row) => (
+        <Button
+          type="button"
+          key={row.env_var ?? ""}
+          variant="ghost"
+          size="sm"
+          disabled={store.isPending || row.family === "claude-oauth-active"}
+          onClick={() =>
+            store.mutate(
+              {
+                harness: "claude-native",
+                kind: "claude-oauth-select",
+                account_name: row.env_var ?? "",
+              },
+              {
+                onSuccess: () => setMessage("Account selected for new chats."),
+                onError: (error) => setMessage(error.message),
+              },
+            )
+          }
+        >
+          {row.source}
+          {row.family === "claude-oauth-active" ? " (selected)" : ""}
+        </Button>
+      ))}
+      <Button type="button" variant="outline" size="sm" onClick={() => setAdding(!adding)}>
+        Add Claude account
+      </Button>
+      {adding && (
+        <div
+          className="flex flex-col gap-2"
+          onKeyDown={(event) => {
+            if (event.key === "Enter") {
+              event.preventDefault();
+              event.stopPropagation();
+              addAccount();
+            }
+          }}
+        >
+          <p className="text-xs text-muted-foreground">
+            Run <code>CLAUDE_CONFIG_DIR=~/.claude-backup claude setup-token</code> on your computer
+            and sign in with the second account in the browser. Paste the generated OAuth token
+            here. Your original CLI login is preserved. When this token expires, add a fresh token
+            under a new name.
+          </p>
+          <Input
+            aria-label="Claude account name"
+            placeholder="Account name"
+            value={name}
+            maxLength={64}
+            onChange={(event) => setName(event.target.value)}
+          />
+          <Input
+            aria-label="Claude OAuth token"
+            placeholder="OAuth token"
+            type="password"
+            autoComplete="off"
+            value={token}
+            onChange={(event) => setToken(event.target.value)}
+          />
+          <Button
+            type="button"
+            onClick={addAccount}
+            size="sm"
+            disabled={store.isPending || !name.trim() || !token.trim()}
+          >
+            Save account
+          </Button>
+        </div>
+      )}
+      {message && (
+        <p role="status" className="text-xs">
+          {message}
+        </p>
+      )}
+    </div>
+  );
+}
