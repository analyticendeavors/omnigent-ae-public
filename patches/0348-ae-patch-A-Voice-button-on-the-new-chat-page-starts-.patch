@@ -0,0 +1,98 @@
+import { act, renderHook } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { disarmVoiceForNextChat, GRACE_MS, takeVoiceArm } from "@/lib/aeVoiceMode";
+import { installFakeSpeech, removeFakeSpeech } from "@/test/fakeSpeech";
+import { useAeVoiceStart } from "./useAeVoiceStart";
+
+function setup(over: { value?: string; canSubmit?: boolean } = {}) {
+  const mic = { start: vi.fn(), stop: vi.fn(), isListening: () => false };
+  const submit = vi.fn();
+  const controller = { current: mic };
+  const hook = renderHook(
+    (props: { value: string; canSubmit: boolean }) =>
+      useAeVoiceStart({ controller, submit, ...props }),
+    { initialProps: { value: over.value ?? "hello", canSubmit: over.canSubmit ?? true } },
+  );
+  return { mic, submit, ...hook };
+}
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  installFakeSpeech();
+});
+afterEach(() => {
+  vi.useRealTimers();
+  removeFakeSpeech();
+  disarmVoiceForNextChat();
+});
+
+describe("useAeVoiceStart", () => {
+  it("toggle arms the next chat and starts the mic; a second toggle disarms and stops it", () => {
+    const { result, mic } = setup();
+    act(() => result.current.toggle());
+    expect(result.current.armed).toBe(true);
+    expect(result.current.phase).toBe("starting");
+    expect(mic.start).toHaveBeenCalledTimes(1);
+    act(() => result.current.onListening(true));
+    expect(result.current.phase).toBe("listening");
+    act(() => result.current.toggle());
+    expect(result.current.armed).toBe(false);
+    expect(mic.stop).toHaveBeenCalledTimes(1);
+    expect(takeVoiceArm()).toBe(false);
+  });
+
+  it("reports unavailable when the mic never listened", () => {
+    const { result } = setup();
+    act(() => result.current.toggle());
+    act(() => result.current.onListening(false));
+    expect(result.current.phase).toBe("unavailable");
+  });
+
+  it("submits GRACE_MS after the last final, then disarms and stops the mic", () => {
+    const { result, submit, mic } = setup();
+    act(() => result.current.toggle());
+    act(() => result.current.onFinal("hello"));
+    act(() => void vi.advanceTimersByTime(GRACE_MS - 1));
+    expect(submit).not.toHaveBeenCalled();
+    act(() => result.current.onFinal("again"));
+    act(() => void vi.advanceTimersByTime(GRACE_MS - 1));
+    expect(submit).not.toHaveBeenCalled();
+    act(() => void vi.advanceTimersByTime(1));
+    expect(submit).toHaveBeenCalledTimes(1);
+    expect(result.current.armed).toBe(false);
+    expect(mic.stop).toHaveBeenCalled();
+    // The session is created asynchronously, so the flag stays for takeVoiceArm.
+    expect(takeVoiceArm()).toBe(true);
+  });
+
+  it("does not submit when the page cannot submit or the draft is empty", () => {
+    const blocked = setup({ canSubmit: false });
+    act(() => blocked.result.current.toggle());
+    act(() => blocked.result.current.onFinal("hello"));
+    act(() => void vi.advanceTimersByTime(GRACE_MS + 10));
+    expect(blocked.submit).not.toHaveBeenCalled();
+
+    const empty = setup({ value: "  " });
+    act(() => empty.result.current.toggle());
+    act(() => empty.result.current.onFinal("hello"));
+    act(() => void vi.advanceTimersByTime(GRACE_MS + 10));
+    expect(empty.submit).not.toHaveBeenCalled();
+  });
+
+  it("ignores a final while not armed", () => {
+    const { result, submit } = setup();
+    act(() => result.current.onFinal("hello"));
+    act(() => void vi.advanceTimersByTime(GRACE_MS + 10));
+    expect(submit).not.toHaveBeenCalled();
+  });
+
+  it("unmounting clears the flag and the timer", () => {
+    const { result, submit, unmount } = setup();
+    act(() => result.current.toggle());
+    act(() => result.current.onFinal("hello"));
+    unmount();
+    act(() => void vi.advanceTimersByTime(GRACE_MS + 10));
+    expect(submit).not.toHaveBeenCalled();
+    expect(takeVoiceArm()).toBe(false);
+  });
+});
diff --git a/web/src/hooks/useAeVoiceStart.ts b/web/src/hooks/useAeVoiceStart.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fd2891cdb8f7b123948d1387169c9a84aa12cff2
--- /dev/null
+++ b/web/src/hooks/useAeVoiceStart.ts
@@ -0,0 +1,118 @@
+// Start a spoken chat from the new-chat page (omnigent-ae, 2026-11-10). The Voice button arms
+// the page, the mic listens, and the first finished sentence plus a short grace starts the
+// chat; the created chat then opens with Voice mode on (see takeVoiceArm).
+
+import { type MutableRefObject, useCallback, useEffect, useRef, useState } from "react";
+import { primeVoicePlayback } from "@/lib/aeSpeakReplies";
+import {
+  type AeMicController,
+  armVoiceForNextChat,
+  disarmVoiceForNextChat,
+  GRACE_MS,
+  type VoicePhase,
+} from "@/lib/aeVoiceMode";
+
+export interface UseAeVoiceStartArgs {
+  controller: MutableRefObject<AeMicController | null>;
+  /** The message draft, with the latest final already appended. */
+  value: string;
+  /** The Start session button would work right now. */
+  canSubmit: boolean;
+  /** Starts the session exactly as the Start session button does. */
+  submit: () => void;
+}
+
+export interface AeVoiceStart {
+  armed: boolean;
+  phase: VoicePhase;
+  toggle: () => void;
+  onListening: (listening: boolean) => void;
+  onFinal: (text: string) => void;
+  disarm: () => void;
+}
+
+export function useAeVoiceStart({
+  controller,
+  value,
+  canSubmit,
+  submit,
+}: UseAeVoiceStartArgs): AeVoiceStart {
+  const [armed, setArmed] = useState(false);
+  const [phase, setPhase] = useState<VoicePhase>("off");
+  const everListened = useRef(false);
+  const timer = useRef<ReturnType<typeof setTimeout> | null>(null);
+  const latest = useRef({ value, canSubmit, submit });
+  latest.current = { value, canSubmit, submit };
+
+  const clearTimer = useCallback(() => {
+    if (timer.current !== null) clearTimeout(timer.current);
+    timer.current = null;
+  }, []);
+
+  // After a submit the module flag stays set: the session is created asynchronously and
+  // takeVoiceArm reads it once the id is known.
+  const release = useCallback(() => {
+    clearTimer();
+    setArmed(false);
+    setPhase("off");
+    everListened.current = false;
+    controller.current?.stop();
+  }, [clearTimer, controller]);
+
+  const disarm = useCallback(() => {
+    disarmVoiceForNextChat();
+    release();
+  }, [release]);
+
+  const toggle = useCallback(() => {
+    if (armed) {
+      disarm();
+      return;
+    }
+    // Inside the tap, so the browser lets the reply play later.
+    primeVoicePlayback();
+    armVoiceForNextChat();
+    everListened.current = false;
+    setArmed(true);
+    setPhase("starting");
+    controller.current?.start();
+  }, [armed, controller, disarm]);
+
+  const onListening = useCallback(
+    (listening: boolean) => {
+      if (!armed) return;
+      if (listening) {
+        everListened.current = true;
+        setPhase("listening");
+      } else setPhase(everListened.current ? "paused" : "unavailable");
+    },
+    [armed],
+  );
+
+  const onFinal = useCallback(
+    (_text: string) => {
+      if (!armed) return;
+      clearTimer();
+      // A pause after the sentence means it is finished; anything said sooner extends it.
+      timer.current = setTimeout(() => {
+        timer.current = null;
+        const now = latest.current;
+        if (!now.canSubmit || !now.value.trim()) return;
+        now.submit();
+        release();
+      }, GRACE_MS);
+    },
+    [armed, clearTimer, release],
+  );
+
+  // Leaving the page must not leave the next chat armed.
+  useEffect(
+    () => () => {
+      if (timer.current !== null) clearTimeout(timer.current);
+      disarmVoiceForNextChat();
+    },
+    [],
+  );
+
+  return { armed, phase, toggle, onListening, onFinal, disarm };
+}
