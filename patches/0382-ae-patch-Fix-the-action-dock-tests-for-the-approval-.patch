Subject: [PATCH 382/443] [ae-patch] Fix the action dock tests for the approval
 source (0382)

AeActionDock answers a child's prompt through submitApproval, which since 0380 sends _meta.source: card. Two tests asserted the old body.
---
 web/src/components/AeActionDock.test.tsx | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/web/src/components/AeActionDock.test.tsx b/web/src/components/AeActionDock.test.tsx
index 63980a26d37547f68e60713fc7ef424be094141e..c2f8a5387372f5dcad069967584cb2b51097e4b2 100644
--- a/web/src/components/AeActionDock.test.tsx
+++ b/web/src/components/AeActionDock.test.tsx
@@ -1023,6 +1023,7 @@ describe("AeActionDock child prompts", () => {
     expect(JSON.parse(String(call[1]?.body))).toEqual({
       action: "accept",
       content: { "Keep the Fuel Cost measure?": "Keep it" },
+      _meta: { source: "card" },
     });
     await waitFor(() => expect(screen.queryByTestId("ae-action-dock")).toBeNull());
   });
@@ -1064,6 +1065,7 @@ describe("AeActionDock child prompts", () => {
       expect(JSON.parse(String(call[1]?.body))).toEqual({
         action: "accept",
         content: { [field]: "Yes" },
+        _meta: { source: "card" },
       });
     });
   });
