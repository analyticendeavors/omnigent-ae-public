+  "echo",
+  "env",
+  "export",
+  "find",
+  "free",
+  "gh",
+  "git",
+  "go",
+  "grep",
+  "head",
+  "helm",
+  "hostnamectl",
+  "htop",
+  "ip",
+  "journalctl",
+  "just",
