+  // `FOO=bar BAZ=1 cmd ...`
+  while (i < words.length && /^[A-Za-z_][A-Za-z0-9_]*=\S*$/.test(words[i])) i += 1;
+  const word = words[i];
+  if (word === undefined) return false;
+  if (/^(\.{1,2}|~)?\/[\w./~-]+$/.test(word)) return true;
+  return COMMAND_WORDS.has(word);
