+// untagged block of prose, JSON, YAML or code must not grow a Run button.
+const COMMAND_WORDS: ReadonlySet<string> = new Set([
+  "apt",
+  "apt-get",
+  "aws",
+  "awk",
+  "az",
+  "bash",
+  "brew",
+  "cargo",
