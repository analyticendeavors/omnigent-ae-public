+++ b/web/src/lib/aeRunCommand.test.ts
@@ -0,0 +1,225 @@
+import { describe, expect, it } from "vitest";
+import {
+  stripHiddenChars,
+  codeBlockLanguage,
+  commandText,
+  detectDangers,
+  isRunnableBlock,
