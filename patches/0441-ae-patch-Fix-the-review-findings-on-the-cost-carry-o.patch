+        starttime = stat.rpartition(")")[2].split()[19]
+        first, _, rest = (
+            (tmp_path / "context_raw.json").read_text(encoding="utf-8").partition("\n")
+        )
+    finally:
+        libc.prctl(15, old.value)
+    assert first == f"{os.getpid()}-{starttime}"
+    assert rest == '{"x": 1}'
