From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Mon, 19 Oct 2026 20:03:27 -0700
Subject: [PATCH 107/191] [ae-patch] Show a bullet beside each note in the
 rail's Absorbed and Unfiled lists

Each note was already its own list item, but Tailwind's preflight strips
the browser's list markers, so two notes in a row read as one paragraph.
The list now shows a muted disc per note; the "more in older messages"
line keeps no bullet, since it is a note about the list, not an item.
---
 web/src/components/aeRail/AeRailTriage.test.tsx | 16 ++++++++++++++++
 web/src/components/aeRail/AeRailTriage.tsx      | 10 ++++++++--
 2 files changed, 24 insertions(+), 2 deletions(-)

diff --git a/web/src/components/aeRail/AeRailTriage.test.tsx b/web/src/components/aeRail/AeRailTriage.test.tsx
index 7b9de2fdb80e880b17521e3559c8d2e533a07837..211b6c83453ad2d5bf027ac8978eb75ef7c40abf 100644
--- a/web/src/components/aeRail/AeRailTriage.test.tsx
+++ b/web/src/components/aeRail/AeRailTriage.test.tsx
@@ -238,6 +238,22 @@ describe("AeRailTriage", () => {
     expect(screen.queryByText(/older messages not loaded here/)).toBeNull();
   });
 
+  it("marks each note with a bullet, and the missing-lines note with none", () => {
+    show({ "ae.absorbed": "3" }, [
+      said("Absorbed: Rename the field, it blocked the build"),
+      said("Absorbed: Phone frame for the popover, same mockup"),
+    ]);
+    fireEvent.click(screen.getByRole("button", { name: /Absorbed/ }));
+    const list = screen.getByRole("list", { name: "Absorbed" });
+    expect(list).toHaveClass("list-disc");
+    const items = within(list).getAllByRole("listitem");
+    expect(items).toHaveLength(3);
+    expect(items[0]).not.toHaveClass("list-none");
+    expect(items[1]).not.toHaveClass("list-none");
+    expect(items[2]).toHaveClass("list-none");
+    expect(items[2]).toHaveTextContent("1 more in older messages not loaded here.");
+  });
+
   it("lists one count's lines at a time below the shared row", () => {
     show({ "ae.absorbed": "1", "ae.unfiled": "1" }, [
       said("Absorbed: Tabler icon for the rail button, same file"),
