diff --git a/web/src/components/chat/CodexQuestionCard.test.tsx b/web/src/components/chat/CodexQuestionCard.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..5fd4477eb8bbca687c0479ead832a73f7fbb8de0
--- /dev/null
+++ b/web/src/components/chat/CodexQuestionCard.test.tsx
@@ -0,0 +1,92 @@
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { CodexQuestionCard } from "./CodexQuestionCard";
+
+const send = vi.fn();
+vi.mock("@/store/chatStore", () => ({
+  useChatStore: { getState: () => ({ conversationId: "conv_1", boundAgentId: "codex", send }) },
+}));
+
+beforeEach(() => {
+  send.mockReset();
+  localStorage.clear();
+  vi.stubGlobal("crypto", {
+    subtle: { digest: vi.fn(async () => new Uint8Array(32).fill(7).buffer) },
+  });
+});
+
+describe("CodexQuestionCard", () => {
+  it("sends one normal user answer and stays answered after reload", async () => {
+    send.mockResolvedValue(undefined);
+    const props = {
+      conversationId: "conv_1",
+      itemId: "item_1",
+      questions: [{ title: "Which path?", options: ["A", "B"] }],
+    };
+    const view = render(<CodexQuestionCard {...props} />);
+    fireEvent.click(screen.getByRole("button", { name: "B" }));
+    fireEvent.click(screen.getByRole("button", { name: "Send answer" }));
+    expect(screen.getByRole("button", { name: "Sending..." })).toBeDisabled();
+    await waitFor(() => expect(send).toHaveBeenCalledTimes(1));
+    expect(send.mock.calls[0][0]).toBe("Answer to Codex questions:\nWhich path?: B");
+    expect(send.mock.calls[0][3]).toMatchObject({
+      pinnedConversationId: "conv_1",
+      stableId: "07070707070707070707070707070707",
+    });
+    await waitFor(() => expect(screen.queryByRole("button", { name: "Send answer" })).toBeNull());
+    view.unmount();
+    render(<CodexQuestionCard {...props} />);
+    expect(screen.queryByRole("button", { name: "Send answer" })).toBeNull();
+  });
+
+  it("accepts free text and leaves failed answers available to retry", async () => {
+    send.mockImplementation(async (_text, _agent, _files, opts) => opts.onError("Offline"));
+    render(
+      <CodexQuestionCard
+        conversationId="conv_1"
+        itemId="item_2"
+        questions={[{ title: "Describe it" }]}
+      />,
+    );
+    fireEvent.change(screen.getByRole("textbox", { name: "Free text answer for Describe it" }), {
+      target: { value: "My answer" },
+    });
+    fireEvent.click(screen.getByRole("button", { name: "Send answer" }));
+    await waitFor(() => expect(screen.getByRole("alert").textContent).toBe("Offline"));
+    expect(screen.getByRole("button", { name: "Send answer" })).toBeEnabled();
+    expect(localStorage.getItem("codex-question:conv_1:item_2:sent")).toBeNull();
+  });
+
+  it("reopens a dismissed prompt without answering it", () => {
+    render(
+      <CodexQuestionCard
+        conversationId="conv_1"
+        itemId="item_3"
+        questions={[{ title: "Describe it" }]}
+      />,
+    );
+    expect(screen.getByRole("dialog", { name: "Codex has questions" })).toBeTruthy();
+    fireEvent.click(screen.getByRole("button", { name: "Close" }));
+    expect(screen.queryByRole("dialog")).toBeNull();
+    fireEvent.click(screen.getByRole("button", { name: "Answer Codex questions" }));
+    expect(screen.getByRole("dialog", { name: "Codex has questions" })).toBeTruthy();
+    expect(send).not.toHaveBeenCalled();
+  });
+
+  it("opens when an older pending prompt becomes newest", () => {
+    const props = {
+      conversationId: "conv_1",
+      itemId: "item_4",
+      questions: [{ title: "What next?" }],
+    };
+    const view = render(<CodexQuestionCard {...props} autoOpen={false} />);
+    expect(screen.queryByRole("dialog")).toBeNull();
+    view.rerender(<CodexQuestionCard {...props} autoOpen />);
+    expect(screen.getByRole("dialog", { name: "Codex has questions" })).toBeTruthy();
+    fireEvent.click(screen.getByRole("button", { name: "Close" }));
+    view.unmount();
+    render(<CodexQuestionCard {...props} autoOpen />);
+    expect(screen.queryByRole("dialog")).toBeNull();
+    expect(screen.getByRole("button", { name: "Answer Codex questions" })).toBeTruthy();
+  });
+});
diff --git a/web/src/components/chat/CodexQuestionCard.tsx b/web/src/components/chat/CodexQuestionCard.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..06f9c6c15b0e96c901d8431e21bab98946305613
--- /dev/null
+++ b/web/src/components/chat/CodexQuestionCard.tsx
@@ -0,0 +1,171 @@
+import { useEffect, useRef, useState } from "react";
+import { Button } from "@/components/ui/button";
+import { Dialog, DialogContent, DialogHeader, DialogTitle } from "@/components/ui/dialog";
+import { Input } from "@/components/ui/input";
+import type { CodexQuestion } from "@/lib/blocks";
+import { useChatStore } from "@/store/chatStore";
+
+export function isCodexQuestionAnswer(text: string, questions: CodexQuestion[]): boolean {
+  return (
+    text.startsWith("Answer to Codex questions:\n") &&
+    questions.every((question) => text.includes(`\n${question.title}: `))
+  );
+}
+
+export function CodexQuestionCard({
+  conversationId,
+  itemId,
+  questions,
+  autoOpen = true,
+}: {
+  conversationId: string;
+  itemId: string;
+  questions: CodexQuestion[];
+  autoOpen?: boolean;
+}) {
+  const storageKey = `codex-question:${conversationId}:${itemId}`;
+  const [answers, setAnswers] = useState(() => questions.map(() => ""));
+  const [pending, setPending] = useState(false);
+  const [error, setError] = useState("");
+  const [sent, setSent] = useState(() => localStorage.getItem(`${storageKey}:sent`) === "1");
+  const [open, setOpen] = useState(
+    () => autoOpen && localStorage.getItem(`${storageKey}:dismissed`) !== "1",
+  );
+  const submitting = useRef(false);
+
+  useEffect(() => {
+    setOpen(autoOpen && localStorage.getItem(`${storageKey}:dismissed`) !== "1");
+  }, [autoOpen, storageKey]);
+
+  if (sent) return null;
+
+  const submit = async () => {
+    if (submitting.current || answers.some((answer) => !answer.trim())) return;
+    const chat = useChatStore.getState();
+    if (chat.conversationId !== conversationId || !chat.boundAgentId) {
+      setError("Open this session to answer the question.");
+      return;
+    }
+    submitting.current = true;
+    setPending(true);
+    setError("");
+    let failed = false;
+    try {
+      let stableId = localStorage.getItem(`${storageKey}:send-id`);
+      if (!stableId) {
+        const digest = await crypto.subtle.digest(
+          "SHA-256",
+          new TextEncoder().encode(`${conversationId}:${itemId}`),
+        );
+        stableId = Array.from(new Uint8Array(digest).slice(0, 16), (byte) =>
+          byte.toString(16).padStart(2, "0"),
+        ).join("");
+        localStorage.setItem(`${storageKey}:send-id`, stableId);
+      }
+      const answer = [
+        "Answer to Codex questions:",
+        ...questions.map((question, index) => `${question.title}: ${answers[index]!.trim()}`),
+      ].join("\n");
+      await chat.send(answer, chat.boundAgentId, undefined, {
+        stableId,
+        pinnedConversationId: conversationId,
+        onError: (message) => {
+          failed = true;
+          setError(message);
+        },
+      });
+      if (!failed) {
+        localStorage.setItem(`${storageKey}:sent`, "1");
+        setSent(true);
+      }
+    } catch (cause) {
+      setError(cause instanceof Error ? cause.message : "Could not send answer.");
+    } finally {
+      submitting.current = false;
+      setPending(false);
+    }
+  };
+
+  return (
+    <>
+      <Button
+        type="button"
+        variant="outline"
+        size="sm"
+        onClick={() => {
+          localStorage.removeItem(`${storageKey}:dismissed`);
+          setOpen(true);
+        }}
+      >
+        Answer Codex questions
+      </Button>
+      <Dialog
+        open={open}
+        onOpenChange={(next) => {
+          if (pending) return;
+          setOpen(next);
+          if (!next) localStorage.setItem(`${storageKey}:dismissed`, "1");
+        }}
+      >
+        <DialogContent className="max-h-[85vh] overflow-y-auto sm:max-w-lg">
+          <DialogHeader>
+            <DialogTitle>Codex has questions</DialogTitle>
+          </DialogHeader>
+          {questions.map((question, index) => (
+            <div
+              className="mb-3 space-y-2"
+              key={`${question.title}:${question.options?.join("|") ?? ""}`}
+            >
+              <p className="text-sm">{question.title}</p>
+              {!!question.options?.length && (
+                <div className="flex flex-wrap gap-2">
+                  {question.options.map((option) => (
+                    <Button
+                      type="button"
+                      variant={answers[index] === option ? "default" : "outline"}
+                      size="sm"
+                      key={option}
+                      disabled={pending}
+                      aria-pressed={answers[index] === option}
+                      onClick={() =>
+                        setAnswers((current) =>
+                          current.map((value, i) => (i === index ? option : value)),
+                        )
+                      }
+                    >
+                      {option}
+                    </Button>
+                  ))}
+                </div>
+              )}
+              <Input
+                aria-label={`Free text answer for ${question.title}`}
+                placeholder="Or type an answer"
+                value={answers[index]}
+                disabled={pending}
+                onChange={(event) =>
+                  setAnswers((current) =>
+                    current.map((value, i) => (i === index ? event.target.value : value)),
+                  )
+                }
+              />
+            </div>
+          ))}
+          {error && (
+            <p role="alert" className="mb-2 text-sm text-destructive">
+              {error}
+            </p>
+          )}
+          <Button
+            type="button"
+            size="sm"
+            disabled={pending || answers.some((answer) => !answer.trim())}
+            onClick={() => void submit()}
+          >
+            {pending ? "Sending..." : "Send answer"}
+          </Button>
+        </DialogContent>
+      </Dialog>
+    </>
+  );
+}
