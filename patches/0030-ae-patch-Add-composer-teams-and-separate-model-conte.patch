index 0000000000000000000000000000000000000000..e3a822cd7e6c7d68751917c9a9ccf9e2c7c549ec
--- /dev/null
+++ b/web/src/components/aeSessionContext.test.ts
@@ -0,0 +1,233 @@
+import { renderHook, waitFor } from "@testing-library/react";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("@/lib/identity", () => ({ authenticatedFetch: vi.fn() }));
+
+import { authenticatedFetch } from "@/lib/identity";
+import type { AeSessionContext } from "./AePlanLimits";
+import {
+  AE_MAX_COLLABORATORS,
+  aeAgentLabel,
+  aeLimitsHarnessFor,
+  buildActiveContext,
+  buildCollaboratorContext,
+  fetchAeSessionContexts,
+  useAeSessionContexts,
+  usesClaudeStatusLine,
+} from "./aeSessionContext";
+
+const NOW = Date.parse("2026-10-13T16:00:00Z");
+
+const STATUS_LINE: AeSessionContext = {
+  conversation_id: "conv_a",
+  observed_at: new Date(NOW - 60_000).toISOString(),
+  model: "Fable",
+  window_size: 1_000_000,
+  used_tokens: 200_000,
+  input_tokens: 0,
+  cache_write_tokens: 0,
+  cache_read_tokens: 200_000,
+};
+
+const json = (body: unknown, status = 200) =>
+  Promise.resolve(new Response(JSON.stringify(body), { status }));
+
+function child(id: string) {
+  return {
+    id,
+    title: `claude_code:${id}`,
+    task_summary: null,
+    tool: null,
+    session_name: null,
+    current_task_status: null,
+    busy: false,
+  };
+}
+
+function wire(id: string, harness: string, extra: Record<string, unknown> = {}) {
+  return { id, agent_id: "agent", status: "idle", created_at: 0, harness, ...extra };
+}
+
+describe("provider gating", () => {
+  it("lets only Claude Code sessions use the Claude status line", () => {
+    expect(usesClaudeStatusLine("claude-native", null)).toBe(true);
+    expect(usesClaudeStatusLine("native-claude", null)).toBe(true);
+    expect(usesClaudeStatusLine("codex-native", "claude-fable-5-1")).toBe(false);
+    expect(usesClaudeStatusLine("claude-sdk", null)).toBe(false);
+    // Harness not known yet: the model decides.
+    expect(usesClaudeStatusLine(null, "claude-fable-5-1")).toBe(true);
+    expect(usesClaudeStatusLine(null, "gpt-5.5")).toBe(false);
+    expect(usesClaudeStatusLine(null, null)).toBe(false);
+  });
+
+  it("maps harnesses to plan-limit blocks and labels", () => {
+    expect(aeLimitsHarnessFor("claude-native")).toBe("claude");
+    expect(aeLimitsHarnessFor("codex-native")).toBe("codex");
+    expect(aeLimitsHarnessFor("native-codex")).toBe("codex");
+    expect(aeLimitsHarnessFor("codex")).toBe("codex");
+    expect(aeLimitsHarnessFor("pi")).toBeNull();
+    expect(aeAgentLabel("codex-native")).toBe("Codex");
+    expect(aeAgentLabel("native-claude")).toBe("Claude Code");
+    expect(aeAgentLabel("claude-sdk")).toBe("Claude SDK");
+    expect(aeAgentLabel("mystery-harness")).toBe("mystery-harness");
+    expect(aeAgentLabel(null)).toBeNull();
+  });
+});
+
+describe("buildActiveContext", () => {
+  const input = {
+    conversationId: "conv_a",
+    harness: "claude-native",
+    model: "claude-fable-5-1",
+    contextWindow: null,
+    tokensUsed: null,
+  };
+
+  it("prefers live figures, then the snapshot, then the status line", () => {
+    const live = buildActiveContext(
+      { ...input, contextWindow: 1_000_000, tokensUsed: 10 },
+      null,
+      [STATUS_LINE],
+      NOW,
+    );
+    expect(live.reading).toMatchObject({ source: "live", used: 10 });
+    const snap = buildActiveContext(
+      input,
+      { harness: "claude-native", llmModel: null, contextWindow: 1_000_000, lastTotalTokens: 20 },
+      [STATUS_LINE],
+      NOW,
+    );
+    expect(snap.reading).toMatchObject({ source: "snapshot", used: 20 });
+    const line = buildActiveContext(input, null, [STATUS_LINE], NOW);
+    expect(line.reading).toMatchObject({ source: "statusline", used: 200_000, stale: false });
+  });
+
+  it("does not report a zero when the store has a window but no tokens", () => {
+    const entry = buildActiveContext(
+      { ...input, harness: "codex-native", contextWindow: 400_000 },
+      null,
+      [STATUS_LINE],
+      NOW,
+    );
+    expect(entry.reading).toBeNull();
+    expect(entry.unavailable).toContain("Codex has not reported");
+  });
+
+  it("drops the store's figures when the snapshot shows a different agent", () => {
+    const entry = buildActiveContext(
+      { ...input, contextWindow: 1_000_000, tokensUsed: 216_800 },
+      { harness: "codex-native", llmModel: "gpt-5.5", contextWindow: 400_000, lastTotalTokens: 0 },
+      [STATUS_LINE],
+      NOW,
+    );
+    expect(entry).toMatchObject({ harness: "codex-native", agent: "Codex", model: "gpt-5.5" });
+    // A fresh Codex session that reports 0 tokens is a real reading, not the old Claude one.
+    expect(entry.reading).toMatchObject({ source: "snapshot", used: 0, size: 400_000 });
+    expect(entry.breakdown).toBeNull();
+  });
+});
+
+describe("buildCollaboratorContext", () => {
+  it("uses the router's model when the snapshot names none", () => {
+    const entry = buildCollaboratorContext(
+      {
+        id: "conv_x",
+        name: "Child",
+        routedModel: "databricks-claude-sonnet-5",
+        snapshot: {
+          harness: "claude-sdk",
+          llmModel: null,
+          contextWindow: null,
+          lastTotalTokens: null,
+        },
+      },
+      [STATUS_LINE],
+      NOW,
+    );
+    expect(entry.model).toBe("databricks-claude-sonnet-5");
+    expect(entry.reading).toBeNull();
+  });
+});
+
+describe("fetchAeSessionContexts", () => {
+  beforeEach(() => vi.mocked(authenticatedFetch).mockReset());
+
+  it("fetches each child's snapshot, caps the list and keeps a failed child visible", async () => {
+    const ids = Array.from({ length: AE_MAX_COLLABORATORS + 2 }, (_, i) => `conv_c${i}`);
+    vi.mocked(authenticatedFetch).mockImplementation((url) => {
+      const path = String(url);
+      if (path === "/v1/sessions/conv_root/child_sessions") {
+        return json({ object: "list", data: ids.map(child) });
+      }
+      if (path.startsWith("/v1/sessions/conv_root?"))
+        return json(wire("conv_root", "codex-native"));
+      if (path.startsWith("/v1/sessions/conv_c1?")) return json({ detail: "gone" }, 404);
+      const id = path.match(/^\/v1\/sessions\/([^/?]+)\?/)?.[1] ?? "";
+      return json(wire(id, "claude-native", { context_window: 200_000, last_total_tokens: 1 }));
+    });
+    const state = await fetchAeSessionContexts("conv_root");
+    expect(state.self?.harness).toBe("codex-native");
+    expect(state.collaborators.map((c) => c.id)).toEqual(ids.slice(0, AE_MAX_COLLABORATORS));
+    expect(state.hidden).toBe(2);
+    expect(state.collaborators[1]).toMatchObject({ snapshot: null });
+    expect(state.collaborators[0].snapshot).toMatchObject({ contextWindow: 200_000 });
+    expect(state.error).toBeNull();
+  });
+
+  it("reports a failed child list without failing the whole read", async () => {
+    vi.mocked(authenticatedFetch).mockImplementation((url) =>
+      String(url).endsWith("/child_sessions")
+        ? json({ detail: "boom" }, 500)
+        : json(wire("conv_root", "claude-native")),
+    );
+    const state = await fetchAeSessionContexts("conv_root");
+    expect(state.collaborators).toEqual([]);
+    expect(state.error).toMatch(/^500/);
+    expect(state.self?.harness).toBe("claude-native");
+  });
+});
+
+describe("useAeSessionContexts", () => {
+  beforeEach(() => {
+    vi.mocked(authenticatedFetch).mockReset();
+    vi.mocked(authenticatedFetch).mockImplementation((url) => {
+      const path = String(url);
+      if (path.endsWith("/child_sessions")) return json({ object: "list", data: [] });
+      const id = path.match(/^\/v1\/sessions\/([^/?]+)\?/)?.[1] ?? "";
+      return json(wire(id, id === "conv_b" ? "codex-native" : "claude-native"));
+    });
+  });
+
+  it("fetches nothing while closed or for a draft session", () => {
+    renderHook(() => useAeSessionContexts(false, "conv_a"));
+    renderHook(() => useAeSessionContexts(true, null));
+    expect(authenticatedFetch).not.toHaveBeenCalled();
+  });
+
+  it("drops the previous session's rows when the session changes", async () => {
+    const { result, rerender } = renderHook(({ id }) => useAeSessionContexts(true, id), {
+      initialProps: { id: "conv_a" },
+    });
+    await waitFor(() => expect(result.current.self?.harness).toBe("claude-native"));
+    rerender({ id: "conv_b" });
+    // Never conv_a's snapshot under conv_b, not even for one render.
+    expect(result.current.self).toBeUndefined();
+    await waitFor(() => expect(result.current.self?.harness).toBe("codex-native"));
+  });
+
+  it("discards old snapshots immediately when the model binding changes in place", async () => {
+    const { result, rerender } = renderHook(
+      ({ binding }) => useAeSessionContexts(true, "conv_a", 60_000, binding),
+      { initialProps: { binding: "claude-native:old-model" } },
+    );
+    await waitFor(() => expect(result.current.self?.harness).toBe("claude-native"));
+    vi.mocked(authenticatedFetch).mockImplementation((url) =>
+      String(url).endsWith("/child_sessions")
+        ? json({ object: "list", data: [] })
+        : json(wire("conv_a", "codex-native")),
+    );
+    rerender({ binding: "codex-native:new-model" });
+    expect(result.current.self).toBeUndefined();
+    await waitFor(() => expect(result.current.self?.harness).toBe("codex-native"));
+  });
+});
diff --git a/web/src/components/aeSessionContext.ts b/web/src/components/aeSessionContext.ts
new file mode 100644
index 0000000000000000000000000000000000000000..499be9a87f5016cabb773451aa9ed0ff6e542502
--- /dev/null
+++ b/web/src/components/aeSessionContext.ts
@@ -0,0 +1,339 @@
+// Context windows for the usage popover, one row per session: the session the
+// composer is on, then each collaborator (child session) it spawned. Every row
+// is that session's own window; rows are never added together, because two
+// sessions on different models share no window.
+//
+// Sources, in order of trust: the chat store's live ring figures (active row
+// only), the session snapshot (`context_window` / `last_total_tokens`), then
+// the Claude Code status line the limits relay captured for that conversation.
+// The status line is used only for a Claude Code session, so a conversation
+// that moved to Codex never shows its old Claude reading.
+
+import { useEffect, useState } from "react";
+import { type ChildSessionInfo, fetchChildSessions } from "@/hooks/useChildSessions";
+import { BRAIN_HARNESS_LABELS } from "@/lib/agentLabels";
+import type { harnessFamily } from "@/lib/forkHarness";
+import { nativeCodingAgentForHarness } from "@/lib/nativeCodingAgents";
+import { getSessionSlim } from "@/lib/sessionsApi";
+import { isTempConvId } from "@/lib/tempConversationId";
+import type { Session } from "@/lib/types";
+import type { AeHarness, AeSessionContext } from "./AePlanLimits";
+
+/** A status line reading older than this is shown, but marked as possibly out of date. */
+export const AE_STATUSLINE_STALE_MS = 60 * 60_000;
+
+/** Collaborator snapshots fetched per open; the rest are counted, not shown. */
+export const AE_MAX_COLLABORATORS = 6;
+
+/** The fields of a session snapshot the context rows read. */
+export interface AeSessionSnapshot {
+  harness: string | null;
+  llmModel: string | null;
+  contextWindow: number | null;
+  lastTotalTokens: number | null;
+}
+
+export interface AeCollaboratorInput {
+  id: string;
+  /** Rail name: task summary, else title, else the child's id. */
+  name: string;
+  /** The child's snapshot; `null` when it failed to load. */
+  snapshot: AeSessionSnapshot | null;
+  /** Router pick from the child list, used when the snapshot names no model. */
+  routedModel?: string | null;
+  error?: string | null;
+}
+
+/** What the popover fetched for the session it was opened on. */
+export interface AeSessionContextsState {
+  /** This session's snapshot, the check on the store's live (possibly stale) fields. */
+  self?: AeSessionSnapshot | null;
+  collaborators: AeCollaboratorInput[];
+  /** Children past `AE_MAX_COLLABORATORS`. */
+  hidden?: number;
+  loading?: boolean;
+  error?: string | null;
+}
+
+export type AeContextSource = "live" | "snapshot" | "statusline";
+
+export interface AeContextReading {
+  source: AeContextSource;
+  used: number;
+  size: number;
+  /** When the reading was taken; only the status line carries a time. */
+  observedAt: string | null;
+  stale: boolean;
+}
+
+export interface AeContextEntry {
+  key: string;
+  role: "active" | "collaborator";
+  name: string;
+  /** Harness id the row resolved to, e.g. `"codex-native"`. */
+  harness: string | null;
+  /** "Codex", "Claude Code", "Claude SDK"; null when the harness is unknown. */
+  agent: string | null;
+  model: string | null;
+  reading: AeContextReading | null;
+  /** Why there is no reading; set exactly when `reading` is null. */
+  unavailable: string | null;
+  /** Prompt cache split from the Claude Code status line, when it is this session's. */
+  breakdown: AeSessionContext | null;
+}
+
+/** Display name for a harness id: "codex-native" → "Codex". */
+export function aeAgentLabel(harness: string | null | undefined): string | null {
+  if (!harness) return null;
+  if (isClaudeCodeHarness(harness)) return "Claude Code";
+  return (
+    nativeCodingAgentForHarness(harness)?.displayName ?? BRAIN_HARNESS_LABELS[harness] ?? harness
+  );
+}
+
+function isClaudeCodeHarness(harness: string): boolean {
+  return harness === "claude-native" || harness === "native-claude";
+}
+
+function modelFamily(model: string | null | undefined): ReturnType<typeof harnessFamily> {
+  const m = (model ?? "").toLowerCase();
+  if (/claude|anthropic|opus|sonnet|haiku|fable/.test(m)) return "anthropic";
+  if (/gpt|codex|openai|\bo[134]\b/.test(m)) return "openai";
+  if (/gemini/.test(m)) return "gemini";
+  return null;
+}
+
+/**
+ * Whether the relay's Claude Code status line can speak for this session: a
+ * Claude Code harness, or (harness not known yet) a Claude model.
+ */
+export function usesClaudeStatusLine(harness: string | null, model: string | null): boolean {
+  if (harness) return isClaudeCodeHarness(harness);
+  return modelFamily(model) === "anthropic";
+}
+
+/** The plan-limit block (`/v1/ae/limits` harness) a session draws on, if any. */
+export function aeLimitsHarnessFor(harness: string | null | undefined): AeHarness | null {
+  if (!harness) return null;
+  if (isClaudeCodeHarness(harness)) return "claude";
+  const codex =
+    harness === "codex" ||
+    harness === "native-codex" ||
+    nativeCodingAgentForHarness(harness)?.key === "codex";
+  return codex ? "codex" : null;
+}
+
+function fromStatusLine(
+  contexts: AeSessionContext[] | undefined,
+  sessionId: string | null,
+  harness: string | null,
+  model: string | null,
+): AeSessionContext | null {
+  if (!sessionId || !usesClaudeStatusLine(harness, model)) return null;
+  return contexts?.find((c) => c.conversation_id === sessionId) ?? null;
+}
+
+function statusLineReading(context: AeSessionContext, now: number): AeContextReading | null {
+  if (!(context.window_size > 0)) return null;
+  const age = now - Date.parse(context.observed_at);
+  return {
+    source: "statusline",
+    used: context.used_tokens,
+    size: context.window_size,
+    observedAt: context.observed_at,
+    stale: Number.isFinite(age) && age > AE_STATUSLINE_STALE_MS,
+  };
+}
+
+function snapshotReading(snapshot: AeSessionSnapshot | null | undefined): AeContextReading | null {
+  if (!snapshot?.contextWindow || snapshot.contextWindow <= 0) return null;
+  if (snapshot.lastTotalTokens == null) return null;
+  return {
+    source: "snapshot",
+    used: snapshot.lastTotalTokens,
+    size: snapshot.contextWindow,
+    observedAt: null,
+    stale: false,
+  };
+}
+
+function missingText(agent: string | null, what: string): string {
+  return `${agent ?? "This agent"} has not reported ${what} yet; no reading to show.`;
+}
+
+export interface AeActiveSessionInput {
+  conversationId: string | null;
+  harness: string | null;
+  model: string | null;
+  contextWindow: number | null;
+  tokensUsed: number | null;
+}
+
+/**
+ * The active session's row. The store's ring figures win unless this
+ * session's own snapshot names a different harness (the agent was switched
+ * and the store has not rebound yet): then the snapshot speaks for it.
+ */
+export function buildActiveContext(
+  input: AeActiveSessionInput,
+  self: AeSessionSnapshot | null | undefined,
+  statusLines: AeSessionContext[] | undefined,
+  now: number,
+): AeContextEntry {
+  const storeStale = Boolean(self?.harness && input.harness && self.harness !== input.harness);
+  const harness = storeStale ? (self?.harness ?? null) : (input.harness ?? self?.harness ?? null);
+  const model = storeStale ? (self?.llmModel ?? null) : (input.model ?? self?.llmModel ?? null);
+  const agent = aeAgentLabel(harness);
+  const statusLine = fromStatusLine(statusLines, input.conversationId, harness, model);
+  const live =
+    !storeStale &&
+    input.contextWindow != null &&
+    input.contextWindow > 0 &&
+    input.tokensUsed != null
+      ? {
+          source: "live" as const,
+          used: input.tokensUsed,
+          size: input.contextWindow,
+          observedAt: null,
+          stale: false,
+        }
+      : null;
+  const reading =
+    live ?? snapshotReading(self) ?? (statusLine ? statusLineReading(statusLine, now) : null);
+  return {
+    key: input.conversationId ?? "active",
+    role: "active",
+    name: "This session",
+    harness,
+    agent,
+    model,
+    reading,
+    unavailable: reading
+      ? null
+      : input.conversationId
+        ? missingText(agent, "context usage for this session")
+        : "No session yet; the reading appears after the first reply.",
+    breakdown: statusLine,
+  };
+}
+
+export function buildCollaboratorContext(
+  input: AeCollaboratorInput,
+  statusLines: AeSessionContext[] | undefined,
+  now: number,
+): AeContextEntry {
+  const harness = input.snapshot?.harness ?? null;
+  const model = input.snapshot?.llmModel ?? input.routedModel ?? null;
+  const agent = aeAgentLabel(harness);
+  const statusLine = input.snapshot ? fromStatusLine(statusLines, input.id, harness, model) : null;
+  const reading =
+    snapshotReading(input.snapshot) ?? (statusLine ? statusLineReading(statusLine, now) : null);
+  return {
+    key: input.id,
+    role: "collaborator",
+    name: input.name,
+    harness,
+    agent,
+    model,
+    reading,
+    unavailable: reading
+      ? null
+      : input.snapshot
+        ? missingText(agent, "context usage for this session")
+        : `Could not load this session${input.error ? ` (${input.error})` : ""}.`,
+    breakdown: statusLine,
+  };
+}
+
+function toSnapshot(session: Session): AeSessionSnapshot {
+  return {
+    harness: session.harness ?? null,
+    llmModel: session.llmModel ?? null,
+    contextWindow: session.contextWindow ?? null,
+    lastTotalTokens: session.lastTotalTokens ?? null,
+  };
+}
+
+function childName(child: ChildSessionInfo): string {
+  return child.task_summary || child.title || child.session_name || child.id;
+}
+
+function errorText(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
+
+/** One fetch of this session's snapshot, its children and theirs. */
+export async function fetchAeSessionContexts(
+  sessionId: string,
+  signal?: AbortSignal,
+): Promise<AeSessionContextsState> {
+  const [self, children] = await Promise.all([
+    getSessionSlim(sessionId, { signal }).then(toSnapshot, () => null),
+    fetchChildSessions(sessionId).then(
+      (rows) => ({ rows, error: null }),
+      (error: unknown) => ({ rows: [] as ChildSessionInfo[], error: errorText(error) }),
+    ),
+  ]);
+  const shown = children.rows.slice(0, AE_MAX_COLLABORATORS);
+  const collaborators = await Promise.all(
+    shown.map(async (child): Promise<AeCollaboratorInput> => {
+      const base = { id: child.id, name: childName(child), routedModel: child.routed_model };
+      try {
+        return { ...base, snapshot: toSnapshot(await getSessionSlim(child.id, { signal })) };
+      } catch (error) {
+        return { ...base, snapshot: null, error: errorText(error) };
+      }
+    }),
+  );
+  return {
+    self,
+    collaborators,
+    hidden: children.rows.length - shown.length,
+    error: children.error,
+  };
+}
+
+/**
+ * This session's and its collaborators' snapshots while `active` (the popover
+ * is open), refreshed once a minute; nothing is fetched while it is closed.
+ * A new session id drops the previous session's rows at once.
+ */
+export function useAeSessionContexts(
+  active: boolean,
+  sessionId: string | null,
+  refreshMs = 60_000,
+  binding = "",
+): AeSessionContextsState {
+  const id = sessionId && !isTempConvId(sessionId) ? sessionId : null;
+  const key = JSON.stringify([id, binding]);
+  const [state, setState] = useState<{ id: string | null; value: AeSessionContextsState }>({
+    id: null,
+    value: { collaborators: [] },
+  });
+  useEffect(() => {
+    if (!active || !id) return undefined;
+    const controller = new AbortController();
+    const load = () => {
+      setState((prev) =>
+        prev.id === key
+          ? { id: key, value: { ...prev.value, loading: true } }
+          : { id: key, value: { collaborators: [], loading: true } },
+      );
+      fetchAeSessionContexts(id, controller.signal)
+        .then((value) => !controller.signal.aborted && setState({ id: key, value }))
+        .catch(
+          (error: unknown) =>
+            !controller.signal.aborted &&
+            setState({ id: key, value: { collaborators: [], error: errorText(error) } }),
+        );
+    };
+    load();
+    const timer = window.setInterval(load, refreshMs);
+    return () => {
+      controller.abort();
+      window.clearInterval(timer);
+    };
+  }, [active, id, key, refreshMs]);
+  if (!id || state.id !== key) return { collaborators: [], loading: active && id !== null };
+  return state.value;
+}
