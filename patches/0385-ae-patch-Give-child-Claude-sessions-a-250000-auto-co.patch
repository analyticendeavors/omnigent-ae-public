Subject: [PATCH 385/443] [ae-patch] Give child Claude sessions a 250000
 auto-compact window through CLAUDE_CODE_AUTO_COMPACT_WINDOW

---
 omnigent/runner/ae_child_compact_window.py   | 40 ++++++++++++++++++++
 omnigent/runner/native/orchestration.py      | 10 +++++
 tests/runner/test_ae_child_compact_window.py | 33 ++++++++++++++++
 3 files changed, 83 insertions(+)
 create mode 100644 omnigent/runner/ae_child_compact_window.py
 create mode 100644 tests/runner/test_ae_child_compact_window.py

diff --git a/omnigent/runner/ae_child_compact_window.py b/omnigent/runner/ae_child_compact_window.py
new file mode 100644
index 0000000000000000000000000000000000000000..eed3206399679ce4b3bbc9b611c2f5628b13cbab
--- /dev/null
+++ b/omnigent/runner/ae_child_compact_window.py
@@ -0,0 +1,40 @@
+"""Give a child Claude session a smaller auto-compact window than its parent.
+
+Parent and standalone sessions use the user's ``autoCompactWindow`` setting in
+Claude Code's settings. A child session (one with a parent session, made by
+another session in a family) gets :data:`CHILD_AUTO_COMPACT_WINDOW` through
+``CLAUDE_CODE_AUTO_COMPACT_WINDOW`` so it compacts earlier. The variable
+outranks the setting, so a parent never gets it.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping, MutableMapping
+
+AUTO_COMPACT_WINDOW_ENV = "CLAUDE_CODE_AUTO_COMPACT_WINDOW"
+# Tokens; kept under the parent's 400000 user setting.
+CHILD_AUTO_COMPACT_WINDOW = "250000"
+
+
+def apply_child_auto_compact_window(
+    env: MutableMapping[str, str],
+    *,
+    parent_session_id: str | None,
+    inherited_env: Mapping[str, str],
+) -> None:
+    """
+    Set the child auto-compact window in a launch env, in place.
+
+    Does nothing for a session without a parent, and never replaces a value the
+    launch env or the runner env it inherits already carries.
+
+    :param env: The Claude pane's launch env overrides, changed in place.
+    :param parent_session_id: The session's parent, e.g. ``"conv_abc123"``, or
+        ``None`` for a parent or standalone session.
+    :param inherited_env: The runner environment the pane inherits.
+    """
+    if not parent_session_id:
+        return
+    if AUTO_COMPACT_WINDOW_ENV in env or AUTO_COMPACT_WINDOW_ENV in inherited_env:
+        return
+    env[AUTO_COMPACT_WINDOW_ENV] = CHILD_AUTO_COMPACT_WINDOW
diff --git a/omnigent/runner/native/orchestration.py b/omnigent/runner/native/orchestration.py
index 212214739fcf8bbf71fff06efa5915f2caac7b87..9c0771692ca5a02796702644086ca87542d2220f 100644
--- a/omnigent/runner/native/orchestration.py
+++ b/omnigent/runner/native/orchestration.py
@@ -9052,6 +9052,16 @@ async def _auto_create_claude_terminal(
     claude_terminal_env = build_native_claude_terminal_env(
         claude_config, account_name=claude_account
     )
+    # A child session compacts earlier than its parent (AE patch).
+    from omnigent.runner.ae_child_compact_window import apply_child_auto_compact_window
+
+    apply_child_auto_compact_window(
+        claude_terminal_env,
+        parent_session_id=(
+            session_init.snapshot.parent_session_id if session_init is not None else None
+        ),
+        inherited_env=os.environ,
+    )
     # Name the account before the first render, so usage readers do not wait for the shim.
     await asyncio.to_thread(write_launch_account, bridge_dir, claude_terminal_env)
 
diff --git a/tests/runner/test_ae_child_compact_window.py b/tests/runner/test_ae_child_compact_window.py
new file mode 100644
index 0000000000000000000000000000000000000000..773004af8ecb7b1177dc5111dd669dc255000ea1
--- /dev/null
+++ b/tests/runner/test_ae_child_compact_window.py
@@ -0,0 +1,33 @@
+"""A child Claude session launches with the smaller auto-compact window."""
+
+from __future__ import annotations
+
+from omnigent.runner.ae_child_compact_window import (
+    AUTO_COMPACT_WINDOW_ENV,
+    CHILD_AUTO_COMPACT_WINDOW,
+    apply_child_auto_compact_window,
+)
+
+
+def test_child_session_gets_the_window() -> None:
+    env: dict[str, str] = {"A": "1"}
+    apply_child_auto_compact_window(env, parent_session_id="conv_p", inherited_env={})
+    assert env == {"A": "1", AUTO_COMPACT_WINDOW_ENV: CHILD_AUTO_COMPACT_WINDOW}
+    assert CHILD_AUTO_COMPACT_WINDOW == "250000"
+
+
+def test_parent_or_standalone_session_gets_nothing() -> None:
+    for parent in (None, ""):
+        env: dict[str, str] = {}
+        apply_child_auto_compact_window(env, parent_session_id=parent, inherited_env={})
+        assert env == {}
+
+
+def test_existing_value_is_kept() -> None:
+    env = {AUTO_COMPACT_WINDOW_ENV: "100000"}
+    apply_child_auto_compact_window(env, parent_session_id="conv_p", inherited_env={})
+    assert env == {AUTO_COMPACT_WINDOW_ENV: "100000"}
+    inherited = {AUTO_COMPACT_WINDOW_ENV: "300000"}
+    env2: dict[str, str] = {}
+    apply_child_auto_compact_window(env2, parent_session_id="conv_p", inherited_env=inherited)
+    assert env2 == {}
