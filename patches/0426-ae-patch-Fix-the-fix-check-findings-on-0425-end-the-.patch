 web/src/hooks/useAeVoiceMode.ts               |  9 ++++-
 web/src/pages/ChatPage.composer.test.tsx      | 14 ++++++++
 web/src/pages/ChatPage.tsx                    | 10 ++++--
 5 files changed, 77 insertions(+), 3 deletions(-)

