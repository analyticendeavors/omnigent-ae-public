From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Thu, 15 Oct 2026 19:23:15 -0700
Subject: [PATCH 052/260] [ae-patch] Submit long Claude login codes as a paste
 followed by Enter.

---
 omnigent/onboarding/claude_browser_login.py   | 6 +++++-
 tests/onboarding/test_claude_browser_login.py | 4 ++--
 2 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/omnigent/onboarding/claude_browser_login.py b/omnigent/onboarding/claude_browser_login.py
index c9fa531455adacc8368c3bdf2e987880015eca4c..2213f4f470fe80fdcaedf25efe27dcb804f4e9f2 100644
--- a/omnigent/onboarding/claude_browser_login.py
+++ b/omnigent/onboarding/claude_browser_login.py
@@ -94,7 +94,11 @@ def _run(job: Login) -> None:
                 with _LOCK:
                     code, job.code = job.code, ""
                 if code:
-                    process.send(code + "\r")
+                    # Long input is handled as a paste; submit in a separate input event.
+                    process.send(code)
+                    if job.cancel.wait(0.3):
+                        break
+                    process.send("\r")
                 ended = False
                 try:
                     output = (output + process.read_nonblocking(8192, timeout=0.25))[-131072:]
diff --git a/tests/onboarding/test_claude_browser_login.py b/tests/onboarding/test_claude_browser_login.py
index cf77c6f1c8963ab6a520d20852ea15337516d89d..24340a141b67874de7b2210d2376660570dcc69e 100644
--- a/tests/onboarding/test_claude_browser_login.py
+++ b/tests/onboarding/test_claude_browser_login.py
@@ -3,7 +3,7 @@
 from __future__ import annotations
 
 import time
-from unittest.mock import Mock
+from unittest.mock import Mock, call
 
 import pytest
 
@@ -111,7 +111,7 @@ def test_code_submitted_with_enter(monkeypatch):
     monkeypatch.setattr(login.shutil, "which", lambda _: "/usr/bin/claude")
     job = login.Login("Backup", code="dummy#state")
     login._run(job)
-    process.send.assert_called_once_with("dummy#state\r")
+    assert process.send.call_args_list == [call("dummy#state"), call("\r")]
     process.sendline.assert_not_called()
 
 
