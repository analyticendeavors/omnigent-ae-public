+    expect(aeChoiceField(schema({ enum: ["Yes", "No"] }))?.needsReject).toBe(false);
+    expect(
+      aeChoiceField(schema({ enum: ["a", "b"], enumNames: ["Go on", "Decline it"] }))?.needsReject,
