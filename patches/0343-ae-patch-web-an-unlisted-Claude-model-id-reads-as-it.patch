diff --git a/web/src/lib/composerModelLabel.ts b/web/src/lib/composerModelLabel.ts
index 88d711e61e18f30cf7912b5aed54660d52c8911e..0b9b8472a3e39c45dc0f91e0945e5b9399b96d1d 100644
