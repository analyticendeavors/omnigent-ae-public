From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Sun, 15 Nov 2026 13:35:35 -0800
Subject: [PATCH 376/443] [ae-patch] Put the context size first in the compact
 suggestion

---
 web/src/components/AeActionDock.test.tsx         | 4 +---
 web/src/components/aeRail/AeRailContext.test.tsx | 4 +---
 web/src/lib/aeCompactSuggestion.test.ts          | 4 +---
 web/src/lib/aeCompactSuggestion.ts               | 2 +-
 4 files changed, 4 insertions(+), 10 deletions(-)

diff --git a/web/src/components/AeActionDock.test.tsx b/web/src/components/AeActionDock.test.tsx
index 62fefd8718659a6f1dd79fca3500266be642a515..63980a26d37547f68e60713fc7ef424be094141e 100644
--- a/web/src/components/AeActionDock.test.tsx
+++ b/web/src/components/AeActionDock.test.tsx
@@ -1110,9 +1110,7 @@ describe("the Compact card", () => {
   it("shows the size and Compact and Not now when the label asks", async () => {
     renderDock([], [], SUGGEST);
     const lead = await screen.findByTestId("ae-dock-lead");
-    expect(lead.textContent).toContain(
-      "This chat is at 370k tokens. Every reply re-reads all of it.",
-    );
+    expect(lead.textContent).toContain("370k tokens. Full context processed each reply.");
     expect(within(lead).getByTestId("ae-dock-compact")).toBeTruthy();
     expect(within(lead).getByTestId("ae-dock-context-later")).toBeTruthy();
   });
diff --git a/web/src/components/aeRail/AeRailContext.test.tsx b/web/src/components/aeRail/AeRailContext.test.tsx
index 516ee3bfac40625d009a5c25af93b35703950b16..c6732fa14ced05c568a9dd8d03b2d403aaed5727 100644
--- a/web/src/components/aeRail/AeRailContext.test.tsx
+++ b/web/src/components/aeRail/AeRailContext.test.tsx
@@ -336,9 +336,7 @@ describe("Compact suggestion line", () => {
     const line = await screen.findByTestId("ae-rail-compact-suggest");
     expect(line.textContent).toBe("370k tokens, re-read on every reply.");
     expect(line.className).toContain("truncate");
-    expect(line.getAttribute("title")).toBe(
-      "This chat is at 370k tokens. Every reply re-reads all of it.",
-    );
+    expect(line.getAttribute("title")).toBe("370k tokens. Full context processed each reply.");
     await screen.findByRole("button", { name: /^Categories/ });
     expect(screen.queryByTestId("ae-rail-compact")).toBeNull();
   });
diff --git a/web/src/lib/aeCompactSuggestion.test.ts b/web/src/lib/aeCompactSuggestion.test.ts
index 3b48b56b7fb48d948f680c843211f41e324ca0fc..a44c53cc14486737ce4ca338c991822e8a4b41fd 100644
--- a/web/src/lib/aeCompactSuggestion.test.ts
+++ b/web/src/lib/aeCompactSuggestion.test.ts
@@ -78,9 +78,7 @@ describe("aeCompactSuggestion", () => {
 
   it("words the line in thousands", () => {
     expect(aeCompactTokens(370_400)).toBe("370k");
-    expect(aeCompactText(370_000)).toBe(
-      "This chat is at 370k tokens. Every reply re-reads all of it.",
-    );
+    expect(aeCompactText(370_000)).toBe("370k tokens. Full context processed each reply.");
     expect(aeCompactRailText(370_000)).toBe("370k tokens, re-read on every reply.");
   });
 });
diff --git a/web/src/lib/aeCompactSuggestion.ts b/web/src/lib/aeCompactSuggestion.ts
index 39a5b957ed7cc18c695b5ac1c44ea9935ff400cc..06823f5e34aed1f1860d4e4922488ddda435029d 100644
--- a/web/src/lib/aeCompactSuggestion.ts
+++ b/web/src/lib/aeCompactSuggestion.ts
@@ -73,7 +73,7 @@ export function aeCompactTokens(tokens: number): string {
 
 /** The card's line, and the rail line's tooltip. */
 export function aeCompactText(tokens: number): string {
-  return `This chat is at ${aeCompactTokens(tokens)} tokens. Every reply re-reads all of it.`;
+  return `${aeCompactTokens(tokens)} tokens. Full context processed each reply.`;
 }
 
 /** The rail's shorter line, which fits the Context card on one line. */
