+    if (!modelRefs.current.wanted && mayTouchModel()) await revertModel();
+  }, [chatId, mayTouchModel, revertModel]);
+
+  useEffect(() => {
+    if (modelWanted) void applyModel();
+    else void revertModel();
+  }, [modelWanted, fastModel, applyModel, revertModel]);
