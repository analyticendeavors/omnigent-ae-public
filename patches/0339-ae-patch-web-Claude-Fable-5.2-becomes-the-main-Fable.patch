+    ]);
+    expect(rows[0]).toMatchObject({
+      id: "fable",
+      model: "claude-fable-5-2",
+      displayName: "Fable 5.2",
+    });
+    expect(rows.some((row) => row.id === "claude-fable-5-1")).toBe(true);
