+    expect(rows.find((row) => row.id === "claude-fable-5-3[1m]")?.displayName).toBe(
+      "Fable 5.3 (1M context)",
+    );
+    expect(rows.some((row) => row.id === "claude-fable-5-2")).toBe(true);
+  });
+});
