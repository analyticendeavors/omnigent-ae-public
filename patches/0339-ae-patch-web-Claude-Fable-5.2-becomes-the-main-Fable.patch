+describe("promotion of a newer known model", () => {
+  it("moves the 1M Fable row to 5.2 and demotes 5.1", () => {
+    const rows = aeWithClaudeVersions(CATALOG);
+    const main = rows.find((row) => row.id === "claude-fable-5-2[1m]");
