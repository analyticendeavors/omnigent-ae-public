From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Wed, 28 Oct 2026 13:26:48 -0700
Subject: [PATCH 225/260] [ae-patch] Let a long choice button wrap inside the
 card instead of overflowing

---
 .../blocks/AeChoiceButtons.test.tsx           | 32 +++++++++++++++++++
 web/src/components/blocks/AeChoiceButtons.tsx |  4 ++-
 2 files changed, 35 insertions(+), 1 deletion(-)
 create mode 100644 web/src/components/blocks/AeChoiceButtons.test.tsx

diff --git a/web/src/components/blocks/AeChoiceButtons.test.tsx b/web/src/components/blocks/AeChoiceButtons.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..8a0cf13db076b18ab01b2501ded2e11776161f1d
--- /dev/null
+++ b/web/src/components/blocks/AeChoiceButtons.test.tsx
@@ -0,0 +1,32 @@
+import { render, screen } from "@testing-library/react";
+import { describe, expect, it, vi } from "vitest";
+import type { AeChoiceField } from "@/lib/aeChoiceButtons";
+import { AeChoiceButtons } from "./AeChoiceButtons";
+
+const long =
+  "Fix it now: one builder on omnigent-ae changes the scheduler so a check-in reuses your orchestrator chat";
+
+const field: AeChoiceField = {
+  name: "q",
+  title: "Which fix?",
+  description: "",
+  needsReject: false,
+  choices: [
+    { value: "a", label: long, fullLabel: "Fix it now" },
+    { value: "b", label: "Park it", fullLabel: "Park it" },
+  ],
+};
+
+describe("AeChoiceButtons on a phone", () => {
+  it("lets a long label wrap and shrink instead of running past the card", () => {
+    render(<AeChoiceButtons field={field} onChoose={vi.fn()} onReject={vi.fn()} />);
+    const button = screen.getByRole("button", { name: "Fix it now" });
+    // jsdom has no layout: these classes are what keep the button inside the column.
+    expect(button.className).toContain("whitespace-normal");
+    expect(button.className).toContain("max-w-full");
+    expect(button.className).toContain("min-w-0");
+    expect(button.className).toContain("h-auto");
+    expect(button.className).not.toContain("whitespace-nowrap");
+    expect(button.parentElement?.className).toContain("min-w-0");
+  });
+});
diff --git a/web/src/components/blocks/AeChoiceButtons.tsx b/web/src/components/blocks/AeChoiceButtons.tsx
index 6432da3e7ae7e2080c18678c62069453630392d9..1e3f9224b277e273bfb7a005b61c7756c1397ddb 100644
--- a/web/src/components/blocks/AeChoiceButtons.tsx
+++ b/web/src/components/blocks/AeChoiceButtons.tsx
@@ -35,7 +35,7 @@ export function AeChoiceButtons({
           {field.description}
         </span>
       )}
-      <div className="flex flex-wrap gap-2">
+      <div className="flex min-w-0 flex-wrap gap-2">
         {field.choices.map((choice, index) => (
           <Button
             key={choice.value}
@@ -47,6 +47,8 @@ export function AeChoiceButtons({
                   ? "outline"
                   : "secondary"
             }
+            // A long label wraps inside the card instead of running past the screen.
+            className="h-auto min-h-7 max-w-full min-w-0 shrink justify-start py-0.5 text-left whitespace-normal"
             title={choice.fullLabel}
             aria-label={choice.fullLabel}
             disabled={sent}
