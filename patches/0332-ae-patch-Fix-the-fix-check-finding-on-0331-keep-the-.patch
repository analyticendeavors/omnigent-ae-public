From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Mon, 9 Nov 2026 13:04:42 -0800
Subject: [PATCH 332/333] [ae-patch] Fix the fix-check finding on 0331: keep
 the queued list in the Move all answer

moveAllAeClaudeChats rebuilt the server's answer from moved, skipped and
pending only, so the Move all toast never counted the chats with no terminal
running and they were not re-read. It now keeps queued; a dialog test sends a
queued row through the real client.
---
 web/src/lib/aeClaudeAccount.ts              |  7 ++++++-
 web/src/shell/AeMoveAllChatsDialog.test.tsx | 20 ++++++++++++++++++++
 2 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/web/src/lib/aeClaudeAccount.ts b/web/src/lib/aeClaudeAccount.ts
index ae5d07370fd75e19c945d474e5acd216d0dabf12..4c86b46b43062d73d4303e7f97e30b90f1ef75d9 100644
--- a/web/src/lib/aeClaudeAccount.ts
+++ b/web/src/lib/aeClaudeAccount.ts
@@ -157,7 +157,12 @@ export async function moveAllAeClaudeChats(
   });
   if (!res.ok) throw await apiErrorFromResponse(res);
   const body = (await res.json()) as Partial<AeMoveAllAnswer> | null;
-  return { moved: body?.moved ?? [], skipped: body?.skipped ?? [], pending: body?.pending ?? [] };
+  return {
+    moved: body?.moved ?? [],
+    skipped: body?.skipped ?? [],
+    pending: body?.pending ?? [],
+    queued: body?.queued ?? [],
+  };
 }
 
 /** One line for the result, e.g. "Moved 4 chats; 1 skipped: Fix CI is mid-reply". */
diff --git a/web/src/shell/AeMoveAllChatsDialog.test.tsx b/web/src/shell/AeMoveAllChatsDialog.test.tsx
index 02af3ebe97fecfe7d02aeba3ed6987dfafd0f6a4..0d84599b862ebae27aa72b3393936c24bb3b74cf 100644
--- a/web/src/shell/AeMoveAllChatsDialog.test.tsx
+++ b/web/src/shell/AeMoveAllChatsDialog.test.tsx
@@ -49,6 +49,26 @@ describe("AeMoveAllChatsDialog", () => {
     expect(authenticatedFetch).not.toHaveBeenCalled();
   });
 
+  it("counts chats with no terminal running apart and re-reads them", async () => {
+    vi.mocked(authenticatedFetch).mockImplementation(() =>
+      json({
+        moved: ["a"],
+        skipped: [],
+        pending: [],
+        queued: [{ id: "q", title: "Idle chat", reason: "starts at its next message" }],
+      }),
+    );
+    ask();
+    const invalidate = vi.spyOn(queryClient, "invalidateQueries");
+    fireEvent.click(await screen.findByTestId("ae-move-all-confirm"));
+    await waitFor(() =>
+      expect(showToast).toHaveBeenCalledWith(
+        "Moved 1 chat; 1 chat not running starts on AE Backup at its next message",
+      ),
+    );
+    expect(invalidate).toHaveBeenCalledWith({ queryKey: ["session", "q"] });
+  });
+
   it("Move all chats posts the login and reports one line", async () => {
     vi.mocked(authenticatedFetch).mockImplementation(() =>
       json({
