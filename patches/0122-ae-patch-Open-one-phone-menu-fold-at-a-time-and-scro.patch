From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 20 Oct 2026 15:44:10 -0700
Subject: [PATCH 122/202] [ae-patch] Open one phone menu fold at a time and
 scroll its items into view

omnigent-ae patch 0122 (2026-10-20), the dual review of 0121. Status and
Move each kept their own open state, so opening both brought back the
20-row menu 0121 removed; one module-wide value now holds the open fold,
so opening one shuts the other, and a closed menu resets it. The opened
group is scrolled into view (the menu scrolls once it runs out of room),
and the row names its group with aria-controls.

Tests: the phone Move test no longer opens Status for its radio count; it
checks Move's items alone, then that opening Status shuts Move. The
Status test checks aria-controls points at the group.
---
 web/src/shell/AeMenuFold.tsx               | 53 ++++++++++++++++++++--
 web/src/shell/AeStatusMenu.test.tsx        |  3 +-
 web/src/shell/Sidebar.aeSortModes.test.tsx |  9 +++-
 3 files changed, 58 insertions(+), 7 deletions(-)

diff --git a/web/src/shell/AeMenuFold.tsx b/web/src/shell/AeMenuFold.tsx
index 90b878bb87bc7dbe466914492f2a9ce822d83d0f..7f1f28505227dca9f6e0b84bdb090b5980da1018 100644
--- a/web/src/shell/AeMenuFold.tsx
+++ b/web/src/shell/AeMenuFold.tsx
@@ -3,7 +3,14 @@
 // menu open, so Status and Move take one row each on a phone (omnigent-ae).
 
 import { ChevronRightIcon } from "lucide-react";
-import { type ComponentType, type ReactNode, useState } from "react";
+import {
+  type ComponentType,
+  type ReactNode,
+  useEffect,
+  useId,
+  useRef,
+  useSyncExternalStore,
+} from "react";
 import { cn } from "@/lib/utils";
 
 export interface AeMenuFoldItemProps {
@@ -11,10 +18,26 @@ export interface AeMenuFoldItemProps {
   className?: string;
   textValue?: string;
   "aria-expanded"?: boolean;
+  "aria-controls"?: string;
   onSelect?: (event: Event) => void;
   "data-testid"?: string;
 }
 
+// One fold open at a time across the open menu, so Status and Move never both
+// lengthen it. Only one row menu is ever open, so one module-wide value does.
+let openFold: string | null = null;
+const listeners = new Set<() => void>();
+
+function setOpenFold(next: string | null) {
+  openFold = next;
+  for (const listener of listeners) listener();
+}
+
+function subscribe(listener: () => void) {
+  listeners.add(listener);
+  return () => listeners.delete(listener);
+}
+
 export function AeMenuFold({
   Item,
   icon,
@@ -31,17 +54,33 @@ export function AeMenuFold({
   testId: string;
   children: ReactNode;
 }) {
-  const [open, setOpen] = useState(false);
+  const open = useSyncExternalStore(subscribe, () => openFold === testId);
+  const groupId = useId();
+  const group = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    // The menu scrolls when it runs out of room; bring the opened items into view.
+    if (open) group.current?.scrollIntoView?.({ block: "nearest" });
+  }, [open]);
+  // A closed menu unmounts its folds; the next one opens with both shut.
+  useEffect(
+    () => () => {
+      if (openFold === testId) setOpenFold(null);
+    },
+    [testId],
+  );
+
   return (
     <>
       <Item
         data-testid={testId}
         aria-expanded={open}
+        aria-controls={open ? groupId : undefined}
         textValue={label}
         onSelect={(event) => {
           // Keep the menu open: this row only shows or hides its items.
           event.preventDefault();
-          setOpen((was) => !was);
+          setOpenFold(open ? null : testId);
         }}
       >
         {icon}
@@ -58,7 +97,13 @@ export function AeMenuFold({
         />
       </Item>
       {open ? (
-        <div role="group" aria-label={label} className="mx-1 mb-1 rounded-md bg-muted/60 py-0.5">
+        <div
+          ref={group}
+          id={groupId}
+          role="group"
+          aria-label={label}
+          className="mx-1 mb-1 rounded-md bg-muted/60 py-0.5"
+        >
           {children}
         </div>
       ) : null}
