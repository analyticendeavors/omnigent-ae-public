 .../components/aeRail/AeRailTriage.test.tsx   |  20 +++
 web/src/components/aeRail/AeRailTriage.tsx    | 142 +++++++++++-------
 2 files changed, 109 insertions(+), 53 deletions(-)

diff --git a/web/src/components/aeRail/AeRailTriage.test.tsx b/web/src/components/aeRail/AeRailTriage.test.tsx
index 6b78f7ca9dd6cb89fdde9deb8e6165ad8c94dbb9..afc8233f1b2e5e6570862aff3db0874167b9eb49 100644
