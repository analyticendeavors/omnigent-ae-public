From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Thu, 19 Nov 2026 16:07:46 -0800
Subject: [PATCH 419/443] [ae-patch] Merge every Apple system voice id form in
 the iPhone voice dedupe and log the device voice list

---
 web/src/components/AeVoiceMenuRows.tsx        | 8 +++++++-
 web/src/lib/aeSpeakReplies.ios-voices.test.ts | 8 ++++++++
 web/src/lib/aeSpeakReplies.ts                 | 9 ++++++---
 3 files changed, 21 insertions(+), 4 deletions(-)

diff --git a/web/src/components/AeVoiceMenuRows.tsx b/web/src/components/AeVoiceMenuRows.tsx
index 88d8fd9c0b6afc5fb0080e17d2e8830fd6921c3c..56fea8873c465dfa1630c12c4ea1fed01b04d0f1 100644
--- a/web/src/components/AeVoiceMenuRows.tsx
+++ b/web/src/components/AeVoiceMenuRows.tsx
@@ -251,7 +251,13 @@ export function useVoiceChoices() {
     };
   }, []);
   useEffect(() => {
-    const refresh = () => setVoices(listVoices());
+    const refresh = () => {
+      const next = listVoices();
+      setVoices(next);
+      if (next.length > 0) {
+        logVoice("device voices", next.map((v) => `${v.name}|${v.lang}|${v.voiceURI}`).join(", ").slice(0, 4000));
+      }
+    };
     refresh();
     return onVoicesChanged(refresh);
   }, []);
diff --git a/web/src/lib/aeSpeakReplies.ios-voices.test.ts b/web/src/lib/aeSpeakReplies.ios-voices.test.ts
index a4de637a2c834a3501df52ad633d68fca7cbc682..99fbf3346a245991b635b878906a156c4970820f 100644
--- a/web/src/lib/aeSpeakReplies.ios-voices.test.ts
+++ b/web/src/lib/aeSpeakReplies.ios-voices.test.ts
@@ -56,3 +56,11 @@ describe("saved pick of a dropped copy", () => {
     expect(canonicalVoiceUri(compact.voiceURI)).toBe(enhanced.voiceURI);
   });
 });
+
+describe("older Apple voice ids", () => {
+  it("merges ttsbundle copies of one voice", () => {
+    const a = v("Daniel", "com.apple.ttsbundle.Daniel-compact");
+    const b = v("Daniel", "com.apple.voice.enhanced.en-US.Daniel");
+    expect(dedupeIosVoices([a, b])).toEqual([b]);
+  });
+});
diff --git a/web/src/lib/aeSpeakReplies.ts b/web/src/lib/aeSpeakReplies.ts
index 292648e829314551ad01bc7fbe48945978a10b5d..71b18dcfabd162f311de108bc73ec852014f52d1 100644
--- a/web/src/lib/aeSpeakReplies.ts
+++ b/web/src/lib/aeSpeakReplies.ts
@@ -146,15 +146,18 @@ export function isSilentIosVoice(voice: SpeechSynthesisVoice): boolean {
 
 function iosVoiceQuality(voice: SpeechSynthesisVoice): number {
   const uri = voice.voiceURI ?? "";
-  if (/\.premium\./i.test(uri)) return 2;
-  if (/\.enhanced\./i.test(uri)) return 1;
+  if (/premium/i.test(uri)) return 2;
+  if (/enhanced/i.test(uri)) return 1;
   return 0;
 }
 
 function iosVoiceKey(v: SpeechSynthesisVoice): string {
   // Only Apple's quality tiers of one system voice are merged; any other voice
   // (a Personal Voice, a third-party voice) stays its own entry.
-  if (!/^com\.apple\.voice\.(compact|enhanced|premium)\./i.test(v.voiceURI ?? "")) {
+  // Apple names its system voices several ways across iOS releases
+  // (com.apple.voice.compact..., com.apple.ttsbundle.Samantha-compact, ...).
+  const uri = v.voiceURI ?? "";
+  if (!/^com\.apple\./i.test(uri) || /personalvoice/i.test(uri)) {
     return `uri|${v.voiceURI}`;
   }
   return `${v.name.trim().toLowerCase()}|${(v.lang ?? "").replace("_", "-").toLowerCase()}`;
