+import { afterEach, describe, expect, it } from "vitest";
+import { aeDropStartOn, aeTakeStartOn } from "@/lib/aeStartOnApply";
+import { useChatStore } from "@/store/chatStore";
+import { aeNoteStartOn } from "./useAeSessionPreset";
+
+const LINE = 'inspect it\nSTART ON: preset "YOLO"';
+
+function chat(patch: Partial<ReturnType<typeof useChatStore.getState>>) {
+  useChatStore.setState({
+    conversationId: "c1",
+    loadingConversation: false,
+    abortController: new AbortController(),
+    conversationLoadError: null,
+    hasMoreHistory: false,
+    pendingUserMessages: [],
+    queuedMessages: [],
+    blocks: [],
+    ...patch,
+  });
+}
+
+afterEach(() => {
+  aeDropStartOn();
+});
+
+describe("aeNoteStartOn", () => {
+  it("queues for a session whose history loaded and is empty", () => {
+    chat({});
+    aeNoteStartOn(LINE, "c1", []);
+    expect(aeTakeStartOn("c1")).toMatchObject({ text: LINE });
+  });
+
+  it("does not count an existing session whose items have not loaded yet", () => {
+    chat({ abortController: null });
+    aeNoteStartOn(LINE, "c1", []);
+    expect(aeTakeStartOn("c1")).toBeNull();
+    chat({ loadingConversation: true });
+    aeNoteStartOn(LINE, "c1", []);
+    expect(aeTakeStartOn("c1")).toBeNull();
+    chat({ conversationId: "other" });
+    aeNoteStartOn(LINE, "c1", []);
+    expect(aeTakeStartOn("c1")).toBeNull();
+  });
+
+  it("does not count a session with turns or older history", () => {
+    chat({ hasMoreHistory: true });
+    aeNoteStartOn(LINE, "c1", []);
+    expect(aeTakeStartOn("c1")).toBeNull();
+    chat({ pendingUserMessages: [{ tempId: "t", content: [], createdAtS: 0 }] });
+    aeNoteStartOn(LINE, "c1", []);
+    expect(aeTakeStartOn("c1")).toBeNull();
+  });
+
+  it("counts a new session (landing page or New Chat dialog) without store state", () => {
+    chat({ conversationId: null });
+    aeNoteStartOn(LINE, null, []);
+    expect(aeTakeStartOn(null)).not.toBeNull();
+    aeNoteStartOn(LINE, "conv_new", [], { isNewSession: true });
+    expect(aeTakeStartOn("conv_other")).toBeNull();
+    expect(aeTakeStartOn("conv_new")).not.toBeNull();
+  });
+
+  it("drops a queued plan when the next message has no START ON line", () => {
+    chat({});
+    aeNoteStartOn(LINE, "c1", []);
+    aeNoteStartOn("a later message", "c1", []);
+    expect(aeTakeStartOn("c1")).toBeNull();
+  });
+});
diff --git a/web/src/hooks/useAeSessionPreset.ts b/web/src/hooks/useAeSessionPreset.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ab56a9338fff0314a0239fd8643aa01e1d9b4255
--- /dev/null
+++ b/web/src/hooks/useAeSessionPreset.ts
@@ -0,0 +1,142 @@
+// A session's roles preset in the composer (omnigent-ae, 2026-10-23): what
+// the pill shows, picking from its menu, Alt 1 to 9, and queuing a START ON
+// line from the first message. The label read and write live in
+// lib/aeSessionRoles.ts; this file binds them to the session and roles queries.
+
+import { useQueryClient } from "@tanstack/react-query";
+import { useCallback, useMemo } from "react";
+import { showToast } from "@/components/ui/toast";
+import { useAeRoles } from "@/hooks/useAeRoles";
+import { useSession } from "@/hooks/useSession";
+import {
+  AE_SUPERSEDED,
+  aeLatestWins,
+  aePresetDigit,
+  aeRememberPreset,
+  aeResolveSessionPreset,
+  aeRolesForPick,
+  readAeSessionRoles,
+  saveAeSessionRoles,
+} from "@/lib/aeSessionRoles";
+import { aeStartOnLine } from "@/lib/aeStartOn";
+import { aeDropStartOn, aeQueueStartOn } from "@/lib/aeStartOnApply";
+import { aeChordFromEvent, aeSameChord, readAeSuggestionKeys } from "@/lib/aeSuggestionKeys";
+import { isTempConvId } from "@/lib/tempConversationId";
+import type { NativeModelOption } from "@/lib/types";
+import { useChatStore } from "@/store/chatStore";
+
+export function useAeSessionPreset(sessionId: string | null | undefined) {
+  const queryClient = useQueryClient();
+  const { session } = useSession(sessionId);
+  const { data: state } = useAeRoles();
+  const labels = session?.labels;
+  const roles = useMemo(() => readAeSessionRoles(labels), [labels]);
+  const choice = useMemo(
+    () => (state ? aeResolveSessionPreset(roles, state) : null),
+    [roles, state],
+  );
+  /**
+   * Put the session on `id` (a preset id or "lead-picks"); resolves true once
+   * saved. Picks for one session run one at a time and the latest wins: a pick
+   * still waiting when a later one arrives never lands (resolves false).
+   */
+  const pick = useCallback(
+    async (id: string): Promise<boolean> => {
+      if (!sessionId || !state) return false;
+      try {
+        const saved = await aeLatestWins(sessionId, () =>
+          saveAeSessionRoles(sessionId, aeRolesForPick(id, state.default_preset)),
+        );
+        if (saved === AE_SUPERSEDED) return false;
+        queryClient.setQueryData(["session", sessionId], saved);
+        aeRememberPreset(id);
+        return true;
+      } catch (error) {
+        const reason = error instanceof Error ? error.message : String(error);
+        showToast(`Could not switch the roles preset: ${reason}. Try again.`);
+        return false;
+      }
+    },
+    [queryClient, sessionId, state],
+  );
+  return { state, roles, choice, pick };
+}
+
+/**
+ * Alt 1 to 9 in the composer: switch to the preset at that list position.
+ * Returns true when it handled the key. The user's suggestion chord wins, and
+ * a position with no preset leaves the key alone (Option+digit types on a Mac).
+ */
+export function useAePresetHotkey(
+  sessionId: string | null | undefined,
+  current: Pick<ReturnType<typeof useAeSessionPreset>, "state" | "choice" | "pick">,
+) {
+  const { state, choice, pick } = current;
+  return useCallback(
+    (event: KeyboardEvent): boolean => {
+      if (event.isComposing) return false;
+      const index = aePresetDigit(event);
+      if (index === null || !state || !sessionId) return false;
+      const chord = aeChordFromEvent(event);
+      const keys = readAeSuggestionKeys();
+      if (chord && (aeSameChord(chord, keys.next) || aeSameChord(chord, keys.previous))) {
+        return false;
+      }
+      const preset = state.presets[index];
+      if (!preset) return false;
+      event.preventDefault();
+      if (choice?.kind === "preset" && choice.preset.id === preset.id && !choice.edited) {
+        showToast(`Already on ${preset.title}.`, { duration: 2000 });
+        return true;
+      }
+      void pick(preset.id).then(
+        (ok) => ok && showToast(`Roles preset: ${preset.title}`, { duration: 2000 }),
+      );
+      return true;
+    },
+    [choice, pick, sessionId, state],
+  );
+}
+
+/**
+ * True only when the session is known to have no message: a new session (the
+ * landing page, or a temp id) or one whose history has finished loading and is
+ * empty. An existing session whose items have not loaded yet never counts.
+ */
+function isFirstMessage(conversationId: string | null, isNewSession: boolean): boolean {
+  if (isNewSession || conversationId === null || isTempConvId(conversationId)) return true;
+  const chat = useChatStore.getState();
+  if (chat.conversationId !== conversationId) return false;
+  const loaded =
+    !chat.loadingConversation &&
+    chat.abortController !== null &&
+    chat.conversationLoadError === null;
+  return (
+    loaded &&
+    !chat.hasMoreHistory &&
+    chat.pendingUserMessages.length === 0 &&
+    chat.queuedMessages.length === 0 &&
+    !chat.blocks.some((block) => block.type === "user_message")
+  );
+}
+
+/**
+ * Called with the text about to be sent (by the composer, and by the New Chat
+ * dialog for a first prompt, with `isNewSession` and the real session id). On a
+ * session's first message, a START ON line is queued for the send to apply
+ * (which checks Settings > Roles "Apply START ON lines" and the presets). Any
+ * other message drops a plan still queued. Not a hook: the composer's tests
+ * render it without a query client.
+ */
+export function aeNoteStartOn(
+  text: string,
+  conversationId: string | null,
+  models: readonly NativeModelOption[],
+  opts: { isNewSession?: boolean } = {},
+) {
+  if (!aeStartOnLine(text) || !isFirstMessage(conversationId, opts.isNewSession === true)) {
+    aeDropStartOn();
+    return;
+  }
+  aeQueueStartOn(conversationId, { text, models });
+}
diff --git a/web/src/lib/aeRoles.ts b/web/src/lib/aeRoles.ts
index 19f0a69d547eae2802e301ffb05db49c0f2210e5..437f33e77c05420b434c19a7246814b99cad722a 100644
--- a/web/src/lib/aeRoles.ts
+++ b/web/src/lib/aeRoles.ts
@@ -53,7 +53,7 @@ export const AE_ROLES_SETTINGS = {
 export const AE_PRESET_LIMIT = 30;
 /** The list view shows a search box past this many presets. */
 export const AE_PRESET_SEARCH_FROM = 8;
-/** Alt 1 to Alt 9 follow list order (the key binding is not wired yet). */
+/** Alt 1 to Alt 9 in the composer pick presets in list order. */
 export const AE_PRESET_SHORTCUTS = 9;
 export const AE_AUTO_RAISES_MAX = 3;
 export const AE_PRESET_TITLE_MAX = 40;
@@ -417,3 +417,43 @@ export function aeDropPreset<T extends AeRolesDoc>(doc: T, id: string, overId: s
     moved.pinned === over.pinned ? doc : aeReplacePreset(doc, { ...moved, pinned: over.pinned });
   return aeNormalizeOrder(aeMovePreset(repinned, id, index));
 }
+
+// ---------------------------------------------------------------------------
+// Settings > Roles' collapsed row
+
+/** Width of one icon chip in the collapsed row plus the gap after it, in px. */
+export const AE_ROW_ICON_PX = 34;
+/** Width of the "+N" button plus its gap, in px. */
+export const AE_ROW_MORE_PX = 42;
+
+/**
+ * The collapsed row's order: the open preset, then the default, then pinned
+ * presets, then the rest in list order.
+ */
+export function aeRowOrder(
+  presets: readonly AeRolePreset[],
+  openId: string,
+  defaultId: string,
+): AeRolePreset[] {
+  const rank = (p: AeRolePreset) =>
+    p.id === openId ? 0 : p.id === defaultId ? 1 : p.pinned ? 2 : 3;
+  return presets
+    .map((p, i) => ({ p, i }))
+    .sort((a, b) => rank(a.p) - rank(b.p) || a.i - b.i)
+    .map(({ p }) => p);
+}
+
+/**
+ * How many icon chips fit beside the open preset in `width` px, where `fixed`
+ * is what the open chip and the new-preset button already take. Every icon
+ * shows when all fit; otherwise room is kept for "+N". A width of 0 (not
+ * measured yet) shows none.
+ */
+export function aeRowIconCount(width: number, fixed: number, icons: number): number {
+  if (width <= 0 || icons <= 0) return 0;
+  if (fixed + icons * AE_ROW_ICON_PX <= width) return icons;
+  return Math.max(
+    0,
+    Math.min(icons, Math.floor((width - fixed - AE_ROW_MORE_PX) / AE_ROW_ICON_PX)),
+  );
+}
