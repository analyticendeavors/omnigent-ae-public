From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Wed, 21 Oct 2026 23:04:00 -0700
Subject: [PATCH 154/220] [ae-patch] Keep the waiting line's state word on a
 phone

At 390 px the dock's waiting line showed only the number and the icon: the detail is hidden on a phone beside a button that names the state (Merge, Mark ready), but a waiting line usually has no button, so "checks 11/12" vanished. Found in the PR 240 live check, 2026-10-22.
---
 web/src/components/AeActionDock.test.tsx | 3 +++
 web/src/components/AeActionDock.tsx      | 6 +++++-
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/web/src/components/AeActionDock.test.tsx b/web/src/components/AeActionDock.test.tsx
index aadb27921f260783bbc53058c3ccd2f979ede6d9..6c0f3addac764e1f7e78f3608ccc4dd5d7b930e8 100644
--- a/web/src/components/AeActionDock.test.tsx
+++ b/web/src/components/AeActionDock.test.tsx
@@ -385,6 +385,9 @@ describe("AeActionDock", () => {
     await waitFor(() =>
       expect(screen.getByTestId("ae-dock-lead").textContent).toContain("checks 11/12"),
     );
+    // No button names the state, so a phone keeps the word.
+    const word = screen.getByTestId("ae-dock-lead").querySelector("[data-ae-lead-text]");
+    expect(word).not.toHaveClass("hidden");
     expect(screen.queryByTestId("ae-dock-merge")).toBeNull();
     expect(screen.queryByTestId("ae-dock-update")).toBeNull();
     serve({ 180: card(180) });
diff --git a/web/src/components/AeActionDock.tsx b/web/src/components/AeActionDock.tsx
index 383b77c15520e8fb79051ca98bbaa7aea783e884..04b1b9845672b97366299af41f848c11d9f97abd 100644
--- a/web/src/components/AeActionDock.tsx
+++ b/web/src/components/AeActionDock.tsx
@@ -162,8 +162,12 @@ function ItemBody({ item, now, expanded }: { item: AeDockItem; now: number; expa
           #{item.number}
         </a>
       </AePrLinkHoverCard>
+      {/* A phone drops the detail beside a button that names the state; a waiting line has no such button. */}
       <span
-        className={cn("min-w-0 truncate text-muted-foreground", !expanded && "hidden md:inline")}
+        className={cn(
+          "min-w-0 truncate text-muted-foreground",
+          !expanded && item.kind !== "waiting" && "hidden md:inline",
+        )}
         title={detail}
         data-ae-lead-text=""
       >
