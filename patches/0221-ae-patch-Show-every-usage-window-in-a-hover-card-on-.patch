+import { describe, expect, it } from "vitest";
+import type { AeLimitWindow } from "@/components/AePlanLimits";
+import type { AeLimitGate } from "./aeLimitGate";
+import { aeLimitHoverRows, aeLimitLevel } from "./aeLimitHover";
+
+const RESET = "2026-10-30T09:00:00Z";
+
+function win(id: string, label: string, used: number, minutes: number | null): AeLimitWindow {
+  return { id, label, used_percent: used, resets_at: RESET, window_minutes: minutes };
+}
+
+const GATE: AeLimitGate = {
+  harness: "claude",
+  account: null,
+  label: "AE Default",
+  windowId: "seven_day",
+  windowKey: "claude||seven_day",
+  span: "weekly",
+  percent: 91,
+  resetsAt: RESET,
+};
+
+const WINDOWS = [
+  win("seven_day_sonnet", "Weekly, Sonnet", 42, 10080),
+  win("seven_day_opus", "Weekly, Opus", 94, 10080),
+  win("seven_day", "Weekly, all models", 91, 10080),
+  win("five_hour", "5-hour", 37.6, 300),
+];
+
+describe("aeLimitLevel", () => {
+  it("is red from 90, amber from 70, green below", () => {
+    expect([69, 70, 89, 90].map(aeLimitLevel)).toEqual(["ok", "mid", "mid", "warn"]);
+  });
+});
+
+describe("aeLimitHoverRows", () => {
+  it("puts the 5-hour and all-models weekly rows first, then the rest fullest first", () => {
+    const rows = aeLimitHoverRows(WINDOWS, GATE);
+    expect(rows.map((r) => r.id)).toEqual([
+      "five_hour",
+      "seven_day",
+      "seven_day_opus",
+      "seven_day_sonnet",
+    ]);
+  });
+
+  it("reads Weekly, X as Weekly · X, rounds, and marks the gate's own window", () => {
+    const rows = aeLimitHoverRows(WINDOWS, GATE);
+    expect(rows.map((r) => r.label)).toEqual([
+      "5-hour",
+      "Weekly · all models",
+      "Weekly · Opus",
+      "Weekly · Sonnet",
+    ]);
+    expect(rows[0]!.percent).toBe(38);
+    expect(rows.filter((r) => r.isGate).map((r) => r.id)).toEqual(["seven_day"]);
+    expect(rows.map((r) => r.level)).toEqual(["ok", "warn", "warn", "ok"]);
+  });
+
+  it("drops a window with no usable percentage and answers [] for none", () => {
+    const bad = { ...win("x", "Weekly, X", Number.NaN, 10080) };
+    expect(aeLimitHoverRows([bad], GATE)).toEqual([]);
+    expect(aeLimitHoverRows([], GATE)).toEqual([]);
+  });
+});
diff --git a/web/src/lib/aeLimitHover.ts b/web/src/lib/aeLimitHover.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2bfcb792bec9a235d82aa9cc8e7c7ac67dd6002b
--- /dev/null
+++ b/web/src/lib/aeLimitHover.ts
@@ -0,0 +1,60 @@
+// The rows of the action dock's limit hover card: every window on the chat's
+// login, headline windows first, then the per-model weekly rows. omnigent-ae,
+// 2026-10-28.
+
+import type { AeLimitWindow } from "@/components/AePlanLimits";
+import { AE_LIMIT_GATE_PERCENT, type AeLimitGate, aeHeadlineWindows } from "@/lib/aeLimitGate";
+
+/** Where the bar's colour changes: red at the gate's own threshold, amber from 70. */
+const AMBER_PERCENT = 70;
+
+export type AeLimitLevel = "warn" | "mid" | "ok";
+
+export interface AeLimitHoverRow {
+  id: string;
+  /** "5-hour", "Weekly · all models", "Weekly · Sonnet". */
+  label: string;
+  /** Whole percent, as the usage popover rounds it. */
+  percent: number;
+  resetsAt: string | null;
+  /** The window that raised the dock's warning. */
+  isGate: boolean;
+  level: AeLimitLevel;
+}
+
+export function aeLimitLevel(percent: number): AeLimitLevel {
+  if (percent >= AE_LIMIT_GATE_PERCENT) return "warn";
+  return percent >= AMBER_PERCENT ? "mid" : "ok";
+}
+
+/** The server labels a weekly row "Weekly, Sonnet"; the popover reads "Weekly · Sonnet". */
+function rowLabel(w: AeLimitWindow): string {
+  return w.label.replace(/^(Weekly), /, "$1 · ");
+}
+
+/**
+ * The 5-hour window, the all-models weekly window, then every other window
+ * fullest first. Windows with no usable percentage are left out.
+ */
+export function aeLimitHoverRows(
+  windows: readonly AeLimitWindow[],
+  gate: AeLimitGate,
+): AeLimitHoverRow[] {
+  const usable = windows.filter((w) => Number.isFinite(w.used_percent));
+  const { five, week } = aeHeadlineWindows(usable);
+  const head = [five, week].filter((w): w is AeLimitWindow => w !== null);
+  const rest = usable
+    .filter((w) => !head.includes(w))
+    .sort((a, b) => b.used_percent - a.used_percent);
+  return [...head, ...rest].map((w) => {
+    const percent = Math.round(w.used_percent);
+    return {
+      id: w.id,
+      label: rowLabel(w),
+      percent,
+      resetsAt: w.resets_at,
+      isGate: w.id === gate.windowId,
+      level: aeLimitLevel(percent),
+    };
+  });
+}
