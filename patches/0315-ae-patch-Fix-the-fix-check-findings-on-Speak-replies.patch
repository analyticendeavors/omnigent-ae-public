+  it("speaks a code block phrase once when a streamed message is finalized", () => {
+    mount();
+    const text = "Run this:\n\n```ps\nInvoke\n```\n";
+    setStore({ blocks: [live("r1", text)] });
+    flush();
+    setStore({ blocks: [final("r1", "m1", "Run this:\n\n```ps\nInvoke\n```")] });
+    flush();
+    expect(
+      synth
+        .texts()
