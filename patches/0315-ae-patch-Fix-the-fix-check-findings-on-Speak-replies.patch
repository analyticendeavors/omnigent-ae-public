+    ).toHaveLength(1);
+  });
+
+  it("speaks a second code block after a different sentence", () => {
+    mount();
+    setStore({
+      blocks: [final("r1", "m1", "One.\n\n```a\nx\n```\n\nTwo.\n\n```b\ny\n```")],
+    });
+    flush();
+    expect(
+      synth
+        .texts()
+        .join(" ")
+        .match(/Code block skipped/g),
+    ).toHaveLength(2);
+  });
+
+  it("speaks a code block in a second message of the same turn", () => {
+    mount();
