+    const m2 = final("r1", "m2", "Beta.\n\n```b\ny\n```");
+    setStore({ blocks: [m1] });
+    flush();
+    setStore({ blocks: [m1, m2] });
+    flush();
+    expect(
+      synth
+        .texts()
+        .join(" ")
+        .match(/Code block skipped/g),
