+import { describe, expect, it } from "vitest";
+import { AE_TIME_COLUMN } from "@/lib/aeFamilyBadge";
+import {
+  AE_LEAD_ACTIONS_OVERLAY,
+  AE_LEAD_CHEVRON_SLOT,
