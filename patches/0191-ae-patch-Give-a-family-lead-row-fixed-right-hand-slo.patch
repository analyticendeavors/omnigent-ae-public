+    useMoveToProject: () => ({ mutate: vi.fn() }),
+    useTogglePinnedConversation: () => ({ mutate: vi.fn(), mutateAsync: vi.fn() }),
+    useArchiveConversation: () => ({ mutate: mocks.archiveOne }),
+    useBulkArchiveConversations: () => ({
+      mutate: mocks.archiveMany,
