+});
+vi.mock("@/hooks/aeSessionActivityHooks", async (importOriginal) => ({
+  ...(await importOriginal<typeof ActivityHooksModule>()),
+  useAeSessionRowState: (c: { id: string }) => ({
+    state: mocks.states.get(c.id) ?? null,
