From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Wed, 28 Oct 2026 13:26:48 -0700
Subject: [PATCH 224/260] [ae-patch] Start an extension page below the native
 shell's shifted header band

---
 web/src/index.css                    | 10 ++++++++++
 web/src/lib/aeExtensionInset.test.ts | 18 ++++++++++++++++++
 2 files changed, 28 insertions(+)
 create mode 100644 web/src/lib/aeExtensionInset.test.ts

diff --git a/web/src/index.css b/web/src/index.css
index 6dddeba92abd46db3c3c339dd1f0c0cae6f9431a..cfe2c36fedddf11ffde365319724306be46b43bd 100644
--- a/web/src/index.css
+++ b/web/src/index.css
@@ -2413,6 +2413,16 @@ main[data-shell-header="hidden"] .extension-view-host {
   padding-top: 0;
 }
 
+/* Native shells float the header at safe-top minus 0.5rem, so an extension
+ * page must start below that band or the header covers its top controls. */
+@media (width < 48rem) {
+  :is([data-ios-native], [data-android-native])
+    main[data-shell-header="visible"]
+    .extension-view-host {
+    padding-top: calc(var(--omnigent-header-height) + max(0px, var(--omnigent-safe-top) - 0.5rem));
+  }
+}
+
 main[data-shell-header="hidden"] .extension-view-status {
   top: 0;
 }
diff --git a/web/src/lib/aeExtensionInset.test.ts b/web/src/lib/aeExtensionInset.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..32812d55b8825b190733bb322b0bf6fbc1d5c0f7
--- /dev/null
+++ b/web/src/lib/aeExtensionInset.test.ts
@@ -0,0 +1,18 @@
+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+import { describe, expect, it } from "vitest";
+
+const css = readFileSync(resolve(__dirname, "../index.css"), "utf8");
+
+describe("extension page inset in native phone shells", () => {
+  // jsdom computes no layout, so this pins the rule that moves the page below
+  // the header band, which a native shell floats at safe-top minus 0.5rem.
+  it("starts the page below the shifted header band", () => {
+    const rule = css.match(
+      /@media \(width < 48rem\) \{\s*:is\(\[data-ios-native\], \[data-android-native\]\)\s*main\[data-shell-header="visible"\]\s*\.extension-view-host \{([^}]*)\}/,
+    );
+    expect(rule).not.toBeNull();
+    expect(rule![1]).toContain("var(--omnigent-header-height)");
+    expect(rule![1]).toContain("var(--omnigent-safe-top) - 0.5rem");
+  });
+});
