+      "1 more claimed a slot a moment ago.",
+    ]);
+    expect(parsed.tail).toHaveLength(3);
+    expect(parsed.park.endsWith("tha....")).toBe(true);
+  });
+
+  it("returns null for block-mode and unrelated text", () => {
