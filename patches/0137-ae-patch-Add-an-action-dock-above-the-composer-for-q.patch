+      [10, "live"],
+    ]);
+    const later = aeDockDeploys(prs, deploys, track, dismissed, NOW - 10_000 + AE_DOCK_LIVE_MS);
+    expect(later.map((item) => item.number)).toEqual([9]);
+  });
+});
+
+function sample(): AeDockItem[] {
