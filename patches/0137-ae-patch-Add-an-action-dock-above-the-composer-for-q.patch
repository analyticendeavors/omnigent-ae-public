+    expect(aeDeployText(item({ mid_turn: 1 }), NOW, clock)).toBe(
+      "merged 4m ago · deploy waits on 1 busy session",
+    );
+    expect(
+      aeDeployText(
+        item({ mid_turn: 3, hold_until: "2026-10-21T05:50:00Z", hold_by: "reid@x.com" }),
+        NOW,
