@@ -0,0 +1,158 @@
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { AeClaudeAccountSubmenu } from "./AeClaudeAccountSubmenu";
+import { DropdownMenu, DropdownMenuContent } from "@/components/ui/dropdown-menu";
+import type { Host } from "@/hooks/useHosts";
+import { dismissAeMoveAll } from "@/lib/aeMoveAllChats";
+
+vi.mock("@/lib/identity", () => ({ authenticatedFetch: vi.fn() }));
+import { authenticatedFetch } from "@/lib/identity";
+
+const mutate = vi.fn();
+let rows: { family: string; source: string; env_var: string }[] = [];
+let labels: Record<string, string> = {};
+vi.mock("@/hooks/useHosts", () => ({
+  useDetectedCredentials: () => ({ data: rows, isError: false, isSuccess: true }),
+  useStoreCredential: () => ({ mutate, isPending: false }),
+}));
+vi.mock("@/hooks/useSession", () => ({
+  useSession: () => ({ session: { id: "s1", hostId: "host", labels }, isLoading: false }),
+}));
+
+const host = { host_id: "host", name: "Laptop" } as Host;
+const json = (body: unknown, status = 200) =>
+  Promise.resolve(new Response(JSON.stringify(body), { status }));
+
+let qc: QueryClient;
+
+function renderMenu(turnBusy = false, sessionId = "s1") {
+  qc = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  render(
+    <QueryClientProvider client={qc}>
+      <DropdownMenu open>
+        <DropdownMenuContent>
+          <AeClaudeAccountSubmenu host={host} sessionId={sessionId} turnBusy={turnBusy} />
+        </DropdownMenuContent>
+      </DropdownMenu>
+    </QueryClientProvider>,
+  );
+  fireEvent.keyDown(screen.getByTestId("composer-claude-account"), { key: "ArrowRight" });
+}
+
+beforeEach(() => {
+  mutate.mockReset();
+  vi.mocked(authenticatedFetch).mockReset();
+  dismissAeMoveAll();
+  labels = { "ae.claude_account": "AE Backup" };
+  rows = [
+    { family: "claude-oauth-active", source: "AE Default", env_var: "" },
+    { family: "claude-oauth", source: "AE Backup", env_var: "AE Backup" },
+  ];
+});
+
+describe("Account submenu inside a chat", () => {
+  it("has a This chat group ticked by the live label and a New chats group below it", () => {
+    renderMenu();
+    expect(screen.getByTestId("composer-claude-account-chat")).toHaveTextContent("This chat");
+    expect(screen.getByTestId("composer-claude-account-new")).toHaveTextContent("New chats");
+    const backup = screen.getByTestId("composer-claude-account-chat-AE Backup");
+    expect(backup).toHaveAttribute("role", "menuitemradio");
+    expect(backup).toHaveAttribute("aria-checked", "true");
+    expect(screen.getByTestId("composer-claude-account-chat-default")).toHaveAttribute(
+      "aria-checked",
+      "false",
+    );
+    // The new-chat rows are the host default (the active row), a separate list.
+    expect(screen.getByTestId("composer-claude-account-default")).toHaveAttribute(
+      "aria-checked",
+      "true",
+    );
+    expect(screen.getByTestId("composer-claude-account-value")).toHaveTextContent("AE Backup");
+  });
+
+  it("the server label outranks the live label", () => {
+    labels = { "omnigent.claude_native.account": "", "ae.claude_account": "AE Backup" };
+    renderMenu();
+    expect(screen.getByTestId("composer-claude-account-chat-default")).toHaveAttribute(
+      "aria-checked",
+      "true",
+    );
+  });
+
+  it("picking a login calls the PUT, then re-reads the chat and its Usage", async () => {
+    vi.mocked(authenticatedFetch).mockImplementation(() => json({ account: "", relaunched: true }));
+    renderMenu();
+    const invalidate = vi.spyOn(qc, "invalidateQueries");
+    fireEvent.click(screen.getByTestId("composer-claude-account-chat-default"));
+    await waitFor(() =>
+      expect(authenticatedFetch).toHaveBeenCalledWith(
+        "/v1/ae/sessions/s1/claude-account",
+        expect.objectContaining({ method: "PUT", body: JSON.stringify({ account: "" }) }),
+      ),
+    );
+    await waitFor(() => {
+      expect(invalidate).toHaveBeenCalledWith({ queryKey: ["session", "s1"] });
+      expect(invalidate).toHaveBeenCalledWith({ queryKey: ["ae-limits", "s1"] });
+    });
+  });
+
+  it("names a removed login as unavailable, never as the host's active one", () => {
+    labels = { "omnigent.claude_native.account": "Gone" };
+    renderMenu();
+    const value = screen.getByTestId("composer-claude-account-value");
+    expect(value).toHaveTextContent("Gone (unavailable)");
+    expect(value).not.toHaveTextContent("AE Default");
+    expect(screen.getByTestId("composer-claude-account-unavailable")).toHaveClass(
+      "text-destructive",
+    );
+  });
+
+  it("gives a new chat's temp id no This chat group and shows the new-chat default", () => {
+    renderMenu(false, "temp:new-1");
+    expect(screen.queryByTestId("composer-claude-account-chat")).toBeNull();
+    expect(screen.queryByTestId("composer-claude-account-new")).toBeNull();
+    expect(screen.getByTestId("composer-claude-account-value")).toHaveTextContent("AE Default");
+  });
+
+  it("shows the server's refusal under the rows", async () => {
+    vi.mocked(authenticatedFetch).mockImplementation(() =>
+      json({ error: { message: "Claude is mid-reply or waiting on an approval." } }, 409),
+    );
+    renderMenu();
+    fireEvent.click(screen.getByTestId("composer-claude-account-chat-default"));
+    expect(await screen.findByTestId("composer-claude-account-chat-error")).toHaveTextContent(
+      "mid-reply",
+    );
+  });
+
+  it("is disabled with the reason while a reply runs", () => {
+    renderMenu(true);
+    const row = screen.getByTestId("composer-claude-account-chat-default");
+    expect(row).toHaveAttribute("aria-disabled", "true");
+    expect(screen.getByTestId("composer-claude-account-chat-busy")).toHaveTextContent(
+      "Claude is replying",
+    );
+    fireEvent.click(row);
+    expect(authenticatedFetch).not.toHaveBeenCalled();
+  });
+
+  it("hides This chat for a chat on provider credentials", () => {
+    rows = [...rows, { family: "claude-provider-env", source: "Gateway", env_var: "X" }];
+    renderMenu();
+    expect(screen.queryByTestId("composer-claude-account-chat")).toBeNull();
+    expect(screen.queryByTestId("composer-claude-account-new")).toBeNull();
+  });
+
+  it("picking a new-chat default asks whether to move every open chat", () => {
+    mutate.mockImplementation((_input: unknown, options: { onSuccess?: () => void }) =>
+      options.onSuccess?.(),
+    );
+    renderMenu();
+    fireEvent.click(screen.getByTestId("composer-claude-account-AE Backup"));
+    expect(mutate).toHaveBeenCalledWith(
+      { harness: "claude-native", kind: "claude-oauth-select", account_name: "AE Backup" },
+      expect.anything(),
+    );
+  });
+});
diff --git a/web/src/shell/AeSessionClaudeAccountGroup.tsx b/web/src/shell/AeSessionClaudeAccountGroup.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..189fe5044174fa278d998ac82148ff77a6cf12ef
--- /dev/null
+++ b/web/src/shell/AeSessionClaudeAccountGroup.tsx
@@ -0,0 +1,129 @@
+// The "This chat" group of the composer's Account submenu (omnigent-ae,
+// 2026-10-27): the Claude login this chat runs on, ticked, and a pick restarts
+// the chat on that login (`PUT /v1/ae/sessions/{id}/claude-account`). A pick is
+// refused while a reply runs, or when the server says no; the reason shows
+// under the rows. The "New chats" heading below it belongs to the same split.
+
+import {
+  DropdownMenuLabel,
+  DropdownMenuRadioGroup,
+  DropdownMenuRadioItem,
+  DropdownMenuSeparator,
+} from "@/components/ui/dropdown-menu";
+import { useAeSwitchClaudeAccount } from "@/hooks/useAeSwitchClaudeAccount";
+import type { DetectedCredential } from "@/hooks/useHosts";
+import { useSession } from "@/hooks/useSession";
+import {
+  AE_NEW_CHATS_HEADING,
+  AE_THIS_CHAT_BUSY_HINT,
+  AE_THIS_CHAT_HEADING,
+  AE_THIS_CHAT_HINT,
+  aeChatAccount,
+} from "@/lib/aeClaudeAccount";
+import { AE_MENU_NOTE_CLASS } from "@/lib/aeMenuRow";
+import { AeSharedAccountMarker, aeIsSharedAccount } from "@/lib/aeSharedClaudeAccounts";
+import { cn } from "@/lib/utils";
+
+// Radix radio values are never empty here: "" is the default login's id.
+const DEFAULT_VALUE = "__default__";
+const UNKNOWN_VALUE = "__unknown__";
+const toValue = (account: string) => (account === "" ? DEFAULT_VALUE : account);
+
+const RADIO_ROW_CLASS =
+  "min-h-8 pr-2! pl-7! whitespace-normal break-words [&>[data-slot=dropdown-menu-radio-item-indicator]]:right-auto [&>[data-slot=dropdown-menu-radio-item-indicator]]:left-1.5";
+
+/**
+ * The login name the trigger shows for this chat, or `fallback` while it is
+ * unknown. A login the host no longer lists shows as unavailable, never as the
+ * host's active one.
+ */
+export function AeChatAccountName({
+  sessionId,
+  rows,
+  fallback,
+}: {
+  sessionId: string;
+  rows: readonly DetectedCredential[];
+  fallback: string;
+}) {
+  const { session } = useSession(sessionId);
+  const account = aeChatAccount(session?.labels);
+  if (account === undefined) return fallback;
+  const row = rows.find((r) => (r.env_var ?? "") === account);
+  if (row) return row.source;
+  const name = account === "" ? "Default login" : account.replace(/^shared:/, "");
+  return (
+    <span className="text-destructive" data-testid="composer-claude-account-unavailable">
+      {name} (unavailable)
+    </span>
+  );
+}
+
+export function AeThisChatAccounts({
+  sessionId,
+  rows,
+  turnBusy,
+}: {
+  sessionId: string;
+  rows: readonly DetectedCredential[];
+  /** A reply is running, so the chat cannot restart. */
+  turnBusy: boolean;
+}) {
+  const { session } = useSession(sessionId);
+  const change = useAeSwitchClaudeAccount(sessionId);
+  const current = aeChatAccount(session?.labels);
+  const disabled = turnBusy || change.isPending;
+  return (
+    <>
+      <DropdownMenuLabel className="px-2 py-1 text-xs" data-testid="composer-claude-account-chat">
+        {AE_THIS_CHAT_HEADING}
+      </DropdownMenuLabel>
+      <DropdownMenuRadioGroup
+        value={current === undefined ? UNKNOWN_VALUE : toValue(current)}
+        aria-label={AE_THIS_CHAT_HEADING}
+      >
+        {rows.map((row) => {
+          const accountId = row.env_var ?? "";
+          return (
+            <DropdownMenuRadioItem
+              key={accountId}
+              value={toValue(accountId)}
+              disabled={disabled}
+              title={turnBusy ? AE_THIS_CHAT_BUSY_HINT : AE_THIS_CHAT_HINT}
+              className={cn(RADIO_ROW_CLASS, "flex items-center gap-2")}
+              onSelect={(event) => {
+                event.preventDefault();
+                if (accountId !== current) change.mutate(accountId);
+              }}
+              data-testid={`composer-claude-account-chat-${accountId || "default"}`}
+            >
+              <span className="min-w-0 flex-1 truncate">{row.source}</span>
+              {aeIsSharedAccount(accountId) && <AeSharedAccountMarker />}
+            </DropdownMenuRadioItem>
+          );
+        })}
+      </DropdownMenuRadioGroup>
+      {turnBusy && (
+        <p
+          className={cn(AE_MENU_NOTE_CLASS, "px-2 py-1 text-xs text-muted-foreground")}
+          data-testid="composer-claude-account-chat-busy"
+        >
+          {AE_THIS_CHAT_BUSY_HINT}
+        </p>
+      )}
+      {change.error && (
+        <p
+          role="alert"
+          className={cn(AE_MENU_NOTE_CLASS, "px-2 py-1 text-xs text-destructive")}
+          data-testid="composer-claude-account-chat-error"
+        >
+          {change.error.message}
+        </p>
+      )}
+      <DropdownMenuSeparator />
+      <DropdownMenuLabel className="px-2 py-1 text-xs" data-testid="composer-claude-account-new">
+        {AE_NEW_CHATS_HEADING}
+      </DropdownMenuLabel>
+    </>
+  );
+}
