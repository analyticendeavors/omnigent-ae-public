+    expect(aeNextProgress(progress, "c")).toEqual(LINE);
+    expect(aeNextProgress(progress, "other")).toBeUndefined();
+    expect(aeNextProgress({ type: "tool_result" } as StreamEvent, "c")).toBeNull();
+    expect(
