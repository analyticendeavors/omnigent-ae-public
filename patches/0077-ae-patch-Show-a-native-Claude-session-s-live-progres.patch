+    :param tokens: Token text, e.g. ``"24.5k tokens"``.
+    """
+
+    type: Literal["session.progress"]
+    conversation_id: str
+    label: str | None = None
+    elapsed: str | None = None
+    elapsed_s: int | None = None
+    tokens: str | None = None
+
