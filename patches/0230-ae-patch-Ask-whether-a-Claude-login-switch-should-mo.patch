diff --git a/web/src/shell/AeSwitchFamilyDialog.test.tsx b/web/src/shell/AeSwitchFamilyDialog.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..83be2de654473f0c118894a66591d9d0b9264d1e
--- /dev/null
+++ b/web/src/shell/AeSwitchFamilyDialog.test.tsx
@@ -0,0 +1,140 @@
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { act, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { AeSwitchFamilyDialog } from "./AeSwitchFamilyDialog";
+import { askAeSwitchFamily, dismissAeSwitchFamily } from "@/lib/aeSwitchFamily";
+
+vi.mock("@/lib/identity", () => ({ authenticatedFetch: vi.fn() }));
+vi.mock("@/components/ui/toast", () => ({ showToast: vi.fn() }));
+import { showToast } from "@/components/ui/toast";
+import { authenticatedFetch } from "@/lib/identity";
+
+const json = (body: unknown, status = 200) =>
+  Promise.resolve(new Response(JSON.stringify(body), { status }));
+
+beforeEach(() => {
+  vi.mocked(authenticatedFetch).mockReset();
+  vi.mocked(showToast).mockReset();
+});
+afterEach(() => act(() => dismissAeSwitchFamily()));
+
+let queryClient: QueryClient;
+
+function ask(childCount = 3) {
+  queryClient = new QueryClient();
+  render(
+    <QueryClientProvider client={queryClient}>
+      <AeSwitchFamilyDialog />
+    </QueryClientProvider>,
+  );
+  act(() =>
+    askAeSwitchFamily({ sessionId: "s1", account: "shared:Backup", label: "Backup", childCount }),
+  );
+}
+
+describe("AeSwitchFamilyDialog", () => {
+  it("asks with the child count and the login, Parent and children first and focused", async () => {
+    ask();
+    expect(await screen.findByText("Switch the child chats too?")).toBeTruthy();
+    expect(
+      screen.getByText(/This chat has 3 child chats\. Each moved chat restarts on Backup/),
+    ).toBeTruthy();
+    expect(screen.getByText(/skipped and listed so you can retry it/)).toBeTruthy();
+    const both = screen.getByTestId("ae-switch-family-both");
+    const parent = screen.getByTestId("ae-switch-family-parent");
+    expect(both.textContent).toBe("Parent and children");
+    expect(parent.textContent).toBe("Parent only");
+    // DOM order is the tab order: the primary action comes first.
+    expect(both.compareDocumentPosition(parent) & Node.DOCUMENT_POSITION_FOLLOWING).toBeTruthy();
+    await waitFor(() => expect(document.activeElement).toBe(both));
+    expect(both.getAttribute("title")).toBe("Restart this chat and its 3 child chats on Backup");
+    expect(parent.getAttribute("title")).toBe(
+      "Only this chat moves; its children finish on the login they have",
+    );
+  });
+
+  it("says child chat for one", async () => {
+    ask(1);
+    expect(await screen.findByText(/This chat has 1 child chat\. Each/)).toBeTruthy();
+  });
+
+  it("Parent and children sends include_children and keeps a skip on screen", async () => {
+    vi.mocked(authenticatedFetch).mockImplementation(() =>
+      json({
+        account: "shared:Backup",
+        relaunched: true,
+        children: {
+          moved: [{ id: "c1", title: "Builder" }],
+          skipped: [{ id: "c2", title: "Reviewer", reason: "mid-reply" }],
+          pending: [],
+        },
+      }),
+    );
+    ask();
+    const invalidate = vi.spyOn(queryClient, "invalidateQueries");
+    fireEvent.click(await screen.findByTestId("ae-switch-family-both"));
+    await waitFor(() =>
+      expect(authenticatedFetch).toHaveBeenCalledWith(
+        "/v1/ae/sessions/s1/claude-account",
+        expect.objectContaining({
+          method: "PUT",
+          body: JSON.stringify({ account: "shared:Backup", include_children: true }),
+        }),
+      ),
+    );
+    await waitFor(() =>
+      expect(showToast).toHaveBeenCalledWith(
+        "This chat now runs on Backup; 1 child chat moved; 1 skipped: Reviewer is mid-reply",
+        { duration: 0 },
+      ),
+    );
+    expect(invalidate).toHaveBeenCalledWith({ queryKey: ["session", "c1"] });
+    await waitFor(() => expect(screen.queryByTestId("ae-switch-family-dialog")).toBeNull());
+  });
+
+  it("a clean family toast uses the default duration", async () => {
+    vi.mocked(authenticatedFetch).mockImplementation(() =>
+      json({
+        account: "shared:Backup",
+        relaunched: true,
+        children: { moved: [{ id: "c1", title: "Builder" }], skipped: [], pending: [] },
+      }),
+    );
+    ask();
+    fireEvent.click(await screen.findByTestId("ae-switch-family-both"));
+    await waitFor(() =>
+      expect(showToast).toHaveBeenCalledWith(
+        "This chat now runs on Backup; 1 child chat moved",
+        undefined,
+      ),
+    );
+  });
+
+  it("Parent only sends the plain body, with no include_children", async () => {
+    vi.mocked(authenticatedFetch).mockImplementation(() =>
+      json({ account: "shared:Backup", relaunched: true }),
+    );
+    ask();
+    fireEvent.click(await screen.findByTestId("ae-switch-family-parent"));
+    await waitFor(() =>
+      expect(authenticatedFetch).toHaveBeenCalledWith(
+        "/v1/ae/sessions/s1/claude-account",
+        expect.objectContaining({ body: JSON.stringify({ account: "shared:Backup" }) }),
+      ),
+    );
+    await waitFor(() =>
+      expect(showToast).toHaveBeenCalledWith("This chat now runs on Backup.", undefined),
+    );
+  });
+
+  it("shows the server's refusal as a toast", async () => {
+    vi.mocked(authenticatedFetch).mockImplementation(() =>
+      json({ error: { message: "Claude is mid-reply or waiting on an approval." } }, 409),
+    );
+    ask();
+    fireEvent.click(await screen.findByTestId("ae-switch-family-both"));
+    await waitFor(() =>
+      expect(showToast).toHaveBeenCalledWith("Claude is mid-reply or waiting on an approval."),
+    );
+  });
+});
diff --git a/web/src/shell/AeSwitchFamilyDialog.tsx b/web/src/shell/AeSwitchFamilyDialog.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..2d6ec51d9de5242aa59f07109bec05175f794f33
--- /dev/null
+++ b/web/src/shell/AeSwitchFamilyDialog.tsx
@@ -0,0 +1,92 @@
+// "Switch the child chats too?" (omnigent-ae, 2026-10-28). Shown when a chat that has
+// child chats is moved to another Claude login; mounted once in the app shell.
+// "Parent and children" holds the initial focus, so Enter moves the whole family.
+
+import { useQueryClient } from "@tanstack/react-query";
+import { useRef } from "react";
+import { Button } from "@/components/ui/button";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/components/ui/dialog";
+import { showToast } from "@/components/ui/toast";
+import {
+  aeRefreshChatAccount,
+  aeSwitchSummary,
+  aeSwitchedChildIds,
+  putAeClaudeAccount,
+} from "@/lib/aeClaudeAccount";
+import { dismissAeSwitchFamily, useAeSwitchFamilyRequest } from "@/lib/aeSwitchFamily";
+
+export function AeSwitchFamilyDialog() {
+  const request = useAeSwitchFamilyRequest();
+  const queryClient = useQueryClient();
+  const bothRef = useRef<HTMLButtonElement>(null);
+  const count = request?.childCount ?? 0;
+  const chats = `${count} child ${count === 1 ? "chat" : "chats"}`;
+  const run = (includeChildren: boolean) => {
+    if (!request) return;
+    const { sessionId, account, label } = request;
+    dismissAeSwitchFamily();
+    // Not the mutation hook: it reads its session id from the request, which is gone by now.
+    putAeClaudeAccount(sessionId, account, includeChildren).then(
+      (answer) => {
+        for (const id of [sessionId, ...aeSwitchedChildIds(answer)]) {
+          aeRefreshChatAccount(queryClient, id);
+        }
+        const kids = answer.children;
+        // A skipped or slow child stays on screen until dismissed, so it can be retried.
+        const lingers = kids && (kids.skipped.length > 0 || kids.pending.length > 0);
+        showToast(aeSwitchSummary(label, answer), lingers ? { duration: 0 } : undefined);
+      },
+      (failure: unknown) => {
+        aeRefreshChatAccount(queryClient, sessionId);
+        showToast(failure instanceof Error ? failure.message : "Could not switch the login.");
+      },
+    );
+  };
+  return (
+    <Dialog open={request !== null} onOpenChange={(open) => !open && dismissAeSwitchFamily()}>
+      <DialogContent
+        data-testid="ae-switch-family-dialog"
+        onOpenAutoFocus={(event) => {
+          event.preventDefault();
+          bothRef.current?.focus();
+        }}
+      >
+        <DialogHeader>
+          <DialogTitle>Switch the child chats too?</DialogTitle>
+          <DialogDescription>
+            This chat has {chats}. Each moved chat restarts on {request?.label} and re-reads its
+            conversation (extra tokens). A child that is mid-reply or waiting on an approval is
+            skipped and listed so you can retry it.
+          </DialogDescription>
+        </DialogHeader>
+        <DialogFooter>
+          <Button
+            ref={bothRef}
+            type="button"
+            onClick={() => run(true)}
+            title={`Restart this chat and its ${chats} on ${request?.label}`}
+            data-testid="ae-switch-family-both"
+          >
+            Parent and children
+          </Button>
+          <Button
+            type="button"
+            variant="outline"
+            onClick={() => run(false)}
+            title="Only this chat moves; its children finish on the login they have"
+            data-testid="ae-switch-family-parent"
+          >
+            Parent only
+          </Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+}
