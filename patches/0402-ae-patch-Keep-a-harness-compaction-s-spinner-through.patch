+    const bubbles = buildBubbles(blocks, useChatStore.getState().activeResponse);
+    expect(bubbles.some((b) => b.kind === "compaction_loading")).toBe(false);
+    expect(bubbles.some((b) => b.kind === "compaction")).toBe(true);
