 2 files changed, 21 insertions(+), 2 deletions(-)

diff --git a/web/src/components/AeContextCategories.test.tsx b/web/src/components/AeContextCategories.test.tsx
index 9057935bde047f7fbafe25167527f83d39861c5b..c6178768c3d2da532d1357e098930b8aae9e9590 100644
