From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ae-automation-bot <bot@example.invalid>
Date: Fri, 13 Nov 2026 09:45:13 -0800
Subject: [PATCH 370/443] [ae-patch] Send a PostToolUse allow's ae_note line to
 the native harness as additional context

A policy that allows a tool result with data {ae_note: line} now reaches Claude Code and Codex as hookSpecificOutput.additionalContext through the shared hook converter, which the claude-native relay, the Codex hook and the other native hooks all call. The tool output is never rewritten.
---
 omnigent/native/native_policy_hook.py         | 11 +++++
 .../test_claude_native_bridge.py              | 29 ++++++++++++
 .../codex_native/test_codex_native_hook.py    | 35 +++++++++++++++
 tests/test_native_policy_hook.py              | 44 +++++++++++++++++++
 4 files changed, 119 insertions(+)

diff --git a/omnigent/native/native_policy_hook.py b/omnigent/native/native_policy_hook.py
index 6e5b193ce35fbd7f2f7d89e3a3cfe080beae66c8..6392de053777c8cace41bf74f40921fdca15afc3 100644
--- a/omnigent/native/native_policy_hook.py
+++ b/omnigent/native/native_policy_hook.py
@@ -512,6 +512,17 @@ def evaluation_response_to_hook_output(
                     "additionalContext": f"[Policy violation] {reason}",
                 },
             }
+        # An ALLOW whose data is ``{"ae_note": <line>}`` asks for one line of context after
+        # the result (the Decision-1 nudge); the tool output itself is never rewritten here.
+        data = eval_response.get("data")
+        note = data.get("ae_note") if isinstance(data, dict) else None
+        if action == "POLICY_ACTION_ALLOW" and isinstance(note, str) and note.strip():
+            return {
+                "hookSpecificOutput": {
+                    "hookEventName": _POST_TOOL_USE,
+                    "additionalContext": note.strip(),
+                },
+            }
         return None
 
     return None
