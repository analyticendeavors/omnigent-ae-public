From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Tue, 17 Nov 2026 22:52:48 -0800
Subject: [PATCH 391/443] [ae-patch] The new chat composer hides its mic and
 roles preset on a narrow phone so the Start button stays inside the card

The landing composer's action row never applied the tight tiers the in-session composer uses (aeComposerTight), so on a 390 px phone the voice start button and its menu, the mic and the roles preset overflowed the card and the Start button poked past its right edge. Wrap the roles preset in COMPOSER_TIGHTER_WRAPPER_CLASS and give the mic COMPOSER_TIGHT_MIC_CLASS, as ChatPage does.
---
 web/src/shell/NewChatDialog.tsx | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/web/src/shell/NewChatDialog.tsx b/web/src/shell/NewChatDialog.tsx
index fb107f47cec31e00480c7c7be84a9c94c22afd0e..547d5558cc08a8232eb24d1d48f530982349263b 100644
--- a/web/src/shell/NewChatDialog.tsx
+++ b/web/src/shell/NewChatDialog.tsx
@@ -339,6 +339,7 @@ import { SkillPills } from "@/components/SkillPills";
 import { ComposerMicButton } from "@/components/ComposerMicButton";
 import { AeVoicePanel } from "@/components/AeVoicePanel";
 import { AeVoiceStartButton } from "@/components/AeVoiceStartButton";
+import { COMPOSER_TIGHT_MIC_CLASS, COMPOSER_TIGHTER_WRAPPER_CLASS } from "@/lib/aeComposerTight";
 import { useAeVoiceStart } from "@/hooks/useAeVoiceStart";
 import { type AeMicController, setVoiceOn, takeVoiceArm } from "@/lib/aeVoiceMode";
 import type { CostControlMode } from "@/components/CostRoutingControl";
@@ -7023,7 +7024,9 @@ export function NewChatLandingScreen() {
                 ),
                 trailing: (
                   <>
-                    <AeSessionPresetPill sessionId={null} disabled={creating} />
+                    <span className={COMPOSER_TIGHTER_WRAPPER_CLASS}>
+                      <AeSessionPresetPill sessionId={null} disabled={creating} />
+                    </span>
                     <div className="flex min-w-0 items-center rounded-lg">
                       {/* One trigger combines the harness glyph with model / effort;
                     the selected entry's submenu owns run configuration. */}
@@ -7087,7 +7090,7 @@ export function NewChatLandingScreen() {
                       className="size-8 md:size-7"
                     />
                     <ComposerMicButton
-                      className="size-8 md:size-7"
+                      className={cn("size-8 md:size-7", COMPOSER_TIGHT_MIC_CLASS)}
                       enableHotkey
                       controller={newChatMic}
                       onListeningChange={voiceStart.onListening}
