 web/src/components/composer/ComposerContextRing.test.tsx | 6 ++----
 web/src/components/composer/ComposerContextRing.tsx      | 2 +-
 web/src/components/ui/tooltip.tsx                        | 2 +-
 3 files changed, 4 insertions(+), 6 deletions(-)

