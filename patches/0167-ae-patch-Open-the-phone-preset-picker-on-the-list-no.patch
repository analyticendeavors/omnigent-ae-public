From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Fri, 23 Oct 2026 19:27:12 -0700
Subject: [PATCH 167/202] [ae-patch] Open the phone preset picker on the list,
 not the search box

---
 web/src/components/AeTeamControl.test.tsx     | 28 +++++++++++++++++++
 .../composer/AeSessionPresetPill.tsx          | 10 +++++++
 2 files changed, 38 insertions(+)

diff --git a/web/src/components/AeTeamControl.test.tsx b/web/src/components/AeTeamControl.test.tsx
index c1ccb4d30c783a7505666c6bdae2d8de23eacdac..3129b19760f4d05ce38a1e57e79e9fbc84ebe991 100644
--- a/web/src/components/AeTeamControl.test.tsx
+++ b/web/src/components/AeTeamControl.test.tsx
@@ -18,6 +18,7 @@ import type { Session } from "@/lib/types";
 import { AeTeamControl, AeTeamEditor, SessionTeamControl } from "./AeTeamControl";
 
 const mocks = vi.hoisted(() => ({
+  mobile: vi.fn(() => false),
   agents: vi.fn(),
   hosts: vi.fn(),
   models: vi.fn(),
@@ -50,6 +51,7 @@ vi.mock("@/lib/aeTeam", async (original) => ({
 // Change lead opens AppShell's fork dialog; the control renders without AppShell here.
 const forkDialog = vi.hoisted(() => ({ canFork: true, openForkDialog: vi.fn() }));
 vi.mock("@/shell/ForkDialogContext", () => ({ useForkDialog: () => forkDialog }));
+vi.mock("@/hooks/useIsMobileViewport", () => ({ useIsMobileViewport: () => mocks.mobile() }));
 vi.mock("@/hooks/useAvailableAgents", () => ({ useAvailableAgents: mocks.agents }));
 vi.mock("@/hooks/useHosts", () => ({ useHosts: mocks.hosts, useHostModelOptions: mocks.models }));
 
@@ -188,6 +190,7 @@ const saveButton = () => screen.getByRole("button", { name: "Save selection" });
 
 beforeEach(() => {
   vi.resetAllMocks();
+  mocks.mobile.mockReturnValue(false);
   mocks.agents.mockReturnValue({ data: agents, isLoading: false, isError: false });
   mocks.hosts.mockReturnValue({ data: [host] });
   mocks.models.mockReturnValue({ data: [{ id: "test-model", displayName: "Available model" }] });
@@ -877,6 +880,31 @@ describe("composer preset pill states", () => {
     expect(screen.getByText("Lead / orchestrator")).toBeInTheDocument();
   });
 
+  it("opens the phone sheet on the list, not in the search box", async () => {
+    mocks.mobile.mockReturnValue(true);
+    mocks.roles.mockReturnValue({ data: ROLES });
+    renderPill();
+    fireEvent.click(screen.getByRole("button", { name: /Roles preset: / }));
+    const menu = await screen.findByTestId("ae-preset-menu");
+    const search = screen.getByRole("searchbox", { name: "Search presets" });
+    await waitFor(() => expect(menu).toContainElement(document.activeElement as HTMLElement));
+    expect(document.activeElement).toBe(menu);
+    expect(document.activeElement).not.toBe(search);
+    // A tap on the box still focuses it.
+    search.focus();
+    expect(document.activeElement).toBe(search);
+  });
+
+  it("leaves the desktop menu's focus behaviour alone", async () => {
+    mocks.roles.mockReturnValue({ data: ROLES });
+    renderPill();
+    fireEvent.click(screen.getByRole("button", { name: /Roles preset: / }));
+    const menu = await screen.findByTestId("ae-preset-menu");
+    const search = screen.getByRole("searchbox", { name: "Search presets" });
+    await waitFor(() => expect(menu).toContainElement(document.activeElement as HTMLElement));
+    expect(document.activeElement).toBe(search);
+  });
+
   it("disables adding and removing sessions in the menu while a turn runs", () => {
     mocks.roles.mockReturnValue({ data: ROLES });
     renderPill({ working: true }, sessionWithTeam([memberFor(claude, { sessionId: "kid" })]));
diff --git a/web/src/components/composer/AeSessionPresetPill.tsx b/web/src/components/composer/AeSessionPresetPill.tsx
index 93cd8f83fc837401f472665eefa1c4e51f6d5906..3e127c0f636a1ca544c00cf3c24d3c714d2c4371 100644
--- a/web/src/components/composer/AeSessionPresetPill.tsx
+++ b/web/src/components/composer/AeSessionPresetPill.tsx
@@ -329,6 +329,16 @@ export function AeSessionPresetPill({
           <DialogContent
             showCloseButton={false}
             data-testid="ae-preset-menu"
+            // Radix would focus the first field, the search box, and the phone
+            // keyboard would cover the list. Focus the sheet itself instead
+            // (it takes focus, tabIndex -1) so the focus trap and screen
+            // readers still work; the keyboard waits for a tap on the box.
+            onOpenAutoFocus={(event) => {
+              event.preventDefault();
+              if (event.currentTarget instanceof HTMLElement) {
+                event.currentTarget.focus({ preventScroll: true });
+              }
+            }}
             className="top-auto bottom-0 left-0 flex max-w-full translate-x-0 translate-y-0 flex-col gap-1 rounded-t-2xl rounded-b-none p-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] sm:max-w-full"
             style={{ top: "auto", maxHeight: "85dvh" }}
           >
