From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Wed, 28 Oct 2026 23:37:34 -0700
Subject: [PATCH 242/260] [ae-patch] Accept both check-in prompt wordings in
 the relay

A scheduled check-in stored before the wording changed still names a person where the new text says the person; the relay now matches either, so those tasks keep posting straight into their session.
---
 omnigent/server/scheduled/checkin_relay.py   | 2 +-
 tests/server/scheduled/test_checkin_relay.py | 8 ++++++++
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/omnigent/server/scheduled/checkin_relay.py b/omnigent/server/scheduled/checkin_relay.py
index 0d4f606911e74185e57f9ada25be906c6f654beb..766c1df35cf5d4fd3cf248e87ebabd62a7ebce78 100644
--- a/omnigent/server/scheduled/checkin_relay.py
+++ b/omnigent/server/scheduled/checkin_relay.py
@@ -26,7 +26,7 @@ _MINT_TTL_S = 300
 _POST_TIMEOUT_S = 30.0
 _PROMPT = re.compile(
     r"^Scheduled orchestrator check-in\.(?: Focus: (?P<note>.*?))?"
-    r" Hand it to the orchestrator session the person talks to: call post_message once"
+    r" Hand it to the orchestrator session (?:the person|\w+) talks to: call post_message once"
     r" with session_id (?P<session_id>\S+) and the text ",
     re.DOTALL,
 )
diff --git a/tests/server/scheduled/test_checkin_relay.py b/tests/server/scheduled/test_checkin_relay.py
index 9558cd882dfb9a0544f5be6cdab6f8e1555eaa3f..22e87164d6c2a5e10a6f2a7d47e131c37ae2b88e 100644
--- a/tests/server/scheduled/test_checkin_relay.py
+++ b/tests/server/scheduled/test_checkin_relay.py
@@ -30,6 +30,8 @@ PLAIN = (
     "Then stop. Only if that call fails, run the check-in yourself as your "
     "instructions describe."
 )
+# Check-in tasks stored before 2026-10-28 name a person where the new wording says "the person".
+LEGACY = PLAIN.replace("the person", "Re" + "id")
 FOCUS = PLAIN.replace("check-in. Hand", "check-in. Focus: PASS 2026 deck redesign Hand")
 
 
@@ -140,3 +142,9 @@ async def test_poster_sends_a_user_message_to_the_events_route_as_the_owner() ->
     assert (session_id, auth) == (SESSION, "Bearer tok-owner")
     assert body["type"] == "message"
     assert body["data"]["content"][0]["text"] == CHECKIN_TEXT
+
+
+def test_parse_checkin_reads_both_wordings() -> None:
+    assert parse_checkin(PLAIN) == (SESSION, CHECKIN_TEXT)
+    assert parse_checkin(LEGACY) == (SESSION, CHECKIN_TEXT)
+    assert parse_checkin(PLAIN.replace("session the person", "session")) is None
