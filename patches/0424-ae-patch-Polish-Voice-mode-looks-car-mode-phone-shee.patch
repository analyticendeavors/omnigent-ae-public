index 0000000000000000000000000000000000000000..14637cf0fe6c48a53989b30943321cc49a559916
--- /dev/null
+++ b/web/src/lib/aeVoiceKeys.test.ts
@@ -0,0 +1,68 @@
+import { afterEach, describe, expect, it } from "vitest";
+import { overlayIsOpen, voiceKeyAction, type VoiceKeyContext } from "./aeVoiceKeys";
+
+const base: VoiceKeyContext = {
+  voiceOn: true,
+  sheet: false,
+  phase: "listening",
+  busy: false,
+  overlayOpen: false,
+};
+const key = (k: string, extra: Record<string, boolean> = {}) => ({
+  key: k,
+  repeat: false,
+  metaKey: false,
+  ctrlKey: false,
+  altKey: false,
+  shiftKey: false,
+  ...extra,
+});
+
+afterEach(() => {
+  document.body.innerHTML = "";
+});
+
+describe("voiceKeyAction", () => {
+  it("Enter sends while listening", () => {
+    expect(voiceKeyAction(key("Enter"), base)).toBe("send");
+    expect(voiceKeyAction(key("Enter", { shiftKey: true }), base)).toBeNull();
+    expect(voiceKeyAction(key("Enter"), { ...base, phase: "speaking" })).toBeNull();
+  });
+
+  it.each(["listening", "speaking"] as const)("Esc ends Voice mode while %s", (phase) => {
+    expect(voiceKeyAction(key("Escape"), { ...base, phase })).toBe("end");
+  });
+
+  it.each(["thinking", "paused", "starting", "unavailable"] as const)(
+    "Esc does nothing while %s",
+    (phase) => {
+      expect(voiceKeyAction(key("Escape"), { ...base, phase })).toBeNull();
+    },
+  );
+
+  it("Esc does nothing when Voice mode is off (dictation discard stays)", () => {
+    expect(voiceKeyAction(key("Escape"), { ...base, voiceOn: false })).toBeNull();
+  });
+
+  it("Esc does nothing while the chat is working or a menu or the /btw overlay is open", () => {
+    expect(voiceKeyAction(key("Escape"), { ...base, busy: true })).toBeNull();
+  });
+
+  it("Esc does nothing with a dialog, menu or listbox open", () => {
+    expect(voiceKeyAction(key("Escape"), { ...base, overlayOpen: true })).toBeNull();
+    expect(overlayIsOpen()).toBe(false);
+    document.body.innerHTML = '<div role="dialog"></div>';
+    expect(overlayIsOpen()).toBe(true);
+  });
+
+  it("the phone sheet has no key change", () => {
+    expect(voiceKeyAction(key("Escape"), { ...base, sheet: true })).toBeNull();
+    expect(voiceKeyAction(key("Enter"), { ...base, sheet: true })).toBeNull();
+  });
+
+  it("ignores chords, repeats and IME composition", () => {
+    expect(voiceKeyAction(key("Escape", { ctrlKey: true }), base)).toBeNull();
+    expect(voiceKeyAction(key("Escape", { repeat: true }), base)).toBeNull();
+    expect(voiceKeyAction({ ...key("Enter"), isComposing: true }, base)).toBeNull();
+  });
+});
diff --git a/web/src/lib/aeVoiceKeys.ts b/web/src/lib/aeVoiceKeys.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4dc5c85d577ad862d8b6f9fb3e5cff326f3f9cc6
--- /dev/null
+++ b/web/src/lib/aeVoiceKeys.ts
@@ -0,0 +1,46 @@
+// Desktop Voice mode keys (omnigent-ae, 2026-11-19): Enter sends the heard draft, Esc ends Voice
+// mode while listening or speaking. Escape keeps its other jobs: it stops a working chat, closes
+// a dialog, menu or the /btw overlay, and (Voice mode off) discards a dictation take.
+
+import type { VoicePhase } from "@/lib/aeVoiceMode";
+
+export interface VoiceKeyContext {
+  voiceOn: boolean;
+  /** The phone sheet has no key hints and no Escape change. */
+  sheet: boolean;
+  phase: VoicePhase;
+  /** The chat is working, read-only, or a /btw, slash or mention menu is open. */
+  busy: boolean;
+  /** A dialog, menu or listbox is open in the document. */
+  overlayOpen: boolean;
+}
+
+export type VoiceKeyAction = "send" | "end" | null;
+
+const OVERLAY_SELECTOR = '[role="dialog"], [role="menu"], [role="listbox"]';
+
+/** True when a dialog, menu or listbox is open. */
+export function overlayIsOpen(doc: Document = document): boolean {
+  return doc.querySelector(OVERLAY_SELECTOR) !== null;
+}
+
+/** What a key press does in Voice mode, or null to leave it to the other handlers. */
+export function voiceKeyAction(
+  e: Pick<KeyboardEvent, "key" | "repeat" | "metaKey" | "ctrlKey" | "altKey" | "shiftKey"> & {
+    isComposing?: boolean;
+  },
+  ctx: VoiceKeyContext,
+): VoiceKeyAction {
+  if (!ctx.voiceOn || ctx.sheet || e.repeat || e.metaKey || e.ctrlKey || e.altKey) return null;
+  if (e.isComposing) return null;
+  if (e.key === "Enter" && !e.shiftKey && ctx.phase === "listening") return "send";
+  if (
+    e.key === "Escape" &&
+    (ctx.phase === "listening" || ctx.phase === "speaking") &&
+    !ctx.busy &&
+    !ctx.overlayOpen
+  ) {
+    return "end";
+  }
+  return null;
+}
