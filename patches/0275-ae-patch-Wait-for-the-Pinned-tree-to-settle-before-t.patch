From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Sat, 31 Oct 2026 15:29:35 -0700
Subject: [PATCH 275/333] [ae-patch] Wait for the Pinned tree to settle before
 the fold test asserts

The fold test ran right after the drag test. dnd-kit swallows document
clicks for 50 ms after a drag ends, so under load the chevron click was
lost. The drag helper now waits that window out.
---
 web/src/shell/Sidebar.aePinnedFamilies.test.tsx | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/web/src/shell/Sidebar.aePinnedFamilies.test.tsx b/web/src/shell/Sidebar.aePinnedFamilies.test.tsx
index 6ecb58e6a0caad5bf0691e2300e63241ddbecf21..39f411e791d3b4ecee581a886062f05e6515ac82 100644
--- a/web/src/shell/Sidebar.aePinnedFamilies.test.tsx
+++ b/web/src/shell/Sidebar.aePinnedFamilies.test.tsx
@@ -58,6 +58,7 @@ vi.mock("@/components/PermissionsModal", () => ({ PermissionsModal: () => null }
 import { useConversations } from "@/hooks/useConversations";
 
 const ROW_HEIGHT = 30;
+const DND_CLICK_GUARD_MS = 60;
 const pin = (value: number, extra: Record<string, string> = {}) => ({
   labels: { "omnigent.pinned": String(value), ...extra },
 });
@@ -120,6 +121,13 @@ async function drag(sourceId: string, targetId: string) {
   await act(async () => {
     fireEvent.mouseUp(document, target);
   });
+  // dnd-kit keeps a document click guard for 50 ms after a drag ends; wait it out so
+  // the next click, even in the next test, is not swallowed.
+  await act(async () => {
+    await new Promise<void>((resolve) => {
+      setTimeout(resolve, DND_CLICK_GUARD_MS);
+    });
+  });
   return insertion;
 }
 
