+import { fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+  AE_SUGGESTION_KEYS_STORAGE_KEY,
+  readAeSuggestionKeys,
+  writeAeSuggestionKey,
+} from "@/lib/aeSuggestionKeys";
+import { AeSuggestionKeysSetting } from "./AeSuggestionKeysSetting";
+
+afterEach(() => {
+  writeAeSuggestionKey("next", null);
+  writeAeSuggestionKey("previous", null);
+});
+
+const caps = (action: string) =>
+  Array.from(screen.getByTestId(`ae-suggestion-key-${action}`).querySelectorAll("kbd")).map(
+    (k) => k.textContent,
+  );
+
+describe("AeSuggestionKeysSetting", () => {
+  it("shows Alt+] and Alt+[ by default, with no Reset", () => {
+    render(<AeSuggestionKeysSetting />);
+    expect(caps("next")).toEqual(["Alt", "]"]);
+    expect(caps("previous")).toEqual(["Alt", "["]);
+    expect(screen.queryByTestId("ae-suggestion-key-next-reset")).toBeNull();
+  });
+
+  it("records the next combo pressed after Change, saves it, and Reset puts the default back", () => {
+    render(<AeSuggestionKeysSetting />);
+    const change = screen.getByTestId("ae-suggestion-key-next-change");
+    fireEvent.click(change);
+    expect(change).toHaveTextContent("Cancel");
+    // A modifier alone is still waiting for its key.
+    fireEvent.keyDown(change, { key: "Control", code: "ControlLeft", ctrlKey: true });
+    expect(change).toHaveTextContent("Cancel");
+    fireEvent.keyDown(change, { key: "j", code: "KeyJ", ctrlKey: true });
+    expect(caps("next")).toEqual(["Ctrl", "J"]);
+    expect(readAeSuggestionKeys().next).toMatchObject({ code: "KeyJ", ctrl: true, alt: false });
+    expect(window.localStorage.getItem(AE_SUGGESTION_KEYS_STORAGE_KEY)).toContain("KeyJ");
+
+    fireEvent.click(screen.getByTestId("ae-suggestion-key-next-reset"));
+    expect(caps("next")).toEqual(["Alt", "]"]);
+    expect(window.localStorage.getItem(AE_SUGGESTION_KEYS_STORAGE_KEY)).toBeNull();
+  });
+
+  it("refuses a bare key, the other action's combo and an app hotkey, and keeps listening", () => {
+    render(<AeSuggestionKeysSetting />);
+    const change = screen.getByTestId("ae-suggestion-key-next-change");
+    fireEvent.click(change);
+    fireEvent.keyDown(change, { key: "j", code: "KeyJ" });
+    expect(screen.getByRole("alert")).toHaveTextContent("would type into the box");
+    fireEvent.keyDown(change, { key: "[", code: "BracketLeft", altKey: true });
+    expect(screen.getByRole("alert")).toHaveTextContent("previous suggestion");
+    fireEvent.keyDown(change, { key: "]", code: "BracketRight", ctrlKey: true });
+    expect(screen.getByRole("alert")).toHaveTextContent("switch sessions");
+    expect(change).toHaveTextContent("Cancel");
+    expect(readAeSuggestionKeys().next).toMatchObject({ code: "BracketRight", alt: true });
+  });
+
+  it("blocks Ctrl+Alt+V (voice dictation) on save, and the press reaches no app hotkey", () => {
+    const appHotkey = vi.fn();
+    window.addEventListener("keydown", appHotkey);
+    render(<AeSuggestionKeysSetting />);
+    const change = screen.getByTestId("ae-suggestion-key-next-change");
+    fireEvent.click(change);
+    fireEvent.keyDown(document.body, { key: "v", code: "KeyV", ctrlKey: true, altKey: true });
+    window.removeEventListener("keydown", appHotkey);
+    expect(screen.getByRole("alert")).toHaveTextContent("Already used");
+    expect(appHotkey).not.toHaveBeenCalled();
+    expect(readAeSuggestionKeys().next).toMatchObject({ code: "BracketRight", alt: true });
+  });
+
+  it("hears the combo with focus elsewhere (Safari leaves a clicked button unfocused)", () => {
+    render(<AeSuggestionKeysSetting />);
+    fireEvent.click(screen.getByTestId("ae-suggestion-key-next-change"));
+    fireEvent.keyDown(document.body, { key: "j", code: "KeyJ", ctrlKey: true });
+    expect(caps("next")).toEqual(["Ctrl", "J"]);
+  });
+
+  it("a click elsewhere cancels", () => {
+    render(<AeSuggestionKeysSetting />);
+    const change = screen.getByTestId("ae-suggestion-key-next-change");
+    fireEvent.click(change);
+    fireEvent.pointerDown(document.body);
+    expect(change).toHaveTextContent("Change");
+  });
+
+  it("Esc cancels without saving", () => {
+    render(<AeSuggestionKeysSetting />);
+    const change = screen.getByTestId("ae-suggestion-key-previous-change");
+    fireEvent.click(change);
+    fireEvent.keyDown(change, { key: "Escape", code: "Escape" });
+    expect(change).toHaveTextContent("Change");
+    expect(caps("previous")).toEqual(["Alt", "["]);
+  });
+});
diff --git a/web/src/pages/settings/AeSuggestionKeysSetting.tsx b/web/src/pages/settings/AeSuggestionKeysSetting.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..7d6d0a199168cc8126ce20d78a9b2ed542818c03
--- /dev/null
+++ b/web/src/pages/settings/AeSuggestionKeysSetting.tsx
@@ -0,0 +1,141 @@
+// Settings > Chat: the keys that step through the composer's suggestion
+// alternatives. Change records the next key combo pressed anywhere on the page
+// (Safari does not focus a clicked button, so the button cannot listen); Esc or
+// clicking elsewhere cancels. Saved in this browser (lib/aeSuggestionKeys.ts).
+
+import { useEffect, useId, useRef, useState } from "react";
+import { Kbd } from "@/components/KeyboardShortcut";
+import { Button } from "@/components/ui/button";
+import {
+  AE_DEFAULT_SUGGESTION_KEYS,
+  aeChordFromEvent,
+  aeChordKeys,
+  aeChordProblem,
+  aeSameChord,
+  readAeSuggestionKeys,
+  useAeSuggestionKeys,
+  writeAeSuggestionKey,
+  type AeSuggestionKeyAction,
+} from "@/lib/aeSuggestionKeys";
+
+const ROWS: { action: AeSuggestionKeyAction; label: string }[] = [
+  { action: "next", label: "Next suggestion" },
+  { action: "previous", label: "Previous suggestion" },
+];
+
+function KeyRow({ action, label }: { action: AeSuggestionKeyAction; label: string }) {
+  const keys = useAeSuggestionKeys();
+  const [recording, setRecording] = useState(false);
+  const [problem, setProblem] = useState<string | null>(null);
+  const chord = keys[action];
+  const isDefault = aeSameChord(chord, AE_DEFAULT_SUGGESTION_KEYS[action]);
+
+  const buttonRef = useRef<HTMLButtonElement>(null);
+
+  const stop = () => {
+    setRecording(false);
+    setProblem(null);
+  };
+
+  useEffect(() => {
+    if (!recording) return;
+    const done = () => {
+      setRecording(false);
+      setProblem(null);
+    };
+    // Capture phase on the window: the combo reaches no app hotkey while recording.
+    const onKeyDown = (event: KeyboardEvent) => {
+      event.preventDefault();
+      event.stopPropagation();
+      if (event.key === "Escape" && !event.altKey && !event.ctrlKey && !event.metaKey) {
+        done();
+        return;
+      }
+      const pressed = aeChordFromEvent(event);
+      if (!pressed) return;
+      const why = aeChordProblem(pressed, action, readAeSuggestionKeys());
+      if (why) {
+        setProblem(why);
+        return;
+      }
+      writeAeSuggestionKey(action, pressed);
+      done();
+    };
+    const onPointerDown = (event: PointerEvent) => {
+      if (!buttonRef.current?.contains(event.target as Node)) done();
+    };
+    window.addEventListener("keydown", onKeyDown, true);
+    window.addEventListener("pointerdown", onPointerDown, true);
+    return () => {
+      window.removeEventListener("keydown", onKeyDown, true);
+      window.removeEventListener("pointerdown", onPointerDown, true);
+    };
+  }, [recording, action]);
+
+  return (
+    <div className="flex flex-col gap-1">
+      <div className="flex items-center justify-between gap-3">
+        <span className="text-ui">{label}</span>
+        <div className="flex items-center gap-2">
+          {recording ? (
+            <span className="text-ui text-muted-foreground">Press a key combo, Esc to cancel</span>
+          ) : (
+            <span className="flex items-center gap-1" data-testid={`ae-suggestion-key-${action}`}>
+              {aeChordKeys(chord).map((key) => (
+                <Kbd key={key}>{key}</Kbd>
+              ))}
+            </span>
+          )}
+          <Button
+            type="button"
+            size="sm"
+            variant="outline"
+            aria-pressed={recording}
+            data-testid={`ae-suggestion-key-${action}-change`}
+            ref={buttonRef}
+            componentId={`settings.chat.ae_suggestion_key_${action}`}
+            onClick={() => (recording ? stop() : setRecording(true))}
+          >
+            {recording ? "Cancel" : "Change"}
+          </Button>
+          {!isDefault && !recording && (
+            <Button
+              type="button"
+              size="sm"
+              variant="ghost"
+              data-testid={`ae-suggestion-key-${action}-reset`}
+              onClick={() => writeAeSuggestionKey(action, null)}
+            >
+              Reset
+            </Button>
+          )}
+        </div>
+      </div>
+      {problem && (
+        <span role="alert" className="text-ui text-destructive">
+          {problem}
+        </span>
+      )}
+    </div>
+  );
+}
+
+export function AeSuggestionKeysSetting() {
+  const labelId = useId();
+  return (
+    <div className="flex flex-col gap-3" aria-labelledby={labelId} role="group">
+      <div className="flex min-w-0 flex-col">
+        <span id={labelId} className="text-ui font-medium">
+          Suggestion keys
+        </span>
+        <span className="text-ui text-muted-foreground">
+          When the composer offers more than one suggestion, these keys step through them; Tab still
+          takes the one shown. Saved in this browser.
+        </span>
+      </div>
+      {ROWS.map((row) => (
+        <KeyRow key={row.action} {...row} />
+      ))}
+    </div>
+  );
+}
