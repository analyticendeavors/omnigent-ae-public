+# Who resolved a card, as the web client names it in ``_meta.source`` (see
+# web/src/lib/aeApprovalSource.ts). Only these reach the log; anything else is "unknown".
+KNOWN_RESOLVE_SOURCES: frozenset[str] = frozenset(
