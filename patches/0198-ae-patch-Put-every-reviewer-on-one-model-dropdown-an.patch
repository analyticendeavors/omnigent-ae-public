@@ -0,0 +1,190 @@
+import { describe, expect, it } from "vitest";
+import {
+  aeCodexDefaultEffort,
+  aeCodexOtherModels,
+  aeCodexEfforts,
+  aeCodexName,
+  aeCompareGeneration,
+  aeLatestCodexModels,
+  aeNewCodexReviewerModel,
+} from "./aeCodexModels";
+import type { NativeModelOption } from "./types";
+
+const levels = (...names: string[]) => names.map((reasoningEffort) => ({ reasoningEffort }));
+const FIVE = levels("low", "medium", "high", "xhigh", "max");
+const SIX = levels("low", "medium", "high", "xhigh", "max", "ultra");
+
+function row(
+  displayName: string,
+  supported = FIVE,
+  defaultReasoningEffort = "medium",
+): NativeModelOption {
+  return {
+    id: displayName.toLowerCase(),
+    model: displayName.toLowerCase(),
+    displayName,
+    supportedReasoningEfforts: supported,
+    defaultReasoningEffort,
+  } as NativeModelOption;
+}
+
+// The host's real list, in its order.
+const HOST = [
+  row("GPT-6-Astra", SIX),
+  row("GPT-6-Sol", SIX),
+  row("GPT-6-Luna"),
+  row("GPT-5.6-Sol", SIX, "low"),
+  row("GPT-5.6-Terra", SIX),
+  row("GPT-5.6-Luna"),
+];
+
+describe("aeCodexName", () => {
+  it("reads the generation and the family from a display name", () => {
+    expect(aeCodexName("GPT-6-Sol")).toEqual({ family: "sol", generation: [6] });
+    expect(aeCodexName("GPT-5.6-Terra")).toEqual({ family: "terra", generation: [5, 6] });
+  });
+
+  it("gives null when either part is missing", () => {
+    expect(aeCodexName("GPT-6")).toBeNull();
+    expect(aeCodexName("Sol")).toBeNull();
+    expect(aeCodexName("")).toBeNull();
+    expect(aeCodexName(undefined)).toBeNull();
+  });
+});
+
+describe("aeCompareGeneration", () => {
+  it("compares part by part, so 5.6 is older than 6 and newer than 5", () => {
+    expect(aeCompareGeneration([5, 6], [6])).toBeLessThan(0);
+    expect(aeCompareGeneration([5, 6], [5])).toBeGreaterThan(0);
+    expect(aeCompareGeneration([6], [6, 0])).toBe(0);
+    expect(aeCompareGeneration([5, 10], [5, 9])).toBeGreaterThan(0);
+  });
+});
+
+describe("aeLatestCodexModels", () => {
+  it("keeps the three families with the newest version, newest of each", () => {
+    expect(aeLatestCodexModels(HOST).map((r) => r.displayName)).toEqual([
+      "GPT-6-Astra",
+      "GPT-6-Sol",
+      "GPT-6-Luna",
+    ]);
+  });
+
+  it("is computed from the names, not fixed to any", () => {
+    const next = [row("GPT-7-Sol", SIX), ...HOST, row("GPT-7-Terra")];
+    expect(aeLatestCodexModels(next).map((r) => r.displayName)).toEqual([
+      "GPT-7-Sol",
+      "GPT-7-Terra",
+      "GPT-6-Astra",
+    ]);
+  });
+
+  it("takes the older generation of a family when the newer one is missing from the list", () => {
+    const rows = [row("GPT-6-Sol", SIX), row("GPT-5.6-Terra"), row("GPT-5.6-Luna")];
+    expect(aeLatestCodexModels(rows).map((r) => r.displayName)).toEqual([
+      "GPT-6-Sol",
+      "GPT-5.6-Terra",
+      "GPT-5.6-Luna",
+    ]);
+  });
+
+  it("lists fewer than three when the host has fewer families", () => {
+    expect(aeLatestCodexModels([row("GPT-6-Sol"), row("GPT-5-Sol")])).toHaveLength(1);
+  });
+
+  it("drops names that do not parse while others do", () => {
+    const rows = [row("Mystery"), row("GPT-6-Sol")];
+    expect(aeLatestCodexModels(rows).map((r) => r.displayName)).toEqual(["GPT-6-Sol"]);
+  });
+
+  it("lists every model when no name parses", () => {
+    const rows = [row("alpha"), row("beta"), row("gamma"), row("delta")];
+    expect(aeLatestCodexModels(rows)).toEqual(rows);
+    expect(aeLatestCodexModels([])).toEqual([]);
+  });
+});
+
+describe("aeNewCodexReviewerModel", () => {
+  it("is Sol of the newest generation", () => {
+    expect(aeNewCodexReviewerModel(HOST)?.displayName).toBe("GPT-6-Sol");
+  });
+
+  it("falls back to the first listed when there is no Sol", () => {
+    expect(aeNewCodexReviewerModel([row("GPT-6-Astra"), row("GPT-6-Luna")])?.displayName).toBe(
+      "GPT-6-Astra",
+    );
+    expect(aeNewCodexReviewerModel([])).toBeNull();
+  });
+});
+
+describe("Codex efforts", () => {
+  it("lists the levels a preset can store, in bar order", () => {
+    expect(aeCodexEfforts(HOST[2])).toEqual(["low", "medium", "high", "xhigh", "max"]);
+    expect(aeCodexEfforts(null)).toEqual([]);
+  });
+
+  it("lists ultra last for a model that offers it", () => {
+    expect(aeCodexEfforts(HOST[1])).toEqual(["low", "medium", "high", "xhigh", "max", "ultra"]);
+  });
+
+  it("opens on ultra when that is the model's default", () => {
+    expect(aeCodexDefaultEffort(row("GPT-6-Sol", SIX, "ultra"))).toBe("ultra");
+  });
+
+  it("uses the model's default, else medium, else its first level", () => {
+    expect(aeCodexDefaultEffort(HOST[3])).toBe("low");
+    expect(aeCodexDefaultEffort(row("GPT-6-Sol", FIVE, "ultra"))).toBe("medium");
+    expect(aeCodexDefaultEffort(row("GPT-6-Sol", levels("high", "max"), "ultra"))).toBe("high");
+    expect(aeCodexDefaultEffort(null)).toBe("medium");
+  });
+});
+
+describe("mixed catalogs", () => {
+  const MIXED = [...HOST, row("GPT-5.6-Codex-Max"), row("GPT-5.6-Max"), row("Mystery")];
+
+  it("keeps the latest three to the named families when two or more parse", () => {
+    expect(aeLatestCodexModels(MIXED).map((r) => r.displayName)).toEqual([
+      "GPT-6-Astra",
+      "GPT-6-Sol",
+      "GPT-6-Luna",
+    ]);
+  });
+
+  it("keeps models that do not parse, and other families, reachable after the latest three", () => {
+    expect(aeCodexOtherModels(MIXED).map((r) => r.displayName)).toEqual([
+      "GPT-5.6-Codex-Max",
+      "GPT-5.6-Max",
+      "Mystery",
+    ]);
+    expect(aeCodexOtherModels(HOST)).toEqual([]);
+  });
+
+  it("never shares a family between Codex-Max and Max", () => {
+    expect(aeCodexName("GPT-5.6-Codex-Max")?.family).toBe("codex-max");
+    expect(aeCodexName("GPT-5.6-Max")?.family).toBe("max");
+  });
+
+  it("falls back to every parsed family when fewer than two named ones exist", () => {
+    const rows = [row("GPT-7-Max"), row("GPT-6-Sol"), row("GPT-5-Codex-Max")];
+    expect(aeLatestCodexModels(rows).map((r) => r.displayName)).toEqual([
+      "GPT-7-Max",
+      "GPT-6-Sol",
+      "GPT-5-Codex-Max",
+    ]);
+  });
+
+  it("starts a new reviewer on the newest Sol anywhere in the list, even beyond the latest three", () => {
+    const rows = [
+      row("GPT-7-Astra"),
+      row("GPT-7-Luna"),
+      row("GPT-7-Terra"),
+      row("GPT-6-Sol"),
+      row("GPT-5-Sol"),
+    ];
+    expect(aeLatestCodexModels(rows).map((r) => r.displayName)).not.toContain("GPT-6-Sol");
+    expect(aeNewCodexReviewerModel(rows)?.displayName).toBe("GPT-6-Sol");
+    expect(aeNewCodexReviewerModel([row("GPT-7-Astra"), row("GPT-7-Luna")])?.displayName).toBe(
+      "GPT-7-Astra",
+    );
+  });
+});
diff --git a/web/src/lib/aeCodexModels.ts b/web/src/lib/aeCodexModels.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d184bc7c075606dc300bd2b69ec3610a4006eab9
--- /dev/null
+++ b/web/src/lib/aeCodexModels.ts
@@ -0,0 +1,141 @@
+// Codex model names for the reviewer rows (omnigent-ae, 2026-10-26). The host
+// lists every Codex model it knows, old generations too. A reviewer row offers
+// the three latest, worked out from the names: the family is the last word
+// ("Sol" in "GPT-6-Sol") and the generation is the number ("6", or "5.6").
+// Pure logic; the components live in pages/settings.
+
+import { AE_AGENT_EFFORTS, type AeAgentEffort } from "@/lib/aeRoleBase";
+import type { NativeModelOption } from "@/lib/types";
+
+export const AE_CODEX_LATEST_COUNT = 3;
+/** The family a new Codex reviewer opens on (the workhorse model). */
+export const AE_CODEX_NEW_REVIEWER_FAMILY = "sol";
+/** The families the host names its models by. With two or more of them in a list, only they count for "latest". */
+export const AE_CODEX_NAMED_FAMILIES: readonly string[] = ["astra", "sol", "luna", "terra"];
+
+export interface AeCodexName {
+  /** Lowercase words after the generation: `sol`, or `codex-max` for "GPT-5.6-Codex-Max". */
+  family: string;
+  /** The generation's parts: "5.6" is [5, 6]. */
+  generation: number[];
+}
+
+const NAME = /(\d+(?:\.\d+)*)[\s-]+([A-Za-z]+(?:[\s-]+[A-Za-z]+)*)\s*$/;
+
+/** The family and generation in a Codex display name, or null when either is missing. */
+export function aeCodexName(label: string | null | undefined): AeCodexName | null {
+  const match = NAME.exec(label?.trim() ?? "");
+  if (!match) return null;
+  return {
+    family: match[2]
+      .toLowerCase()
+      .split(/[\s-]+/)
+      .join("-"),
+    generation: match[1].split(".").map(Number),
+  };
+}
+
+/** Negative when `a` is the older generation. */
+export function aeCompareGeneration(a: readonly number[], b: readonly number[]): number {
+  for (let i = 0; i < Math.max(a.length, b.length); i++) {
+    const diff = (a[i] ?? 0) - (b[i] ?? 0);
+    if (diff !== 0) return diff;
+  }
+  return 0;
+}
+
+/** What the host calls a model in its list. */
+export function aeCodexLabel(row: Pick<NativeModelOption, "id" | "displayName">): string {
+  return row.displayName?.trim() || row.id;
+}
+
+export function aeCodexRowName(row: NativeModelOption): AeCodexName | null {
+  return aeCodexName(row.displayName) ?? aeCodexName(row.id);
+}
+
+interface Newest {
+  row: NativeModelOption;
+  generation: number[];
+  order: number;
+}
+
+/** The newest row of each family, keyed by family; `only` limits which families count. */
+function newestByFamily(rows: readonly NativeModelOption[], only?: readonly string[]) {
+  const newest = new Map<string, Newest>();
+  rows.forEach((row, order) => {
+    const name = aeCodexRowName(row);
+    if (!name || (only && !only.includes(name.family))) return;
+    const current = newest.get(name.family);
+    if (!current || aeCompareGeneration(name.generation, current.generation) > 0)
+      newest.set(name.family, { row, generation: name.generation, order });
+  });
+  return newest;
+}
+
+const byNewest = (a: Newest, b: Newest) =>
+  aeCompareGeneration(b.generation, a.generation) || a.order - b.order;
+
+/** Whether a list names models by the host's families, so only those count for "latest". */
+function namedOnly(rows: readonly NativeModelOption[]): readonly string[] | undefined {
+  return newestByFamily(rows, AE_CODEX_NAMED_FAMILIES).size >= 2
+    ? AE_CODEX_NAMED_FAMILIES
+    : undefined;
+}
+
+/**
+ * The newest version of each family, the families with the newest versions
+ * overall first (catalog order breaks a tie), cut to `limit`. With two or more
+ * of the host's named families in the list, only those count. When no name
+ * parses, every model is listed as the host gave it.
+ */
+export function aeLatestCodexModels(
+  rows: readonly NativeModelOption[],
+  limit = AE_CODEX_LATEST_COUNT,
+): NativeModelOption[] {
+  const newest = newestByFamily(rows, namedOnly(rows));
+  if (newest.size === 0) return [...rows];
+  return [...newest.values()]
+    .sort(byNewest)
+    .slice(0, limit)
+    .map((entry) => entry.row);
+}
+
+/** Every other model the host lists (older generations stay out), so nothing it offers is unreachable. */
+export function aeCodexOtherModels(rows: readonly NativeModelOption[]): NativeModelOption[] {
+  const only = namedOnly(rows);
+  const older = new Set(
+    rows.filter((row) => {
+      const name = aeCodexRowName(row);
+      return !!name && (!only || only.includes(name.family));
+    }),
+  );
+  const latest = new Set(aeLatestCodexModels(rows));
+  return rows.filter((row) => !latest.has(row) && !older.has(row));
+}
+
+/** The model a new Codex reviewer starts on: the newest Sol in the whole list, else the newest model. */
+export function aeNewCodexReviewerModel(
+  rows: readonly NativeModelOption[],
+): NativeModelOption | null {
+  const sol = newestByFamily(rows).get(AE_CODEX_NEW_REVIEWER_FAMILY);
+  if (sol) return sol.row;
+  return aeLatestCodexModels(rows)[0] ?? null;
+}
+
+/** The efforts a model offers, in bar order (ultra last); empty when it lists none. */
+export function aeCodexEfforts(row: NativeModelOption | null | undefined): AeAgentEffort[] {
+  const listed = new Set(
+    (row?.supportedReasoningEfforts ?? []).map((option) => option.reasoningEffort),
+  );
+  return AE_AGENT_EFFORTS.filter((effort) => listed.has(effort));
+}
+
+/** The model's own default effort when it offers it, else Medium, else its first level. */
+export function aeCodexDefaultEffort(row: NativeModelOption | null | undefined): AeAgentEffort {
+  const efforts = aeCodexEfforts(row);
+  const own = row?.defaultReasoningEffort;
+  const stored = efforts.find((effort) => effort === own);
+  if (stored) return stored;
+  if (efforts.length === 0 || efforts.includes("medium")) return "medium";
+  return efforts[0];
+}
