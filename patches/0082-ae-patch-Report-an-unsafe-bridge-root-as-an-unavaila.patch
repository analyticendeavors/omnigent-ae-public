From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Sat, 17 Oct 2026 13:18:20 -0700
Subject: [PATCH 082/191] [ae-patch] Report an unsafe bridge root as an
 unavailable context probe, not a server error

ensure_secure_dir raises RuntimeError, which the context-usage route does not catch, so a bridge root with the wrong owner or mode answered 500 and skipped the 30-second retry backoff. It now raises ValueError with what to fix. The tests use pathlib.Path directly.
---
 omnigent/runner/ae_context_usage.py   |  9 ++++++++-
 tests/runner/test_ae_context_usage.py | 14 ++++++++++++--
 2 files changed, 20 insertions(+), 3 deletions(-)

diff --git a/omnigent/runner/ae_context_usage.py b/omnigent/runner/ae_context_usage.py
index 347629ab1aa967c22313f9a90988dad2005a6469..b98f212fc94b26f10b4f5d0509746a17d4c19e1f 100644
--- a/omnigent/runner/ae_context_usage.py
+++ b/omnigent/runner/ae_context_usage.py
@@ -286,7 +286,14 @@ def _scratch_parent() -> Path:
     )
 
     root = bridge_dir_for_bridge_id("ae-context-probe").parent
-    ensure_secure_dir(root)
+    try:
+        ensure_secure_dir(root)
+    except RuntimeError as exc:
+        # ValueError keeps the route's "unavailable" answer and its 30-second backoff.
+        raise ValueError(
+            f"Bridge root {root} failed its owner or permission check ({exc}). "
+            "Fix that directory's owner and mode, then retry."
+        ) from exc
     return root
 
 
diff --git a/tests/runner/test_ae_context_usage.py b/tests/runner/test_ae_context_usage.py
index 4ba9af5e9df25cf7401f468233d485cc4104961f..dec5ba6661f6d4cd0f8e4f196f6b19bf9bd6dbe9 100644
--- a/tests/runner/test_ae_context_usage.py
+++ b/tests/runner/test_ae_context_usage.py
@@ -3,6 +3,7 @@
 import asyncio
 import json
 import sys
+from pathlib import Path
 from unittest.mock import AsyncMock
 
 import pytest
@@ -382,7 +383,7 @@ for line in sys.stdin:
 """)
     command = [sys.executable, str(script), "--mcp-config", json.dumps(_bridge_config(live))]
     await usage.probe(command, {}, str(tmp_path))
-    copy = type(live)(seen.read_text())
+    copy = Path(seen.read_text())
     assert copy.parent.parent == claude_bridge_root
     assert copy.parent.name.startswith("ae-context-")
     assert not copy.parent.exists()
@@ -399,10 +400,19 @@ def test_isolated_copy_passes_bridge_allowed_root_check(tmp_path, claude_bridge_
     command = usage.isolated_command(
         ["claude", "--mcp-config", json.dumps(_bridge_config(live))], str(tmp_path), scratch
     )
-    copy = type(live)(json.loads(command[2])["mcpServers"]["omnigent"]["args"][-1])
+    copy = Path(json.loads(command[2])["mcpServers"]["omnigent"]["args"][-1])
     assert claude_bridge._trusted_parent_for_bridge_dir(copy) == claude_bridge._TRUSTED_PARENT
     claude_bridge.ensure_secure_dir(copy)
     claude_bridge._write_json_file(copy / "server.json", {"pid": 1})
     # The old location is rejected, which is the failure this guards against.
     with pytest.raises(RuntimeError, match="not under an allowed bridge root"):
         claude_bridge.ensure_secure_dir(tmp_path / "ae-context-elsewhere" / "0-0")
+
+
+def test_unsafe_bridge_root_is_reported_as_unavailable(monkeypatch):
+    def refuse(_target):
+        raise RuntimeError("group-writable ancestor")
+
+    monkeypatch.setattr(claude_bridge, "ensure_secure_dir", refuse)
+    with pytest.raises(ValueError, match="group-writable ancestor"):
+        usage._scratch_parent()
