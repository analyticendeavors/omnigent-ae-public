+import { act, renderHook } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { createSpeaker } from "@/lib/aeSpeakReplies";
+import {
+  GRACE_MS,
+  registerVoiceSpeaker,
+  RESUME_MS,
+  resetVoiceStore,
+  setVoiceOn,
+  setVoiceSpeaking,
+  getVoiceSnapshot,
+} from "@/lib/aeVoiceMode";
+import { useChatStore } from "@/store/chatStore";
+import { installFakeSpeech, removeFakeSpeech, type FakeSynth } from "@/test/fakeSpeech";
+import { useAeVoiceMode } from "./useAeVoiceMode";
+
+const CARD = {
+  type: "elicitation",
+  ctx: { depth: 0 },
+  elicitationId: "e1",
+  status: "pending",
+  targetSessionId: null,
+  contentPreview: "",
+  askUserQuestion: {
+    questions: [
+      {
+        question: "How should it deploy?",
+        multiSelect: false,
+        options: [
+          { label: "Force it", description: "Now." },
+          { label: "Let the timer do it", description: "Later." },
+          { label: "Hold it", description: "Wait." },
+        ],
+      },
+    ],
+  },
+};
+
+let synth: FakeSynth;
+let listening = false;
+const controller = {
+  current: {
+    start: vi.fn(() => {
+      listening = true;
+    }),
+    stop: vi.fn(() => {
+      listening = false;
+    }),
+    isListening: () => listening,
+  },
+};
+const submit = vi.fn();
+const submitApproval = vi.fn(() => Promise.resolve());
+
+function mount(initial: { value?: string; status?: string } = {}) {
+  return renderHook(
+    (props: { value: string; status: string }) =>
+      useAeVoiceMode({ chatId: "c1", controller, submit, ...props }),
+    { initialProps: { value: initial.value ?? "", status: initial.status ?? "idle" } },
+  );
+}
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  window.localStorage.clear();
+  resetVoiceStore();
+  listening = false;
+  controller.current.start.mockClear();
+  controller.current.stop.mockClear();
+  submit.mockClear();
+  submitApproval.mockClear();
+  vi.stubGlobal(
+    "fetch",
+    vi.fn(() => Promise.resolve(new Response("{}", { status: 200 }))),
+  );
+  synth = installFakeSpeech();
+  useChatStore.setState({
+    conversationId: "c1",
+    blocks: [],
+    status: "idle",
+    submitApproval,
+  } as never);
+  setVoiceOn("c1", true);
+});
+
+afterEach(() => {
+  vi.useRealTimers();
+  vi.unstubAllGlobals();
+  removeFakeSpeech();
+});
+
+describe("useAeVoiceMode", () => {
+  it("starts the mic when on and idle", () => {
+    mount();
+    expect(controller.current.start).toHaveBeenCalledTimes(1);
+  });
+
+  it("sends the draft 600 ms after a final", () => {
+    const { result } = mount({ value: "hello there" });
+    act(() => void result.current.onFinal("hello there"));
+    act(() => void vi.advanceTimersByTime(GRACE_MS - 1));
+    expect(submit).not.toHaveBeenCalled();
+    act(() => void vi.advanceTimersByTime(1));
+    expect(submit).toHaveBeenCalledTimes(1);
+    expect(controller.current.stop).toHaveBeenCalled();
+  });
+
+  it("a new partial inside the grace cancels the send", () => {
+    const { result } = mount({ value: "hello" });
+    act(() => void result.current.onFinal("hello"));
+    act(() => void vi.advanceTimersByTime(400));
+    act(() => void result.current.onPartial("and also"));
+    act(() => void vi.advanceTimersByTime(2000));
+    expect(submit).not.toHaveBeenCalled();
+  });
+
+  it("does not send an empty draft", () => {
+    const { result } = mount({ value: "  " });
+    act(() => void result.current.onFinal("x"));
+    act(() => void vi.advanceTimersByTime(2000));
+    expect(submit).not.toHaveBeenCalled();
+  });
+
+  it("sends nothing while speaking, and resumes listening 300 ms after it ends", () => {
+    const speaker = createSpeaker();
+    speaker.subscribe(() => setVoiceSpeaking("c1", speaker.speaking()));
+    const { result } = mount({ value: "hello" });
+    act(() => speaker.speak("A reply.", { voiceURI: null, rate: 1 }));
+    expect(getVoiceSnapshot("c1").speaking).toBe(true);
+    expect(controller.current.stop).toHaveBeenCalled();
+    act(() => void result.current.onFinal("hello"));
+    act(() => void vi.advanceTimersByTime(2000));
+    expect(submit).not.toHaveBeenCalled();
+    controller.current.start.mockClear();
+    act(() => void synth.finishNext());
+    act(() => void vi.advanceTimersByTime(RESUME_MS - 1));
+    expect(controller.current.start).not.toHaveBeenCalled();
+    act(() => void vi.advanceTimersByTime(1));
+    expect(controller.current.start).toHaveBeenCalledTimes(1);
+  });
+
+  it("keeps the mic off while the reply streams", () => {
+    const { rerender } = mount({ value: "hi", status: "idle" });
+    rerender({ value: "", status: "streaming" });
+    expect(controller.current.stop).toHaveBeenCalled();
+    controller.current.start.mockClear();
+    rerender({ value: "", status: "idle" });
+    act(() => void vi.advanceTimersByTime(RESUME_MS));
+    expect(controller.current.start).toHaveBeenCalledTimes(1);
+  });
+
+  it("reads a question card and picks the option that was said", () => {
+    const speaker = createSpeaker();
+    registerVoiceSpeaker("c1", (t) => speaker.speak(t, { voiceURI: null, rate: 1 }));
+    useChatStore.setState({ blocks: [CARD] } as never);
+    const { result } = mount({ status: "streaming" });
+    act(() => void vi.advanceTimersByTime(50));
+    expect(synth.texts()).toEqual([
+      "Question. How should it deploy? One, Force it. Two, Let the timer do it. Three, Hold it.",
+    ]);
+    let used = false;
+    act(() => {
+      used = result.current.onFinal("option two");
+    });
+    expect(used).toBe(true);
+    expect(submitApproval).toHaveBeenCalledWith("e1", "accept", {
+      "How should it deploy?": "Let the timer do it",
+    });
+    expect(submit).not.toHaveBeenCalled();
+  });
+
+  it("sends an unmatched answer as the card's own words after the grace", () => {
+    useChatStore.setState({ blocks: [CARD] } as never);
+    const { result } = mount();
+    act(() => void result.current.onFinal("ask me tomorrow"));
+    expect(submitApproval).not.toHaveBeenCalled();
+    act(() => void vi.advanceTimersByTime(GRACE_MS));
+    expect(submitApproval).toHaveBeenCalledWith("e1", "accept", {
+      "How should it deploy?": "ask me tomorrow",
+    });
+  });
+
+  it("never answers a card on silence", () => {
+    useChatStore.setState({ blocks: [CARD] } as never);
+    mount();
+    act(() => void vi.advanceTimersByTime(120_000));
+    expect(submitApproval).not.toHaveBeenCalled();
+    expect(submit).not.toHaveBeenCalled();
+  });
+
+  it("collects picks on a multi-select card until done", () => {
+    const multi = {
+      ...CARD,
+      askUserQuestion: {
+        questions: [{ ...CARD.askUserQuestion.questions[0], multiSelect: true }],
+      },
+    };
+    useChatStore.setState({ blocks: [multi] } as never);
+    const { result } = mount();
+    act(() => void result.current.onFinal("one"));
+    act(() => void result.current.onFinal("three"));
+    expect(submitApproval).not.toHaveBeenCalled();
+    act(() => void result.current.onFinal("done"));
+    expect(submitApproval).toHaveBeenCalledWith("e1", "accept", {
+      "How should it deploy?": ["Force it", "Hold it"],
+    });
+  });
+
+  it("stays out of the way when off", () => {
+    setVoiceOn("c1", false);
+    const { result } = mount({ value: "hi" });
+    expect(controller.current.start).not.toHaveBeenCalled();
+    let used = true;
+    act(() => {
+      used = result.current.onFinal("hi");
+    });
+    expect(used).toBe(false);
+    act(() => void vi.advanceTimersByTime(2000));
+    expect(submit).not.toHaveBeenCalled();
+  });
+});
diff --git a/web/src/hooks/useAeVoiceMode.ts b/web/src/hooks/useAeVoiceMode.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2aa602ad7dc0874e8ccf958f65d8eeed66e097c9
--- /dev/null
+++ b/web/src/hooks/useAeVoiceMode.ts
@@ -0,0 +1,265 @@
+// The Voice mode loop: the mic listens while idle, a finished sentence plus a short
+// grace sends the draft, the mic is muted from send until the reply has been spoken,
+// and a pending question card is read aloud and answered by voice.
+
+import { type MutableRefObject, useCallback, useEffect, useRef, useState } from "react";
+import {
+  type AeMicController,
+  GRACE_MS,
+  isPendingElicitation,
+  matchSpokenOption,
+  matchSpokenOptions,
+  questionKey,
+  questionsOf,
+  questionSpeech,
+  RESUME_MS,
+  setVoicePhase,
+  splitDone,
+  type VoicePhase,
+  useVoiceSnapshot,
+} from "@/lib/aeVoiceMode";
+import { useChatStore } from "@/store/chatStore";
+
+/** If the chat never starts streaming after a send, stop waiting for it. */
+const SEND_WAIT_MS = 5000;
+
+export interface UseAeVoiceModeArgs {
+  chatId: string | null;
+  controller: MutableRefObject<AeMicController | null>;
+  status: string;
+  /** The composer draft. */
+  value: string;
+  /** Sends the draft exactly as the Send button does. */
+  submit: () => void;
+}
+
+export interface AeVoiceMode {
+  on: boolean;
+  phase: VoicePhase;
+  /** A final sentence arrived; true when Voice mode used it (the draft should not take it). */
+  onFinal: (text: string) => boolean;
+  /** A partial arrived; true when Voice mode is answering a card and the draft should not take it. */
+  onPartial: (text: string) => boolean;
+}
+
+interface CardState {
+  id: string;
+  index: number;
+  answers: Record<string, string | string[]>;
+  picked: string[];
+  custom: string;
+}
+
+export function useAeVoiceMode({
+  chatId,
+  controller,
+  status,
+  value,
+  submit,
+}: UseAeVoiceModeArgs): AeVoiceMode {
+  const voice = useVoiceSnapshot(chatId);
+  const { on, speaking } = voice;
+  const block = useChatStore((s) =>
+    s.blocks.find((b) => isPendingElicitation(b, s.conversationId)),
+  );
+  const questions = on ? questionsOf(block?.type === "elicitation" ? block : undefined) : null;
+  const cardActive = questions !== null;
+
+  const [awaiting, setAwaiting] = useState(false);
+  const [ready, setReady] = useState(true);
+  const sawStreaming = useRef(false);
+  const sendTimer = useRef<ReturnType<typeof setTimeout> | null>(null);
+  const graceTimer = useRef<ReturnType<typeof setTimeout> | null>(null);
+  const card = useRef<CardState | null>(null);
+
+  const waiting = !cardActive && (awaiting || status === "streaming");
+  const muted = on && (speaking || waiting);
+  const wantListen = on && !muted && ready;
+
+  const latest = useRef({ value, submit, muted, questions, speak: voice.speak, block });
+  latest.current = {
+    value,
+    submit,
+    muted,
+    questions,
+    speak: voice.speak,
+    block: block?.type === "elicitation" ? block : undefined,
+  };
+  const readyRef = useRef(ready);
+  readyRef.current = ready;
+
+  const clearGrace = useCallback(() => {
+    if (graceTimer.current !== null) clearTimeout(graceTimer.current);
+    graceTimer.current = null;
+  }, []);
+
+  // A send is in flight until the chat has streamed and gone idle again.
+  useEffect(() => {
+    if (!awaiting) return;
+    if (status === "streaming") sawStreaming.current = true;
+    else if (sawStreaming.current) {
+      setAwaiting(false);
+      sawStreaming.current = false;
+    }
+  }, [awaiting, status]);
+  useEffect(
+    () => () => {
+      if (sendTimer.current !== null) clearTimeout(sendTimer.current);
+      clearGrace();
+    },
+    [clearGrace],
+  );
+
+  // The mic comes back RESUME_MS after the chat goes quiet.
+  useEffect(() => {
+    if (muted) {
+      setReady(false);
+      return;
+    }
+    if (readyRef.current) return;
+    const t = setTimeout(() => setReady(true), RESUME_MS);
+    return () => clearTimeout(t);
+  }, [muted]);
+
+  const wasOn = useRef(on);
+  useEffect(() => {
+    const mic = controller.current;
+    if (!on) {
+      clearGrace();
+      // Turning the switch off hands the mic back, quiet.
+      if (wasOn.current && mic?.isListening()) mic.stop();
+      wasOn.current = false;
+      return;
+    }
+    wasOn.current = true;
+    if (!mic) return;
+    if (wantListen && !mic.isListening()) mic.start();
+    else if (!wantListen && mic.isListening()) mic.stop();
+  }, [on, wantListen, controller, clearGrace]);
+
+  useEffect(() => {
+    if (!chatId) return;
+    const phase: VoicePhase = !on
+      ? "off"
+      : speaking
+        ? "speaking"
+        : waiting
+          ? "thinking"
+          : "listening";
+    setVoicePhase(chatId, phase);
+  }, [chatId, on, speaking, waiting]);
+
+  const send = useCallback(() => {
+    setAwaiting(true);
+    sawStreaming.current = false;
+    if (sendTimer.current !== null) clearTimeout(sendTimer.current);
+    sendTimer.current = setTimeout(() => {
+      if (!sawStreaming.current) setAwaiting(false);
+    }, SEND_WAIT_MS);
+    latest.current.submit();
+  }, []);
+
+  // A new question card: read it aloud, one question at a time.
+  const cardId = block?.type === "elicitation" ? block.elicitationId : null;
+  useEffect(() => {
+    if (!on || !cardId) {
+      card.current = null;
+      return;
+    }
+    const qs = latest.current.questions;
+    if (!qs || card.current?.id === cardId) return;
+    card.current = { id: cardId, index: 0, answers: {}, picked: [], custom: "" };
+    const q = qs[0];
+    latest.current.speak?.(
+      questionSpeech(
+        q.question,
+        q.options.map((o) => o.label),
+      ),
+    );
+  }, [on, cardId, voice.speak]);
+
+  const answerCard = useCallback((state: CardState, answer: string | string[]) => {
+    const qs = latest.current.questions;
+    if (!qs) return;
+    state.answers[questionKey(qs[state.index])] = answer;
+    state.index += 1;
+    state.picked = [];
+    state.custom = "";
+    if (state.index < qs.length) {
+      const next = qs[state.index];
+      latest.current.speak?.(
+        questionSpeech(
+          next.question,
+          next.options.map((o) => o.label),
+        ),
+      );
+      return;
+    }
+    void useChatStore.getState().submitApproval(state.id, "accept", state.answers);
+  }, []);
+
+  const onCardFinal = useCallback(
+    (state: CardState, text: string) => {
+      const qs = latest.current.questions;
+      const q = qs?.[state.index];
+      if (!q) return;
+      const labels = q.options.map((o) => o.label);
+      if (q.multiSelect) {
+        const { done, rest } = splitDone(text);
+        const hits = matchSpokenOptions(rest, labels).map((i) => labels[i]);
+        if (hits.length === 0 && rest.trim() !== "")
+          state.custom = `${state.custom} ${rest}`.trim();
+        for (const h of hits) if (!state.picked.includes(h)) state.picked.push(h);
+        if (done && (state.picked.length > 0 || state.custom !== "")) {
+          answerCard(state, state.custom ? [...state.picked, state.custom] : [...state.picked]);
+        }
+        return;
+      }
+      const index = matchSpokenOption(text, labels);
+      if (index !== null) {
+        state.custom = "";
+        answerCard(state, labels[index]);
+        return;
+      }
+      // No option matched: after the grace the words go in as the card's own answer.
+      state.custom = `${state.custom} ${text}`.trim();
+      clearGrace();
+      graceTimer.current = setTimeout(() => {
+        graceTimer.current = null;
+        if (card.current === state && state.custom !== "") answerCard(state, state.custom);
+      }, GRACE_MS);
+    },
+    [answerCard, clearGrace],
+  );
+
+  const onFinal = useCallback(
+    (text: string): boolean => {
+      if (!on) return false;
+      const state = card.current;
+      if (state && latest.current.questions) {
+        if (!latest.current.muted) onCardFinal(state, text);
+        return true;
+      }
+      if (latest.current.muted) return false;
+      clearGrace();
+      graceTimer.current = setTimeout(() => {
+        graceTimer.current = null;
+        const now = latest.current;
+        if (now.muted || now.value.trim() === "") return;
+        send();
+      }, GRACE_MS);
+      return false;
+    },
+    [on, onCardFinal, clearGrace, send],
+  );
+
+  const onPartial = useCallback(
+    (_text: string): boolean => {
+      clearGrace();
+      return on && card.current !== null && latest.current.questions !== null;
+    },
+    [on, clearGrace],
+  );
+
+  return { on, phase: voice.phase, onFinal, onPartial };
+}
