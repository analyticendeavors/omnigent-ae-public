+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { createCloudSpeaker, fetchCloudVoices, resetCloudVoicesCache } from "./aeCloudVoice";
+import type { Speaker, SpeakOptions } from "./aeSpeakReplies";
+
+const OPTS: SpeakOptions = { voiceURI: null, rate: 1, cloudVoiceId: "en-US-AvaMultilingualNeural" };
+
+class FakeAudio {
+  static last: FakeAudio | null = null;
+  src = "";
+  onended: (() => void) | null = null;
+  onerror: (() => void) | null = null;
+  played: string[] = [];
+  pauses = 0;
+  constructor() {
+    FakeAudio.last = this;
+  }
+  play() {
+    this.played.push(this.src);
+    return Promise.resolve();
+  }
+  pause() {
+    this.pauses++;
+  }
+  removeAttribute(name: string) {
+    if (name === "src") this.src = "";
+  }
+  end() {
+    this.onended?.();
+  }
+}
+
+class FakeDevice implements Speaker {
+  texts: string[] = [];
+  stops = 0;
+  on = false;
+  listeners = new Set<() => void>();
+  speak = (text: string) => {
+    this.texts.push(text);
+    this.on = true;
+    this.listeners.forEach((cb) => cb());
+  };
+  stop = () => {
+    this.stops++;
+    this.on = false;
+    this.listeners.forEach((cb) => cb());
+  };
+  speaking = () => this.on;
+  retained = () => 0;
+  subscribe = (cb: () => void) => {
+    this.listeners.add(cb);
+    return () => this.listeners.delete(cb);
+  };
+  finish() {
+    this.on = false;
+    this.listeners.forEach((cb) => cb());
+  }
+}
+
+interface Pending {
+  text: string;
+  signal: AbortSignal | null | undefined;
+  resolve: (r: Response) => void;
+}
+
+let pending: Pending[];
+let fetchMock: ReturnType<typeof vi.fn>;
+let urls: string[];
+
+const mp3 = () =>
+  new Response(new Uint8Array([1, 2, 3]), {
+    status: 200,
+    headers: { "Content-Type": "audio/mpeg" },
+  });
+const tick = () =>
+  new Promise<void>((r) => {
+    setTimeout(r, 0);
+  });
+async function settle() {
+  await tick();
+  await tick();
+  await tick();
+  await tick();
+}
+
+beforeEach(() => {
+  pending = [];
+  urls = [];
+  FakeAudio.last = null;
+  resetCloudVoicesCache();
+  fetchMock = vi.fn((input: string, init?: RequestInit) => {
+    if (String(input).endsWith("/tts/voices")) {
+      return Promise.resolve(
+        new Response(JSON.stringify({ voices: [{ id: "a", name: "Ava" }] }), { status: 200 }),
+      );
+    }
+    return new Promise<Response>((resolve, reject) => {
+      const body = JSON.parse(String(init?.body)) as { text: string };
+      pending.push({ text: body.text, signal: init?.signal, resolve });
+      init?.signal?.addEventListener("abort", () => reject(new DOMException("x", "AbortError")));
+    });
+  });
