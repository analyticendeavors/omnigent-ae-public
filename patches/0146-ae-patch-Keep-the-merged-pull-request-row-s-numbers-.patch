From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Wed, 21 Oct 2026 13:23:52 -0700
Subject: [PATCH 146/191] [ae-patch] Keep the merged pull request row's numbers
 on one line on a phone

On a phone the fold's pull request numbers wrapped to a second line beside the
label and the deploy status. They now stay on one line and scroll sideways when
they do not fit.
---
 web/src/components/AeInlinePrCards.test.tsx | 5 +++++
 web/src/components/AeMergedPrFold.tsx       | 8 ++++++--
 2 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/web/src/components/AeInlinePrCards.test.tsx b/web/src/components/AeInlinePrCards.test.tsx
index 2cc0cef332ce948c85b24571307b23b14115e261..d43c9ffb18572af672ccd0c6bbd562ad7739030f 100644
--- a/web/src/components/AeInlinePrCards.test.tsx
+++ b/web/src/components/AeInlinePrCards.test.tsx
@@ -199,6 +199,11 @@ describe("AeInlinePrCards", () => {
       expect(chips.map((chip) => chip.tagName)).toEqual(["A", "A"]);
       expect(chips[0]).toHaveAttribute("href", url(173));
       expect(chips[0]).toHaveAttribute("target", "_blank");
+      // One line on a phone: the numbers scroll sideways rather than wrap.
+      const row = screen.getByTestId("ae-pr-fold-chips");
+      expect(row).not.toHaveClass("flex-wrap");
+      expect(row).toHaveClass("overflow-x-auto");
+      expect(chips[0]).toHaveClass("shrink-0", "whitespace-nowrap");
 
       fireEvent.click(chips[0]);
       expect(screen.getByTestId("ae-pr-fold-toggle")).toHaveAttribute("aria-expanded", "false");
diff --git a/web/src/components/AeMergedPrFold.tsx b/web/src/components/AeMergedPrFold.tsx
index abec79d404e7b0d6386764978c7f703fe1b9c988..c9b1d784bf2d73799e20c642bc70ad7a7980fdca 100644
--- a/web/src/components/AeMergedPrFold.tsx
+++ b/web/src/components/AeMergedPrFold.tsx
@@ -145,7 +145,11 @@ export function AeMergedPrFold({
           />
           <span className="font-medium">{aeFoldLabel(prs)}</span>
         </button>
-        <span className="relative flex min-w-0 flex-wrap gap-1.5">
+        {/* One line on a phone too: the numbers scroll sideways, never wrap. */}
+        <span
+          className="relative flex min-w-0 gap-1.5 overflow-x-auto [scrollbar-width:none]"
+          data-testid="ae-pr-fold-chips"
+        >
           {prs.map((pr) => (
             <AePrLinkHoverCard key={pr.url} href={pr.url}>
               <a
@@ -153,7 +157,7 @@ export function AeMergedPrFold({
                 target="_blank"
                 rel="noreferrer"
                 data-testid="ae-pr-fold-chip"
-                className="rounded border border-border px-1.5 text-xs text-muted-foreground hover:text-foreground"
+                className="shrink-0 rounded border border-border px-1.5 text-xs whitespace-nowrap text-muted-foreground hover:text-foreground"
                 onClick={(event) => event.stopPropagation()}
               >
                 {foldRef(pr, multiRepo)}
