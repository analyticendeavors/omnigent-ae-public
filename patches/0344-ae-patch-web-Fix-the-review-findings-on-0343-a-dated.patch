diff --git a/web/src/lib/composerModelLabel.ts b/web/src/lib/composerModelLabel.ts
index 0b9b8472a3e39c45dc0f91e0945e5b9399b96d1d..28f9ec6444d1cda135978dc431144d34bdc0af1b 100644
--- a/web/src/lib/composerModelLabel.ts
