From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Sat, 7 Nov 2026 10:35:00 -0800
Subject: [PATCH 302/333] [ae-patch] Make the SDK's ExtensionApiError plain
 TypeScript so web's type-check can import the SDK

Web's tsc runs with erasableSyntaxOnly, which rejects a constructor parameter
property. The openPage params test imports the SDK's index.ts, which pulled the
file into that program. Declare code as a class field and assign it in the
constructor; runtime behavior is the same.
---
 sdks/web-extension/src/index.ts | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/sdks/web-extension/src/index.ts b/sdks/web-extension/src/index.ts
index 2603bbad7df643afd6628a795c0d45b732935fdb..e2bdf3abc8155ec584f7465ffee24e3d84268426 100644
--- a/sdks/web-extension/src/index.ts
+++ b/sdks/web-extension/src/index.ts
@@ -55,11 +55,11 @@ export interface ExtensionServerResponse {
 }
 
 export class ExtensionApiError extends Error {
-  constructor(
-    readonly code: string,
-    message: string,
-  ) {
+  readonly code: string;
+
+  constructor(code: string, message: string) {
     super(message);
+    this.code = code;
     this.name = "ExtensionApiError";
   }
 }
