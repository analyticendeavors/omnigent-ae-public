From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Tue, 20 Oct 2026 22:51:18 -0700
Subject: [PATCH 139/260] [ae-patch] Show the session title in the header of
 the iOS and Android apps

The native shells hid every breadcrumb segment but the parent-session
link, on the view that their own chrome identifies the session. It only
switches servers, so on a phone the session's name was visible only in
the closed sidebar. Keep the plain title visible in native shells; the
folder and sub-agent segments stay hidden.
---
 web/src/index.css                             |  20 ++--
 ...versationBreadcrumb.aeNativeTitle.test.tsx | 110 ++++++++++++++++++
 web/src/shell/ConversationBreadcrumb.tsx      |   6 +-
 web/src/shell/HeaderTitle.tsx                 |   2 +-
 4 files changed, 124 insertions(+), 14 deletions(-)
 create mode 100644 web/src/shell/ConversationBreadcrumb.aeNativeTitle.test.tsx

diff --git a/web/src/index.css b/web/src/index.css
index 7e1abfc74bcd5703761107ad6784828784e1326f..6dddeba92abd46db3c3c339dd1f0c0cae6f9431a 100644
--- a/web/src/index.css
+++ b/web/src/index.css
@@ -936,18 +936,14 @@ html[data-electron-mac] .breadcrumb-folder {
   -webkit-app-region: no-drag;
 }
 
-/* Native shells carry their own chrome (server switcher), so the folder /
- * title / sub-agent segments are redundant there. Keep the parent-session
- * link: native back is off and edge-pan opens the sidebar, so that link is
- * the only in-header climb-out of a sub-agent. Hide the empty nav when there
- * is no parent link (top-level). Not scoped to a width media query so it
- * holds on wider native shells (e.g. iPad) too. */
-[data-ios-native] .conversation-breadcrumb:not(:has(> a.breadcrumb-parent-link)),
-[data-android-native] .conversation-breadcrumb:not(:has(> a.breadcrumb-parent-link)) {
-  display: none;
-}
-[data-ios-native] .conversation-breadcrumb > :not(a.breadcrumb-parent-link),
-[data-android-native] .conversation-breadcrumb > :not(a.breadcrumb-parent-link) {
+/* Native shells carry their own chrome (server switcher), which makes the
+ * folder and sub-agent segments redundant but does not name the session, so
+ * the session title stays. The parent-session link stays too: it is the only
+ * in-header climb-out of a sub-agent. Holds at every width (iPad too). */
+[data-ios-native] .conversation-breadcrumb > :not(a.breadcrumb-parent-link):not(.breadcrumb-title),
+[data-android-native]
+  .conversation-breadcrumb
+  > :not(a.breadcrumb-parent-link):not(.breadcrumb-title) {
   display: none;
 }
 
diff --git a/web/src/shell/ConversationBreadcrumb.aeNativeTitle.test.tsx b/web/src/shell/ConversationBreadcrumb.aeNativeTitle.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..7933ea439722fcffcbb51f4f85ff7a9a836bae7d
--- /dev/null
+++ b/web/src/shell/ConversationBreadcrumb.aeNativeTitle.test.tsx
@@ -0,0 +1,110 @@
+// The native shells (iOS, Android) hide the breadcrumb's folder and sub-agent
+// segments, but keep the session title: their own chrome does not name the
+// session. jsdom applies no app stylesheet, so this loads the real native rule
+// from index.css and checks what it hides.
+
+import { readFileSync } from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { render } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { TooltipProvider } from "@/components/ui/tooltip";
+import { ConversationBreadcrumb } from "./ConversationBreadcrumb";
+import { HeaderTitle } from "./HeaderTitle";
+
+vi.mock("@/hooks/useConversations", async (importOriginal) => ({
+  ...(await importOriginal<object>()),
+  useRenameConversation: () => ({ mutate: vi.fn(), isPending: false }),
+}));
+
+const srcDir = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const indexCss = readFileSync(path.join(srcDir, "index.css"), "utf8");
+// Every rule whose selector names the native shells and the breadcrumb.
+const nativeRules = [
+  ...indexCss.matchAll(
+    /(\[data-(?:ios|android)-native\][^{]*conversation-breadcrumb[^{]*)\{([^}]*)\}/g,
+  ),
+]
+  .map((m) => `${m[1]}{${m[2]}}`)
+  .join("\n");
+
+let style: HTMLStyleElement | null = null;
+
+afterEach(() => {
+  style?.remove();
+  style = null;
+});
+
+function renderInShell(
+  shell: "ios" | "android",
+  props: { titleLinkTo?: string; renameable?: boolean } = {},
+) {
+  style = document.createElement("style");
+  style.textContent = nativeRules;
+  document.head.appendChild(style);
+  const view = render(
+    <div {...{ [`data-${shell}-native`]: "" }}>
+      <MemoryRouter>
+        <TooltipProvider>
+          <ConversationBreadcrumb
+            conversationTitle="UX for multiple autocomplete suggestions"
+            projectName="reid"
+            isChildSession={Boolean(props.titleLinkTo)}
+            subAgentName="Explore"
+            boundAgent={undefined}
+            wrapperLabel={null}
+            titleLinkTo={props.titleLinkTo}
+            titleSlot={
+              props.renameable ? (
+                <HeaderTitle
+                  conversationId="conv_a"
+                  title="UX for multiple autocomplete suggestions"
+                />
+              ) : undefined
+            }
+          />
+        </TooltipProvider>
+      </MemoryRouter>
+    </div>,
+  );
+  return view.container;
+}
+
+const shown = (el: Element | null) => el !== null && getComputedStyle(el).display !== "none";
+
+describe("ConversationBreadcrumb in a native shell", () => {
+  it("loads the native rules from index.css", () => {
+    expect(nativeRules).toContain("breadcrumb-title");
+  });
+
+  it.each(["ios", "android"] as const)(
+    "%s shows the session title and hides the folder",
+    (shell) => {
+      const container = renderInShell(shell);
+      const nav = container.querySelector("nav.conversation-breadcrumb");
+      const title = container.querySelector(".breadcrumb-title");
+      expect(shown(nav)).toBe(true);
+      expect(title).toHaveTextContent("UX for multiple autocomplete suggestions");
+      expect(shown(title)).toBe(true);
+      const folder = container.querySelector(".breadcrumb-folder")?.parentElement ?? null;
+      expect(folder).not.toBeNull();
+      expect(shown(folder)).toBe(false);
+    },
+  );
+
+  it("shows the click-to-rename title of wider native shells (iPad) too", () => {
+    const container = renderInShell("ios", { renameable: true });
+    const title = container.querySelector("[data-testid=header-title]");
+    expect(title).toHaveTextContent("UX for multiple autocomplete suggestions");
+    expect(shown(title)).toBe(true);
+  });
+
+  it("a sub-agent keeps only the back link", () => {
+    const container = renderInShell("ios", { titleLinkTo: "/c/parent" });
+    const nav = container.querySelector("nav.conversation-breadcrumb")!;
+    const visible = [...nav.children].filter(shown);
+    expect(visible).toHaveLength(1);
+    expect(visible[0]).toHaveClass("breadcrumb-parent-link");
+  });
+});
