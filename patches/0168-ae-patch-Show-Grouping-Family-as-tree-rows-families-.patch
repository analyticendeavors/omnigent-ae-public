+    expect(folded.tree.leads.get("gone")).toMatchObject({ folded: true });
+  });
+
+  it("stands in for an unknown lead with a stub entry of the lead's id", () => {
+    const { sessions, tree } = build([row("a", orch("ghost")), row("b", orch("ghost"))], {
+      folded: ["ghost"],
