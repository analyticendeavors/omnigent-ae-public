Subject: [PATCH 090/191] [ae-patch] Light the turn rail's last tick when the
 chat is scrolled to its end

---
 .../chat/Transcript.activeTurn.test.ts        | 12 +++++++++++
 web/src/components/chat/Transcript.tsx        | 11 ++++++----
 web/src/lib/aeActiveTurn.test.ts              | 21 +++++++++++++++++++
 web/src/lib/aeActiveTurn.ts                   | 11 ++++++++++
 4 files changed, 51 insertions(+), 4 deletions(-)
 create mode 100644 web/src/lib/aeActiveTurn.test.ts
 create mode 100644 web/src/lib/aeActiveTurn.ts

diff --git a/web/src/components/chat/Transcript.activeTurn.test.ts b/web/src/components/chat/Transcript.activeTurn.test.ts
index 126cac2d54d690d907c0b37b7eed369eb81bcde2..44044c09d00dce93d74b2ed7a40ca8ae20c640a7 100644
--- a/web/src/components/chat/Transcript.activeTurn.test.ts
+++ b/web/src/components/chat/Transcript.activeTurn.test.ts
@@ -143,6 +143,18 @@ describe("activeTurnIdAtBubbleIndex", () => {
     expect(activeTurnIdAtBubbleIndex(withSystem, 2)).toBe("u0");
   });
 
+  it("lights the last user turn at the end of the chat, even after an assistant reply", () => {
+    // At the end the memo asks for the last bubble's index; midpoint stays on u0.
+    const endsWithReply: Bubble[] = [user("u0"), assistant("a0"), user("u1"), assistant("a1")];
+    expect(activeTurnIdAtBubbleIndex(endsWithReply, endsWithReply.length - 1)).toBe("u1");
+    expect(activeTurnIdAtBubbleIndex(endsWithReply, 1)).toBe("u0");
+  });
+
+  it("lights the last user turn when the chat ends on that user bubble", () => {
+    const endsWithUser: Bubble[] = [user("u0"), assistant("a0"), user("u1")];
+    expect(activeTurnIdAtBubbleIndex(endsWithUser, endsWithUser.length - 1)).toBe("u1");
+  });
+
   it("returns null for an empty transcript", () => {
     expect(activeTurnIdAtBubbleIndex([], 0)).toBeNull();
   });
diff --git a/web/src/components/chat/Transcript.tsx b/web/src/components/chat/Transcript.tsx
index b0108fbb95e03f685662813a69bbd36dda2b1fec..1fef7249fcf6a109b1ed56e020c6594fa8ada467 100644
--- a/web/src/components/chat/Transcript.tsx
+++ b/web/src/components/chat/Transcript.tsx
@@ -2,6 +2,7 @@ import { memo, useCallback, useEffect, useLayoutEffect, useMemo, useRef, useStat
 import { flushSync } from "react-dom";
 import { useVirtualizer } from "@tanstack/react-virtual";
 import { useStickToBottomContext } from "use-stick-to-bottom";
+import { aeAtTranscriptEnd } from "@/lib/aeActiveTurn";
 import {
   Conversation,
   ConversationContent,
@@ -940,13 +941,15 @@ export function VirtualBubbleList({
     const scrollOffset = virtualizer.scrollOffset;
     if (scrollOffset === null || bubbles.length === 0) return null;
     const viewport = scrollEl?.clientHeight ?? 0;
+    if (aeAtTranscriptEnd(scrollOffset, viewport, scrollEl?.scrollHeight ?? 0))
+      return activeTurnIdAtBubbleIndex(bubbles, bubbles.length - 1);
     const midItem = virtualizer.getVirtualItemForOffset(scrollOffset + viewport / 2);
     return activeTurnIdAtBubbleIndex(bubbles, midItem?.index ?? bubbles.length - 1);
-    // `range` and `totalSize` are deps so the active turn recomputes as the
-    // window scrolls and as measurements settle; `scrollOffset` alone isn't a
-    // render trigger.
+    // `range` and `totalSize` recompute the active turn as the window scrolls and
+    // measurements settle; `scrollOffset` is a dep so the at-end check reruns when
+    // the scroll reaches the end.
     // eslint-disable-next-line react-hooks/exhaustive-deps
-  }, [bubbles, scrollEl, range, totalSize, virtualizer]);
+  }, [bubbles, scrollEl, range, totalSize, virtualizer, virtualizer.scrollOffset]);
 
   // Older-history prepend compensation. Absolute rows are out of normal flow,
   // so the browser's native scroll anchoring can't hold the read position
diff --git a/web/src/lib/aeActiveTurn.test.ts b/web/src/lib/aeActiveTurn.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fe9fb92a96cac354ad67320da857cb8c0869e7f0
--- /dev/null
+++ b/web/src/lib/aeActiveTurn.test.ts
@@ -0,0 +1,21 @@
+import { describe, expect, it } from "vitest";
+import { aeAtTranscriptEnd } from "./aeActiveTurn";
+
+describe("aeAtTranscriptEnd", () => {
+  it("is true at the exact end", () => {
+    expect(aeAtTranscriptEnd(600, 400, 1000)).toBe(true);
+  });
+  it("is true within the slack and false beyond it", () => {
+    expect(aeAtTranscriptEnd(596, 400, 1000)).toBe(true);
+    expect(aeAtTranscriptEnd(595, 400, 1000)).toBe(false);
+  });
+  it("honors a custom slack", () => {
+    expect(aeAtTranscriptEnd(590, 400, 1000, 10)).toBe(true);
+  });
+  it("is true when the content does not overflow", () => {
+    expect(aeAtTranscriptEnd(0, 400, 300)).toBe(true);
+  });
+  it("is false mid-scroll", () => {
+    expect(aeAtTranscriptEnd(100, 400, 1000)).toBe(false);
+  });
+});
diff --git a/web/src/lib/aeActiveTurn.ts b/web/src/lib/aeActiveTurn.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ea7db0807004f3fbb6ada553ba7859fa16db0dc3
--- /dev/null
+++ b/web/src/lib/aeActiveTurn.ts
@@ -0,0 +1,11 @@
+// True when a scroll container is within `slackPx` of its real end. scrollHeight
+// includes the spacer below the last turn, so this matches StickToBottom's view
+// of "at the bottom".
+export function aeAtTranscriptEnd(
+  scrollTop: number,
+  clientHeight: number,
+  scrollHeight: number,
+  slackPx = 4,
+): boolean {
+  return scrollHeight - clientHeight - scrollTop <= slackPx;
+}
