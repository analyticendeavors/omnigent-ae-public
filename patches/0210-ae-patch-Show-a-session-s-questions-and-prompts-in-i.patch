+    message: "Allow Bash: pbi-tools deploy ./model?",
+    askUserQuestion: null,
+  } as unknown as AnyBlock;
+
+  function renderChildDock(blocks: AnyBlock[]) {
+    useChatStore.setState({ conversationId: "s1", blocks });
