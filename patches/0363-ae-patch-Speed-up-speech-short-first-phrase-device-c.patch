@@ -0,0 +1,71 @@
+import { afterEach, describe, expect, it } from "vitest";
+import {
+  fastestCloudVoice,
+  readVoiceChatVoicePick,
+  resolveVoiceChatVoice,
+  VOICE_CHAT_VOICE_KEY,
+  VOICE_CHAT_VOICE_SAME,
+  voiceChatVoiceKey,
+  writeVoiceChatVoicePick,
+} from "./aeVoiceChatVoice";
+
+const ROCKY = { id: "rocky-xtts", name: "Rocky", provider: "rocky" };
+const AVA = { id: "ava", name: "Ava", provider: "azure" };
+const ANDREW = { id: "andrew", name: "Andrew", provider: "azure" };
+const SPEAK = { kind: "cloud", id: "rocky-xtts" } as const;
+const DEVICE = { kind: "device", id: "aria" } as const;
+
+afterEach(() => window.localStorage.clear());
+
+describe("voice chat voice", () => {
+  it("defaults to the first non-Rocky cloud voice, whatever the order", () => {
+    expect(fastestCloudVoice([ROCKY, AVA, ANDREW])).toBe(AVA);
+    expect(resolveVoiceChatVoice(null, [ROCKY, ANDREW, AVA], SPEAK, DEVICE)).toEqual({
+      kind: "cloud",
+      id: "andrew",
+    });
+  });
+
+  it("falls back to the device voice when only Rocky or nothing is listed", () => {
+    expect(resolveVoiceChatVoice(null, [ROCKY], SPEAK, DEVICE)).toEqual(DEVICE);
+    expect(resolveVoiceChatVoice(null, [], SPEAK, DEVICE)).toEqual(DEVICE);
+    expect(resolveVoiceChatVoice(null, [], SPEAK, null)).toBeNull();
+  });
+
+  it("gives the Speak replies voice for Same as Speak replies", () => {
+    expect(resolveVoiceChatVoice(VOICE_CHAT_VOICE_SAME, [ROCKY, AVA], SPEAK, DEVICE)).toBe(SPEAK);
+  });
+
+  it("keeps a saved pick, and drops a cloud pick the server no longer lists", () => {
+    expect(resolveVoiceChatVoice("cloud:rocky-xtts", [ROCKY, AVA], null, DEVICE)).toEqual(SPEAK);
+    expect(resolveVoiceChatVoice("device:x:y", [AVA], null, null)).toEqual({
+      kind: "device",
+      id: "x:y",
+    });
+    expect(resolveVoiceChatVoice("cloud:gone", [ROCKY, AVA], SPEAK, DEVICE)).toEqual({
+      kind: "cloud",
+      id: "ava",
+    });
+    // A list not loaded yet keeps the saved cloud voice.
+    expect(resolveVoiceChatVoice("cloud:ava", [], SPEAK, DEVICE)).toEqual({
+      kind: "cloud",
+      id: "ava",
+    });
+  });
+
+  it("persists per device and ignores a junk value", () => {
+    expect(readVoiceChatVoicePick()).toBeNull();
+    writeVoiceChatVoicePick("cloud:ava");
+    expect(readVoiceChatVoicePick()).toBe("cloud:ava");
+    writeVoiceChatVoicePick(VOICE_CHAT_VOICE_SAME);
+    expect(readVoiceChatVoicePick()).toBe(VOICE_CHAT_VOICE_SAME);
+    window.localStorage.setItem(VOICE_CHAT_VOICE_KEY, "junk");
+    expect(readVoiceChatVoicePick()).toBeNull();
+  });
+
+  it("labels the selected menu row", () => {
+    expect(voiceChatVoiceKey(VOICE_CHAT_VOICE_SAME, DEVICE)).toBe("same");
+    expect(voiceChatVoiceKey(null, { kind: "cloud", id: "ava" })).toBe("cloud:ava");
+    expect(voiceChatVoiceKey(null, null)).toBe("");
+  });
+});
diff --git a/web/src/lib/aeVoiceChatVoice.ts b/web/src/lib/aeVoiceChatVoice.ts
new file mode 100644
index 0000000000000000000000000000000000000000..477292957f82a8cf52ed22a60736007a4de944ce
--- /dev/null
+++ b/web/src/lib/aeVoiceChatVoice.ts
@@ -0,0 +1,77 @@
+// The voice Voice mode speaks with (omnigent-ae, 2026-11-12). Rocky's cloud voice takes seconds per
+// sentence, so while Voice mode is on, replies, Read last reply and the approval line use this
+// voice instead; outside Voice mode the normal Voice pick applies. Saved per device.
+
+import type { CloudVoice } from "./aeCloudVoice";
+import type { VoiceChoice } from "./aeSpeakReplies";
+
+export const VOICE_CHAT_VOICE_KEY = "omnigent:ae-voice-chat-voice";
+/** Stored value for "Same as Speak replies". */
+export const VOICE_CHAT_VOICE_SAME = "same";
+
+function getItem(key: string): string | null {
+  if (typeof window === "undefined") return null;
+  try {
+    return window.localStorage.getItem(key);
+  } catch {
+    return null;
+  }
+}
+
+function setItem(key: string, value: string | null): void {
+  if (typeof window === "undefined") return;
+  try {
+    if (value === null) window.localStorage.removeItem(key);
+    else window.localStorage.setItem(key, value);
+  } catch {
+    // A storage failure must not break the composer.
+  }
+}
+
+/** The saved pick: `same`, `cloud:<id>`, `device:<voiceURI>`, or null when none was made. */
+export function readVoiceChatVoicePick(): string | null {
+  const raw = getItem(VOICE_CHAT_VOICE_KEY);
+  if (raw === VOICE_CHAT_VOICE_SAME) return raw;
+  if (raw !== null && /^(cloud|device):./.test(raw)) return raw;
+  return null;
+}
+
+export function writeVoiceChatVoicePick(pick: string | null): void {
+  setItem(VOICE_CHAT_VOICE_KEY, pick);
+}
+
+/** The fastest cloud voice that is not Rocky's: the first one the server lists (Azure). */
+export function fastestCloudVoice(cloudVoices: readonly CloudVoice[]): CloudVoice | null {
+  return cloudVoices.find((v) => v.provider !== "rocky") ?? null;
+}
+
+/**
+ * The voice Voice mode speaks with. `same` gives the Speak replies voice. A saved voice that the
+ * server no longer lists falls to the default. The default is the fastest non-Rocky cloud voice,
+ * else the device voice.
+ */
+export function resolveVoiceChatVoice(
+  pick: string | null,
+  cloudVoices: readonly CloudVoice[],
+  speakVoice: VoiceChoice | null,
+  deviceDefault: VoiceChoice | null,
+): VoiceChoice | null {
+  if (pick === VOICE_CHAT_VOICE_SAME) return speakVoice;
+  if (pick !== null) {
+    const [kind, ...rest] = pick.split(":");
+    const id = rest.join(":");
+    if (kind === "device") return { kind: "device", id };
+    // An empty list is a list not loaded yet: keep the saved cloud voice, the server knows it.
+    if (cloudVoices.length === 0 || cloudVoices.some((v) => v.id === id)) {
+      return { kind: "cloud", id };
+    }
+  }
+  const fast = fastestCloudVoice(cloudVoices);
+  return fast ? { kind: "cloud", id: fast.id } : deviceDefault;
+}
+
+/** The pick the menu shows as selected. */
+export function voiceChatVoiceKey(pick: string | null, resolved: VoiceChoice | null): string {
+  if (pick === VOICE_CHAT_VOICE_SAME) return VOICE_CHAT_VOICE_SAME;
+  return resolved ? `${resolved.kind}:${resolved.id}` : "";
+}
