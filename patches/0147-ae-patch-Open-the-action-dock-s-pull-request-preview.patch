From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Wed, 21 Oct 2026 14:53:14 -0700
Subject: [PATCH 147/191] [ae-patch] Open the action dock's pull request
 preview above the bar

The dock's hover preview opened downward over the composer, where the user
types. AePrLinkHoverCard takes an optional side, and the dock asks for top, the
same way its list opens; chat links keep the default.
---
 web/src/components/AeActionDock.test.tsx | 2 ++
 web/src/components/AeActionDock.tsx      | 2 +-
 web/src/components/AePrLinkHoverCard.tsx | 5 ++++-
 3 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/web/src/components/AeActionDock.test.tsx b/web/src/components/AeActionDock.test.tsx
index 5aa608c2759e5478f63f5d5f428c26d943898be2..efa246f0672f1771fb2ed88eba9c9cda1b098016 100644
--- a/web/src/components/AeActionDock.test.tsx
+++ b/web/src/components/AeActionDock.test.tsx
@@ -191,6 +191,8 @@ describe("AeActionDock", () => {
     fireEvent.focus(link);
     const preview = await screen.findByTestId("ae-pr-hover");
     expect(within(preview).getByText("PR 180")).toBeTruthy();
+    // Above the bar, like the tray, so it never covers the composer.
+    expect(preview.closest("[data-side]")).toHaveAttribute("data-side", "top");
   });
 
   it("renders inside the workspace bar, the caret after the bar's right cluster", async () => {
diff --git a/web/src/components/AeActionDock.tsx b/web/src/components/AeActionDock.tsx
index a17fa9f7265a31df3c1c2b12129d9607d3d35f76..62761bdf983bd4a58d156382b54c6b0166677481 100644
--- a/web/src/components/AeActionDock.tsx
+++ b/web/src/components/AeActionDock.tsx
@@ -118,7 +118,7 @@ function ItemBody({ item, now, expanded }: { item: AeDockItem; now: number; expa
   return (
     <>
       {/* The chat links' preview on hover; no title, which would show over it. */}
-      <AePrLinkHoverCard href={item.url}>
+      <AePrLinkHoverCard href={item.url} side="top">
         <a
           href={item.url}
           target="_blank"
diff --git a/web/src/components/AePrLinkHoverCard.tsx b/web/src/components/AePrLinkHoverCard.tsx
index a361720f612e3179ab465b466c92e295d9fe752f..5be2c14fa8584cd1f2f081d94b933b7ba682af9d 100644
--- a/web/src/components/AePrLinkHoverCard.tsx
+++ b/web/src/components/AePrLinkHoverCard.tsx
@@ -123,9 +123,12 @@ function AePrPreview({ repo, number }: { repo: string; number: number }) {
 /** Wraps a chat link to a GitHub pull request; any other link passes through. */
 export function AePrLinkHoverCard({
   href,
+  side,
   children,
 }: {
   href: string | undefined;
+  /** Where the preview opens; the action dock passes "top" to keep the composer clear. */
+  side?: "top" | "bottom";
   children: ReactElement;
 }) {
   const ref = pullRequestOf(href);
@@ -133,7 +136,7 @@ export function AePrLinkHoverCard({
   return (
     <HoverCard openDelay={300} closeDelay={100}>
       <HoverCardTrigger asChild>{children}</HoverCardTrigger>
-      <HoverCardContent align="start" className="w-80">
+      <HoverCardContent align="start" side={side} className="w-80">
         <AePrPreview repo={ref.repo} number={ref.number} />
       </HoverCardContent>
     </HoverCard>
