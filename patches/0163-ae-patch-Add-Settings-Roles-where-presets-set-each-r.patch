+  });
+
+  it("creates a new preset as a copy of the open one", async () => {
+    serve(stateOf());
+    renderSection();
+    await screen.findByRole("heading", { name: "Balanced" });
+    fireEvent.click(
+      within(screen.getByTestId("ae-roles-row")).getByRole("button", { name: "New preset" }),
