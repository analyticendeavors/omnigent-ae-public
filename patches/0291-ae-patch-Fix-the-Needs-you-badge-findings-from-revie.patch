         "ml-auto inline-flex h-4 min-w-4 items-center justify-center rounded-full px-1 text-10 font-medium tabular-nums",
         red
           ? "bg-destructive text-white dark:text-background"
-          : "bg-[var(--sidebar-active)] text-[var(--sidebar-active-foreground)]",
+          : // The ring keeps the neutral pill visible on the active row, which paints the same wash.
+            "bg-[var(--sidebar-active)] text-[var(--sidebar-active-foreground)] ring-1 ring-border",
         view.kind === "unknown" && "border border-muted-foreground bg-transparent",
       )}
     >
diff --git a/web/src/lib/aeAttention.ts b/web/src/lib/aeAttention.ts
index 819c05d2dab08a140804b8516c2443c01ac397be..a9e3d7e38a8dda30622c27dcfba0a2b58ab0bbf1 100644
--- a/web/src/lib/aeAttention.ts
+++ b/web/src/lib/aeAttention.ts
@@ -115,5 +115,7 @@ export function useAeAttention(): AeAttentionView {
     staleTime: 30_000,
     retry: false,
   });
-  return aeAttentionView(data, isError && !data);
+  // Any query error wins: react-query keeps the last data through a failed refetch, and an old
+  // count through an outage would read as current (review round 1, 2026-11-03).
+  return aeAttentionView(isError ? null : data, isError);
 }
