From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Tue, 3 Nov 2026 16:05:54 -0800
Subject: [PATCH 291/333] [ae-patch] Fix the Needs you badge findings from
 review round 1

A failed refetch now shows the lone question mark instead of the last good count, because
react-query keeps data through an error and an old count through an outage reads as current.
The neutral pill gets a ring so it stays visible on the active row, which paints the same wash.
Both changes are in the files patch 0290 added, so they cannot conflict with a sync.
---
 web/src/components/AeAttentionBadge.test.tsx | 20 ++++++++++++++++++++
 web/src/components/AeAttentionBadge.tsx      |  3 ++-
 web/src/lib/aeAttention.ts                   |  4 +++-
 3 files changed, 25 insertions(+), 2 deletions(-)

diff --git a/web/src/components/AeAttentionBadge.test.tsx b/web/src/components/AeAttentionBadge.test.tsx
index 2f208d310e4913a3be1b3373d83509c8eb33e372..0f14a4ae4342e43680c45a600ceeffdf97b05647 100644
--- a/web/src/components/AeAttentionBadge.test.tsx
+++ b/web/src/components/AeAttentionBadge.test.tsx
@@ -5,6 +5,7 @@ import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
 const fetchMock = vi.hoisted(() => vi.fn());
 vi.mock("@/lib/identity", () => ({ authenticatedFetch: fetchMock }));
 
+import { AE_ATTENTION_QUERY_KEY } from "@/lib/aeAttention";
 import { AeAttentionBadge } from "./AeAttentionBadge";
 
 function answer(body: unknown, ok = true, status = 200) {
@@ -44,6 +45,8 @@ describe("AeAttentionBadge", () => {
     expect(pill.textContent).toBe("17");
     expect(pill.dataset.kind).toBe("review");
     expect(pill.className).not.toContain("bg-destructive");
+    expect(pill.className).toContain("ring-1");
+    expect(pill.className).toContain("ring-border");
   });
 
   it("draws a red pill with the urgent count and an aria-label with the split", async () => {
@@ -77,6 +80,23 @@ describe("AeAttentionBadge", () => {
     expect(pill.dataset.kind).toBe("unknown");
   });
 
+  it("shows a lone question mark when a refetch fails after a good read, not the old count", async () => {
+    answer(counts(6, 17));
+    const qc = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+    render(
+      <QueryClientProvider client={qc}>
+        <AeAttentionBadge />
+      </QueryClientProvider>,
+    );
+    expect((await screen.findByTestId("ae-attention-pill")).textContent).toBe("6");
+    answer({}, false, 500);
+    await qc.refetchQueries({ queryKey: AE_ATTENTION_QUERY_KEY });
+    await waitFor(() => expect(screen.getByTestId("ae-attention-pill").textContent).toBe("?"));
+    answer(counts(2, 0));
+    await qc.refetchQueries({ queryKey: AE_ATTENTION_QUERY_KEY });
+    await waitFor(() => expect(screen.getByTestId("ae-attention-pill").textContent).toBe("2"));
+  });
+
   it("shows a lone question mark when the answer has no counts", async () => {
     answer({ nope: true });
     renderBadge();
diff --git a/web/src/components/AeAttentionBadge.tsx b/web/src/components/AeAttentionBadge.tsx
