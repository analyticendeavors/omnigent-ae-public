+    fireEvent.click(screen.getByRole("button", { name: "Save" }));
+    expect(updateMutate).toHaveBeenCalledWith(
+      { policyId: "x1", factory_params: { hours: 6, write_paths: [], retired: "kept" } },
+      expect.anything(),
+    );
