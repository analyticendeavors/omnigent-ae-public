+  };
+}
+
+const POLICIES = [
+  policy({
+    id: "r1",
+    name: "ae_rabbit_hole",
+    handler: RABBIT_HOLE.handler,
+    factory_params: { hours: 4, turns: 60 },
+  }),
+  policy({
+    id: "s1",
+    name: "ae_slot_cap",
+    handler: SLOT_CAP.handler,
