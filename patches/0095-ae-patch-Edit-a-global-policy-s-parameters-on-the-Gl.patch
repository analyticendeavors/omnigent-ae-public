+
+function mutationStub(mutate: ReturnType<typeof vi.fn>) {
+  mutate.mockImplementation((_arg: unknown, opts?: { onSuccess?: () => void }) =>
+    opts?.onSuccess?.(),
+  );
+  return { mutate, isPending: false, isError: false, error: null };
+}
+
+function renderPage() {
+  return render(
+    <MemoryRouter>
+      <PoliciesPage />
+    </MemoryRouter>,
