Subject: [PATCH 228/260] [ae-patch] Keep a submenu inside the visible area of
 a zoomed phone screen

---
 web/src/lib/aeKeepOnScreen.test.tsx | 32 +++++++++++++++++++++++++++++
 web/src/lib/aeKeepOnScreen.ts       | 20 ++++++++++++------
 2 files changed, 46 insertions(+), 6 deletions(-)

diff --git a/web/src/lib/aeKeepOnScreen.test.tsx b/web/src/lib/aeKeepOnScreen.test.tsx
index 1db9e71a714c455089d638b066ffbc4cf60a60d0..8c3762572e82561957ec18d8bf9869b950f303cd 100644
--- a/web/src/lib/aeKeepOnScreen.test.tsx
+++ b/web/src/lib/aeKeepOnScreen.test.tsx
@@ -43,6 +43,13 @@ describe("aeScreenShift", () => {
     expect(aeScreenShift(-73, 192, 440)).toBe(81);
   });
 
+  it("keeps a box inside a visible band that starts right of the page's left edge", () => {
+    // Pinch-zoomed and panned: the visible band is x 200 to 590 (offset 200, width 390).
+    expect(aeScreenShift(150, 192, 390, 200)).toBe(58);
+    expect(aeScreenShift(500, 192, 390, 200)).toBe(-110);
+    expect(aeScreenShift(300, 192, 390, 200)).toBe(0);
+  });
+
   it("keeps the left edge visible when the box is wider than the screen", () => {
     expect(aeScreenShift(50, 500, 390)).toBe(-42);
   });
@@ -84,6 +91,31 @@ describe("aeKeepOnScreen", () => {
     stop();
   });
 
+  it("follows a pinch-zoomed screen that is panned right and refits on its scroll", () => {
+    const listeners: Record<string, () => void> = {};
+    const vv = {
+      width: 390,
+      offsetLeft: 200,
+      addEventListener: vi.fn((name: string, fn: () => void) => {
+        listeners[name] = fn;
+      }),
+      removeEventListener: vi.fn(),
+    };
+    window.innerWidth = 1024;
+    Object.defineProperty(window, "visualViewport", { value: vv, configurable: true });
+    const { node, wrapper } = flyout(150, 192);
+    const stop = aeKeepOnScreen(node);
+    // Band is x 200 to 590, so a flyout at 150 moves right to 208.
+    expect(node.style.left).toBe("58px");
+    vv.offsetLeft = 0;
+    wrapper.getBoundingClientRect = () => ({ left: 150, width: 192 }) as DOMRect;
+    listeners.scroll();
+    expect(node.style.left).toBe("");
+    stop();
+    expect(vv.removeEventListener).toHaveBeenCalledWith("scroll", expect.any(Function));
+    expect(vv.removeEventListener).toHaveBeenCalledWith("resize", expect.any(Function));
+  });
+
   it("stops observing after cleanup", async () => {
     window.innerWidth = 390;
     const { node, wrapper } = flyout(100, 192);
diff --git a/web/src/lib/aeKeepOnScreen.ts b/web/src/lib/aeKeepOnScreen.ts
index aab546caddc8da06218bc71368fbb553668970ae..b2354867d534b8c61fe43cf61d11c5ea6260da11 100644
--- a/web/src/lib/aeKeepOnScreen.ts
+++ b/web/src/lib/aeKeepOnScreen.ts
@@ -9,20 +9,25 @@ import * as React from "react";
 
 export const AE_SCREEN_MARGIN = 8;
 
-/** How far to move a box at `left` with `width` so it sits inside `viewport` minus the margin. */
+/**
+ * How far to move a box at `left` with `width` so it sits inside the visible band
+ * `[origin, origin + viewport]` minus the margin.
+ */
 export function aeScreenShift(
   left: number,
   width: number,
   viewport: number,
+  origin = 0,
   margin = AE_SCREEN_MARGIN,
 ): number {
-  const fitted = Math.max(margin, Math.min(left, viewport - margin - width));
+  const fitted = Math.max(origin + margin, Math.min(left, origin + viewport - margin - width));
   return Math.round(fitted - left);
 }
 
-/** The width the user can see: the visual viewport shrinks under pinch-zoom on iOS. */
-function visibleWidth(): number {
-  return window.visualViewport?.width ?? window.innerWidth;
+/** The band the user can see: under pinch-zoom on iOS the visual viewport shrinks and pans. */
+function visibleBand(): { origin: number; width: number } {
+  const vv = window.visualViewport;
+  return vv ? { origin: vv.offsetLeft, width: vv.width } : { origin: 0, width: window.innerWidth };
 }
 
 /** Shift `node` inside the screen now and whenever Radix repositions its wrapper. */
@@ -31,7 +36,8 @@ export function aeKeepOnScreen(node: HTMLElement): () => void {
   if (!wrapper) return () => {};
   const fit = () => {
     const box = wrapper.getBoundingClientRect();
-    const shift = aeScreenShift(box.left, box.width, visibleWidth());
+    const { origin, width } = visibleBand();
+    const shift = aeScreenShift(box.left, box.width, width, origin);
     node.style.position = "relative";
     node.style.left = shift === 0 ? "" : `${shift}px`;
   };
@@ -41,11 +47,13 @@ export function aeKeepOnScreen(node: HTMLElement): () => void {
   observer.observe(wrapper, { attributes: true, attributeFilter: ["style"] });
   window.addEventListener("resize", fit);
   window.visualViewport?.addEventListener("resize", fit);
+  window.visualViewport?.addEventListener("scroll", fit);
   return () => {
     cancelAnimationFrame(frame);
     observer.disconnect();
     window.removeEventListener("resize", fit);
     window.visualViewport?.removeEventListener("resize", fit);
+    window.visualViewport?.removeEventListener("scroll", fit);
   };
 }
 
