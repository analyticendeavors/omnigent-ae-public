From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Wed, 11 Nov 2026 19:23:59 -0800
Subject: [PATCH 362/443] [ae-patch] Tell agents when to call ask_judge

The lead's roles text gets one line on when to call ask_judge, shown only when the server sets a judge flag for an owner the judge is available to.
---
 omnigent/inner/ae_roles.py   | 31 +++++++++++++++++++++++--
 tests/inner/test_ae_roles.py | 45 ++++++++++++++++++++++++++++++++++++
 2 files changed, 74 insertions(+), 2 deletions(-)

diff --git a/omnigent/inner/ae_roles.py b/omnigent/inner/ae_roles.py
index 452864760d820adc0f345727dfe02e5294ff28bc..6fb945e60d5c157810f112c69141166f2ada2c72 100644
--- a/omnigent/inner/ae_roles.py
+++ b/omnigent/inner/ae_roles.py
@@ -223,6 +223,8 @@ def resolve_roles(conv: Conversation, store: ConversationStore) -> dict[str, Any
     roles = _own_helpers(roles) if _legacy_solo(conv) else roles
     roles = ae_reviewers.resolve_agents(roles, _agent_lookup(store))
     roles = ae_reviewers.attach_personas(roles, ae_reviewers.persona_lookup(_owner(conv, store)))
+    if _judge_available(_owner(conv, store)):
+        roles = {**roles, "judge": True}
     return {**roles, "current": _current_ids()}
 
 
@@ -578,13 +580,38 @@ def _advisor_line(roles: dict[str, Any]) -> str | None:
     )
 
 
+def _judge_available(owner: str) -> bool:
+    """Whether ``ask_judge`` is shown to this owner: the same answer as ``GET /v1/ae/decision``."""
+    try:
+        from ae_omni_policies import decision_status
+
+        return decision_status.reason(owner) is None
+    except Exception:  # noqa: BLE001 (a missing or broken judge must never block a turn)
+        return False
+
+
+_JUDGE_LINE = (
+    "Decision-1 judge: before you settle one of these yourself, call ask_judge: picking "
+    "between two or more approaches, full test suite or scoped tests, asking for review now "
+    "or fixing more, or whether work is ready to hand off. In Claude Code it is a deferred "
+    'tool: load it first with ToolSearch query "select:mcp__ae__ask_judge" (Codex: call it '
+    "directly). Write the question in neutral words with no names, paths or quoted text. If "
+    "it answers with low_confidence, errors, or is missing, decide yourself."
+)
+
+
 def _tools(roles: dict[str, Any]) -> str:
-    """The Agent tool sentence for the lead, plus how to name a role on each start."""
+    """The Agent tool sentence for the lead, plus how to name a role on each start.
+
+    When the server set the ``judge`` flag, the ask_judge line rides on the same line (the
+    block stays under its line budget).
+    """
     session = roles.get("lead_session")
     base = _TOOLS_OTHER if isinstance(session, dict) and session.get("claude") is False else _TOOLS
     # Native subagents apply under "own" too; create_session does not.
     named = [_SUBAGENT_ROLE] if helpers_of(roles) == OWN else [_SESSION_ROLE, _SUBAGENT_ROLE]
-    return " ".join([base, *named, _REPORT_REVIEW])
+    extra = [_JUDGE_LINE] if roles.get("judge") is True else []
+    return " ".join([base, *named, _REPORT_REVIEW, *extra])
 
 
 def render_roles(roles: object) -> str | None:
diff --git a/tests/inner/test_ae_roles.py b/tests/inner/test_ae_roles.py
index e60624d07b84fc53ca511e330c1cbb58b3d242a4..a82da2baa3be4317e2da53e64c89902367205e3d 100644
--- a/tests/inner/test_ae_roles.py
+++ b/tests/inner/test_ae_roles.py
@@ -1236,3 +1236,48 @@ def test_worker_agent_slots_get_the_live_id_by_name() -> None:
     preset = _with_worker("builder", {**CODEX, "agent": "stale"})
     out = ae_reviewers.resolve_agents({"preset": preset}, lambda name: "live-id")
     assert out["preset"]["roles"]["builder"]["agent"] == "live-id"
+
+
+def test_the_judge_line_renders_only_when_the_flag_is_true(prefs: dict[str, Any]) -> None:
+    prefs["presets"] = [BALANCED, YOLO]
+    for pick in ("lead-picks", "balanced"):
+        roles = resolve_roles(conversation(team_label(roles={"preset": pick})), owner_store())
+        base = render_roles(roles) or ""
+        assert "ask_judge" not in base
+        on = render_roles({**roles, "judge": True}) or ""
+        assert on.count("Decision-1 judge: before you settle one of these yourself") == 1
+        assert 'ToolSearch query "select:mcp__ae__ask_judge"' in on
+        assert "decide yourself." in on
+        assert len(on.splitlines()) == len(base.splitlines())  # folded in, no extra line
+        assert "ask_judge" not in (render_roles({**roles, "judge": False}) or "")
+        assert "ask_judge" not in (render_roles({**roles, "judge": "yes"}) or "")
+
+
+def test_resolve_roles_sets_the_judge_flag_server_side(
+    prefs: dict[str, Any], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    from ae_omni_policies import decision_status
+
+    prefs["presets"] = [BALANCED, YOLO]
+    seen: list[str | None] = []
+
+    def reason(caller: str | None) -> str | None:
+        seen.append(caller)
+        return None
+
+    monkeypatch.setattr(decision_status, "reason", reason)
+    for pick in ("lead-picks", "balanced"):
+        labels = team_label(roles={"preset": pick})
+        roles = resolve_roles(conversation(labels), owner_store())
+        assert roles["judge"] is True
+        assert "ask_judge" in (render_roles(roles) or "")
+    assert seen == ["local", "local"]
+
+    monkeypatch.setattr(decision_status, "reason", lambda caller: "not_allowed")
+    assert "judge" not in resolve_roles(conversation(labels), owner_store())
+
+    def boom(caller: str | None) -> str | None:
+        raise RuntimeError("broken")
+
+    monkeypatch.setattr(decision_status, "reason", boom)
+    assert "judge" not in resolve_roles(conversation(labels), owner_store())
