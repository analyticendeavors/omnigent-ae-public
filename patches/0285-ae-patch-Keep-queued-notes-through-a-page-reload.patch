+
+  it("drops notes stored for another signed-in user", async () => {
+    vi.spyOn(console, "info").mockImplementation(() => {});
+    identity.userId = "bob";
+    seed([entry("a")], { userId: "alice" });
+    await install();
+    expect(queue()).toEqual([]);
