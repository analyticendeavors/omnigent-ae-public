+    expect(toasts).toHaveLength(1);
+    expect(toasts[0]).toContain("3 queued notes came back");
+    expect(toasts[0]).toContain("2 wait for Retry");
+    expect(toasts[0]).toContain("attachments");
+    expect(toasts[0]).toContain("over an hour ago");
