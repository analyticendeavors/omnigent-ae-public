+
+  it("holds every note back when the browser has no Web Locks", async () => {
+    setLocks(undefined);
+    seed([entry("a")]);
+    await install();
+    expect(queue().map((m) => [m.text, m.requiresRetry])).toEqual([["a", true]]);
+    expect(toasts).toHaveLength(1);
