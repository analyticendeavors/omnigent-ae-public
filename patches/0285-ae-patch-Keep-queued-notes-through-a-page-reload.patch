+
+  it("mints a stable id for a stored note without one", async () => {
+    seed([{ text: "old", conversationId: CONV, firstSeenAt: Date.now() }]);
+    await install();
+    const [m] = queue();
+    expect(m!.stableId).toMatch(/^[0-9a-f]{32}$/);
+    expect(m!.queueId).toBe(`q_ae_${m!.stableId}`);
