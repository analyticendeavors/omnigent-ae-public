+      word: `merged ${clock}`,
+      tone: "done",
+      icon: "filled",
+      dim: false,
+    });
+  });
+
+  it("dims a pull request closed without merging", () => {
+    expect(aePrReceipt(card({ state: "closed" }))).toEqual({
+      word: "closed",
+      tone: "gray",
+      icon: "ring",
+      dim: true,
