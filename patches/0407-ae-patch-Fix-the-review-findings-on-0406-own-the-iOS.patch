+    getVoiceSnapshot("c1");
+    setVoiceOn("c1", true);
     setVoiceOn("c1", false);
     expect(session().type).toBe("auto");
+    expect(formatVoiceLog()).not.toContain("audio session");
+  });
+
+  it("the arm holds the session; disarm before a chat exists releases it", () => {
+    setUa(IOS_UA);
+    setSession("auto");
     armVoiceForNextChat();
     expect(session().type).toBe("play-and-record");
