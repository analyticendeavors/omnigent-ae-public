From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Sat, 17 Oct 2026 12:33:36 -0700
Subject: [PATCH 079/191] [ae-patch] Fix the review findings on per-session
 usage: write the account file first, drop unused context fields

The statusLine shim wrote the capture before the account file, so a reader
could pair a new capture with the previous launch's account; the account file
now comes first. The relay now posts each session's windows and account in
their own list, so the web's session context type drops the fields it never
read.
---
 omnigent/harnesses/claude_native/bridge.py | 8 +++++---
 web/src/components/AePlanLimits.tsx        | 6 ------
 2 files changed, 5 insertions(+), 9 deletions(-)

diff --git a/omnigent/harnesses/claude_native/bridge.py b/omnigent/harnesses/claude_native/bridge.py
index 48c5b9d407204cc00df659669cd9105ddea25b9d..7dfee7e61df41a63558c1e13f5f4c6f35f8f8059 100644
--- a/omnigent/harnesses/claude_native/bridge.py
+++ b/omnigent/harnesses/claude_native/bridge.py
@@ -2592,11 +2592,13 @@ def build_hook_settings(
     # The account sidecar records which Claude login renders this bar
     # (empty for the default one) so usage readers can key limits by account.
     account_quoted = shlex.quote(str(bridge_dir / CLAUDE_ACCOUNT_FILE))
+    # Written before the capture, so a reader never pairs a new capture with
+    # the previous launch's account.
     status_command = (
-        f"p=$(cat); printf '%s' \"$p\" > {raw_quoted}.$$.tmp"
-        f" && mv -f {raw_quoted}.$$.tmp {raw_quoted}"
-        f"; printf '%s' \"${{OMNIGENT_CLAUDE_ACCOUNT-}}\" > {account_quoted}.$$.tmp"
+        f"p=$(cat); printf '%s' \"${{OMNIGENT_CLAUDE_ACCOUNT-}}\" > {account_quoted}.$$.tmp"
         f" && mv -f {account_quoted}.$$.tmp {account_quoted}"
+        f"; printf '%s' \"$p\" > {raw_quoted}.$$.tmp"
+        f" && mv -f {raw_quoted}.$$.tmp {raw_quoted}"
     )
     chain_command = read_user_status_line_command()
     if chain_command is not None:
diff --git a/web/src/components/AePlanLimits.tsx b/web/src/components/AePlanLimits.tsx
index 28d5be1d3b3871fc6f28163b886ddbc4b85bcab9..c9aee35e678dd8227b20c881623d0fee146d2607 100644
--- a/web/src/components/AePlanLimits.tsx
+++ b/web/src/components/AePlanLimits.tsx
@@ -76,12 +76,6 @@ export interface AeSessionContext {
   input_tokens: number;
   cache_write_tokens: number;
   cache_read_tokens: number;
-  // Absent from a server older than per-session accounts.
-  /** The backup account this session runs on; null or absent = the box's default login. */
-  account?: string | null;
-  account_label?: string | null;
-  /** That account's own plan windows, when the session is on a backup account. */
-  windows?: AeLimitWindow[];
 }
 
 export interface AeLimitSnapshot {
