+/* Token defrag (omnigent-ae): the composer tray's compaction strip and its hidden
+   Win98-style window. Pills are positioned by the frame loop, so they carry no
+   transitions except the final pour into the context ring. */
+
+.ae-defrag {
+  --ae-defrag-message: oklch(70.4% 0.14 182.5);
+  --ae-defrag-summary: var(--brand-accent);
+  display: flex;
+  flex: 1 1 auto;
+  align-items: center;
+  gap: 0.5rem;
+  min-width: 0;
+  height: 100%;
+  margin: 0 0.25rem 0 0.5rem;
+  padding: 0;
+  border: 0;
+  background: transparent;
+  color: var(--muted-foreground);
+  font: inherit;
+  font-size: 0.75rem;
+  cursor: default;
+}
+
+.ae-defrag:focus-visible {
+  outline: 2px solid var(--ring);
+  outline-offset: 2px;
+  border-radius: 6px;
+}
+
+.ae-defrag-strip {
+  position: relative;
+  flex: 1 1 auto;
+  min-width: 0;
+  height: 100%;
+  overflow: hidden;
+  mask-image: linear-gradient(90deg, #000 82%, transparent);
+}
+
+.ae-defrag[data-state="failed"] .ae-defrag-strip {
+  opacity: 0.35;
+  transition: opacity 600ms ease;
+  animation: ae-defrag-shake 240ms ease-in-out 2;
+}
+
+.ae-defrag-pill,
+.ae-defrag-ghost {
+  position: absolute;
+  top: 50%;
+  left: 0;
+  height: 8px;
+  margin-top: -4px;
+  border-radius: 4px;
+}
+
+.ae-defrag-pill {
+  will-change: transform;
+}
+
+.ae-defrag-pill[data-kind="message"] {
+  background: var(--ae-defrag-message);
+}
+
+.ae-defrag-pill[data-kind="summary"] {
+  z-index: 1;
+  background: var(--ae-defrag-summary);
+  transition: box-shadow 160ms ease;
+}
+
+.ae-defrag-pill[data-kind="summary"][data-gulp] {
+  box-shadow: 0 0 8px color-mix(in oklch, var(--ae-defrag-summary) 85%, transparent);
+}
+
+.ae-defrag-pill[data-docked] {
+  z-index: 2;
+}
+
+.ae-defrag-pill[data-flying] {
+  z-index: 3;
+  box-shadow: 0 3px 8px color-mix(in oklch, var(--ae-defrag-message) 60%, transparent);
+}
+
+.ae-defrag-ghost {
+  outline: 1px dashed color-mix(in oklch, var(--muted-foreground) 45%, transparent);
+  outline-offset: -1px;
+  transition: opacity 700ms ease;
+}
+
+.ae-defrag-pill.ae-defrag-pour {
+  transition:
+    transform 520ms cubic-bezier(0.55, 0, 0.75, 0.4),
+    width 520ms ease,
+    opacity 420ms ease 120ms;
+}
+
+.ae-defrag-label {
+  flex: 0 1 auto;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  font-variant-numeric: tabular-nums;
+  transition: opacity 300ms ease;
+}
+
+.ae-defrag-label[data-landed] {
+  opacity: 0;
+}
+
+.ae-defrag[data-state="failed"] .ae-defrag-label {
+  color: var(--destructive);
+}
+
+@keyframes ae-defrag-shake {
+  0%,
+  100% {
+    transform: none;
+  }
+  25% {
+    transform: translateX(-2px);
+  }
+  75% {
+    transform: translateX(2px);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .ae-defrag-pill,
+  .ae-defrag-pill.ae-defrag-pour,
+  .ae-defrag-ghost {
+    transition: none;
+  }
+
+  .ae-defrag[data-state="failed"] .ae-defrag-strip {
+    animation: none;
+  }
+}
+
+/* The hidden window: a Win98 Disk Defragmenter drawn in CSS. */
+
