Date: Mon, 23 Nov 2026 22:36:25 -0800
Subject: [PATCH 443/443] [ae-patch] The Stop hook's completed idle edge
 carries the background shell count

Observers of the turn-edge registry learn how many background shells were still running when a claude-native turn ended. The count already reached the server through the Stop hook but lived only in an in-memory cache that a server restart empties; handing it to observers lets an out-of-tree policy persist it.
---
 omnigent/server/ae_turn_edges.py              |  6 ++++-
 .../server/routes/sessions/routes_events.py   |  6 ++++-
 tests/server/test_ae_turn_edges.py            | 26 +++++++++++++++++++
 3 files changed, 36 insertions(+), 2 deletions(-)

diff --git a/omnigent/server/ae_turn_edges.py b/omnigent/server/ae_turn_edges.py
index ed1e0ee843a9506ba99c02a3d7a839a796c125ce..089a1ceb619110e103c6abd3bc267c8f9269659e 100644
--- a/omnigent/server/ae_turn_edges.py
+++ b/omnigent/server/ae_turn_edges.py
@@ -36,12 +36,15 @@ class TurnEdge:
         ``prompt`` (a claude-native UserPromptSubmit: a turn opened, no status published).
     :param response_id: The response id the edge carried, if any.
     :param turn_completed: ``True`` only for the Stop hook's idle edge.
+    :param background_task_count: Background shells still running, sent only on the
+        Stop hook's idle edge (``0`` when none); ``None`` on every other edge.
     """
 
     session_id: str
     status: str
     response_id: str | None = None
     turn_completed: bool = False
+    background_task_count: int | None = None
 
 
 TurnEdgeObserver = Callable[[TurnEdge], None]
@@ -72,11 +75,12 @@ def notify_turn_edge(
     *,
     response_id: str | None = None,
     turn_completed: bool = False,
+    background_task_count: int | None = None,
 ) -> None:
     """Hand one edge to every observer; an observer's failure never reaches the caller."""
     if not _observers:
         return
-    edge = TurnEdge(session_id, status, response_id, turn_completed)
+    edge = TurnEdge(session_id, status, response_id, turn_completed, background_task_count)
     for observer in list(_observers):
         try:
             observer(edge)
