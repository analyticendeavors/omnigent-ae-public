 web/src/components/AePrCards.test.tsx | 27 ++++++++++
 web/src/components/AePrCards.tsx      | 73 +++++++++++++++++++--------
 2 files changed, 79 insertions(+), 21 deletions(-)

diff --git a/web/src/components/AePrCards.test.tsx b/web/src/components/AePrCards.test.tsx
