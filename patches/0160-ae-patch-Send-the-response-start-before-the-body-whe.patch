From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Fri, 23 Oct 2026 11:45:45 -0700
Subject: [PATCH 160/260] [ae-patch] Send the response start before the body
 when a binary file read skips gzip

Starlette 1.9 decides at the start message whether a response is excluded from compression. The skip_gzip opt-out only set the flag on the first body message and relied on Starlette to emit the buffered start, so the body reached the client first and the metrics middleware answered 500 for every image, video and PDF read. The responder now sends the start itself, which Starlette 1.3 and 1.9 both accept. A test drives the responder directly and checks the message order.
---
 omnigent/server/routes/_gzip_route.py         | 17 ++++-
 tests/server/routes/test_session_resources.py | 76 +++++++++++++++++++
 2 files changed, 91 insertions(+), 2 deletions(-)

diff --git a/omnigent/server/routes/_gzip_route.py b/omnigent/server/routes/_gzip_route.py
index 71477a690d4e3f1ec4bded4edfe3b09ec6faa1b6..d12b3b3a289a93812cbc61a5caf3d602be6438e7 100644
--- a/omnigent/server/routes/_gzip_route.py
+++ b/omnigent/server/routes/_gzip_route.py
@@ -128,14 +128,27 @@ class _StateAwareGZipResponder(GZipResponder):
         :param message: The outgoing ASGI message.
         :returns: None.
         """
+        already_passing_through = (
+            self.content_encoding_set
+            or getattr(self, "partial_response", False)
+            or self.content_type_is_excluded
+        )
         if (
             message["type"] == "http.response.body"
             and not self.started
+            and not already_passing_through
             and self._state.get(SKIP_GZIP_STATE_KEY)
         ):
-            # Starlette reads this flag on the first body message, then emits
-            # the start message it buffered — untouched.
+            # Starlette 1.3 read this flag on the first body message and then
+            # emitted the start message it had buffered. Starlette 1.9 decides at
+            # the start message instead, so the buffered start is never sent and
+            # the body reaches the client first (a 500 from the metrics
+            # middleware). Send the start here, which both versions accept.
             self.content_type_is_excluded = True
+            self.started = True
+            await self.send(self.initial_message)
+            await self.send(message)
+            return
         await super().send_with_compression(message)
 
 
