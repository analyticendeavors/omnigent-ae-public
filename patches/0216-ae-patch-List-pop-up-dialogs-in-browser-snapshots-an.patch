diff --git a/web/electron/test/aeBrowserCapture.test.js b/web/electron/test/aeBrowserCapture.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..a3b4a60c186df580d33b803ad098fc950d0b2810
--- /dev/null
+++ b/web/electron/test/aeBrowserCapture.test.js
@@ -0,0 +1,163 @@
+// Tests for src/aeBrowserCapture.js, run with `node --test`. Fake view, window
+// and image objects; no Electron.
+
+const { describe, it } = require("node:test");
+const assert = require("node:assert/strict");
+
+const { captureBrowserView } = require("../src/aeBrowserCapture");
+
+const png = (empty) => ({
+  isEmpty: () => empty,
+  getSize: () => (empty ? { width: 0, height: 0 } : { width: 10, height: 10 }),
+  toPNG: () => Buffer.from("PNG"),
+});
+const DATA_URL = `data:image/png;base64,${Buffer.from("PNG").toString("base64")}`;
+
+/** captures: array of "empty" | "full" | "hang" | Error, consumed in order (last repeats). */
+function setup({ attached = false, captures = ["full"], active = null, visible = true } = {}) {
+  const log = [];
+  let bounds = { x: 5, y: 6, width: 300, height: 200 };
+  let vis = visible;
+  let n = 0;
+  const view = {
+    getBounds: () => ({ ...bounds }),
+    setBounds: (b) => {
+      bounds = { ...b };
+      log.push(["setBounds", { ...b }]);
+    },
+    getVisible: () => vis,
+    setVisible: (v) => {
+      vis = v;
+      log.push(["setVisible", v]);
+    },
+    webContents: {
+      capturePage: () => {
+        log.push(["capture", { ...bounds }]);
+        const step = captures[Math.min(n++, captures.length - 1)];
+        if (step === "hang") return new Promise(() => {});
+        if (step instanceof Error) return Promise.reject(step);
+        return Promise.resolve(png(step === "empty"));
+      },
+    },
+  };
+  const children = attached ? [view] : [];
+  const win = {
+    contentView: {
+      children,
+      addChildView: (v, i) => {
+        children.splice(i ?? children.length, 0, v);
+        log.push(["add", i]);
+      },
+      removeChildView: (v) => {
+        children.splice(children.indexOf(v), 1);
+        log.push(["remove"]);
+      },
+    },
+    getContentBounds: () => ({ x: 0, y: 0, width: 1000, height: 700 }),
+  };
+  const entry = {
+    view,
+    boundsController: { resync: () => log.push(["resync"]) },
+  };
+  const registry = { activeConversationId: () => active };
+  const state = () => ({ bounds, vis, children });
+  return { log, view, win, entry, registry, state };
+}
+
+const run = (s, extra = {}) =>
+  captureBrowserView({
+    registry: s.registry,
+    conversationId: "c1",
+    entry: s.entry,
+    win: s.win,
+    wait: async () => {},
+    ...extra,
+  });
+
+describe("captureBrowserView", () => {
+  it("captures an attached view without touching children", async () => {
+    const s = setup({ attached: true, active: "c1" });
+    const r = await run(s);
+    assert.deepEqual(r, { ok: true, dataUrl: DATA_URL });
+    assert.deepEqual(
+      s.log.map((l) => l[0]),
+      ["capture"],
+    );
+  });
+
+  it("stages a detached view at index 0 offscreen and restores it", async () => {
+    const s = setup({ active: "other", visible: false });
+    const r = await run(s);
+    assert.equal(r.ok, true);
+    const add = s.log.findIndex((l) => l[0] === "add");
+    assert.equal(s.log[add][1], 0);
+    const cap = s.log.find((l) => l[0] === "capture");
+    assert.deepEqual(cap[1], { x: 999, y: 699, width: 300, height: 200 });
+    assert.equal(s.state().children.length, 0);
+    assert.deepEqual(s.state().bounds, { x: 5, y: 6, width: 300, height: 200 });
+    assert.equal(s.state().vis, false);
+  });
+
+  it("uses the window size when saved bounds are empty", async () => {
+    const s = setup({ active: "other" });
+    s.view.setBounds({ x: 0, y: 0, width: 0, height: 0 });
+    await run(s);
+    const cap = s.log.find((l) => l[0] === "capture");
+    assert.deepEqual(cap[1], { x: 999, y: 699, width: 1000, height: 700 });
+  });
+
+  it("retries a never-painted view until it paints", async () => {
+    const s = setup({ active: "other", captures: ["empty", "empty", "full"] });
+    const r = await run(s);
+    assert.equal(r.ok, true);
+    assert.equal(s.log.filter((l) => l[0] === "capture").length, 3);
+  });
+
+  it("errors and cleans up when still empty after maxWaitMs", async () => {
+    const s = setup({ active: "other", captures: ["empty"] });
+    const r = await run(s, { retryMs: 50, maxWaitMs: 100 });
+    assert.equal(r.ok, false);
+    assert.match(r.error, /not painted yet/);
+    assert.equal(s.state().children.length, 0);
+    assert.deepEqual(s.state().bounds, { x: 5, y: 6, width: 300, height: 200 });
+  });
+
+  it("leaves the view attached and resyncs when the chat became active", async () => {
+    const s = setup({ active: "c1" });
+    const r = await run(s);
+    assert.equal(r.ok, true);
+    assert.equal(s.state().children.length, 1);
+    assert.ok(s.log.some((l) => l[0] === "resync"));
+    assert.ok(!s.log.some((l) => l[0] === "remove"));
+  });
+
+  it("times out on a hang and cleans up", async () => {
+    const s = setup({ active: "other", captures: ["hang"] });
+    const r = await run(s, { timeoutMs: 20 });
+    assert.equal(r.ok, false);
+    assert.match(r.error, /screenshot timed out after 0 s/);
+    assert.equal(s.state().children.length, 0);
+    assert.deepEqual(s.state().bounds, { x: 5, y: 6, width: 300, height: 200 });
+  });
+
+  it("reports a 10 s timeout message by default seconds", async () => {
+    const s = setup({ attached: true, active: "c1", captures: ["hang"] });
+    const r = await run(s, { timeoutMs: 1000 });
+    assert.match(r.error, /timed out after 1 s: the browser view did not paint/);
+  });
+
+  it("returns the rejection message and cleans up", async () => {
+    const s = setup({ active: "other", captures: [new Error("UnknownVizError")] });
+    const r = await run(s);
+    assert.deepEqual(r, { ok: false, error: "UnknownVizError" });
+    assert.equal(s.state().children.length, 0);
+  });
+
+  it("serializes concurrent captures of one view", async () => {
+    const s = setup({ active: "other" });
+    const [a, b] = await Promise.all([run(s), run(s)]);
+    assert.equal(a.ok && b.ok, true);
+    const seq = s.log.map((l) => l[0]).filter((k) => k === "add" || k === "remove");
+    assert.deepEqual(seq, ["add", "remove", "add", "remove"]);
+  });
+});
diff --git a/web/src/hooks/useBrowserAgentRelay.snapshot.test.ts b/web/src/hooks/useBrowserAgentRelay.snapshot.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ff19278d8dea4648fdd2147191443220b06cf01c
--- /dev/null
+++ b/web/src/hooks/useBrowserAgentRelay.snapshot.test.ts
@@ -0,0 +1,99 @@
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+
+import { SNAPSHOT_JS } from "./useBrowserAgentRelay";
+
+// jsdom has no layout, so size comes from a `data-size="WxH"` attribute
+// (default 100x20) on the element.
+const realRect = Element.prototype.getBoundingClientRect;
+
+beforeEach(() => {
+  Element.prototype.getBoundingClientRect = function (this: Element) {
+    const [w, h] = (this.getAttribute("data-size") ?? "100x20").split("x").map(Number);
+    return { x: 0, y: 0, top: 0, left: 0, right: w, bottom: h, width: w, height: h, toJSON() {} };
+  };
+});
+
+afterEach(() => {
+  Element.prototype.getBoundingClientRect = realRect;
+  document.body.innerHTML = "";
+});
+
+function snapshot(): { tree: string } {
+  return JSON.parse((0, eval)(SNAPSHOT_JS));
+}
+
+const DIALOG = `
+  <div role="dialog" style="position:fixed">
+    <h2>Add link</h2>
+    <input type="radio" aria-label="YouTube">
+    <input placeholder="Title">
+  </div>`;
+
+describe("SNAPSHOT_JS visibility walk", () => {
+  it("lists a dialog rendered inside a zero-size portal root", () => {
+    document.body.innerHTML = `<h1>hello</h1><div data-size="0x0" style="position:absolute">${DIALOG}</div>`;
+    const { tree } = snapshot();
+    expect(tree).toContain('heading "hello"');
+    expect(tree).toContain('dialog');
+    expect(tree).toContain('heading "Add link"');
+    expect(tree).toContain('radio "YouTube"');
+    expect(tree).toContain('textbox "Title"');
+  });
+
+  it("lists children of a display:contents wrapper", () => {
+    document.body.innerHTML = `<div data-size="0x0" style="display:contents"><button>Go</button></div>`;
+    expect(snapshot().tree).toContain('button "Go"');
+  });
+
+  it("skips children of a zero-height overflow:hidden container", () => {
+    document.body.innerHTML = `<div data-size="100x0" style="overflow-x:hidden;overflow-y:hidden"><button>Hidden</button></div><button>Shown</button>`;
+    const { tree } = snapshot();
+    expect(tree).not.toContain("Hidden");
+    expect(tree).toContain("Shown");
+  });
+
+  it("skips display:none and opacity:0 subtrees", () => {
+    document.body.innerHTML = `
+      <div style="display:none"><button>NoneBtn</button></div>
+      <div style="opacity:0"><button>FadedBtn</button></div>
+      <button>Visible</button>`;
+    const { tree } = snapshot();
+    expect(tree).not.toContain("NoneBtn");
+    expect(tree).not.toContain("FadedBtn");
+    expect(tree).toContain("Visible");
+  });
+
+  it("does not list a visibility:hidden element itself", () => {
+    document.body.innerHTML = `<button style="visibility:hidden">Ghost</button><button>Real</button>`;
+    const { tree } = snapshot();
+    expect(tree).not.toContain("Ghost");
+    expect(tree).toContain("Real");
+  });
+
+  it("walks open shadow roots", () => {
+    document.body.innerHTML = `<div id="host"></div>`;
+    const root = document.getElementById("host")!.attachShadow({ mode: "open" });
+    root.innerHTML = `<button>InShadow</button>`;
+    expect(snapshot().tree).toContain('button "InShadow"');
+  });
+
+  it("walks a same-origin iframe body", () => {
+    document.body.innerHTML = `<iframe></iframe>`;
+    const frame = document.querySelector("iframe")!;
+    // The frame is another realm: give its Element.prototype the same size stub.
+    (frame.contentWindow as unknown as Window & typeof globalThis).Element.prototype.getBoundingClientRect =
+      Element.prototype.getBoundingClientRect;
+    const doc = frame.contentDocument!;
+    doc.body.innerHTML = `<button>InFrame</button>`;
+    expect(snapshot().tree).toContain('button "InFrame"');
+  });
+
+  it("keeps refs for portal content in window.__omni_refs__", () => {
+    document.body.innerHTML = `<div data-size="0x0">${DIALOG}</div>`;
+    const { tree } = snapshot();
+    const ref = Number(/radio "YouTube" \[ref=(\d+)\]/.exec(tree)![1]);
+    const refs = (window as unknown as { __omni_refs__: Map<number, WeakRef<Element>> })
+      .__omni_refs__;
+    expect(refs.get(ref)!.deref()).toBe(document.querySelector('input[type="radio"]'));
+  });
+});
