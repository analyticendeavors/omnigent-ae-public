From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Fri, 20 Nov 2026 10:58:37 -0800
Subject: [PATCH 432/443] [ae-patch] Let an extension page's Download button
 save a file (allow-downloads in its frame sandbox)

---
 web/src/extensions/ExtensionViewHost.test.tsx | 2 +-
 web/src/extensions/ExtensionViewHost.tsx      | 4 +++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/web/src/extensions/ExtensionViewHost.test.tsx b/web/src/extensions/ExtensionViewHost.test.tsx
index fcb242f06cdfffdefead192b9500c124dd36ed26..6cccaccd16ccfcbeb70f4a9e52c90958f48530be 100644
--- a/web/src/extensions/ExtensionViewHost.test.tsx
+++ b/web/src/extensions/ExtensionViewHost.test.tsx
@@ -69,7 +69,7 @@ describe("ExtensionViewHost", () => {
   it("uses an opaque sandbox and becomes ready only after the nonce-bound handshake", async () => {
     render(<ExtensionViewHost extension={extension} page={page} refresh={refresh} />);
     const iframe = await screen.findByTitle("Dashboard");
-    expect(iframe).toHaveAttribute("sandbox", "allow-scripts");
+    expect(iframe).toHaveAttribute("sandbox", "allow-scripts allow-downloads");
     expect(iframe).toHaveAttribute("allow", "");
     expect(iframe).toHaveClass("min-h-0", "flex-1");
     expect(iframe.parentElement).toHaveClass("extension-view-host", "pt-14", "md:pt-12");
diff --git a/web/src/extensions/ExtensionViewHost.tsx b/web/src/extensions/ExtensionViewHost.tsx
index df137aa042f2777ba9c1809afe99ef5f44231efd..56136e0b3f2b80794dbef00ed15aed8879293da4 100644
--- a/web/src/extensions/ExtensionViewHost.tsx
+++ b/web/src/extensions/ExtensionViewHost.tsx
@@ -305,7 +305,9 @@ export function ExtensionViewHost({
           key={frameDocument.identity.nonce}
           ref={iframeRef}
           title={page.title}
-          sandbox="allow-scripts"
+          // allow-downloads (AE, 2026-11-20): a page's own Download button (a blob link with
+          // `download`) saves a file; without it the frame drops the save with no message.
+          sandbox="allow-scripts allow-downloads"
           allow=""
           srcDoc={frameDocument.srcDoc}
           onLoad={handleLoad}
