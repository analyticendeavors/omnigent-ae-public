 web/src/components/ui/kbd.tsx  | 2 +-
 web/src/shell/Sidebar.test.tsx | 2 ++
 web/src/shell/Sidebar.tsx      | 4 ++--
 3 files changed, 5 insertions(+), 3 deletions(-)

