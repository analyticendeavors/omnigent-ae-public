From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Tue, 20 Oct 2026 21:25:18 -0700
Subject: [PATCH 136/191] [ae-patch] Fill the chat column with assistant text
 and align replies, PR rows and the composer on one right edge

Assistant text was capped at 80ch while user bubbles, merged PR rows, inline PR cards and the composer sat on a wider column, so the right edges never lined up. The assistant cap is now the full column (about 110 characters at the 120ch tier), and the merged PR fold and inline PR card are full width instead of a fixed w-xl. Above 1920px the chat column stays 48rem instead of growing to 56rem, which left text at 80ch beside a wide empty strip.
---
 web/src/components/AeMergedPrFold.tsx | 2 +-
 web/src/components/AePrCards.tsx      | 2 +-
 web/src/index.css                     | 2 +-
 web/src/pages/chatLayout.ts           | 2 +-
 4 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/web/src/components/AeMergedPrFold.tsx b/web/src/components/AeMergedPrFold.tsx
index 3787f277b624b836857cc4810779d43ba4220a80..3f4ff760811675b85bb957308f5d465ade111e8a 100644
--- a/web/src/components/AeMergedPrFold.tsx
+++ b/web/src/components/AeMergedPrFold.tsx
@@ -125,7 +125,7 @@ export function AeMergedPrFold({
   return (
     <div
       data-testid="ae-pr-fold"
-      className="mt-2 w-xl max-w-full rounded-lg border border-border bg-background"
+      className="mt-2 w-full rounded-lg border border-border bg-background"
     >
       {/* The toggle's ::after covers the row, so a click anywhere but a number
           opens the fold; the numbers sit above it as links of their own. */}
diff --git a/web/src/components/AePrCards.tsx b/web/src/components/AePrCards.tsx
index 62ca2530ba15e997195d46c324b752e4dfe1293e..beb3d562fb01128bca3a9024a304d5e5e2f38558 100644
--- a/web/src/components/AePrCards.tsx
+++ b/web/src/components/AePrCards.tsx
@@ -719,7 +719,7 @@ export function AePrCardView({
         "@container/aepr flex flex-col gap-1.5 rounded-lg border border-border bg-background px-3 py-2",
         // A set width, not max-w only: the container ignores its content, so
         // the chat's w-fit bubble would shrink the card to the message text.
-        inline && "mt-2 w-xl max-w-full",
+        inline && "mt-2 w-full",
       )}
     >
       {/* One link for the whole header: the state, the title on up to two
diff --git a/web/src/index.css b/web/src/index.css
index 8467d90ba390932689d2da58ec693ed932b073e1..7e1abfc74bcd5703761107ad6784828784e1326f 100644
--- a/web/src/index.css
+++ b/web/src/index.css
@@ -1515,7 +1515,7 @@ html[data-electron-mac] .breadcrumb-folder {
 }
 
 .is-assistant {
-  --chat-prose-width: 80ch;
+  --chat-prose-width: 100%;
 }
 
 @container chat-column (min-width: 64rem) {
