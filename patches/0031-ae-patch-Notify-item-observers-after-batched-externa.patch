From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 13 Oct 2026 16:26:02 +0000
Subject: [PATCH 031/159] [ae-patch] Notify item observers after batched
 external items persist

The claude-native forwarder posts a sub-agent transcript as one array, and
_persist_external_conversation_items appends a run of those items in one
store call without reaching notify_items_persisted, so the AE observer never
saw them. One call after the append, the same filter as the per-entry path
(deduplicated re-posts are skipped), and a test that posts an array.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../server/routes/_sessions/orchestration.py  |  1 +
 tests/server/test_item_observers.py           | 33 +++++++++++++++++++
 2 files changed, 34 insertions(+)

diff --git a/omnigent/server/routes/_sessions/orchestration.py b/omnigent/server/routes/_sessions/orchestration.py
index 2b36f82fcb87a1a6b1e690d053a5fb898ee4bfc1..85f511bd0077fe63dba92d7231f0e3cc7dc9849d 100644
--- a/omnigent/server/routes/_sessions/orchestration.py
+++ b/omnigent/server/routes/_sessions/orchestration.py
@@ -3208,6 +3208,7 @@ async def _persist_external_conversation_items(
         if items
         else []
     )
+    notify_items_persisted(session_id, [it for it in persisted_items if not it.deduplicated])
     for body, persisted in zip(bodies[: len(items)], persisted_items, strict=True):
         if not persisted.deduplicated:
             _publish_persisted_external_item(session_id, body, persisted)
diff --git a/tests/server/test_item_observers.py b/tests/server/test_item_observers.py
index 7fdba6befde0f2afd265fb5fb48e791b17008049..7b3e89d12156c23e031ff91b8fe9e082fcfd72e5 100644
--- a/tests/server/test_item_observers.py
+++ b/tests/server/test_item_observers.py
@@ -221,6 +221,39 @@ async def test_external_conversation_items_reach_observers(client: httpx.AsyncCl
     assert delivered[1].data.content[0]["text"] == "FORK: build the testimonials section"
 
 
+async def test_a_batched_external_run_reaches_observers(client: httpx.AsyncClient) -> None:
+    # The claude-native forwarder posts a sub-agent transcript as one array.
+    seen = _Recorder()
+    register_item_observer(seen)
+    session_id = await _create_session(client, "observed-batch")
+    texts = ["FORK: build the testimonials section", "Absorbed: fixed the padding, same file."]
+    body = [
+        {
+            "type": "external_conversation_item",
+            "data": {
+                "item_type": "message",
+                "item_data": {
+                    "role": "assistant",
+                    "content": [{"type": "output_text", "text": text}],
+                    "agent": "worker",
+                },
+                "response_id": "resp_claude_batch",
+            },
+        }
+        for text in texts
+    ]
+
+    resp = await client.post(f"/v1/sessions/{session_id}/events", json=body)
+    assert resp.status_code in (200, 201, 202), resp.text
+    await drain_item_observers()
+
+    assert len(seen.calls) == 1
+    observed_session, items = seen.calls[0]
+    assert observed_session == session_id
+    assert [item.id for item in items] == [ack["item_id"] for ack in resp.json()]
+    assert [item.data.content[0]["text"] for item in items] == texts
+
+
 async def test_a_deduplicated_repost_notifies_nobody(client: httpx.AsyncClient) -> None:
     seen = _Recorder()
     register_item_observer(seen)
