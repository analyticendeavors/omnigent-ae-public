+vi.mock("@/hooks/useHosts", () => ({ useHosts: mocks.hosts }));
+
+describe("useAeReviewerAgents", () => {
+  it("pins the agents the stored reviewers name, like the lead and members", () => {
+    mocks.agents.mockReturnValue({ data: [], isSuccess: true });
