+        BALANCED,
+        _with_reviewers(SONNET_MEDIUM, CODEX) | {"id": "two", "title": "Two"},
+    ]
+    roles = resolve_roles(conversation(team_label(roles={"preset": "lead-picks"})), owner_store())
