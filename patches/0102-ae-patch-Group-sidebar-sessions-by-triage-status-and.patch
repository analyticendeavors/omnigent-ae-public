@@ -0,0 +1,146 @@
+import { describe, expect, it } from "vitest";
+import {
+  AE_ORDER_MAX,
+  type AeMoveTo,
+  aeApplyManualOrder,
+  aeIsOrderId,
+  aeMoveInOrder,
+  aeTrimOrder,
+} from "./aeSessionOrder";
+
+const rows = (...ids: string[]) => ids.map((id) => ({ id }));
+const ids = (list: { id: string }[]) => list.map((row) => row.id);
+
+describe("aeApplyManualOrder", () => {
+  it("puts rows the order lacks first, in their incoming order, then the rest by rank", () => {
+    const ordered = aeApplyManualOrder(rows("new2", "b", "new1", "a", "c"), ["c", "a", "b"]);
+    expect(ids(ordered)).toEqual(["new2", "new1", "c", "a", "b"]);
+  });
+
+  it("returns the rows themselves for an empty order", () => {
+    const list = rows("a", "b");
+    expect(aeApplyManualOrder(list, [])).toBe(list);
+  });
+
+  it("ignores ranked ids the list does not hold", () => {
+    expect(ids(aeApplyManualOrder(rows("b", "a"), ["gone", "a", "b"]))).toEqual(["a", "b"]);
+  });
+});
+
+describe("aeMoveInOrder", () => {
+  // Two lists share one order: Sessions holds s1..s4, a folder holds f1 and f2.
+  const loadedIds = ["s1", "f1", "s2", "s3", "f2", "s4"];
+  const sessions = ["s1", "s2", "s3", "s4"];
+  const folder = ["f1", "f2"];
+  const shown = (order: readonly string[], members: string[]) =>
+    ids(aeApplyManualOrder(rows(...loadedIds.filter((id) => members.includes(id))), order));
+  const move = (order: readonly string[], id: string, to: AeMoveTo, scopeIds = sessions) =>
+    aeMoveInOrder({ order, loadedIds, scopeIds, id, to });
+
+  it("moves within the list from an empty order, writing the loaded rows in first", () => {
+    const next = move([], "s3", "top");
+    expect(shown(next, sessions)).toEqual(["s3", "s1", "s2", "s4"]);
+    // The other list shows what it showed.
+    expect(shown(next, folder)).toEqual(["f1", "f2"]);
+    expect(next).toEqual(["s3", "s1", "f1", "s2", "f2", "s4"]);
+  });
+
+  it("handles up, down and bottom by the list's own neighbours", () => {
+    let order = move([], "s3", "up");
+    expect(shown(order, sessions)).toEqual(["s1", "s3", "s2", "s4"]);
+    order = move(order, "s1", "down");
+    expect(shown(order, sessions)).toEqual(["s3", "s1", "s2", "s4"]);
+    order = move(order, "s3", "bottom");
+    expect(shown(order, sessions)).toEqual(["s1", "s2", "s4", "s3"]);
+    expect(shown(order, folder)).toEqual(["f1", "f2"]);
+  });
+
+  it("drops before or after a target the way the insertion line shows", () => {
+    expect(shown(move([], "s1", { after: "s3" }), sessions)).toEqual(["s2", "s3", "s1", "s4"]);
+    expect(shown(move([], "s4", { before: "s2" }), sessions)).toEqual(["s1", "s4", "s2", "s3"]);
+    expect(shown(move([], "s1", { before: "s3" }), sessions)).toEqual(["s2", "s1", "s3", "s4"]);
+  });
+
+  it("moves a folder row among its folder's rows only", () => {
+    const next = move([], "f2", "top", folder);
+    expect(shown(next, folder)).toEqual(["f2", "f1"]);
+    expect(shown(next, sessions)).toEqual(sessions);
+  });
+
+  it("returns the order itself for a move that changes nothing", () => {
+    const order = [...loadedIds];
+    expect(move(order, "s1", "top")).toBe(order);
+    expect(move(order, "s1", "up")).toBe(order);
+    expect(move(order, "s4", "down")).toBe(order);
+    expect(move(order, "s1", { before: "s2" })).toBe(order);
+    expect(move(order, "s1", { after: "missing" })).toBe(order);
+    expect(move(order, "unlisted", "top")).toBe(order);
+  });
+
+  it("keeps a new session on top of its list after other moves", () => {
+    const order = move([], "s4", "top");
+    const withNew = ["s0", ...sessions];
+    expect(ids(aeApplyManualOrder(rows(...withNew), order))).toEqual([
+      "s0",
+      "s4",
+      "s1",
+      "s2",
+      "s3",
+    ]);
+  });
+
+  it("replays on a fresh order by the list as that order shows it", () => {
+    // Another device put s4 first; "up" on s2 now passes s1 only.
+    const fresh = ["s4", "s1", "s2", "s3"];
+    expect(shown(move(fresh, "s2", "up"), sessions)).toEqual(["s4", "s2", "s1", "s3"]);
+  });
+});
+
+describe("aeTrimOrder", () => {
+  it("drops unloaded ids from the end first, keeping the moved id", () => {
+    const order = Array.from({ length: AE_ORDER_MAX + 2 }, (_, i) => `id${i}`);
+    const loaded = new Set(order.slice(0, AE_ORDER_MAX - 5));
+    const last = order[order.length - 1];
+    const trimmed = aeTrimOrder(order, loaded, last);
+    expect(trimmed).toHaveLength(AE_ORDER_MAX);
+    expect(trimmed.at(-1)).toBe(last);
+    expect(trimmed).not.toContain(order[order.length - 2]);
+    expect(trimmed).not.toContain(order[order.length - 3]);
+  });
+
+  it("never drops the moved id, even when every id is loaded", () => {
+    const order = Array.from({ length: AE_ORDER_MAX + 3 }, (_, i) => `id${i}`);
+    const last = order[order.length - 1];
+    const trimmed = aeTrimOrder(order, new Set(order), last);
+    expect(trimmed).toHaveLength(AE_ORDER_MAX);
+    expect(trimmed.at(-1)).toBe(last);
+    expect(trimmed.slice(0, -1)).toEqual(order.slice(0, AE_ORDER_MAX - 1));
+  });
+
+  it("keeps a row moved to the bottom of more than 500 loaded rows", () => {
+    const loadedIds = Array.from({ length: AE_ORDER_MAX + 20 }, (_, i) => `id${i}`);
+    const next = aeMoveInOrder({
+      order: [],
+      loadedIds,
+      scopeIds: loadedIds,
+      id: "id0",
+      to: "bottom",
+    });
+    expect(next).toHaveLength(AE_ORDER_MAX);
+    expect(next.at(-1)).toBe("id0");
+  });
+
+  it("leaves a short order alone", () => {
+    const order = ["a"];
+    expect(aeTrimOrder(order, new Set())).toBe(order);
+  });
+});
+
+describe("aeIsOrderId", () => {
+  it("accepts session ids and refuses a provisional row's", () => {
+    expect(aeIsOrderId("0123456789abcdef0123456789abcdef")).toBe(true);
+    expect(aeIsOrderId("temp:0123456789abcdef0123456789ab")).toBe(false);
+    expect(aeIsOrderId("0123456789ABCDEF0123456789ABCDEF")).toBe(false);
+    expect(aeIsOrderId("abc")).toBe(false);
+  });
+});
diff --git a/web/src/lib/aeSessionOrder.ts b/web/src/lib/aeSessionOrder.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3ef85c504028e669a1dd51c4296a447ebeb1f3d0
--- /dev/null
+++ b/web/src/lib/aeSessionOrder.ts
@@ -0,0 +1,124 @@
+// The sidebar's manual session order (omnigent-ae, 2026-10-19): one saved list
+// of session ids per user (`GET` and `PUT /v1/ae/sidebar`) ranks every list the
+// sidebar shows, Sessions, Shared, each project folder and each group alike.
+// A session the saved order does not hold sorts above the ranked ones, in the
+// list's own order, so a new session lands on top of its list.
+
+/** The most ids the server keeps; it refuses a longer order. */
+export const AE_ORDER_MAX = 500;
+
+/** Session ids are 32 lowercase hex; a provisional `temp:` row's id never enters the order. */
+const SESSION_ID_RE = /^[0-9a-f]{32}$/;
+
+export function aeIsOrderId(id: string): boolean {
+  return SESSION_ID_RE.test(id);
+}
+
+/** Where a move puts the session, within its own list. */
+export type AeMoveTo = "top" | "up" | "down" | "bottom" | { before: string } | { after: string };
+
+// One rank map per saved order, shared by every list that applies it.
+const ranks = new WeakMap<readonly string[], Map<string, number>>();
+
+function rankOf(order: readonly string[]): Map<string, number> {
+  let rank = ranks.get(order);
+  if (!rank) {
+    rank = new Map(order.map((id, index) => [id, index]));
+    ranks.set(order, rank);
+  }
+  return rank;
+}
+
+/**
+ * Rows in manual order: the ones `order` does not hold first, in their
+ * incoming order, then the rest by rank. An empty order returns `rows` itself.
+ */
+export function aeApplyManualOrder<T extends { id: string }>(
+  rows: T[],
+  order: readonly string[],
+): T[] {
+  if (order.length === 0) return rows;
+  const rank = rankOf(order);
+  const unranked = rows.filter((row) => !rank.has(row.id));
+  const ranked = rows
+    .filter((row) => rank.has(row.id))
+    .sort((a, b) => (rank.get(a.id) ?? 0) - (rank.get(b.id) ?? 0));
+  return [...unranked, ...ranked];
+}
+
+/**
+ * The saved order after moving `id` within its list. `loadedIds` is every
+ * loaded row (window and folder rows alike) in the lists' own order; the ones
+ * the saved order lacks are written in first, in that order, so every list
+ * still shows what it showed. `scopeIds` are the members of the moved row's
+ * list, in any order: the list as shown is derived from the order, so a move
+ * replayed on a fresh order lands where it would have on that order. The moved
+ * id then sits next to its new neighbour in the list, which changes no other
+ * list. Returns `order` itself when the move changes nothing.
+ */
+export function aeMoveInOrder({
+  order,
+  loadedIds,
+  scopeIds,
+  id,
+  to,
+}: {
+  order: readonly string[];
+  loadedIds: readonly string[];
+  scopeIds: readonly string[];
+  id: string;
+  to: AeMoveTo;
+}): readonly string[] {
+  const known = new Set(order);
+  const prepend = loadedIds.filter((rowId) => !known.has(rowId));
+  const full = [...prepend, ...order];
+  const members = new Set(scopeIds);
+  const shown = full.filter((rowId) => members.has(rowId));
+  const from = shown.indexOf(id);
+  if (from < 0) return order;
+
+  let dest: number;
+  if (to === "top") dest = 0;
+  else if (to === "bottom") dest = shown.length - 1;
+  else if (to === "up") dest = from - 1;
+  else if (to === "down") dest = from + 1;
+  else {
+    const target = shown.indexOf("before" in to ? to.before : to.after);
+    if (target < 0) return order;
+    if ("before" in to) dest = target > from ? target - 1 : target;
+    else dest = target < from ? target + 1 : target;
+  }
+  if (dest === from || dest < 0 || dest >= shown.length) return order;
+
+  const moved = shown.filter((rowId) => rowId !== id);
+  moved.splice(dest, 0, id);
+  const next = full.filter((rowId) => rowId !== id);
+  if (dest > 0) next.splice(next.indexOf(moved[dest - 1]) + 1, 0, id);
+  else next.splice(next.indexOf(moved[1]), 0, id);
+  return aeTrimOrder(next, new Set(loadedIds), id);
+}
+
+/**
+ * Cap an order at `AE_ORDER_MAX`, dropping ids no list has loaded from the end
+ * first (archived, deleted, or past the loaded window), then the last ranks.
+ * `keep` (the moved id) is never dropped.
+ */
+export function aeTrimOrder(
+  order: readonly string[],
+  loaded: ReadonlySet<string>,
+  keep?: string,
+): readonly string[] {
+  if (order.length <= AE_ORDER_MAX) return order;
+  let excess = order.length - AE_ORDER_MAX;
+  const dropped = new Set<number>();
+  // Two passes from the end: unloaded ids, then any id; never `keep`.
+  for (const droppable of [(rowId: string) => !loaded.has(rowId), () => true]) {
+    for (let index = order.length - 1; index >= 0 && excess > 0; index -= 1) {
+      const rowId = order[index];
+      if (rowId === keep || dropped.has(index) || !droppable(rowId)) continue;
+      dropped.add(index);
+      excess -= 1;
+    }
+  }
+  return order.filter((_, index) => !dropped.has(index));
+}
