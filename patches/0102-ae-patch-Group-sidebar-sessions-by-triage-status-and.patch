diff --git a/web/src/pages/settings/AeSessionListSetting.test.tsx b/web/src/pages/settings/AeSessionListSetting.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a50aa352de0e24d89e510ba479d03576290f36eb
--- /dev/null
+++ b/web/src/pages/settings/AeSessionListSetting.test.tsx
@@ -0,0 +1,124 @@
+// Settings > Chat > Session list: the pointer to the list's filter button, and
+// "Reset manual order", which saves an empty order and offers an Undo that
+// puts the previous order back.
+
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { act, cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+const mocks = vi.hoisted(() => ({ fetch: vi.fn(), toast: vi.fn(), showToast: vi.fn() }));
+vi.mock("@/lib/identity", () => ({ authenticatedFetch: mocks.fetch }));
+vi.mock("@/components/ui/toast", () => ({ showToast: mocks.showToast }));
+vi.mock("sonner", () => ({ toast: mocks.toast }));
+
+import { AE_SIDEBAR_QUERY_KEY, aeEnqueueOrder } from "@/hooks/useAeSidebarOrder";
+import { AeSessionListSetting } from "./AeSessionListSetting";
+
+const A = "a".repeat(32);
+const B = "b".repeat(32);
+
+const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { "Content-Type": "application/json" } });
+
+function puts(): { order: string[]; revision: number }[] {
+  return mocks.fetch.mock.calls
+    .filter(([, init]) => (init as RequestInit | undefined)?.method === "PUT")
+    .map(([, init]) => JSON.parse(String((init as RequestInit).body)));
+}
+
+beforeEach(() => {
+  mocks.fetch.mockReset();
+  mocks.toast.mockReset();
+  mocks.showToast.mockReset();
+});
+
+afterEach(cleanup);
+
+describe("AeSessionListSetting", () => {
+  it("points at the list's filter button and renders without a query client", () => {
+    render(<AeSessionListSetting />);
+    expect(screen.getByText("Session list")).toBeInTheDocument();
+    expect(screen.getByText(/filter button at the top of the session list/)).toBeInTheDocument();
+    expect(mocks.fetch).not.toHaveBeenCalled();
+  });
+
+  it("resets the order on the current revision and undoes it", async () => {
+    const qc = new QueryClient();
+    mocks.fetch
+      .mockResolvedValueOnce(json({ order: [B, A], revision: 4 }))
+      .mockResolvedValueOnce(json({ order: [], revision: 5 }))
+      .mockResolvedValueOnce(json({ order: [B, A], revision: 6 }));
+    render(
+      <QueryClientProvider client={qc}>
+        <AeSessionListSetting />
+      </QueryClientProvider>,
+    );
+    fireEvent.click(screen.getByTestId("ae-reset-session-order"));
+    await waitFor(() => expect(mocks.toast).toHaveBeenCalledTimes(1));
+    expect(puts()).toEqual([{ order: [], revision: 4 }]);
+    expect(qc.getQueryData(AE_SIDEBAR_QUERY_KEY)).toEqual({ order: [], revision: 5 });
+    const [title, options] = mocks.toast.mock.calls[0] as [
+      string,
+      { action: { label: string; onClick: () => void } },
+    ];
+    expect(title).toBe("Manual order reset");
+    expect(options.action.label).toBe("Undo");
+    options.action.onClick();
+    await waitFor(() => expect(mocks.showToast).toHaveBeenCalledWith("Manual order restored."));
+    expect(puts()[1]).toEqual({ order: [B, A], revision: 5 });
+    expect(qc.getQueryData(AE_SIDEBAR_QUERY_KEY)).toEqual({ order: [B, A], revision: 6 });
+  });
+
+  it("waits behind a sidebar move still saving, then resets on top of it", async () => {
+    const qc = new QueryClient();
+    qc.setQueryData(AE_SIDEBAR_QUERY_KEY, { order: [A, B], revision: 2 });
+    let answerMove!: (res: Response) => void;
+    mocks.fetch
+      .mockReturnValueOnce(
+        new Promise<Response>((resolve) => {
+          answerMove = resolve;
+        }),
+      )
+      .mockResolvedValueOnce(json({ order: [], revision: 4 }));
+    // The sidebar's move: B to top, saving when Reset is pressed.
+    aeEnqueueOrder(qc, { kind: "set", order: [B, A] });
+    render(
+      <QueryClientProvider client={qc}>
+        <AeSessionListSetting />
+      </QueryClientProvider>,
+    );
+    fireEvent.click(screen.getByTestId("ae-reset-session-order"));
+    await act(async () => answerMove(json({ order: [B, A], revision: 3 })));
+    await waitFor(() => expect(mocks.toast).toHaveBeenCalledTimes(1));
+    // No read raced the move, and the reset went last, on the move's revision.
+    expect(mocks.fetch.mock.calls.every(([, init]) => init?.method === "PUT")).toBe(true);
+    expect(puts()).toEqual([
+      { order: [B, A], revision: 2 },
+      { order: [], revision: 3 },
+    ]);
+    expect(qc.getQueryData(AE_SIDEBAR_QUERY_KEY)).toEqual({ order: [], revision: 4 });
+  });
+
+  it("saves nothing when the order is already empty", async () => {
+    mocks.fetch.mockResolvedValueOnce(json({ order: [], revision: 0 }));
+    render(<AeSessionListSetting />);
+    fireEvent.click(screen.getByTestId("ae-reset-session-order"));
+    await waitFor(() => expect(mocks.showToast).toHaveBeenCalledTimes(1));
+    expect(puts()).toHaveLength(0);
+    expect(mocks.toast).not.toHaveBeenCalled();
+  });
+
+  it("offers no Undo when the reset could not be saved", async () => {
+    const conflict = (revision: number) =>
+      json({ error: { code: "conflict", message: "stale", order: [B], revision } }, 409);
+    mocks.fetch
+      .mockResolvedValueOnce(json({ order: [A], revision: 1 }))
+      .mockResolvedValueOnce(conflict(2))
+      .mockResolvedValueOnce(conflict(3));
+    render(<AeSessionListSetting />);
+    fireEvent.click(screen.getByTestId("ae-reset-session-order"));
+    await waitFor(() => expect(mocks.showToast).toHaveBeenCalledTimes(1));
+    expect(String(mocks.showToast.mock.calls[0][0])).toContain("another device");
+    expect(mocks.toast).not.toHaveBeenCalled();
+  });
+});
diff --git a/web/src/pages/settings/AeSessionListSetting.tsx b/web/src/pages/settings/AeSessionListSetting.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..1f83aeda0e0c66ac4d724609b7f0559f4ab56158
--- /dev/null
+++ b/web/src/pages/settings/AeSessionListSetting.tsx
@@ -0,0 +1,81 @@
+// Settings > Chat: the session list's sort options (omnigent-ae, 2026-10-19).
+// Grouping and Ordering live in the list's own filter menu, per device; the
+// manual order is saved on the server, so its reset lives here, with an Undo
+// that puts the previous order back.
+
+import { QueryClient, QueryClientContext } from "@tanstack/react-query";
+import { useContext, useState } from "react";
+import { toast } from "sonner";
+import { Button } from "@/components/ui/button";
+import { showToast } from "@/components/ui/toast";
+import { aeEnqueueOrder, aeOrderSettled, aeReadOrder, reasonOf } from "@/hooks/useAeSidebarOrder";
+
+const UNDO_MS = 8000;
+
+export function AeSessionListSetting() {
+  // Reset and Undo go through the session list's save queue, so a move still
+  // saving cannot land after them. Settings also renders without a query
+  // client (tests); a local one stands in, with a queue of its own.
+  const appClient = useContext(QueryClientContext);
+  const [localClient] = useState(() => (appClient ? null : new QueryClient()));
+  const queryClient = appClient ?? localClient!;
+  const [busy, setBusy] = useState(false);
+
+  const undo = async (previous: readonly string[]) => {
+    aeEnqueueOrder(queryClient, { kind: "set", order: previous });
+    // A failed save shows the queue's own toast.
+    if (await aeOrderSettled(queryClient)) showToast("Manual order restored.");
+  };
+
+  const reset = async () => {
+    setBusy(true);
+    try {
+      const current = await aeReadOrder(queryClient);
+      if (current.order.length === 0) {
+        showToast("The manual order is already empty; the list shows newest first.");
+        return;
+      }
+      aeEnqueueOrder(queryClient, { kind: "set", order: [] });
+      if (!(await aeOrderSettled(queryClient))) return;
+      toast("Manual order reset", {
+        description: "Sessions now list newest first until you move one.",
+        duration: UNDO_MS,
+        action: { label: "Undo", onClick: () => void undo(current.order) },
+        testId: "ae-session-order-reset-toast",
+      });
+    } catch (error) {
+      showToast(
+        `Could not reset the manual order: ${reasonOf(error)}. Reload the page and try again.`,
+      );
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <div
+      data-testid="ae-session-list-setting"
+      className="flex items-start justify-between gap-6 max-sm:flex-col max-sm:gap-2"
+    >
+      <div className="flex min-w-0 flex-1 flex-col">
+        <span className="text-ui font-medium">Session list</span>
+        <span className="text-ui text-muted-foreground">
+          Pick Triage grouping or Manual ordering from the filter button at the top of the session
+          list. The manual order is saved for your account, so it follows you to every device.
+        </span>
+      </div>
+      <Button
+        type="button"
+        variant="outline"
+        size="sm"
+        disabled={busy}
+        onClick={() => void reset()}
+        data-testid="ae-reset-session-order"
+        componentId="settings.chat.reset_session_order"
+        className="mt-0.5 shrink-0"
+      >
+        Reset manual order
+      </Button>
+    </div>
+  );
+}
diff --git a/web/src/shell/AeArchivedGroup.tsx b/web/src/shell/AeArchivedGroup.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c827b212f0371b7141e8a8dc9eb542cc4265ed11
--- /dev/null
+++ b/web/src/shell/AeArchivedGroup.tsx
@@ -0,0 +1,128 @@
+// The Triage view's last group (omnigent-ae, 2026-10-19): archived sessions,
+// collapsed until opened on this device. Opening it loads the newest archived
+// page; "Show more" loads the next. The sidebar passes its own section
+// component and row props in, so this file imports nothing from Sidebar.tsx.
+
+import { type ComponentType, type MouseEvent, type ReactNode, useMemo, useState } from "react";
+import type { Conversation } from "@/hooks/useConversations";
+import { useArchivedSessions } from "@/hooks/useScopeCache";
+import { AE_ICON_HISTORY, AE_ICON_LOADER } from "@/lib/aeSortIcons";
+import { AeTablerSvg } from "@/lib/aeTablerIcon";
+
+const STORAGE_KEY = "ae.sidebar.archivedOpen";
+
+function readOpen(): boolean {
+  try {
+    return window.localStorage.getItem(STORAGE_KEY) === "open";
+  } catch {
+    return false;
+  }
+}
+
+function writeOpen(open: boolean): void {
+  try {
+    if (open) window.localStorage.setItem(STORAGE_KEY, "open");
+    else window.localStorage.removeItem(STORAGE_KEY);
+  } catch {
+    // A local view preference; losing it is harmless.
+  }
+}
+
+/** The props the sidebar's `ConversationSection` takes that this group sets. */
+export interface AeSectionProps {
+  title?: string;
+  titleContent?: ReactNode;
+  conversations: Conversation[];
+  activeConversationId: string | null;
+  pinnedConversationIds: string[];
+  collapsed: boolean;
+  onToggleCollapsed: () => void;
+  onRowClick: (e: MouseEvent<HTMLAnchorElement>) => void;
+  onTogglePinned: (conversationId: string) => void;
+  selectionMode: boolean;
+  selectedIds: Set<string>;
+  onToggleSelected: (conversationId: string, shiftKey?: boolean) => void;
+  onProjectAssigned?: (projectName: string) => void;
+  emptyMessage?: ReactNode;
+  footer?: ReactNode;
+}
+
+type AeRowProps = Omit<
+  AeSectionProps,
+  | "title"
+  | "titleContent"
+  | "conversations"
+  | "collapsed"
+  | "onToggleCollapsed"
+  | "emptyMessage"
+  | "footer"
+>;
+
+export function AeArchivedGroup({
+  show,
+  Section,
+  rowProps,
+}: {
+  /** Triage is on, outside search, selection, and the Shared and Archived displays. */
+  show: boolean;
+  Section: ComponentType<AeSectionProps>;
+  rowProps: AeRowProps;
+}) {
+  const [open, setOpen] = useState(readOpen);
+  const query = useArchivedSessions(show && open);
+  const rows = useMemo(() => query.data?.pages.flatMap((page) => page.data) ?? [], [query.data]);
+  if (!show) return null;
+  const toggle = () => {
+    writeOpen(!open);
+    setOpen(!open);
+  };
+  let footer: ReactNode = null;
+  if (query.isError) {
+    footer = (
+      <p role="status" className="px-2 py-1 text-destructive text-ui">
+        Could not load archived sessions.{" "}
+        <button type="button" onClick={() => void query.refetch()}>
+          Retry
+        </button>
+      </p>
+    );
+  } else if (query.isLoading) {
+    footer = <p className="px-2 py-1 text-muted-foreground text-sm">Loading…</p>;
+  } else if (query.hasNextPage) {
+    footer = (
+      <button
+        type="button"
+        data-testid="ae-archived-show-more"
+        disabled={query.isFetchingNextPage}
+        onClick={() => void query.fetchNextPage()}
+        className="flex w-full cursor-pointer items-center justify-center gap-1.5 rounded-md px-2 py-1.5 text-muted-foreground text-sm hover:bg-muted disabled:pointer-events-none disabled:opacity-50"
+      >
+        {query.isFetchingNextPage ? (
+          <>
+            <AeTablerSvg node={AE_ICON_LOADER} className="size-3 animate-spin" />
+            Loading…
+          </>
+        ) : (
+          "Show more"
+        )}
+      </button>
+    );
+  }
+  return (
+    <Section
+      title="Archived"
+      titleContent={
+        <span className="inline-flex items-center gap-1.5 align-middle">
+          <AeTablerSvg node={AE_ICON_HISTORY} className="size-3.5 shrink-0" />
+          Archived
+        </span>
+      }
+      conversations={rows}
+      collapsed={!open}
+      onToggleCollapsed={toggle}
+      emptyMessage={query.isLoading || query.isError ? undefined : "No archived sessions"}
+      footer={footer}
+      {...rowProps}
+    />
+  );
+}
diff --git a/web/src/shell/AeSidebarRowOrder.tsx b/web/src/shell/AeSidebarRowOrder.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..e91c8bc9f33fa2a507080b658bd36297b53cb71c
--- /dev/null
+++ b/web/src/shell/AeSidebarRowOrder.tsx
@@ -0,0 +1,223 @@
+// The row-level parts of the sidebar's Manual ordering and Triage grouping
+// (omnigent-ae, 2026-10-19): each row as a drop target for reordering its own
+// list, the row menu's Move items, and the Triage group headers.
+
+import { useDroppable } from "@dnd-kit/core";
+import { type ComponentType, type ReactNode, useCallback, useRef } from "react";
+import { createPortal } from "react-dom";
+import { AE_STATUS_ICONS } from "@/components/AeStatusIcon";
+import { useIsMobileViewport } from "@/hooks/useIsMobileViewport";
+import { getEmbedRoot } from "@/lib/host";
+import type { AeMoveTo } from "@/lib/aeSessionOrder";
+import {
+  AE_ICON_ARROWS_SORT,
+  AE_ICON_MOVE_BOTTOM,
+  AE_ICON_MOVE_DOWN,
+  AE_ICON_MOVE_TOP,
+  AE_ICON_MOVE_UP,
+  AE_ICON_NO_STATUS,
+} from "@/lib/aeSortIcons";
+import type { AeTablerIconNode } from "@/lib/aeTablerIconData";
+import { AeTablerSvg } from "@/lib/aeTablerIcon";
+import { AE_TRIAGE_STATUS, type AeTriageGroup, aeGroupCounts } from "@/lib/aeTriage";
+import {
+  type AeRowPlace,
+  type AeSidebarView,
+  aeInsertionSide,
+  aeMoveRow,
+  aePlaceOf,
+  useAeSidebarStore,
+} from "./aeSidebarStore";
+
+/**
+ * A row as a drop target for its own list's order: on only while Manual is on,
+ * for listed rows outside Pinned, Archived and selection. A pending save never
+ * toggles it, since every toggle re-measures every target mid-drag. The
+ * insertion line shows on the row under the pointer, never on the dragged one,
+ * portaled above the drag preview, which sits on the pointer and hid it.
+ */
+export function useAeOrderRow(
+  id: string,
+  {
+    isPinned,
+    isArchived,
+    selectionMode,
+  }: { isPinned: boolean; isArchived: boolean; selectionMode: boolean },
+): { setNodeRef: (node: HTMLElement | null) => void; insertion: ReactNode } {
+  const listed = useAeSidebarStore((s) => s.manual && s.listOf.has(id));
+  const enabled = listed && !isPinned && !isArchived && !selectionMode;
+  const { setNodeRef, isOver, active } = useDroppable({
+    id: `ae-order:${id}`,
+    data: { type: "ae-order", id },
+    disabled: !enabled,
+  });
+  const nodeRef = useRef<HTMLElement | null>(null);
+  const setRef = useCallback(
+    (node: HTMLElement | null) => {
+      nodeRef.current = node;
+      setNodeRef(node);
+    },
+    [setNodeRef],
+  );
+  const draggedId = active ? String(active.id) : null;
+  const side =
+    enabled && isOver && draggedId !== null && draggedId !== id
+      ? aeInsertionSide(draggedId, id)
+      : null;
+  const rect = side ? nodeRef.current?.getBoundingClientRect() : undefined;
+  // Same root as the DragOverlay (z-index 999), one layer above it. The accent
+  // color and end dot keep it from reading as a strikethrough on the preview.
+  const insertion =
+    side && rect
+      ? createPortal(
+          <span
+            data-testid="ae-order-insertion"
+            className="pointer-events-none fixed z-[1000] h-0.5 rounded-full bg-sidebar-primary"
+            style={{
+              left: rect.left,
+              width: rect.width,
+              top: (side === "before" ? rect.top : rect.bottom) - 1,
+            }}
+          >
+            <span className="-left-1 -top-[3px] absolute size-2 rounded-full border-2 border-sidebar-primary bg-background" />
+          </span>,
+          getEmbedRoot() ?? document.body,
+        )
+      : null;
+  return { setNodeRef: setRef, insertion };
+}
+
+// ── the Move menu ────────────────────────────────────────────────────────
+
+// The subset of the sidebar's menu-component bundle the Move items render,
+// typed structurally so both the dropdown and the context-menu families fit.
+interface AeMoveItemProps {
+  children?: ReactNode;
+  className?: string;
+  disabled?: boolean;
+  textValue?: string;
+  onSelect?: (event: Event) => void;
+  "data-testid"?: string;
+  "data-move"?: string;
+}
+
+export interface AeMoveMenuComponents {
+  Item: ComponentType<AeMoveItemProps>;
+  Sub: ComponentType<{ children?: ReactNode }>;
+  SubTrigger: ComponentType<{
+    children?: ReactNode;
+    className?: string;
+    "data-testid"?: string;
+  }>;
+  SubContent: ComponentType<{ children?: ReactNode; className?: string }>;
+}
+
+const MOVES: {
+  to: Extract<AeMoveTo, string>;
+  label: string;
+  icon: AeTablerIconNode;
+  /** The places where the move would change nothing. */
+  idleAt: readonly AeRowPlace[];
+}[] = [
+  { to: "top", label: "Move to top", icon: AE_ICON_MOVE_TOP, idleAt: ["only", "first"] },
+  { to: "up", label: "Move up", icon: AE_ICON_MOVE_UP, idleAt: ["only", "first"] },
+  { to: "down", label: "Move down", icon: AE_ICON_MOVE_DOWN, idleAt: ["only", "last"] },
+  { to: "bottom", label: "Move to bottom", icon: AE_ICON_MOVE_BOTTOM, idleAt: ["only", "last"] },
+];
+
+/**
+ * The row menu's Move items while Manual is on: a submenu on desktop, and
+ * plain items under a "Move" heading on a phone, like the Status items. Plain
+ * items rather than radio items: they act, they hold no choice.
+ */
+export function AeMoveMenu({
+  components: C,
+  conversationId,
+  onDone,
+}: {
+  components: AeMoveMenuComponents;
+  conversationId: string;
+  onDone?: () => void;
+}) {
+  const isMobile = useIsMobileViewport();
+  const place = useAeSidebarStore((s) => aePlaceOf(s, conversationId));
+  if (place === null) return null;
+  const items = MOVES.map(({ to, label, icon, idleAt }) => (
+    <C.Item
+      key={to}
+      data-testid="ae-move-item"
+      data-move={to}
+      disabled={idleAt.includes(place)}
+      textValue={label}
+      onSelect={() => {
+        onDone?.();
+        aeMoveRow(conversationId, to);
+      }}
+    >
+      <AeTablerSvg node={icon} className="size-3.5" />
+      {label}
+    </C.Item>
+  ));
+  if (isMobile) {
+    return (
+      <>
+        <p className="px-2 pt-1.5 pb-0.5 text-xs text-muted-foreground">Move</p>
+        {items}
+      </>
+    );
+  }
+  return (
+    <C.Sub>
+      <C.SubTrigger data-testid="ae-move-menu" className="whitespace-nowrap">
+        <AeTablerSvg node={AE_ICON_ARROWS_SORT} className="size-3.5" />
+        Move
+      </C.SubTrigger>
+      <C.SubContent className="min-w-40">{items}</C.SubContent>
+    </C.Sub>
+  );
+}
+
+// ── the Triage headers ───────────────────────────────────────────────────
+
+/**
+ * A Triage group's header text: the status glyph, the word and the row count.
+ * The glyph is hidden from screen readers, so the header reads as the word; a
+ * named status icon there would read it twice.
+ */
+export function AeTriageTitle({ title, count }: { title: string; count: number }) {
+  const status = AE_TRIAGE_STATUS[title as AeTriageGroup] ?? null;
+  const Icon = status ? AE_STATUS_ICONS[status] : null;
+  return (
+    <span
+      data-testid="ae-triage-title"
+      data-group={title}
+      className="inline-flex max-w-full items-center gap-1.5 align-middle"
+    >
+      {Icon ? (
+        <Icon aria-hidden="true" className="size-3.5 shrink-0" />
+      ) : (
+        <AeTablerSvg node={AE_ICON_NO_STATUS} className="size-3.5 shrink-0" />
+      )}
+      <span className="truncate">{title}</span>
+      <span className="shrink-0 tabular-nums opacity-70">{count}</span>
+    </span>
+  );
+}
+
+// Counted once per list update, shared by every group header.
+const counted = new WeakMap<ReadonlyMap<string, string>, Map<string, number>>();
+
+/** The header content for a Triage group; `undefined` keeps every other header as is. */
+export function aeTriageTitle(
+  ae: AeSidebarView,
+  title: string,
+  groupTitles: ReadonlyMap<string, string> | null,
+): ReactNode {
+  if (!ae.triage || !groupTitles) return undefined;
+  let counts = counted.get(groupTitles);
+  if (!counts) {
+    counts = aeGroupCounts(groupTitles);
+    counted.set(groupTitles, counts);
+  }
+  return <AeTriageTitle title={title} count={counts.get(title) ?? 0} />;
+}
