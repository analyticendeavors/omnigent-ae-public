+    if (url !== "/v1/ae/sidebar") return json({}, 404);
+    if (init?.method === "PUT") {
+      const body = JSON.parse(String(init.body)) as { order: string[] };
+      server = { order: body.order, revision: server.revision + 1 };
+    }
+    return json(server);
+  });
+});
