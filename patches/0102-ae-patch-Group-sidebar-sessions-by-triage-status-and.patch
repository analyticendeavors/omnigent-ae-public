+import { describe, expect, it } from "vitest";
+import { AE_STATUS_VALUES } from "@/lib/aeLabels";
+import { AE_STATUS_WORDS } from "@/components/AeStatusIcon";
+import {
+  AE_TRIAGE_GROUPS,
+  AE_TRIAGE_STATUS,
+  type AeTriageGroup,
+  aeGroupCounts,
+  aeTriageGroupOf,
+} from "./aeTriage";
+
+const row = (status?: string, pending = 0) => ({
+  id: `id-${status ?? "none"}-${pending}`,
+  labels: (status === undefined ? {} : { "ae.status": status }) as Record<string, string>,
+  pending_elicitations_count: pending,
+});
+
+describe("aeTriageGroupOf", () => {
+  it("groups by the shown status, in the triage order", () => {
+    expect(AE_TRIAGE_GROUPS).toEqual([
+      "Blocked",
+      "Working",
+      "Review",
+      "No status",
+      "Parked",
+      "Reference",
+    ]);
+    for (const status of AE_STATUS_VALUES) {
+      expect(aeTriageGroupOf(row(status), null)).toBe(AE_STATUS_WORDS[status]);
+      expect(AE_TRIAGE_STATUS[AE_STATUS_WORDS[status] as AeTriageGroup]).toBe(status);
+    }
+  });
+
+  it("puts a working session waiting on an approval under Blocked", () => {
+    expect(aeTriageGroupOf(row("working", 1), null)).toBe("Blocked");
+  });
+
+  it("puts a missing, blank or unknown status under No status", () => {
+    expect(aeTriageGroupOf(row(), null)).toBe("No status");
+    expect(aeTriageGroupOf(row(" "), null)).toBe("No status");
+    expect(aeTriageGroupOf(row("someday"), null)).toBe("No status");
+  });
+
+  it("holds the first group while a frozen map is passed", () => {
+    const frozen = new Map<string, AeTriageGroup>();
+    const session = row("working");
+    expect(aeTriageGroupOf(session, frozen)).toBe("Working");
+    expect(aeTriageGroupOf({ ...session, labels: { "ae.status": "review" } }, frozen)).toBe(
+      "Working",
+    );
+    expect(aeTriageGroupOf({ ...session, labels: { "ae.status": "review" } }, null)).toBe("Review");
+  });
+});
+
+describe("aeGroupCounts", () => {
+  it("counts rows per title", () => {
+    const counts = aeGroupCounts(
+      new Map([
+        ["a", "Working"],
+        ["b", "Working"],
+        ["c", "Review"],
+      ]),
+    );
+    expect(Object.fromEntries(counts)).toEqual({ Working: 2, Review: 1 });
+    expect(aeGroupCounts(null).size).toBe(0);
+  });
+});
diff --git a/web/src/lib/aeTriage.ts b/web/src/lib/aeTriage.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1be0c9d8522036c8596fd04df31559c1a9f66089
--- /dev/null
+++ b/web/src/lib/aeTriage.ts
@@ -0,0 +1,61 @@
+// The sidebar's Triage grouping (omnigent-ae, 2026-10-19): one group per shown
+// `ae.status`, in the order a person works through them, with the sessions
+// that carry no status between the active and the resting ones.
+
+import type { Conversation } from "@/hooks/useConversations";
+import { type AeStatus, aeDisplayStatus } from "@/lib/aeLabels";
+
+export const AE_TRIAGE_GROUPS = [
+  "Blocked",
+  "Working",
+  "Review",
+  "No status",
+  "Parked",
+  "Reference",
+] as const;
+export type AeTriageGroup = (typeof AE_TRIAGE_GROUPS)[number];
+
+/** Each group's status; `null` for "No status". */
+export const AE_TRIAGE_STATUS: Record<AeTriageGroup, AeStatus | null> = {
+  Blocked: "blocked",
+  Working: "working",
+  Review: "review",
+  "No status": null,
+  Parked: "parked",
+  Reference: "reference",
+};
+
+// The group each status falls in; the titles are the status words the row
+// icons show (`AE_STATUS_WORDS`).
+const GROUP_OF = Object.fromEntries(
+  AE_TRIAGE_GROUPS.flatMap((group) => {
+    const status = AE_TRIAGE_STATUS[group];
+    return status ? [[status, group]] : [];
+  }),
+) as Record<AeStatus, AeTriageGroup>;
+
+/**
+ * A row's group, from the status the row shows (blocked included). A `frozen`
+ * map pins the first answer while the pointer is in the list, so a status
+ * change under the cursor does not move the row to another group.
+ */
+export function aeTriageGroupOf(
+  conversation: Pick<Conversation, "id" | "labels" | "pending_elicitations_count">,
+  frozen: Map<string, AeTriageGroup> | null,
+): AeTriageGroup {
+  const held = frozen?.get(conversation.id);
+  if (held) return held;
+  const status = aeDisplayStatus(conversation);
+  const group: AeTriageGroup = status ? GROUP_OF[status] : "No status";
+  frozen?.set(conversation.id, group);
+  return group;
+}
+
+/** Rows per group title, from the list's id-to-title map. */
+export function aeGroupCounts(
+  groupTitles: ReadonlyMap<string, string> | null,
+): Map<string, number> {
+  const counts = new Map<string, number>();
+  for (const title of groupTitles?.values() ?? []) counts.set(title, (counts.get(title) ?? 0) + 1);
+  return counts;
+}
