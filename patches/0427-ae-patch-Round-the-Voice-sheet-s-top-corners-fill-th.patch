Subject: [PATCH 427/443] [ae-patch] Round the Voice sheet's top corners, fill
 the disabled Stop, and resume the iOS audio context in parallel

---
 web/src/components/AeVoicePanel.tsx | 14 +++++++++++---
 web/src/lib/dictation.ios.test.ts   | 25 +++++++++++++++++++++++++
 web/src/lib/dictation.ts            | 11 ++++++++++-
 3 files changed, 46 insertions(+), 4 deletions(-)

diff --git a/web/src/components/AeVoicePanel.tsx b/web/src/components/AeVoicePanel.tsx
index df9c29f8f75deced18e2d3f38116b4d51661e560..cb81f611e3a7b87137bb7071f3229d9bf28c5941 100644
--- a/web/src/components/AeVoicePanel.tsx
+++ b/web/src/components/AeVoicePanel.tsx
@@ -196,6 +196,15 @@ const SHEET_COLOURS: Record<string, { top: string; solid: string; outline: strin
     },
   };
 
+/** The disabled Stop's dimmed fill per state colour: the speaking Stop's shape, not ready yet. */
+const SHEET_DIM: Record<string, string> = {
+  "text-teal-500": "bg-teal-500/30 text-teal-800 dark:text-teal-200",
+  "text-amber-500": "bg-amber-500/30 text-amber-900 dark:text-amber-200",
+  "text-blue-500": "bg-blue-500/30 text-blue-900 dark:text-blue-200",
+  "text-red-500": "bg-red-500/30 text-red-900 dark:text-red-200",
+  "text-muted-foreground": "bg-foreground/15 text-foreground/70",
+};
+
 /** The sheet's short state words; the bar keeps `words()`. */
 const SHEET_LABEL: Partial<Record<VoicePhaseKey, string>> = {
   thinking: "Working",
@@ -423,9 +432,8 @@ export function AeVoicePanel({
       button = (
         <Button
           type="button"
-          variant="outline"
           data-testid="ae-voice-action"
-          className={cn(big, "opacity-50")}
+          className={cn(big, SHEET_DIM[tone.text])}
           aria-disabled="true"
           aria-label="Stop (nothing playing yet)"
           tabIndex={-1}
@@ -480,7 +488,7 @@ export function AeVoicePanel({
         data-layout="sheet"
         data-phase={key}
         className={cn(
-          "flex flex-col items-stretch gap-3 border-t-[3px] px-4 pt-3 pb-4",
+          "flex flex-col items-stretch gap-3 rounded-t-[calc(1rem-1px)] border-t-[3px] px-4 pt-3 pb-4",
           sheetBg,
           top,
           className,
diff --git a/web/src/lib/dictation.ios.test.ts b/web/src/lib/dictation.ios.test.ts
index c55e7cab24516a7f4a58f14aeea380e064899c44..b43ff3e134fb79f79de88e10764feae8a5c19750 100644
--- a/web/src/lib/dictation.ios.test.ts
+++ b/web/src/lib/dictation.ios.test.ts
@@ -191,6 +191,31 @@ describe("DictationSession on iOS", () => {
     second.cancel();
   });
 
+  it("resumes the shared context before the mic and the socket settle", async () => {
+    setUserAgent(IOS_UA);
+    unlockVoiceAudioContext();
+    const order: string[] = [];
+    contexts[0].resume.mockClear();
+    contexts[0].resume.mockImplementation(() => {
+      order.push("resume");
+      contexts[0].state = "running";
+      return Promise.resolve();
+    });
+    getMicStreamMock.mockImplementation(() => {
+      order.push("mic asked");
+      return Promise.resolve(makeStream()).then((stream) => {
+        order.push("mic resolved");
+        return stream;
+      });
+    });
+    const session = await DictationSession.start(events());
+    expect(order.indexOf("resume")).toBeGreaterThanOrEqual(0);
+    expect(order.indexOf("resume")).toBeLessThan(order.indexOf("mic resolved"));
+    expect(contexts[0].resume).toHaveBeenCalledTimes(1);
+    expect(formatVoiceLog()).toContain("dictation ctx resume");
+    session.cancel();
+  });
+
   it("makes no shared context when the setting is off", () => {
     setUserAgent(IOS_UA);
     window.localStorage.setItem(VOICE_SERVER_STT_KEY, "off");
diff --git a/web/src/lib/dictation.ts b/web/src/lib/dictation.ts
index cf420d6740a0c559e275a1716a4822e0c4a34c1c..48f9e335a5f562efc63f90a9a6bb9a6ed57d120a 100644
--- a/web/src/lib/dictation.ts
+++ b/web/src/lib/dictation.ts
@@ -318,6 +318,14 @@ export class DictationSession {
     // The mic and the socket are opened together: each takes a few hundred ms and neither
     // needs the other.
     const t0 = Date.now();
+    // On iOS the shared tap context is left suspended by playback; its resume overlaps the
+    // mic and the socket instead of following them. resumeCapped never rejects.
+    const earlyContext = isIosDevice() ? getSharedVoiceAudioContext() : null;
+    const earlyResume = earlyContext
+      ? resumeCapped(earlyContext).then(() => {
+          logVoice("dictation ctx resume", `${Date.now() - t0} ms`);
+        })
+      : null;
     const micPromise = getMicStream({
       channelCount: 1,
       echoCancellation: true,
@@ -385,7 +393,8 @@ export class DictationSession {
           audioContext = new AudioContext();
         }
       }
-      await resumeCapped(audioContext);
+      if (earlyResume && audioContext === earlyContext) await earlyResume;
+      else await resumeCapped(audioContext);
       if (ios && audioContext.state !== "running") {
         logVoice("dictation ctx not unlocked", audioContext.state);
       }
