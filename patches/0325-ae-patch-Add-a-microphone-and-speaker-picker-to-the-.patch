+  it("re-lists on devicechange", async () => {
+    const cb = vi.fn();
+    const off = subscribeAudioDevices(cb);
+    await refreshAudioDevices();
+    cb.mockClear();
+    listeners.devicechange?.();
+    await vi.waitFor(() => expect(cb).toHaveBeenCalled());
+    off();
