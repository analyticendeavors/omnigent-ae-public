From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Wed, 28 Oct 2026 08:38:37 -0700
Subject: [PATCH 219/220] [ae-patch] Stop the limit buttons spilling over the
 badges in a phone's action dock

The limit item's text is hidden on a phone, so the dock's width check never saw it overflow and Model, Account and New chat painted over the merge and waiting badges. The strip clips to its own width now and drops New chat on a phone; the opened list keeps it.
---
 web/src/components/AeActionDock.tsx | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/web/src/components/AeActionDock.tsx b/web/src/components/AeActionDock.tsx
index 7bf53f9baa22a4997ab5c9f09a274a4771d52bb7..40bee64e29132823e13e0a1657c88ee8090b7888 100644
--- a/web/src/components/AeActionDock.tsx
+++ b/web/src/components/AeActionDock.tsx
@@ -251,6 +251,7 @@ function NewChatButton({ inList }: { inList: boolean }) {
       label="New chat"
       short="New chat"
       inList={inList}
+      hideOnPhone={!inList}
       onClick={() => navigate("/")}
       testId="ae-dock-limit-new"
     />
@@ -264,17 +265,22 @@ const LimitButton = forwardRef<
     label: string;
     short: string;
     inList: boolean;
+    /** A phone strip is too narrow for it: it would spill over the badges. The list keeps it. */
+    hideOnPhone?: boolean;
     onClick?: () => void;
     testId: string;
     title?: string;
     disabled?: boolean;
   }
->(function LimitButton({ icon, label, short, inList, onClick, testId, title, ...rest }, ref) {
+>(function LimitButton(
+  { icon, label, short, inList, hideOnPhone, onClick, testId, title, ...rest },
+  ref,
+) {
   return (
     <Button
       ref={ref}
       variant="outline"
-      className={cn(ACTION, "w-6 px-0 md:w-auto md:px-2")}
+      className={cn(ACTION, "w-6 px-0 md:w-auto md:px-2", hideOnPhone && "hidden md:inline-flex")}
       aria-label={label}
       title={title ?? label}
       onClick={onClick}
@@ -751,7 +757,7 @@ function Dock({ sessionId, onSwitchModel }: { sessionId?: string; onSwitchModel?
         ) : (
           <span
             className={cn(
-              "flex min-w-0 items-center gap-1.5 md:gap-2",
+              "flex min-w-0 items-center gap-1.5 overflow-hidden md:gap-2",
               liveNotice && "h-6 rounded-md bg-emerald-500/15 pr-0.5 pl-1.5",
             )}
             data-testid={liveNotice ? "ae-dock-live" : undefined}
