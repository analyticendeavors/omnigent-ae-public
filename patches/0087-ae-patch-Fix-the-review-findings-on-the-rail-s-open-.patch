+            </Routes>
+          </MemoryRouter>
+        </TooltipProvider>
+      </SidebarDataProvider>
+    </QueryClientProvider>,
+  );
+}
+
+const railShown = () => screen.queryByTestId("ae-session-rail") !== null;
+const panelToggle = () => screen.getByRole("button", { name: /right panel$/ });
