+      .toLowerCase()
+      .replace(/[^a-z0-9]+/g, "-")
+      .replace(/^-+|-+$/g, "")
+      .slice(0, 32)
+      .replace(/-+$/, "") || "persona";
+  const start = ID_PATTERN.test(base) ? base : `p-${base}`.slice(0, 32);
+  if (!inUse.includes(start)) return start;
+  for (let n = 2; ; n += 1) {
+    const candidate = `${start}-${n}`;
+    if (!inUse.includes(candidate)) return candidate;
+  }
