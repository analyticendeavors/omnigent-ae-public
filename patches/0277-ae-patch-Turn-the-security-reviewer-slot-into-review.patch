+export function aeAllPersonas(
+  builtin: readonly AePersona[],
+  mine: readonly AePersona[] | undefined,
+): AePersonaEntry[] {
+  return [
+    ...builtin.map((p) => ({ ...p, builtin: true })),
+    ...(mine ?? []).map((p) => ({ ...p, builtin: false })),
+  ];
