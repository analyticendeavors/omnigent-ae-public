+    expect(aeEffectiveSlot({ mode: "fixed", persona: "docs" }, all)).toEqual({ mode: "auto" });
+    expect(aeEffectiveSlot({ mode: "fixed", persona: "gone" }, all)).toEqual({ mode: "auto" });
