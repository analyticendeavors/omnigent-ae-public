+    expect(aePersonaProblems({ ...draft, name: " " })).toEqual(["Give it a name."]);
+    expect(aePersonaProblems({ ...draft, purpose: "" })).toEqual(["Say what it is for."]);
+    expect(aePersonaProblems({ ...draft, instructions: "  \n " })).toEqual([
+      "Write its instructions.",
