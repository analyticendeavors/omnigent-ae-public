+export function aeEffectiveSlot(
+  slot: AeReviewerSlot,
+  personas: readonly AePersonaEntry[],
+): AeReviewerSlot {
+  if (slot.mode !== "fixed") return slot;
+  const persona = aePersonaOf(slot, personas);
+  const model = slot.model ?? persona?.model;
