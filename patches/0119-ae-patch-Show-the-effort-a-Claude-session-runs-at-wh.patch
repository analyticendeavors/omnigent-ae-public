diff --git a/web/src/lib/aeEffortDefault.test.ts b/web/src/lib/aeEffortDefault.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e831d958b648315a70d9c0bd9dd4dc72a747ef42
