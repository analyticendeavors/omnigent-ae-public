+    const older = aeWithClaudeVersions(CATALOG).slice(CATALOG.length);
+    expect(older.map((row) => row.id)).toEqual([
+      "claude-opus-5",
+      "claude-opus-4-8",
+      "claude-opus-4-7",
+      "claude-sonnet-5",
+      "claude-sonnet-4-6",
+      "claude-haiku-4-5",
+      "claude-fable-5",
