+  aeStepBody,
+  aeStepVerb,
+  aeTurnStartedAt,
+  aeWaitingLabel,
+  deriveAeActivity,
+  isAeSessionState,
+  type AeActivityInput,
+} from "./aeSessionActivity";
+
+const NOW = new Date(2026, 9, 17, 8, 30, 0).getTime();
+const NINE = new Date(2026, 9, 17, 9, 0, 0).getTime();
+
+function input(extra: Partial<AeActivityInput> = {}): AeActivityInput {
+  return {
+    working: false,
+    pendingQuestions: 0,
+    backgroundShells: 0,
+    runningChildren: 0,
+    lastEventAt: null,
+    nextRun: null,
+    now: NOW,
+    ...extra,
+  };
+}
+
+const ctx = (createdAtS?: number) => ({
+  agent: null,
+  depth: 0,
+  turn: 0,
+  timestamp: 0,
+  responseId: "r",
+  itemId: null,
+  ...(createdAtS === undefined ? {} : { clientCreatedAtS: createdAtS }),
+});
+
+function toolGroup(callId: string, command: string, atS?: number): AnyBlock {
+  return {
+    type: "tool_group",
+    ctx: ctx(atS),
+    iteration: 0,
+    executions: [
+      {
+        name: "Bash",
+        arguments: { command },
+        argsSummary: command,
+        callId,
+        agentName: "main",
+        executedBy: "client",
