+    tool: "worker",
+    session_name: id,
+    current_task_status: "in_progress",
+    busy: true,
+    last_message_preview: null,
+    pending_elicitations_count: 0,
+    created_at: startedS,
+  };
+}
+
+const checkin = (): ScheduledTask => ({
+  id: "a".repeat(32),
+  name: "AE orchestrator check-in",
+  prompt: `Check in on ${CONV}`,
+  rrule: "FREQ=HOURLY",
+  ownerUserId: null,
