Subject: [PATCH 306/333] [ae-patch] Rename the navigator.share stand-in in the
 share-service test so oxlint's no-shadow passes

---
 .../services/useExtensionHostServices.aeShare.test.tsx        | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/web/src/extensions/services/useExtensionHostServices.aeShare.test.tsx b/web/src/extensions/services/useExtensionHostServices.aeShare.test.tsx
index 022ee153a34e5aa54df7c72a231015399aee0347..ce2d5b34e763b51c5e58edcda977985abfb8568d 100644
--- a/web/src/extensions/services/useExtensionHostServices.aeShare.test.tsx
+++ b/web/src/extensions/services/useExtensionHostServices.aeShare.test.tsx
@@ -54,8 +54,8 @@ function share(permissions: ExtensionCatalogItem["permissions"] = ["navigation"]
 const image = (type = "image/jpeg", size = 10) =>
   new File([new Uint8Array(size)], "post.jpg", { type });
 
-function setNavigator(share: unknown, canShare?: unknown): void {
-  Object.defineProperty(navigator, "share", { value: share, configurable: true });
+function setNavigator(shareFn: unknown, canShare?: unknown): void {
+  Object.defineProperty(navigator, "share", { value: shareFn, configurable: true });
   Object.defineProperty(navigator, "canShare", { value: canShare, configurable: true });
 }
 
