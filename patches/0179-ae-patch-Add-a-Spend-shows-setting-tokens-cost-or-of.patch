+) -> str:
+    entry: dict[str, Any] = {
+        "type": "assistant",
+        "requestId": request_id,
+        "message": {
+            "role": "assistant",
+            "usage": {
+                "input_tokens": inp,
+                "output_tokens": out,
+                "cache_creation_input_tokens": cc,
+                "cache_read_input_tokens": cr,
+            },
+        },
+    }
+    if side:
+        entry["isSidechain"] = True
