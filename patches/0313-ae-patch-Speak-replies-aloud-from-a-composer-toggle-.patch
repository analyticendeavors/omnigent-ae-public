@@ -0,0 +1,192 @@
+import { act, renderHook } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { WORKING_CUE_DELAY_MS, WORKING_CUE_TEXT } from "@/lib/aeSpeakReplies";
+import { type AnyBlock, LIVE_ITEM_PREFIX } from "@/lib/blocks";
+import { useChatStore } from "@/store/chatStore";
+import { type FakeSynth, installFakeSpeech, removeFakeSpeech } from "@/test/fakeSpeech";
+import { useAeSpeakReplies } from "./useAeSpeakReplies";
+
+let synth: FakeSynth;
+
+function ctx(responseId: string, itemId: string | null, extra: Record<string, unknown> = {}) {
+  return { agent: null, depth: 0, turn: 1, timestamp: 1, responseId, itemId, ...extra };
+}
+function live(responseId: string, fullText: string): AnyBlock {
+  return {
+    type: "text_done",
+    ctx: ctx(responseId, `${LIVE_ITEM_PREFIX}${responseId}`),
+    fullText,
+    hasCodeBlocks: false,
+  } as AnyBlock;
+}
+function final(responseId: string, itemId: string, fullText: string, extra = {}): AnyBlock {
+  return {
+    type: "text_done",
+    ctx: ctx(responseId, itemId, extra),
+    fullText,
+    hasCodeBlocks: false,
+  } as AnyBlock;
+}
+function chunk(responseId: string, text: string, depth = 0): AnyBlock {
+  return { type: "text_chunk", ctx: { ...ctx(responseId, null), depth }, text } as AnyBlock;
+}
+function setStore(patch: Record<string, unknown>) {
+  act(() => {
+    useChatStore.setState(patch as never);
+  });
+}
+function flush() {
+  act(() => {
+    vi.advanceTimersByTime(1);
+  });
+}
+
+function mount(enabled = true, chatId: string | null = "c1") {
+  return renderHook(
+    (p: { enabled: boolean; chatId: string | null }) =>
+      useAeSpeakReplies({ ...p, voiceURI: null, rate: 1 }),
+    { initialProps: { enabled, chatId } },
+  );
+}
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  synth = installFakeSpeech();
+  useChatStore.setState({ conversationId: "c1", blocks: [], status: "idle" } as never);
+});
+
+afterEach(() => {
+  vi.useRealTimers();
+  removeFakeSpeech();
+  useChatStore.setState({ conversationId: null, blocks: [], status: "idle" } as never);
+});
+
+describe("useAeSpeakReplies", () => {
+  it("speaks a growing live preview, then only the remainder on the final", () => {
+    mount();
+    setStore({ blocks: [live("r1", "One. Two")] });
+    flush();
+    expect(synth.texts()).toEqual(["One."]);
+    setStore({ blocks: [live("r1", "One. Two. Thr")] });
+    flush();
+    expect(synth.texts()).toEqual(["One.", "Two."]);
+    setStore({ blocks: [final("r1", "item-1", "One. Two. Three.\n\n**TLDR**\nDone.")] });
+    flush();
+    expect(synth.texts()).toEqual(["One.", "Two.", "Three."]);
+  });
+
+  it("speaks an SDK chunk stream the same way", () => {
+    mount();
+    setStore({ blocks: [chunk("r1", "Alpha. Be"), chunk("r1", "ta. Gam")] });
+    flush();
+    expect(synth.texts()).toEqual(["Alpha. Beta."]);
+    setStore({ blocks: [final("r1", "item-1", "Alpha. Beta. Gamma.")] });
+    flush();
+    expect(synth.texts()).toEqual(["Alpha. Beta.", "Gamma."]);
+  });
+
+  it("speaks a final that was never streamed whole", () => {
+    mount();
+    setStore({ blocks: [final("r1", "item-1", "Whole reply.")] });
+    flush();
+    expect(synth.texts()).toEqual(["Whole reply."]);
+  });
+
+  it("does not read back what was on screen when it was enabled", () => {
+    setStore({
+      blocks: [final("r0", "item-0", "Old reply."), live("r1", "Half sentence. Still going")],
+    });
+    mount();
+    flush();
+    expect(synth.texts()).toEqual([]);
+    setStore({
+      blocks: [
+        final("r0", "item-0", "Old reply."),
+        live("r1", "Half sentence. Still going. More."),
+      ],
+    });
+    flush();
+    expect(synth.texts()).toEqual(["More."]);
+  });
+
+  it("ignores history, sub-agent and interrupted text", () => {
+    mount();
+    setStore({
+      blocks: [
+        final("r1", "h", "From history.", { createdAtS: 100 }),
+        chunk("r2", "Sub agent talking. ", 1),
+        { ...final("r3", "i", "Cancelled partial."), interrupted: true } as AnyBlock,
+      ],
+    });
+    flush();
+    expect(synth.texts()).toEqual([]);
+  });
+
+  it("stops speech when a message is sent", () => {
+    mount();
+    setStore({ blocks: [final("r1", "item-1", "Talking now.")] });
+    flush();
+    const cancels = synth.cancelCount;
+    setStore({ status: "streaming" });
+    expect(synth.cancelCount).toBeGreaterThan(cancels);
+  });
+
+  it("says the working cue once after six seconds of silence", () => {
+    mount();
+    setStore({ status: "streaming" });
+    act(() => {
+      vi.advanceTimersByTime(WORKING_CUE_DELAY_MS - 1);
+    });
+    expect(synth.texts()).toEqual([]);
+    act(() => {
+      vi.advanceTimersByTime(2);
+    });
+    expect(synth.texts()).toEqual([WORKING_CUE_TEXT]);
+    act(() => {
+      vi.advanceTimersByTime(20000);
+    });
+    expect(synth.texts()).toEqual([WORKING_CUE_TEXT]);
+  });
+
+  it("skips the working cue when text arrives first", () => {
+    mount();
+    setStore({ status: "streaming" });
+    setStore({ blocks: [live("r1", "Quick start.")] });
+    act(() => {
+      vi.advanceTimersByTime(WORKING_CUE_DELAY_MS + 10);
+    });
+    expect(synth.texts()).toEqual(["Quick start."]);
+  });
+
+  it("stops and goes quiet when disabled", () => {
+    const { rerender } = mount();
+    setStore({ blocks: [final("r1", "item-1", "Talking now.")] });
+    flush();
+    const cancels = synth.cancelCount;
+    rerender({ enabled: false, chatId: "c1" });
+    expect(synth.cancelCount).toBeGreaterThan(cancels);
+    setStore({ blocks: [final("r2", "item-2", "Not spoken.")] });
+    flush();
+    expect(synth.texts()).toEqual(["Talking now."]);
+  });
+
+  it("does nothing without a chat id", () => {
+    mount(true, null);
+    setStore({ blocks: [final("r1", "item-1", "Silent.")] });
+    flush();
+    expect(synth.texts()).toEqual([]);
+  });
+
+  it("readLast speaks the last lead reply with the TLDR cut", () => {
+    const { result } = mount(false);
+    setStore({
+      blocks: [
+        final("r1", "a", "First.", { createdAtS: 1 }),
+        final("r2", "b", "**Second** reply.\n\nTLDR\nDone.", { createdAtS: 2 }),
+      ],
+    });
+    act(() => result.current.readLast());
+    flush();
+    expect(synth.texts()).toEqual(["Second reply."]);
+  });
+});
diff --git a/web/src/hooks/useAeSpeakReplies.ts b/web/src/hooks/useAeSpeakReplies.ts
new file mode 100644
index 0000000000000000000000000000000000000000..472a16aef8ffd76323400d39ed15bb8eb8304fcf
--- /dev/null
+++ b/web/src/hooks/useAeSpeakReplies.ts
@@ -0,0 +1,191 @@
+// Reads assistant replies aloud as they stream into the visible chat. Only live
+// depth-0 text is spoken: history, sub-agent text and interrupted partials are not.
+
+import { useCallback, useEffect, useRef, useSyncExternalStore } from "react";
+import {
+  createSpeaker,
+  type Speaker,
+  WORKING_CUE_DELAY_MS,
+  WORKING_CUE_TEXT,
+} from "@/lib/aeSpeakReplies";
+import { completeSentences, speechTextFromMarkdown, stripTldr } from "@/lib/aeSpeechText";
+import { type AnyBlock, LIVE_ITEM_PREFIX, type TextDone } from "@/lib/blocks";
+import { useChatStore } from "@/store/chatStore";
+
+let sharedSpeaker: Speaker | null = null;
+function getSpeaker(): Speaker {
+  sharedSpeaker ??= createSpeaker();
+  return sharedSpeaker;
+}
+
+interface ResponseTrack {
+  /** Raw markdown characters of this response already handed to the speaker. */
+  spokenRawEnd: number;
+  raw: string;
+  done: boolean;
+}
+
+interface ResponseGroup {
+  chunks: string[];
+  live: TextDone | null;
+  finals: TextDone[];
+}
+
+function isSpeakable(b: AnyBlock): b is AnyBlock & { type: "text_chunk" | "text_done" } {
+  if (b.type !== "text_chunk" && b.type !== "text_done") return false;
+  if (b.ctx.depth !== 0 || b.ctx.createdAtS !== undefined) return false;
+  return !(b.type === "text_done" && b.interrupted);
+}
+
+function groupByResponse(blocks: readonly AnyBlock[]): Map<string, ResponseGroup> {
+  const groups = new Map<string, ResponseGroup>();
+  for (const b of blocks) {
+    if (!isSpeakable(b)) continue;
+    let g = groups.get(b.ctx.responseId);
+    if (!g) {
+      g = { chunks: [], live: null, finals: [] };
+      groups.set(b.ctx.responseId, g);
+    }
+    if (b.type === "text_chunk") g.chunks.push(b.text);
+    else if (b.ctx.itemId?.startsWith(LIVE_ITEM_PREFIX)) g.live = b;
+    else g.finals.push(b);
+  }
+  return groups;
+}
+
+export interface UseAeSpeakRepliesArgs {
+  chatId: string | null;
+  enabled: boolean;
+  voiceURI: string | null;
+  rate: number;
+}
+
+export function useAeSpeakReplies({ chatId, enabled, voiceURI, rate }: UseAeSpeakRepliesArgs): {
+  speaking: boolean;
+  stop: () => void;
+  readLast: () => void;
+} {
+  const optsRef = useRef({ voiceURI, rate });
+  optsRef.current = { voiceURI, rate };
+
+  const speaking = useSyncExternalStore(
+    (cb) => getSpeaker().subscribe(cb),
+    () => getSpeaker().speaking(),
+    () => false,
+  );
+
+  useEffect(() => {
+    if (!enabled || !chatId) return;
+    const speaker = getSpeaker();
+    const handled = new Set<string>();
+    let responses = new Map<string, ResponseTrack>();
+    let cueTimer: ReturnType<typeof setTimeout> | null = null;
+    let spokenThisTurn = false;
+    let synced = false;
+    let prevStatus: "idle" | "streaming" = "idle";
+
+    const clearCue = () => {
+      if (cueTimer !== null) clearTimeout(cueTimer);
+      cueTimer = null;
+    };
+    const say = (markdown: string) => {
+      // A reply joined mid-sentence leaves the sentence's end mark at the start.
+      const text = speechTextFromMarkdown(markdown.replace(/^[.!?\s]+/, ""));
+      if (text === "") return;
+      spokenThisTurn = true;
+      clearCue();
+      speaker.speak(text, optsRef.current);
+    };
+    // Everything already on screen counts as handled so it is never read back.
+    const snapshot = (blocks: readonly AnyBlock[]) => {
+      handled.clear();
+      responses = new Map();
+      for (const b of blocks) if (b.ctx.itemId) handled.add(b.ctx.itemId);
+      for (const [rid, g] of groupByResponse(blocks)) {
+        const raw = g.live?.fullText ?? g.chunks.join("");
+        if (raw !== "") responses.set(rid, { spokenRawEnd: raw.length, raw, done: false });
+      }
+    };
+
+    const onChange = (state: ReturnType<typeof useChatStore.getState>) => {
+      if (state.conversationId !== chatId) {
+        synced = false;
+        return;
+      }
+      if (!synced) {
+        synced = true;
+        prevStatus = state.status;
+        snapshot(state.blocks);
+        return;
+      }
+      if (prevStatus === "idle" && state.status === "streaming") {
+        speaker.stop();
+        snapshot(state.blocks);
+        spokenThisTurn = false;
+        clearCue();
+        cueTimer = setTimeout(() => {
+          cueTimer = null;
+          if (!spokenThisTurn) {
+            spokenThisTurn = true;
+            speaker.speak(WORKING_CUE_TEXT, optsRef.current);
+          }
+        }, WORKING_CUE_DELAY_MS);
+      } else if (prevStatus === "streaming" && state.status === "idle") {
+        clearCue();
+      }
+      prevStatus = state.status;
+
+      for (const [rid, g] of groupByResponse(state.blocks)) {
+        const track = responses.get(rid) ?? { spokenRawEnd: 0, raw: "", done: false };
+        responses.set(rid, track);
+        for (const f of g.finals) {
+          const key = f.ctx.itemId ?? `${rid}:final`;
+          if (handled.has(key)) continue;
+          handled.add(key);
+          const stripped = stripTldr(f.fullText);
+          const spokenPrefix = track.raw.slice(0, track.spokenRawEnd);
+          const continues = track.spokenRawEnd > 0 && f.fullText.startsWith(spokenPrefix);
+          say(continues ? stripped.slice(track.spokenRawEnd) : stripped);
+          track.done = true;
+        }
+        if (track.done) continue;
+        const raw = g.live?.fullText ?? g.chunks.join("");
+        if (raw === "") continue;
+        track.raw = raw;
+        const { ready } = completeSentences(stripTldr(raw).slice(track.spokenRawEnd));
+        if (ready !== "") {
+          track.spokenRawEnd += ready.length;
+          say(ready);
+        }
+      }
+    };
+
+    const unsubscribe = useChatStore.subscribe(onChange);
+    onChange(useChatStore.getState());
+    return () => {
+      unsubscribe();
+      clearCue();
+      speaker.stop();
+      handled.clear();
+      responses = new Map();
+    };
+  }, [enabled, chatId]);
+
+  const stop = useCallback(() => getSpeaker().stop(), []);
+
+  const readLast = useCallback(() => {
+    const blocks = useChatStore.getState().blocks;
+    for (let i = blocks.length - 1; i >= 0; i--) {
+      const b = blocks[i];
+      if (b.type !== "text_done" || b.ctx.depth !== 0 || b.fullText.trim() === "") continue;
+      const text = speechTextFromMarkdown(stripTldr(b.fullText));
+      if (text === "") continue;
+      const speaker = getSpeaker();
+      speaker.stop();
+      speaker.speak(text, optsRef.current);
+      return;
+    }
+  }, []);
+
+  return { speaking, stop, readLast };
+}
