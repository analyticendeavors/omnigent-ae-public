diff --git a/web/src/lib/aeSpeakReplies.test.ts b/web/src/lib/aeSpeakReplies.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..84c65bd76f196c67ae29fcde4937df103254d17e
--- /dev/null
+++ b/web/src/lib/aeSpeakReplies.test.ts
@@ -0,0 +1,192 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { type FakeSynth, installFakeSpeech, makeVoice, removeFakeSpeech } from "@/test/fakeSpeech";
+import {
+  clearFastAnswersState,
+  createSpeaker,
+  isSpeechSupported,
+  listVoices,
+  onVoicesChanged,
+  pickDefaultVoice,
+  rankVoices,
+  readFastAnswersState,
+  readFastEnabled,
+  readRate,
+  readSpeakReplies,
+  readVoiceURI,
+  voiceLabel,
+  writeFastAnswersState,
+  writeFastEnabled,
+  writeRate,
+  writeSpeakReplies,
+  writeVoiceURI,
+} from "./aeSpeakReplies";
+
+let synth: FakeSynth;
+
+beforeEach(() => {
+  window.localStorage.clear();
+  synth = installFakeSpeech();
+  vi.useFakeTimers();
+});
+
+afterEach(() => {
+  vi.useRealTimers();
+  removeFakeSpeech();
+});
+
+const OPTS = { voiceURI: null, rate: 1 };
+
+describe("the speaker", () => {
+  it("queues one utterance per chunk, in order", () => {
+    const speaker = createSpeaker();
+    speaker.speak("First one. Second one.", { voiceURI: null, rate: 1.25 });
+    speaker.speak("x".repeat(150) + ". " + "y".repeat(150) + ".", OPTS);
+    vi.runAllTimers();
+    expect(synth.texts()[0]).toBe("First one. Second one.");
+    expect(synth.texts().length).toBe(3);
+    expect(synth.spoken[0].rate).toBe(1.25);
+  });
+
+  it("is speaking until the last utterance ends", () => {
+    const speaker = createSpeaker();
+    const seen: boolean[] = [];
+    speaker.subscribe(() => seen.push(speaker.speaking()));
+    speaker.speak("One. " + "z".repeat(230) + ".", OPTS);
+    expect(speaker.speaking()).toBe(true);
+    vi.runAllTimers();
+    synth.finishNext();
+    expect(speaker.speaking()).toBe(true);
+    synth.spoken.forEach((u) => u.onend?.());
+    expect(speaker.speaking()).toBe(false);
+    expect(seen).toEqual([true, false]);
+  });
+
+  it("stop cancels and drops utterances not yet queued", () => {
+    const speaker = createSpeaker();
+    speaker.speak("Hello there.", OPTS);
+    speaker.stop();
+    vi.runAllTimers();
+    expect(synth.cancelCount).toBe(1);
+    expect(synth.spoken).toEqual([]);
+    expect(speaker.speaking()).toBe(false);
+  });
+
+  it("uses the chosen voice by uri, else the default pick", () => {
+    synth.voices = [
+      makeVoice({ name: "Plain", lang: "en-US" }),
+      makeVoice({ name: "Microsoft Aria Online (Natural)", lang: "en-US", voiceURI: "aria" }),
+    ];
+    const speaker = createSpeaker();
+    speaker.speak("One.", { voiceURI: "Plain", rate: 1 });
+    speaker.speak("Two.", OPTS);
+    vi.runAllTimers();
+    expect((synth.spoken[0].voice as { name: string }).name).toBe("Plain");
+    expect((synth.spoken[1].voice as { name: string }).name).toContain("Aria");
+    expect(synth.spoken[1].lang).toBe("en-US");
+  });
+});
+
+describe("voices", () => {
+  it("ranks a Natural voice above a plain one of the same language", () => {
+    const plain = makeVoice({ name: "Plain", lang: "en-US", default: true });
+    const natural = makeVoice({ name: "Aria Online (Natural)", lang: "en-GB" });
+    expect(rankVoices([plain, natural], "en-US")[0]).toBe(natural);
+  });
+
+  it("ranks a same-language plain voice above a Natural one of another language", () => {
+    const plain = makeVoice({ name: "Plain", lang: "en-US" });
+    const natural = makeVoice({ name: "Denise Online (Natural)", lang: "fr-FR" });
+    expect(rankVoices([natural, plain], "en-US")[0]).toBe(plain);
+    expect(pickDefaultVoice([natural, plain], "en-US")).toBe(plain);
+    expect(pickDefaultVoice([], "en-US")).toBeNull();
+  });
+
+  it("orders Google, then Premium, then default, then name", () => {
+    const voices = [
+      makeVoice({ name: "Zed", lang: "en-US", default: true }),
+      makeVoice({ name: "Alice Premium", lang: "en-US" }),
+      makeVoice({ name: "Google US English", lang: "en-US" }),
+      makeVoice({ name: "Bob", lang: "en-US" }),
+    ];
+    expect(rankVoices(voices, "en-US").map((v) => v.name)).toEqual([
+      "Google US English",
+      "Alice Premium",
+      "Zed",
+      "Bob",
+    ]);
+  });
+
+  it("shortens labels", () => {
+    expect(voiceLabel({ name: "Microsoft Aria Online (Natural) - English (United States)" })).toBe(
+      "Aria (Natural)",
+    );
+    expect(voiceLabel({ name: "Google US English" })).toBe("US English");
+    expect(voiceLabel({ name: "Google" })).toBe("Google");
+    expect(voiceLabel({ name: "Samantha" })).toBe("Samantha");
+  });
+
+  it("lists voices and reports voiceschanged", () => {
+    synth.voices = [makeVoice({ name: "A", lang: "en-US" })];
+    expect(listVoices()).toHaveLength(1);
+    const cb = vi.fn();
+    const off = onVoicesChanged(cb);
+    synth.emitVoicesChanged();
+    off();
+    synth.emitVoicesChanged();
+    expect(cb).toHaveBeenCalledTimes(1);
+  });
+});
+
+describe("preferences", () => {
+  it("defaults and round trips", () => {
+    expect(readSpeakReplies("c1")).toBe(false);
+    writeSpeakReplies("c1", true);
+    expect(readSpeakReplies("c1")).toBe(true);
+    expect(readSpeakReplies("c2")).toBe(false);
+    writeSpeakReplies("c1", false);
+    expect(window.localStorage.length).toBe(0);
+
+    expect(readFastAnswersState("c1")).toBeNull();
+    writeFastAnswersState("c1", { previousEffort: "high" });
+    expect(readFastAnswersState("c1")).toEqual({ previousEffort: "high" });
+    writeFastAnswersState("c1", { previousEffort: null });
+    expect(readFastAnswersState("c1")).toEqual({ previousEffort: null });
+    clearFastAnswersState("c1");
+    expect(readFastAnswersState("c1")).toBeNull();
+
+    expect(readFastEnabled()).toBe(true);
+    writeFastEnabled(false);
+    expect(readFastEnabled()).toBe(false);
+    writeFastEnabled(true);
+    expect(readFastEnabled()).toBe(true);
+
+    expect(readVoiceURI()).toBeNull();
+    writeVoiceURI("v1");
+    expect(readVoiceURI()).toBe("v1");
+
+    expect(readRate()).toBe(1);
+    writeRate(1.25);
+    expect(readRate()).toBe(1.25);
+    writeRate(1);
+    expect(readRate()).toBe(1);
+  });
+
+  it("ignores a corrupt fast state", () => {
+    window.localStorage.setItem("omnigent:ae-speak-fast:c1", "{nope");
+    expect(readFastAnswersState("c1")).toBeNull();
+  });
+});
+
+describe("without the speech api", () => {
+  it("throws nothing and reports unsupported", () => {
+    removeFakeSpeech();
+    expect(isSpeechSupported()).toBe(false);
+    expect(listVoices()).toEqual([]);
+    const off = onVoicesChanged(() => {});
+    off();
+    const speaker = createSpeaker();
+    speaker.speak("Hello.", OPTS);
+    speaker.stop();
+    expect(speaker.speaking()).toBe(false);
+  });
+});
diff --git a/web/src/lib/aeSpeakReplies.ts b/web/src/lib/aeSpeakReplies.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1653414e32b0c9d3141d68bd91632ff4a0b3ea3f
--- /dev/null
+++ b/web/src/lib/aeSpeakReplies.ts
@@ -0,0 +1,243 @@
+// Speak replies: per-browser preferences, voice ranking and a queueing speaker
+// over window.speechSynthesis. Every access is guarded; nothing here throws when
+// the speech API or storage is missing.
+
+import { splitForSpeech } from "./aeSpeechText";
+
+export const WORKING_CUE_TEXT = "Working on it.";
+export const WORKING_CUE_DELAY_MS = 6000;
+export const FAST_EFFORT = "low";
+export const RATE_FASTER = 1.25;
+
+const SPEAK_KEY = "omnigent:ae-speak-replies:";
+const FAST_STATE_KEY = "omnigent:ae-speak-fast:";
+export const SPEAK_FAST_ENABLED_KEY = "omnigent:ae-speak-fast-enabled";
+export const SPEAK_VOICE_KEY = "omnigent:ae-speak-voice";
+export const SPEAK_RATE_KEY = "omnigent:ae-speak-rate";
+
+function getItem(key: string): string | null {
+  if (typeof window === "undefined") return null;
+  try {
+    return window.localStorage.getItem(key);
+  } catch {
+    return null;
+  }
+}
+
+function setItem(key: string, value: string | null): void {
+  if (typeof window === "undefined") return;
+  try {
+    if (value === null) window.localStorage.removeItem(key);
+    else window.localStorage.setItem(key, value);
+  } catch {
+    // A storage failure must not break the composer.
+  }
+}
+
+export function readSpeakReplies(chatId: string): boolean {
+  return getItem(SPEAK_KEY + chatId) === "true";
+}
+
+export function writeSpeakReplies(chatId: string, on: boolean): void {
+  setItem(SPEAK_KEY + chatId, on ? "true" : null);
+}
+
+export interface FastAnswersState {
+  previousEffort: string | null;
+}
+
+export function readFastAnswersState(chatId: string): FastAnswersState | null {
+  const raw = getItem(FAST_STATE_KEY + chatId);
+  if (raw === null) return null;
+  try {
+    const parsed: unknown = JSON.parse(raw);
+    if (typeof parsed !== "object" || parsed === null) return null;
+    const prev = (parsed as { previousEffort?: unknown }).previousEffort;
+    return { previousEffort: typeof prev === "string" ? prev : null };
+  } catch {
+    return null;
+  }
+}
+
+export function writeFastAnswersState(chatId: string, state: FastAnswersState): void {
+  setItem(FAST_STATE_KEY + chatId, JSON.stringify({ previousEffort: state.previousEffort }));
+}
+
+export function clearFastAnswersState(chatId: string): void {
+  setItem(FAST_STATE_KEY + chatId, null);
+}
+
+export function readFastEnabled(): boolean {
+  return getItem(SPEAK_FAST_ENABLED_KEY) !== "false";
+}
+
+export function writeFastEnabled(on: boolean): void {
+  setItem(SPEAK_FAST_ENABLED_KEY, on ? null : "false");
+}
+
+export function readVoiceURI(): string | null {
+  return getItem(SPEAK_VOICE_KEY);
+}
+
+export function writeVoiceURI(uri: string | null): void {
+  setItem(SPEAK_VOICE_KEY, uri);
+}
+
+export function readRate(): number {
+  return getItem(SPEAK_RATE_KEY) === String(RATE_FASTER) ? RATE_FASTER : 1;
+}
+
+export function writeRate(rate: number): void {
+  setItem(SPEAK_RATE_KEY, rate === RATE_FASTER ? String(RATE_FASTER) : null);
+}
+
+export function isSpeechSupported(): boolean {
+  if (typeof window === "undefined") return false;
+  return Boolean(window.speechSynthesis) && typeof window.SpeechSynthesisUtterance === "function";
+}
+
+export function listVoices(): SpeechSynthesisVoice[] {
+  if (!isSpeechSupported()) return [];
+  try {
+    return window.speechSynthesis.getVoices();
+  } catch {
+    return [];
+  }
+}
+
+/** Voices load late in Chrome and Edge; the callback fires when the list changes. */
+export function onVoicesChanged(cb: () => void): () => void {
+  if (!isSpeechSupported()) return () => {};
+  const synth = window.speechSynthesis;
+  synth.addEventListener?.("voiceschanged", cb);
+  return () => synth.removeEventListener?.("voiceschanged", cb);
+}
+
+function defaultLang(): string {
+  try {
+    return typeof navigator === "undefined" ? "en-US" : navigator.language || "en-US";
+  } catch {
+    return "en-US";
+  }
+}
+
+export function rankVoices(
+  voices: readonly SpeechSynthesisVoice[],
+  lang: string = defaultLang(),
+): SpeechSynthesisVoice[] {
+  const prefix = lang.slice(0, 2).toLowerCase();
+  const score = (v: SpeechSynthesisVoice): number[] => [
+    v.lang.slice(0, 2).toLowerCase() === prefix ? 0 : 1,
+    /Natural|Online/.test(v.name) ? 0 : 1,
+    /Google/.test(v.name) ? 0 : 1,
+    /Premium|Enhanced|Siri/.test(v.name) ? 0 : 1,
+    v.default ? 0 : 1,
+  ];
+  return [...voices].sort((a, b) => {
+    const sa = score(a);
+    const sb = score(b);
+    for (let i = 0; i < sa.length; i++) if (sa[i] !== sb[i]) return sa[i] - sb[i];
+    return a.name.localeCompare(b.name);
+  });
+}
+
+export function pickDefaultVoice(
+  voices: readonly SpeechSynthesisVoice[],
+  lang: string = defaultLang(),
+): SpeechSynthesisVoice | null {
+  return rankVoices(voices, lang)[0] ?? null;
+}
+
+/** Short menu name: "Microsoft Aria Online (Natural) - English" reads "Aria (Natural)". */
+export function voiceLabel(voice: Pick<SpeechSynthesisVoice, "name">): string {
+  let name = voice.name.split(" - ")[0];
+  const stripped = name.replace(/^(Microsoft|Google) /, "");
+  if (stripped.trim() !== "") name = stripped;
+  return name.replace(/ Online/, "").trim();
+}
+
+export interface SpeakOptions {
+  voiceURI: string | null;
+  rate: number;
+}
+
+export interface Speaker {
+  speak: (text: string, opts: SpeakOptions) => void;
+  stop: () => void;
+  speaking: () => boolean;
+  subscribe: (cb: () => void) => () => void;
+}
+
+export function createSpeaker(): Speaker {
+  const listeners = new Set<() => void>();
+  // Bumped by stop() so events from cancelled utterances are ignored.
+  let generation = 0;
+  let pending = 0;
+  let isSpeaking = false;
+
+  const notify = () => listeners.forEach((cb) => cb());
+  const setSpeaking = (next: boolean) => {
+    if (isSpeaking === next) return;
+    isSpeaking = next;
+    notify();
+  };
+
+  return {
+    speak(text, opts) {
+      if (!isSpeechSupported()) return;
+      const chunks = splitForSpeech(text);
+      if (chunks.length === 0) return;
+      const gen = generation;
+      const synth = window.speechSynthesis;
+      const voices = listVoices();
+      const voice =
+        (opts.voiceURI ? voices.find((v) => v.voiceURI === opts.voiceURI) : undefined) ??
+        pickDefaultVoice(voices);
+      pending += chunks.length;
+      setSpeaking(true);
+      // Chrome drops a speak() issued in the same tick as cancel().
+      setTimeout(() => {
+        if (gen !== generation) return;
+        for (const chunk of chunks) {
+          const utterance = new window.SpeechSynthesisUtterance(chunk);
+          if (voice) {
+            utterance.voice = voice;
+            utterance.lang = voice.lang;
+          }
+          utterance.rate = opts.rate;
+          const done = () => {
+            if (gen !== generation) return;
+            pending = Math.max(0, pending - 1);
+            if (pending === 0) setSpeaking(false);
+          };
+          utterance.onend = done;
+          utterance.onerror = done;
+          try {
+            synth.speak(utterance);
+          } catch {
+            done();
+          }
+        }
+      }, 0);
+    },
+    stop() {
+      generation++;
+      pending = 0;
+      if (isSpeechSupported()) {
+        try {
+          window.speechSynthesis.cancel();
+        } catch {
+          // Nothing to cancel.
+        }
+      }
+      setSpeaking(false);
+    },
+    speaking: () => isSpeaking,
+    subscribe(cb) {
+      listeners.add(cb);
+      return () => {
+        listeners.delete(cb);
+      };
+    },
+  };
+}
