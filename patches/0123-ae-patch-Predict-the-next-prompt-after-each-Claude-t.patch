+def test_side_call_prompt_stays_within_the_budget() -> None:
+    context = suggest.TurnContext("~" * 5000, "^" * 4000 + "END")
+    prompt = suggest.build_side_call_prompt(context)
+    assert prompt.count("~") == suggest.MAX_PROMPT_CHARS
