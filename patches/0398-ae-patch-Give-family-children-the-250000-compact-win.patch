+@pytest.mark.parametrize(
+    "labels,parent,expected",
+    [
+        pytest.param({}, None, False, id="lead"),
+        pytest.param({"ae.orch": "conv_lead"}, None, True, id="orch-label"),
+        pytest.param({"ae.orch": "1"}, None, False, id="standalone"),
