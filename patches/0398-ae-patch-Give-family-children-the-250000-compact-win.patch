From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ae-automation-bot <ae-automation-bot@users.noreply.github.com>
Date: Wed, 18 Nov 2026 13:20:49 -0800
Subject: [PATCH 398/443] [ae-patch] Give family children the 250000 compact
 window: decide child with the family rule (ae.orch label), not only
 parent_session_id

---
 omnigent/inner/ae_roles.py                    | 24 +++++--
 omnigent/runner/ae_child_compact_window.py    | 15 +++--
 omnigent/runner/native/orchestration.py       | 10 ++-
 tests/runner/test_ae_child_compact_window.py  | 50 +++++++++++---
 .../test_app_claude_native_launch_args.py     | 67 +++++++++++++++++--
 5 files changed, 138 insertions(+), 28 deletions(-)

diff --git a/omnigent/inner/ae_roles.py b/omnigent/inner/ae_roles.py
index 00d503022c8c6c3bd31ab13cffed6c4bdae68a29..81b5500192137d2181b360ab4b2988c1efe3f973 100644
--- a/omnigent/inner/ae_roles.py
+++ b/omnigent/inner/ae_roles.py
@@ -301,21 +301,33 @@ def _agent_lookup(store: ConversationStore) -> Callable[[str], str | None]:
     return lookup
 
 
-def _is_child(conv: Conversation) -> bool:
+def is_family_child(labels: object, parent_session_id: object = None) -> bool:
     """True for a session with a parent or an ``ae.orch`` label holding a session id.
 
     A fork (``omnigent.fork.source_id``, no parent) copies its source's labels
-    but is a top-level session, so it is never a child.
+    but is a top-level session, so it is never a child. ``ae.orch`` of ``"1"``
+    marks a standalone handoff chat or an unknown orchestrator, which leads its
+    own family. The family view and the child auto-compact window both decide
+    with this one rule.
+
+    :param labels: The session's labels, e.g. ``{"ae.orch": "conv_lead"}``; any
+        non-dict reads as no labels.
+    :param parent_session_id: The session's parent id, or ``None``.
     """
-    if getattr(conv, "parent_conversation_id", None):
+    if parent_session_id:
         return True
-    labels = conv.labels if isinstance(conv.labels, dict) else {}
-    if labels.get(FORK_SOURCE_LABEL):
+    label_map = labels if isinstance(labels, dict) else {}
+    if label_map.get(FORK_SOURCE_LABEL):
         return False
-    orch = labels.get(ORCH_LABEL)
+    orch = label_map.get(ORCH_LABEL)
     return isinstance(orch, str) and orch.strip() not in ("", "1")
 
 
+def _is_child(conv: Conversation) -> bool:
+    """True when *conv* is a family child (see :func:`is_family_child`)."""
+    return is_family_child(conv.labels, getattr(conv, "parent_conversation_id", None))
+
+
 def with_roles(
     notice: dict[str, object] | None, conv: Conversation, store: ConversationStore
 ) -> dict[str, object]:
diff --git a/omnigent/runner/ae_child_compact_window.py b/omnigent/runner/ae_child_compact_window.py
index eed3206399679ce4b3bbc9b611c2f5628b13cbab..e06665699c118c03334798235a8f836be0b2b986 100644
--- a/omnigent/runner/ae_child_compact_window.py
