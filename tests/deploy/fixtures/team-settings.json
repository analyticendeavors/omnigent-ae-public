{
  "env": {
    "DOTNET_hostBuilder__reloadConfigOnChange": "false",
    "DOTNET_EnableDiagnostics": "0"
  },
  "allowedMcpServers": [
    {
      "serverUrl": "https://mcp.krisp.ai/*"
    },
    {
      "serverUrl": "https://mcp.hubspot.com/*"
    },
    {
      "serverUrl": "https://esignatures-oauth.analytic-endeavors-account.workers.dev/*"
    },
    {
      "serverName": "freshbooks"
    },
    {
      "serverName": "powerbi-modeling-sp"
    },
    {
      "serverName": "omnigent"
    },
    {
      "serverName": "ae"
    }
  ],
  "deniedMcpServers": [
    {
      "serverName": "plugin:rayfin:Github"
    },
    {
      "serverName": "plugin:rayfin:raymcp"
    },
    {
      "serverName": "plugin:fabric-skills:powerbi-modeling-mcp"
    }
  ],
  "enabledPlugins": {
    "rayfin@rayfin-skills": true,
    "powerbi-authoring@fabric-collection": true
  },
  "extraKnownMarketplaces": {
    "fabric-collection": {
      "source": {
        "source": "github",
        "repo": "microsoft/skills-for-fabric"
      }
    },
    "rayfin-skills": {
      "source": {
        "source": "github",
        "repo": "microsoft/rayfin"
      }
    }
  }
}
