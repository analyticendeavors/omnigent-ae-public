{
  "servers": [
    {
      "name": "freshbooks",
      "transport": "stdio",
      "command": "node",
      "args": [
        "{{HOME}}/.claude/ae-team/mcp/freshbooks-mcp/servers/freshbooks-server.js"
      ],
      "env": {
        "FRESHBOOKS_ACCOUNTS": "AE",
        "FRESHBOOKS_REFRESH_SECRET": "freshbooks-refresh-token-steve"
      },
      "owner_env_drop": [
        "FRESHBOOKS_ACCOUNTS",
        "FRESHBOOKS_REFRESH_SECRET"
      ],
      "sync_paths": [
        "freshbooks-mcp/servers"
      ],
      "setup": [
        "npm ci --omit=dev"
      ],
      "auth": "none"
    },
    {
      "name": "powerbi-modeling-sp",
      "transport": "stdio",
      "command": "bash",
      "args": [
        "{{HOME}}/.claude/ae-team/mcp/claude-config/mcp/pbi-mcp.sh"
      ],
      "env": {},
      "sync_paths": [
        "claude-config/mcp"
      ],
      "setup": [
        "npm ci --omit=dev"
      ],
      "auth": "none"
    },
    {
      "name": "esignatures-oauth",
      "transport": "http",
      "url": "https://esignatures-oauth.analytic-endeavors-account.workers.dev/mcp",
      "auth": "interactive"
    }
  ]
}
