[Unit]
Description=Rocky voice service for OmniGent
After=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/share/rocky-tts/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=COQUI_TOS_AGREED=1
UMask=0077
ExecStart=%h/.local/share/rocky-tts/venv/bin/python %h/deploy/omnigent-ae/packages/ae_omni_policies/src/ae_omni_policies/rocky_tts_bridge.py --repo %h/.local/share/rocky-tts --socket %h/.local/state/ae-rocky-tts/rocky.sock
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=default.target
