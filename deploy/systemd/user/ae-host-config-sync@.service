[Unit]
Description=AE shared config sync into the %i host container (skills, team rules, MCP servers, settings keys)

[Service]
# A USER unit template (2026-10-28, deploy/README.md "Syncing the shared AE
# setup"): copy it and ae-host-config-sync@.timer to ~/.config/systemd/user/,
# then `systemctl --user enable --now ae-host-config-sync@member.timer`. As
# <user>, who is in the docker group, so no sudo.
#
# A oneshot that runs `host-container.sh %i sync-config`: the allowlisted team
# files from the ae-claude-skills clone's origin/main (git archive, never the
# working tree), scanned twice, into the user's volume as the container's own
# user. A container that is not running is a skipped sync (exit 0), and nothing
# here starts, stops or restarts it. The clone is kept current by
# ae-rules-sync.timer, so this unit never fetches. The long timeout covers a
# first `npm ci` through the egress proxy.
Type=oneshot
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=%h/deploy/omnigent-ae/deploy/host-container.sh %i sync-config
TimeoutStartSec=15min
