[Unit]
Description=AE OmniGent new-model watch (look inside Claude Code for model ids, ask the new ones, post to /v1/ae/model-watch)
After=network-online.target
Wants=network-online.target

[Service]
# A USER unit, run by ae-omnigent-model-watch.timer: copy both files to
# ~/.config/systemd/user/ and `systemctl --user enable --now
# ae-omnigent-model-watch.timer` (deploy/README.md "New-model watch", 2026-11-10).
# It runs on the host, not in the server image, because only the host has the `claude`
# binary. As <user>, like ae-omnigent-limits: it posts with the token `omnigent login`
# stored in ~/.omnigent/auth_tokens.json, and asks each new model id one word through
# `claude -p` with no tools, MCP servers, settings or saved session. No secret passes
# through this unit.
#
# config/host.env carries OMNIGENT_SERVER_URL; without it the relay falls back to the
# server that login recorded. PATH is spelled out because claude lives in
# ~/.local/node/bin, which a systemd user session does not have. A pass reads the
# binary only when its size or mtime changed, and asks at most three ids, each up to
# 90 seconds.
Type=oneshot
EnvironmentFile=-%h/deploy/omnigent-ae/config/host.env
Environment=PATH=%h/.omnigent-host/venv/bin:%h/.local/node/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.omnigent-host/venv/bin/python -m ae_omni_policies.model_watch_relay
TimeoutStartSec=6min
Nice=10
