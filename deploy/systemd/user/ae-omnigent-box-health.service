[Unit]
Description=AE OmniGent box health relay (post heat, CPU, memory, storage and bloat to /v1/ae/box-health)

[Service]
# A USER unit, run by ae-omnigent-box-health.timer: copy both files to
# ~/.config/systemd/user/ and `systemctl --user enable --now
# ae-omnigent-box-health.timer` (deploy/README.md, "Box health relay", 2026-10-28).
# As <user>, like ae-omnigent-limits: it reads /sys and /proc, <user>'s own temp
# folders, `docker` (<user> is in the docker group), and posts with the token
# `omnigent login` stored in ~/.omnigent/auth_tokens.json. No secret passes
# through this unit, and the post carries counts, sizes and ages only, never a
# folder, project, session, branch, worktree or file name.
#
# config/host.env carries AE_BOX_USERS and the other AE_BOX_HEALTH_* settings.
# PATH is spelled out so the venv's python and ~/.local/bin come first; docker,
# systemctl, journalctl, du and git are in /usr/bin.
#
# Nice and idle IO because the hourly pass walks Claude's temp folders and
# ~/.cache; TimeoutStartSec leaves room for that and a slow `docker system df -v`.
Type=oneshot
EnvironmentFile=-%h/deploy/omnigent-ae/config/host.env
Environment=PATH=%h/.omnigent-host/venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.omnigent-host/venv/bin/python -m ae_omni_policies.box_health_relay
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=4min
