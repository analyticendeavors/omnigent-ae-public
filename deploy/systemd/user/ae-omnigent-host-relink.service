[Unit]
Description=AE OmniGent host relink (send a sign-in link and restart the host when the server rejects it)
After=ae-omnigent-host.service

[Service]
# A USER unit, added 2026-10-20: copy it to ~/.config/systemd/user/ and
# `systemctl --user enable --now ae-omnigent-host-relink.service` (deploy/README.md,
# "Host relink"). It runs deploy/host-relink.sh watch, which follows the host's
# journal: once the host reports 30 straight rejections or its unit fails, or
# when the Admin Center's Box host button asks, it runs `omnigent login`,
# sends the sign-in link as a
# task-store reminder and restarts ae-omnigent-host.service once the sign-in
# lands. As reid, like the host: the login writes reid's
# ~/.omnigent/auth_tokens.json, and reid is in the docker group, which the
# script's `compose.sh exec` calls need.
#
# config/host.env carries OMNIGENT_SERVER_URL, the URL `omnigent login` takes.
# No secret passes through this unit: the reminder is sent by the server's own
# CLI, with the server's task-store token.
Type=simple
EnvironmentFile=-%h/deploy/omnigent-ae/config/host.env
Environment=PATH=%h/.omnigent-host/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/deploy/omnigent-ae/deploy/host-relink.sh watch
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
