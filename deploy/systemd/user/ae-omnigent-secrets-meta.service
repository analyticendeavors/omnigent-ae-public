[Unit]
Description=AE OmniGent secret expiry relay (post the Key Vault secrets' expiry dates, never their values, to /v1/ae/secrets/meta)
After=network-online.target
Wants=network-online.target

[Service]
# A USER unit, run by ae-omnigent-secrets-meta.timer: copy both files to
# ~/.config/systemd/user/ and `systemctl --user enable --now
# ae-omnigent-secrets-meta.timer` (deploy/README.md, "Secret expiry dates",
# 2026-10-23). As reid, like ae-omnigent-limits: it needs reid's `az login`
# (the list call reads attributes only; it never calls `secret show`) and posts
# with the token `omnigent login` stored in ~/.omnigent/auth_tokens.json.
#
# This unit loads no secrets file. config/host.env carries OMNIGENT_SERVER_URL;
# without it the relay falls back to the server that login recorded. PATH is
# spelled out because az lives in ~/.local/bin (uv tool install azure-cli),
# which a systemd user session does not have.
Type=oneshot
EnvironmentFile=-%h/deploy/omnigent-ae/config/host.env
Environment=PATH=%h/.omnigent-host/venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.omnigent-host/venv/bin/python -m ae_omni_policies.secrets_relay
# 5 min since 2026-10-23: it lists two vaults and every Entra app (side by side).
TimeoutStartSec=5min
