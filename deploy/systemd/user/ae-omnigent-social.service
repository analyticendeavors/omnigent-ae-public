[Unit]
Description=AE OmniGent Social relay (read the YouTube uploads and post them to /v1/ae/social/uploads)
After=network-online.target
Wants=network-online.target

[Service]
# A USER unit, run by ae-omnigent-social.timer: copy both files to
# ~/.config/systemd/user/ and `systemctl --user enable --now ae-omnigent-social.timer`
# (deploy/README.md, "Social card", 2026-11-06). As <user>, like ae-omnigent-secrets-meta:
# the lister reads the YouTube login the youtube-video-publish skill keeps on this box,
# and the post uses the token `omnigent login` stored in ~/.omnigent/auth_tokens.json.
#
# This unit loads no secrets file. config/host.env carries OMNIGENT_SERVER_URL; without it
# the relay falls back to the server that login recorded. PATH is spelled out because node
# lives in ~/.local/node/bin, which a systemd user session does not have.
Type=oneshot
EnvironmentFile=-%h/deploy/omnigent-ae/config/host.env
Environment=PATH=%h/.omnigent-host/venv/bin:%h/.local/node/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.omnigent-host/venv/bin/python -m ae_omni_policies.social_relay
# The lister has its own 120 s cap; this is the ceiling for the whole run.
TimeoutStartSec=4min
