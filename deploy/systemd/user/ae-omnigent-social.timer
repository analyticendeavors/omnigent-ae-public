[Unit]
Description=AE OmniGent Social relay every two hours

[Timer]
# Every two hours at :05 (00:05, 02:05, ... local time; the box is on Pacific), up to five
# minutes late. A new upload or a changed schedule shows on the card within two hours, and
# the card warns when a reading is over six hours old. Persistent: a box that was off runs
# the missed pass when it comes back.
OnCalendar=*-*-* 00/2:05:00
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
