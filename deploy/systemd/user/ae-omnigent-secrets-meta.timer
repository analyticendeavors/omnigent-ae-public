[Unit]
Description=AE OmniGent secret expiry relay daily

[Timer]
# Once a day at 06:15 local time (the box is on Pacific), up to ten minutes
# late. Expiry dates change on a scale of months, so a day is plenty, and the
# Admin Center warns when a reading is over 36 hours old. Persistent: a box that
# was off at 06:15 runs the missed pass when it comes back.
OnCalendar=*-*-* 06:15:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
