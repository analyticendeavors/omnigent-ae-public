[Unit]
Description=AE OmniGent plan limits relay every 5 minutes

[Timer]
# Every five minutes, around the clock, local time (the box is on Pacific):
# :00, :05, :10 and so on, each up to 30 seconds late. A pass reads one small
# file and asks codex app-server one question, so five minutes costs nothing
# and the panel's "last updated" stamp is never much older than the CLIs'
# own reading. Not Persistent: a missed pass is simply the next one.
OnCalendar=*:0/5
RandomizedDelaySec=30
OnBootSec=2min

[Install]
WantedBy=timers.target
