[Unit]
Description=AE /tmp leftover sweep every six hours

[Timer]
# Every six hours at :15, local time (the box is on Pacific): 00:15, 06:15, 12:15
# and 18:15, each up to five minutes late. A run removes at most 5,000 items, so four
# runs a day clear a large backlog within a few days and then keep it near zero.
# Persistent: a run missed while the box was off happens at the next boot.
OnCalendar=00/6:15
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
