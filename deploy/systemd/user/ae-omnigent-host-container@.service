[Unit]
Description=AE OmniGent host container for %i (compose project omnigent-host-%i: the host and its egress proxy)

[Service]
# A USER unit template (2026-10-20, deploy/README.md "Second user's host
# (container)"): ~/.config/systemd/user/ae-omnigent-host-container@.service,
# enabled per user with `systemctl --user enable --now
# ae-omnigent-host-container@member`. As <user>, who is in the docker group, so no
# sudo; linger is already on for the box host.
#
# Docker supervises the containers (restart: unless-stopped), so they come back
# after a reboot or a Docker restart on their own; the unit is the switch and
# the place to look, the same shape as ae-omnigent.service: a oneshot that runs
# `up -d` and stays "active (exited)", with ExecStop taking the project down.
# `up` builds the images first when the server's release tag has none yet,
# which is why the start timeout is long. The user manager cannot order itself
# after the system's docker.service or ae-omnigent.service, so a start at boot
# can come before Docker or before the server stack has made the network
# omnigent-host-%i (its `down` at shutdown removes it once no host holds it):
# `up` then fails with that reason, and Restart= tries again every 30 seconds
# until the server is up.
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=30s
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=%h/deploy/omnigent-ae/deploy/host-container.sh %i up -d --remove-orphans
ExecStop=%h/deploy/omnigent-ae/deploy/host-container.sh %i down
TimeoutStartSec=1800
TimeoutStopSec=120

[Install]
WantedBy=default.target
