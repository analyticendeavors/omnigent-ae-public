[Unit]
Description=AE OmniGent auto-update every minute

[Timer]
# Every minute, around the clock, local time (the box is on Pacific), at 30
# seconds past the minute so the fetch stays off the exact minute other timers
# use. AccuracySec keeps it there: the systemd default of one minute would let
# passes drift and merge.
# Every minute since 2026-11-09 (every ten minutes before): the image was ready
# at 23:04:33Z for ae-v0.18.0.267 and the pass came at 23:10:44Z, 6 of the 13
# minutes from merge to live. A pass that finds nothing new is a git fetch and
# a file compare, and a tag whose image is not published yet is a quiet
# "waiting" pass, so a pushed tag is live about a minute after image.yml's build.
# An update only recreates the omnigent container, never Postgres, so a pass
# during the 02:40 dump (ae-omnigent-dump) does not disturb it.
# Not Persistent: a missed pass is simply the next one.
OnCalendar=*-*-* *:*:30
AccuracySec=5s
OnBootSec=5min

[Install]
WantedBy=timers.target
