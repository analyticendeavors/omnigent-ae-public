[Unit]
Description=AE OmniGent auto-update every 10 minutes

[Timer]
# Every ten minutes, around the clock, local time (the box is on Pacific):
# :00, :10, :20 and so on, each up to a minute late. A pass that finds nothing
# new is a git fetch and a file compare, so ten minutes costs nothing and a
# pushed tag is live within about twenty (image.yml's build plus one pass).
# The randomized delay keeps the fetch off the exact minute other timers use.
# An update only recreates the omnigent container, never Postgres, so a pass
# during the 02:40 dump (ae-omnigent-dump) does not disturb it.
# Not Persistent: a missed pass is simply the next one.
OnCalendar=*:0/10
RandomizedDelaySec=60
OnBootSec=5min

[Install]
WantedBy=timers.target
