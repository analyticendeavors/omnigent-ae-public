[Unit]
Description=AE OmniGent plan limits relay (post Claude Code's and Codex's subscription windows to /v1/ae/limits)
After=network-online.target
Wants=network-online.target

[Service]
# A USER unit, run by ae-omnigent-limits.timer: copy both files to
# ~/.config/systemd/user/ and `systemctl --user enable --now
# ae-omnigent-limits.timer` (docs/PLAN-LIMITS.md, 2026-09-24). As reid, like
# ae-omnigent-host: the relay reads reid's saved Claude status line
# (~/.omnigent/ae/claude-statusline.json, written by
# deploy/ae-limits-statusline.sh), asks reid's Codex login through a
# short-lived `codex app-server`, and posts with the token `omnigent login`
# stored in ~/.omnigent/auth_tokens.json. No secret passes through this unit.
#
# The relay also reads each claude-native session's own status line capture
# under /tmp/omnigent-<uid>/claude-native and asks `claude -p` for get_usage
# (per-model limits, credits; 2026-09-24). This unit loads no secrets file, so
# the probe sees no CLAUDE_CODE_OAUTH_TOKEN and uses reid's stored
# `claude auth login` when there is one; the relay strips the variable too.
#
# config/host.env carries OMNIGENT_SERVER_URL (and AE_LIMITS_CLAUDE_PLAN);
# without it the relay falls back to the server that login recorded. PATH is
# spelled out because codex and claude live in ~/.local/node/bin, which a
# systemd user session does not have.
Type=oneshot
EnvironmentFile=-%h/deploy/omnigent-ae/config/host.env
Environment=PATH=%h/.omnigent-host/venv/bin:%h/.local/node/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.omnigent-host/venv/bin/python -m ae_omni_policies.limits_relay
TimeoutStartSec=2min
