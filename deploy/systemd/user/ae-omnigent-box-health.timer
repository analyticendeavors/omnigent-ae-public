[Unit]
Description=AE OmniGent box health relay every 5 minutes

[Timer]
# Every five minutes, around the clock, local time (the box is on Pacific):
# :00, :05, :10 and so on, each up to 30 seconds late. The fast pass reads a few
# small files in /sys and /proc, so five minutes costs nothing and catches inode
# exhaustion (the 2026-10-28 outage) early; the folder scans cache themselves
# and run about hourly. Not Persistent: a missed pass is simply the next one.
OnCalendar=*:0/5
RandomizedDelaySec=30
OnBootSec=2min

[Install]
WantedBy=timers.target
