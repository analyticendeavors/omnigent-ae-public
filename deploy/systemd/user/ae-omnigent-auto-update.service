[Unit]
Description=AE OmniGent auto-update (deploy the newest ae-v* image tag, health check, roll back on failure)
After=network-online.target
Wants=network-online.target

[Service]
# A USER unit, run by ae-omnigent-auto-update.timer: copy both files to
# ~/.config/systemd/user/ and `systemctl --user enable --now
# ae-omnigent-auto-update.timer` (deploy/README.md, "Automatic updates",
# 2026-09-24). Linger is already on for reid, so it runs without a login
# session, like ae-omnigent-host.
#
# As reid, never root: reid is in the docker group, logs in to ghcr.io once
# (compose pulls with the invoking user's credentials), owns the deploy clone
# (~/deploy/omnigent-ae, 2026-10-13; nobody works in it) and its config/server.env, and can read /secure/env/omnigent-ae.env (640 root:reid).
# The script never calls sudo.
#
# One pass per start; the script takes a lock, so an overlapping start exits
# at once. The timeout covers a slow pull, the migrations behind the health
# check (up to a minute of retries) and, when the upstream pin moved, the
# host venv rebuild.
#
# PATH is spelled out: uv (for the host rebuild) lives in ~/.local/bin, which
# is not on a systemd user session's default PATH.
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/deploy/omnigent-ae
ExecStart=%h/deploy/omnigent-ae/deploy/auto-update.sh
TimeoutStartSec=20min
