[Unit]
Description=AE /tmp leftover sweep (remove old test temp folders and dead debug sockets from the top of /tmp)

[Service]
# A USER unit, run by ae-tmp-litter-sweep.timer: copy both files to
# ~/.config/systemd/user/ and `systemctl --user enable --now
# ae-tmp-litter-sweep.timer` (deploy/README.md, "/tmp leftover sweep", 2026-11-05).
# As <user>, never root (the sweep refuses root). It runs exactly one cleanup,
# `tmp_litter`: top-level /tmp names on a fixed allowlist (LITTER_PATTERNS in
# box_cleanup.py), owned by <user>, older than two days, with every safety check
# the Box health Remove button makes. The journal line carries counts only, never
# a folder or file name.
#
# config/host.env is read for the same AE_BOX_HEALTH_* limits as the box health relay.
# PATH is spelled out so the venv's python comes first.
#
# Nice and idle IO because a pass can remove thousands of small files;
# TimeoutStartSec is well above the sweep's own 120 second removal cap.
Type=oneshot
EnvironmentFile=-%h/deploy/omnigent-ae/config/host.env
Environment=PATH=%h/.omnigent-host/venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.omnigent-host/venv/bin/python -m ae_omni_policies.box_cleanup --sweep
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=5min
