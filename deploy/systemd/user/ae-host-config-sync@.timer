[Unit]
Description=AE shared config sync into the %i host container every 30 minutes

[Timer]
# Every 30 minutes, around the clock, local time (the box is on Pacific): :00
# and :30, each up to two minutes late so a second user's sync does not land on
# the clone at the same instant. Persistent: a pass missed while the box was off
# runs once at the next start. The triggered unit is the same instance of
# ae-host-config-sync@.service.
OnCalendar=*:0/30
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target
