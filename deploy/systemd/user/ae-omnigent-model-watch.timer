[Unit]
Description=AE OmniGent new-model watch every 6 hours

[Timer]
# Every six hours, local time (the box is on Pacific): 00:17, 06:17, 12:17 and 18:17,
# each up to ten minutes late. A pass with no new id only stats the Claude Code binary
# and posts a one-line report, which the Admin Center uses to tell the timer is alive.
# Persistent: a pass missed while the box was off runs at the next boot.
OnCalendar=00/6:17
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
