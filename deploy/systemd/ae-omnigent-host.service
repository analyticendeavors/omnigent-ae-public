[Unit]
Description=AE OmniGent host (runs the steward and shutdown agents; dials out to the server over the tailnet)
After=network-online.target
Wants=network-online.target

[Service]
# A USER unit: ~/.config/systemd/user/ae-omnigent-host.service, enabled with
# `systemctl --user enable --now ae-omnigent-host` after `loginctl enable-linger
# reid` (sudo, once) so it runs without a login session. It runs as reid on
# purpose: the claude-sdk harness uses reid's Claude Max OAuth token, the
# stored `omnigent login` lives in ~/.omnigent/auth_tokens.json, and the
# agents' MCP server reads that same file.
#
# Foreground, not `omnigent host --background`: the background form spawns a
# detached daemon with a filtered environment and returns, which leaves
# systemd supervising nothing. This is the same ExecStart upstream's own
# `omnigent host enable` writes (omnigent/host/service.py): the service entry
# runs `omnigent host --server <url> --non-interactive` and maps the permanent
# auth failure (exit 78: no stored login) onto a clean stop instead of a
# restart loop, so RestartPreventExitStatus below leaves it stopped for a
# person to run `omnigent login` again.
#
# Nothing listens: the host opens a WebSocket to OMNIGENT_SERVER_URL.
# Environment: config/host.env carries the server URL and the runner
# passthrough list (copied from config/host.env.example); the second file,
# 640 root:reid on the encrypted volume and written by deploy/pull-secrets.sh,
# carries CLAUDE_CODE_OAUTH_TOKEN.
# Code runs from the venv deploy/install-host.sh builds (omnigent from the
# pinned submodule plus packages/ae_omni_policies, so `python -m
# ae_omni_policies.mcp`, the agents' tool, resolves) and from the deploy clone,
# ~/deploy/omnigent-ae, which omnigent is installed editable from: before
# 2026-10-13 that was the ~/repos checkout, so every runner loaded whatever
# branch a session had checked out there. PATH is spelled out because the Claude CLI lives in
# ~/.local/node/bin, which is not on a systemd user session's default PATH.
# Added 2026-10-13 so claude-native sessions can reach Fabric: ~/.local/bin
# holds fab (a uv tool). The Fabric env file is deliberately NOT an
# EnvironmentFile here: no host session should carry that secret.
# A box-specific folder (AE's box adds its fab-robot and rayfin-robot wrappers,
# which read the Fabric service principal into their own process) goes in a
# drop-in, never here (2026-10-21):
#   ~/.config/systemd/user/ae-omnigent-host.service.d/<name>.conf
#   [Service]
#   Environment=PATH=<this unit's PATH below>:<the extra folder>
# A drop-in's PATH replaces this one whole, so copy the line in full, keep the
# extra folder after /bin so it can never shadow a system command, and update
# the drop-in when this line changes. Installing a new copy of this file
# replaces only the file; the .d folder stays. A drop-in applies at the next
# start: `systemctl --user daemon-reload`, then restart the unit.
Type=simple
EnvironmentFile=%h/deploy/omnigent-ae/config/host.env
EnvironmentFile=/secure/env/omnigent-host.env
# The box's GNOME keyring is running but locked and nobody can answer its unlock
# prompt, so the keyring secret backend blocks forever; force the file backend.
Environment=OMNIGENT_DISABLE_KEYRING=true
Environment=PATH=%h/.omnigent-host/venv/bin:%h/.local/node/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.omnigent-host/venv/bin/python -m omnigent.host.service_entry --server ${OMNIGENT_SERVER_URL}
Restart=on-failure
RestartPreventExitStatus=78 143
RestartSec=10s

[Install]
WantedBy=default.target
