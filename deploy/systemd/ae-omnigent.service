[Unit]
Description=AE OmniGent server (docker compose: postgres + omnigent-ae, loopback :8010, Tailscale-fronted)
After=network-online.target docker.service tailscaled.service
Wants=network-online.target
Requires=docker.service
# The database, the artifacts and the secrets all live on the encrypted
# volume. A stack that starts before the mount would initialise a fresh,
# empty Postgres in the plain directory underneath /secure/omnigent and serve
# it, which looks exactly like data loss. Same guard as ae-backup.service and
# ae-task-app.service.
RequiresMountsFor=/secure

[Service]
# `docker compose up -d` returns once the containers are running, so the unit
# is a oneshot that stays "active (exited)" while Docker supervises the
# containers (restart: unless-stopped in upstream's compose file). ExecStop
# takes the stack down, so `systemctl stop ae-omnigent` is a clean stop.
Type=oneshot
RemainAfterExit=yes
# Binds 127.0.0.1:8010 -> container 8000 by design; nothing listens off-box.
# Expose it over the tailnet with:
#   tailscale serve --bg --https 8010 http://localhost:8010
# (:8000 and :8001 are the two Graphiti MCPs, :8900 the task-store app,
# :8443 Netdata; Analytic Endeavors' own port map lives in a private repo.)
# Code runs from the deploy clone, ~/deploy/omnigent-ae, never the ~/repos
# checkout sessions work in (2026-10-13); compose.sh names upstream's compose
# file, the AE overlay, config/server.env and /secure/env/omnigent-ae.env.
# Runs as root: the Docker socket, and the secrets file is 640 root:reid.
# The checkout path below is the one install path (system units have no %h);
# on another box render it with sed while copying (deploy/README.md, step 6).
ExecStart=/home/reid/deploy/omnigent-ae/deploy/compose.sh up -d --remove-orphans
ExecStop=/home/reid/deploy/omnigent-ae/deploy/compose.sh down
# First start pulls the image and waits for Postgres to pass its health check.
TimeoutStartSec=900
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
