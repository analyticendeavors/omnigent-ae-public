[Unit]
Description=AE OmniGent nightly Postgres dump into /secure/omnigent/backups
After=docker.service ae-omnigent.service
Requires=docker.service
# The dump directory is on the encrypted volume, and a run without the mount
# would write next to nothing and report success. backup-omnigent.sh checks
# the mountpoint too; this stops the run from starting at all.
RequiresMountsFor=/secure

[Service]
Type=oneshot
# pg_dump inside the running postgres container, through deploy/compose.sh,
# gzip'd into /secure/omnigent/backups/omnigent-<stamp>.sql.gz, newest seven
# kept. The nightly restic run (ae-backup, 03:10 local, from
# agents-and-automation) carries the file to Azure Blob once
# /secure/omnigent/backups is in backup.sh's path list; a live Postgres data
# directory is not restorable from a file copy, which is why this exists.
# Runs as root: the Docker socket, and the secrets file is 640 root:<user>.
# Code runs from the deploy clone, ~/deploy/omnigent-ae (2026-10-13).
# __AE_HOME__ is the checkout path; system units have no %h, so the installer
# renders the token on every install while copying (deploy/README.md, step 6).
ExecStart=__AE_HOME__/deploy/backup-omnigent.sh
