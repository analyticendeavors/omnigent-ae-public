[Unit]
Description=AE OmniGent Postgres dump nightly 02:40 local

[Timer]
# 02:40 every day, local time (the box is on Pacific), thirty minutes ahead of
# ae-backup at 03:10 so restic finds tonight's dump, not yesterday's. Clear of
# the other jobs on Analytic Endeavors' box: ae-delta-ingest is 04:34, ae-krisp-ingest
# takes every :45, the morning is busy 07:30 to 08:20. The randomized delay is
# two minutes, not the usual five to ten, so a late start still lands before
# :45. Persistent catches a missed run after downtime; a dump takes seconds.
OnCalendar=*-*-* 02:40:00
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target
